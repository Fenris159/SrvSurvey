<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.SurfaceMiningOverlayPresentation"
             x:DataType="vm:SurfaceMiningOverlayViewModel" Width="250" ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="Border.rig">
      <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    </Style>
    <Style Selector="Border.rig.collect">
      <Setter Property="BorderBrush" Value="{DynamicResource RavenSecondaryBrush}" />
    </Style>
    <Style Selector="Border.rig.close">
      <Setter Property="BorderBrush" Value="{DynamicResource RavenDangerBrush}" />
    </Style>
    <Style Selector="Border.rig controls|DirectionalChevronControl">
      <Setter Property="Stroke" Value="{DynamicResource RavenAccentBrush}" />
    </Style>
    <Style Selector="Border.rig.collect controls|DirectionalChevronControl">
      <Setter Property="Stroke" Value="{DynamicResource RavenSecondaryBrush}" />
    </Style>
    <Style Selector="Border.rig.close controls|DirectionalChevronControl">
      <Setter Property="Stroke" Value="{DynamicResource RavenDangerBrush}" />
    </Style>
    <Style Selector="Border.resource TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
    </Style>
    <Style Selector="Border.resource controls|DirectionalChevronControl">
      <Setter Property="Stroke" Value="{DynamicResource RavenAccentBrush}" />
    </Style>
    <Style Selector="Border.resource.near TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RavenSecondaryBrush}" />
    </Style>
    <Style Selector="Border.resource.near controls|DirectionalChevronControl">
      <Setter Property="Stroke" Value="{DynamicResource RavenSecondaryBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Padding="4" Background="{DynamicResource RavenWindowBrush}" CornerRadius="5">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
        <StackPanel Spacing="2">
          <TextBlock Classes="overlay-header type-header" Text="SURFACE MINING" />
          <TextBlock FontSize="17" Classes="type-title" Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold" Text="{Binding SurfaceMining.BodyName}" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="9" Classes="monospace type-detail" Text="{Binding SurfaceMining.HeadingText}" />
            <TextBlock FontSize="9" Classes="muted type-detail" Text="{Binding SurfaceMining.HistoryText}" />
          </StackPanel>
        </StackPanel>
        <LayoutTransformControl Grid.Column="1" Classes="type-icon" VerticalAlignment="Top">
          <Border Classes="badge">
            <TextBlock FontSize="8" Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding InputMode}" />
          </Border>
        </LayoutTransformControl>
      </Grid>
      <controls:SurfaceSurveyRadarControl Grid.Row="1" MinHeight="140"
          Markers="{Binding SurfaceMining.RadarMarkers}" ScaleMultiplier="{Binding SurfaceMining.RadarScale}"
          SplatBoundaries="{Binding SurfaceMining.SplatBoundaries}"
          SuggestedRigLocations="{Binding SurfaceMining.SuggestedRigLocations}"
          BackgroundBrush="{DynamicResource RavenRaisedSurfaceBrush}"
          GridBrush="{DynamicResource RavenBorderBrush}" AccentBrush="{DynamicResource RavenSecondaryBrush}"
          SuggestionBrush="{DynamicResource RavenPrimaryBrush}"
          MutedBrush="{DynamicResource RavenMutedTextBrush}" SuccessBrush="{DynamicResource RavenSuccessBrush}"
          WarningBrush="{DynamicResource RavenWarningBrush}" DangerBrush="{DynamicResource RavenDangerBrush}" />
      <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="4">
        <Border Padding="7,5" CornerRadius="7" BorderThickness="1"
                BorderBrush="{DynamicResource RavenBorderBrush}" Background="{DynamicResource RavenSurfaceBrush}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
            <TextBlock FontSize="10" Classes="type-caption" Text="Ship" Foreground="{DynamicResource RavenAccentBrush}" />
            <LayoutTransformControl Grid.Column="1" Classes="type-icon"
                                    IsVisible="{Binding SurfaceMining.HasShipTracker}">
              <controls:DirectionalChevronControl Width="12" Height="12"
                  BearingDegrees="{Binding SurfaceMining.ShipBearing}" Stroke="{DynamicResource RavenAccentBrush}" />
            </LayoutTransformControl>
            <TextBlock FontSize="10" Classes="type-icon" Grid.Column="1" Text="X" IsVisible="{Binding !SurfaceMining.HasShipTracker}"
                       Foreground="{DynamicResource RavenMutedTextBrush}" />
            <TextBlock FontSize="9" Classes="type-value" Grid.Column="2" Text="{Binding SurfaceMining.ShipDistanceText}" />
          </Grid>
        </Border>
        <Border Grid.Column="1" Padding="7,5" CornerRadius="7" BorderThickness="1"
                BorderBrush="{DynamicResource RavenBorderBrush}" Background="{DynamicResource RavenSurfaceBrush}">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
            <TextBlock FontSize="10" Classes="type-caption" Text="Rhino" Foreground="{DynamicResource RavenAccentBrush}" />
            <LayoutTransformControl Grid.Column="1" Classes="type-icon"
                                    IsVisible="{Binding SurfaceMining.HasRhinoTracker}">
              <controls:DirectionalChevronControl Width="12" Height="12"
                  BearingDegrees="{Binding SurfaceMining.RhinoBearing}" Stroke="{DynamicResource RavenAccentBrush}" />
            </LayoutTransformControl>
            <TextBlock FontSize="10" Classes="type-icon" Grid.Column="1" Text="X" IsVisible="{Binding !SurfaceMining.HasRhinoTracker}"
                       Foreground="{DynamicResource RavenMutedTextBrush}" />
            <TextBlock FontSize="9" Classes="type-value" Grid.Column="2" Text="{Binding SurfaceMining.RhinoDistanceText}" />
          </Grid>
        </Border>
      </Grid>
      <ItemsControl Grid.Row="3" ItemsSource="{Binding SurfaceMining.Rigs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MiningRigViewModel">
            <Border Classes="rig" Classes.collect="{Binding CanCollect}" Classes.close="{Binding IsTooClose}"
                    Margin="1" Padding="2,4" BorderThickness="1" CornerRadius="5">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock FontSize="9" Classes="type-body" Text="{Binding Name}" HorizontalAlignment="Center" />
                <LayoutTransformControl Classes="type-icon">
                  <Grid Width="18" Height="18">
                    <controls:DirectionalChevronControl Width="18" Height="18" BearingDegrees="{Binding Bearing}"
                        IsVisible="{Binding IsSet}" StrokeThickness="1.5" />
                    <Ellipse Width="14" Height="14" IsVisible="{Binding !IsSet}"
                        Stroke="{DynamicResource RavenMutedTextBrush}" StrokeThickness="1" />
                  </Grid>
                </LayoutTransformControl>
                <TextBlock FontSize="8" Classes="type-value" Text="{Binding DistanceText}" HorizontalAlignment="Center" />
                <TextBlock FontSize="6" Classes="type-detail" Text="{Binding Status}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock FontSize="8" Classes="type-detail" Grid.Row="4" Text="{Binding SurfaceMining.Detection.SlotsText}"
                 IsVisible="{Binding SurfaceMining.Detection.Enabled}" TextWrapping="Wrap" />
      <ScrollViewer Grid.Row="5" MaxHeight="180" IsVisible="{Binding SurfaceMining.HasResources}"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ResourceTrackers" ItemsSource="{Binding SurfaceMining.Resources}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MiningResourceViewModel">
              <Border Classes="resource" Classes.near="{Binding IsNear}"
                      Margin="1,2" Padding="5,5" CornerRadius="7" BorderThickness="1"
                      Background="{DynamicResource RavenSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                  <TextBlock FontSize="10" Classes="type-body" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                  <LayoutTransformControl Grid.Column="1" Classes="type-icon" VerticalAlignment="Center">
                    <controls:DirectionalChevronControl Width="12" Height="12"
                        BearingDegrees="{Binding Bearing}" IsFar="{Binding !IsNear}" StrokeThickness="1.5" />
                  </LayoutTransformControl>
                  <TextBlock FontSize="9" Classes="type-value" Grid.Column="2" Text="{Binding DistanceText}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="6" Spacing="4">
        <TextBlock FontSize="9" Classes="type-value" Text="{Binding SurfaceMining.CargoText}" />
        <ProgressBar Minimum="0" Maximum="72" Value="{Binding SurfaceMining.CargoUsed}" Height="5"
                     Foreground="{DynamicResource RavenAccentBrush}" Background="{DynamicResource RavenBorderBrush}" />
        <TextBlock FontSize="8" Classes="muted type-detail" Text="{Binding SurfaceMining.StatusText}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
