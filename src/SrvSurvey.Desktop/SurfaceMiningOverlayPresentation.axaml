<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.SurfaceMiningOverlayPresentation"
             x:DataType="vm:SurfaceMiningOverlayViewModel" ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="Border.rig">
      <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    </Style>
    <Style Selector="Border.rig.collect">
      <Setter Property="BorderBrush" Value="{DynamicResource RavenSecondaryBrush}" />
    </Style>
    <Style Selector="Border.rig.close">
      <Setter Property="BorderBrush" Value="{DynamicResource RavenDangerBrush}" />
    </Style>
    <Style Selector="Border.rig controls|DirectionalChevronControl">
      <Setter Property="Stroke" Value="{DynamicResource RavenAccentBrush}" />
    </Style>
    <Style Selector="Border.rig.collect controls|DirectionalChevronControl">
      <Setter Property="Stroke" Value="{DynamicResource RavenSecondaryBrush}" />
    </Style>
    <Style Selector="Border.rig.close controls|DirectionalChevronControl">
      <Setter Property="Stroke" Value="{DynamicResource RavenDangerBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Padding="4" Background="{DynamicResource RavenWindowBrush}" CornerRadius="5">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
        <StackPanel Spacing="2">
          <TextBlock Classes="overlay-header" Text="SURFACE MINING" />
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}" FontSize="17"
                     FontWeight="SemiBold" Text="{Binding SurfaceMining.BodyName}" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="monospace" FontSize="9" Text="{Binding SurfaceMining.HeadingText}" />
            <TextBlock Classes="muted" FontSize="9" Text="{Binding SurfaceMining.HistoryText}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top">
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}" FontSize="8" Text="{Binding InputMode}" />
        </Border>
      </Grid>
      <controls:SurfaceSurveyRadarControl Grid.Row="1" MinHeight="140"
          Markers="{Binding SurfaceMining.RadarMarkers}" ScaleMultiplier="1"
          BackgroundBrush="{DynamicResource RavenRaisedSurfaceBrush}"
          GridBrush="{DynamicResource RavenBorderBrush}" AccentBrush="{DynamicResource RavenSecondaryBrush}"
          MutedBrush="{DynamicResource RavenMutedTextBrush}" SuccessBrush="{DynamicResource RavenSuccessBrush}"
          WarningBrush="{DynamicResource RavenWarningBrush}" DangerBrush="{DynamicResource RavenDangerBrush}" />
      <ItemsControl Grid.Row="2" ItemsSource="{Binding SurfaceMining.ShipMarkers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SurfaceRadarMarkerViewModel">
            <Border Padding="7,5" CornerRadius="7" BorderThickness="1"
                    BorderBrush="{DynamicResource RavenBorderBrush}" Background="{DynamicResource RavenSurfaceBrush}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource RavenAccentBrush}" FontSize="10" />
                <controls:DirectionalChevronControl Grid.Column="1" Width="12" Height="12"
                    BearingDegrees="{Binding RelativeBearingDegrees}" Stroke="{DynamicResource RavenAccentBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding DistanceText}" FontSize="9" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl Grid.Row="3" ItemsSource="{Binding SurfaceMining.Rigs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MiningRigViewModel">
            <Border Classes="rig" Classes.collect="{Binding CanCollect}" Classes.close="{Binding IsTooClose}"
                    Margin="1" Padding="2,4" BorderThickness="1" CornerRadius="5">
              <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="9" HorizontalAlignment="Center" />
                <controls:DirectionalChevronControl Width="18" Height="18" BearingDegrees="{Binding Bearing}"
                    IsVisible="{Binding IsSet}" StrokeThickness="1.5" />
                <Ellipse Width="14" Height="14" IsVisible="{Binding !IsSet}"
                    Stroke="{DynamicResource RavenMutedTextBrush}" StrokeThickness="1" />
                <TextBlock Text="{Binding DistanceText}" FontSize="8" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Status}" FontSize="6" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Row="4" Spacing="4">
        <TextBlock FontSize="9" Text="{Binding SurfaceMining.CargoText}" />
        <ProgressBar Minimum="0" Maximum="72" Value="{Binding SurfaceMining.CargoUsed}" Height="5"
                     Foreground="{DynamicResource RavenAccentBrush}" Background="{DynamicResource RavenBorderBrush}" />
        <TextBlock Classes="muted" FontSize="8" Text="{Binding SurfaceMining.StatusText}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
