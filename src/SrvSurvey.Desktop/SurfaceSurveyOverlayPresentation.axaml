<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.SurfaceSurveyOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SurfaceSurveyOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="5">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
        <StackPanel Spacing="2">
          <TextBlock Classes="eyebrow" Text="SURFACE SURVEY" />
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Text="{Binding SurfaceSurvey.BodyName}"
                     TextTrimming="CharacterEllipsis" />
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
            <TextBlock Classes="monospace"
                       FontSize="9"
                       Text="{Binding SurfaceSurvey.HeadingText}" />
            <TextBlock Grid.Column="1"
                       Classes="muted"
                       FontSize="9"
                       Text="{Binding SurfaceSurvey.HistoryText}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2"
                       Classes="monospace"
                       FontSize="9"
                       IsVisible="{Binding SurfaceSurvey.ShouldShowRadar}"
                       Text="{Binding SurfaceSurvey.RadarScaleText}" />
          </Grid>
        </StackPanel>
        <Border Grid.Column="1"
                Classes="badge"
                VerticalAlignment="Top">
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="8"
                     FontWeight="SemiBold"
                     Text="{Binding InputMode}" />
        </Border>
      </Grid>

      <Grid Grid.Row="1"
            RowDefinitions="*,Auto"
            RowSpacing="7"
            MinHeight="0">
        <Border ClipToBounds="True"
                CornerRadius="4"
                IsVisible="{Binding SurfaceSurvey.ShouldShowRadar}">
          <controls:SurfaceSurveyRadarControl
              MinHeight="160"
              ClipToBounds="True"
              Markers="{Binding SurfaceSurvey.RadarMarkers}"
              ScaleMultiplier="{Binding SurfaceSurvey.RadarScale}"
              BackgroundBrush="{DynamicResource RavenRaisedSurfaceBrush}"
              GridBrush="{DynamicResource RavenBorderBrush}"
              AccentBrush="{DynamicResource RavenAccentBrush}"
              MutedBrush="{DynamicResource RavenMutedTextBrush}"
              SuccessBrush="{DynamicResource RavenSuccessBrush}"
              WarningBrush="{DynamicResource RavenWarningBrush}"
              DangerBrush="{DynamicResource RavenDangerBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      MaxHeight="135"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SurfaceSurvey.TrackerGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SurfaceTrackerGroupViewModel">
                <Border Margin="0,0,0,5"
                        Padding="7,5"
                        Background="{DynamicResource RavenSurfaceBrush}"
                        BorderBrush="{DynamicResource RavenBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Opacity="{Binding RowOpacity}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <ItemsControl Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  ItemsSource="{Binding Targets}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SurfaceRadarMarkerViewModel">
                          <Border Margin="3,0,0,0"
                                  Padding="5,2"
                                  Background="{DynamicResource RavenRaisedSurfaceBrush}"
                                  CornerRadius="5">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                              <controls:DirectionalChevronControl
                                  Width="12"
                                  Height="12"
                                  BearingDegrees="{Binding RelativeBearingDegrees}"
                                  IsFar="{Binding IsFarTarget}"
                                  Stroke="{DynamicResource RavenAccentBrush}"
                                  StrokeThickness="1.5" />
                              <TextBlock Classes="monospace"
                                         FontSize="8"
                                         Text="{Binding DistanceText}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="6">
        <ItemsControl IsVisible="{Binding SurfaceSurvey.HasNavigationMarkers}"
                      ItemsSource="{Binding SurfaceSurvey.NavigationMarkers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SurfaceRadarMarkerViewModel">
              <Border Margin="0,0,5,4"
                      Padding="6,3"
                      Background="{DynamicResource RavenAccentMutedBrush}"
                      BorderBrush="{DynamicResource RavenBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Text="{Binding Name}" />
                  <controls:DirectionalChevronControl
                      Width="14"
                      Height="14"
                      BearingDegrees="{Binding RelativeBearingDegrees}"
                      IsFar="{Binding IsFarTarget}"
                      Stroke="{DynamicResource RavenAccentBrush}"
                      StrokeThickness="1.6" />
                  <TextBlock Classes="monospace"
                             FontSize="8"
                             Text="{Binding BearingText}" />
                  <TextBlock Classes="monospace"
                             FontSize="8"
                             Text="{Binding DistanceText}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted"
                   FontSize="8"
                   MaxHeight="32"
                   Text="{Binding SurfaceSurvey.StatusText}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
