  <Application.Styles>
    <FluentTheme />
    <Style Selector="controls|BiologyRewardBandControl">
      <Setter Property="FilledSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioConfirmedSegmentEdgeBrush}" />
      <Setter Property="PotentialSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioConfirmedPotentialSegmentEdgeBrush}" />
      <Setter Property="DimmedFilledSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioConfirmedDimSegmentEdgeBrush}" />
      <Setter Property="DimmedPotentialSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioConfirmedDimPotentialSegmentEdgeBrush}" />
      <Setter Property="PredictionFilledSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioPredictionSegmentEdgeBrush}" />
      <Setter Property="PredictionPotentialSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioPredictionPotentialSegmentEdgeBrush}" />
      <Setter Property="HighlightFilledSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioGoldSegmentEdgeBrush}" />
      <Setter Property="HighlightPotentialSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioGoldPotentialSegmentEdgeBrush}" />
      <Setter Property="DimmedHighlightFilledSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioGoldDimSegmentEdgeBrush}" />
      <Setter Property="DimmedHighlightPotentialSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioGoldDimPotentialSegmentEdgeBrush}" />
      <Setter Property="GlobalRegionalFilledSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioGalacticRegionSegmentEdgeBrush}" />
      <Setter Property="GlobalRegionalPotentialSegmentEdgeBrush" Value="{DynamicResource RavenOverlayBioGalacticRegionPotentialSegmentEdgeBrush}" />
      <Setter Property="DimmedPotentialBrush" Value="{DynamicResource RavenOverlayBioConfirmedDimPotentialBrush}" />
      <Setter Property="HighlightPotentialBrush" Value="{DynamicResource RavenOverlayBioGoldPotentialBrush}" />
      <Setter Property="DimmedHighlightPotentialBrush" Value="{DynamicResource RavenOverlayBioGoldDimPotentialBrush}" />
    </Style>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://SrvSurvey.Desktop/Styles/RavenStyles.axaml" />
    <StyleInclude Source="avares://SrvSurvey.Desktop/Styles/GuardianLegacyOverlayStyles.axaml" />
    <StyleInclude Source="avares://SrvSurvey.Desktop/Styles/OverlayTypographyStyles.axaml" />
    <Style Selector="TextBlock">
      <Setter Property="localization:LocalizationBehavior.Enabled" Value="True" />
    </Style>
    <Style Selector="Button, CheckBox, RadioButton, Expander, TabItem">
      <Setter Property="localization:LocalizationBehavior.Enabled" Value="True" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="localization:LocalizationBehavior.Enabled" Value="True" />
      <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="False" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="behaviors:ListBoxBringIntoViewBehavior.Contain" Value="True" />
      <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="False" />
    </Style>
    <Style Selector="Window">
      <Setter Property="localization:LocalizationBehavior.Enabled" Value="True" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="IsScrollChainingEnabled" Value="False" />
    </Style>
  </Application.Styles>
</Application>
