<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.JumpInfoOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:JumpInfoOverlayViewModel"
             mc:Ignorable="d"
             Width="600"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <StackPanel Spacing="3">
          <TextBlock Classes="overlay-header type-header" Text="NEXT JUMP" />
          <TextBlock FontSize="11" Classes="muted type-detail"
                     Text="Route and destination intelligence" />
        </StackPanel>
        <LayoutTransformControl Grid.Column="1" Classes="type-icon" VerticalAlignment="Top">
          <Border Classes="badge">
            <TextBlock FontSize="10" Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding InputMode}" />
          </Border>
        </LayoutTransformControl>
      </Grid>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <LayoutTransformControl Classes="type-icon" IsVisible="{Binding JumpInfo.IsQuestTagged}">
            <Border Classes="badge">
              <TextBlock FontSize="9" Foreground="{DynamicResource RavenWarningBrush}"
                         FontWeight="Bold"
                         Text="Q" />
            </Border>
          </LayoutTransformControl>
          <TextBlock FontSize="16" Classes="type-title" Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold"
                     Text="{Binding TargetName}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
          <LayoutTransformControl Classes="type-icon" IsVisible="{Binding JumpInfo.IsScoopableStarClass}">
            <Border Classes="badge"
                    Background="{DynamicResource RavenRouteGuidanceBadgeBrush}"
                    MinHeight="18"
                    Padding="7,2">
              <TextBlock FontSize="9" VerticalAlignment="Center"
                         Foreground="{DynamicResource RavenWarningBrush}"
                         Text="SCOOPABLE" />
            </Border>
          </LayoutTransformControl>
          <TextBlock FontSize="12" Classes="monospace type-value"
                     Foreground="{DynamicResource RavenWarningBrush}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Text="{Binding JumpInfo.StarClass}" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
        <TextBlock FontSize="11" Classes="monospace type-value"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Text="{Binding JumpInfo.JumpProgress}" />
        <controls:JumpRouteProgressControl Grid.Column="1"
                                           Height="34"
                                           MinWidth="220"
                                           VerticalAlignment="Center"
                                           Legs="{Binding JumpInfo.RouteLegs}"
                                           TargetLegIndex="{Binding JumpInfo.TargetLegIndex}"
                                           AheadBrush="{DynamicResource RavenAccentBrush}"
                                           BehindBrush="{DynamicResource RavenMutedTextBrush}"
                                           TargetBrush="{DynamicResource RavenSuccessBrush}"
                                           BoostBrush="{DynamicResource RavenWarningBrush}"
                                           BackgroundLineBrush="{DynamicResource RavenBorderBrush}" />
        <TextBlock FontSize="11" Grid.Column="2"
                   Classes="monospace type-value"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Text="{Binding JumpInfo.TotalDistance}" />
      </Grid>

      <StackPanel IsVisible="{Binding JumpInfo.ShowDetails}" Spacing="8">
        <Border Classes="overlay-divider"
                Background="{DynamicResource RavenBorderBrush}" />
        <Grid IsVisible="{Binding JumpInfo.HasDiscoveryOrRouteGuidance}"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
          <TextBlock Classes="type-body" IsVisible="{Binding JumpInfo.HasDiscoveryText}"
                     Text="{Binding JumpInfo.DiscoveryText}"
                     TextWrapping="Wrap" />
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="6"
                      IsVisible="{Binding JumpInfo.HasRouteGuidanceBadges}">
            <LayoutTransformControl Classes="type-icon" IsVisible="{Binding JumpInfo.HasRefuelGuidance}">
              <Border Classes="badge"
                      Background="{DynamicResource RavenRouteGuidanceBadgeBrush}"
                      Padding="7,2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Image Width="14"
                         Height="14"
                         Source="avares://SrvSurvey.Desktop/Assets/Routes/refuel-star.png"
                         Stretch="Uniform" />
                  <TextBlock FontSize="9" VerticalAlignment="Center"
                             Foreground="#FF8A00"
                             Text="REFUEL" />
                </StackPanel>
              </Border>
            </LayoutTransformControl>
            <LayoutTransformControl Classes="type-icon" IsVisible="{Binding JumpInfo.HasNeutronGuidance}">
              <Border Classes="badge"
                      Background="{DynamicResource RavenRouteGuidanceBadgeBrush}"
                      Padding="7,2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Image Width="14"
                         Height="14"
                         Source="avares://SrvSurvey.Desktop/Assets/Routes/neutron-star.png"
                         Stretch="Uniform" />
                  <TextBlock FontSize="9" VerticalAlignment="Center"
                             Foreground="#4A9EE8"
                             Text="NEUTRON" />
                </StackPanel>
              </Border>
            </LayoutTransformControl>
          </StackPanel>
        </Grid>
        <TextBlock Classes="type-body" IsVisible="{Binding JumpInfo.HasTraffic}"
                   Text="{Binding JumpInfo.TrafficText}"
                   TextWrapping="Wrap" />
        <TextBlock Classes="type-body" IsVisible="{Binding JumpInfo.HasPointsOfInterest}"
                   Text="{Binding JumpInfo.PointsOfInterestText}"
                   TextWrapping="Wrap" />
        <ItemsControl IsVisible="{Binding JumpInfo.HasDetailLines}"
                      ItemsSource="{Binding JumpInfo.DetailLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JumpInfoDetailLineViewModel">
              <Grid Margin="0,2" ColumnDefinitions="Auto,*" ColumnSpacing="7">
                <TextBlock Classes="type-caption" Foreground="{DynamicResource RavenAccentBrush}"
                           FontWeight="SemiBold"
                           Text="{Binding Label, StringFormat={}{0}:}" />
                <TextBlock Classes="type-value" Grid.Column="1"
                           Text="{Binding Value}"
                           TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock FontSize="10" Classes="muted type-detail"
                   IsVisible="{Binding JumpInfo.HasDataStatus}"
                   Text="{Binding JumpInfo.DataStatus}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
