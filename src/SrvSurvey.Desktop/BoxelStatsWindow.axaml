<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        xmlns:pres="using:SrvSurvey.Desktop.Presentation"
        xmlns:search="using:SrvSurvey.Core.Search"
        x:Class="SrvSurvey.Desktop.BoxelStatsWindow"
        x:DataType="vm:BoxelSurveyStatsViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="760"
        Width="1100"
        Height="760"
        MinWidth="860"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="Boxel statistics">
  <Window.Resources>
    <pres:BoxelSurveyIndentMarginConverter x:Key="IndentMarginConverter" />
  </Window.Resources>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource RavenSidebarBrush}"
            BorderBrush="{DynamicResource RavenBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="3">
          <TextBlock Classes="eyebrow" Text="BOXEL" />
          <TextBlock Classes="page-title" FontSize="24" Text="Boxel statistics" />
          <TextBlock Classes="muted"
                     Text="Browse visited cubes by mass code, then open a cube for helium, body classes, and value." />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Button Classes="secondary"
                  Command="{Binding RefreshCommand}"
                  Content="Refresh" />
          <Button Classes="secondary"
                  Command="{Binding RebuildCommand}"
                  Content="Rebuild" />
          <Button Classes="secondary"
                  Click="Close_Click"
                  Content="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20" ColumnDefinitions="320,*" ColumnSpacing="16">
      <Border Classes="card" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
          <TextBlock Classes="muted" Text="MASS CODE" />
          <ItemsControl Grid.Row="1" Margin="0,8,0,12" ItemsSource="{Binding MassCodes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BoxelSurveyMassCodeOption">
                <Button Classes="secondary"
                        MinWidth="42"
                        MinHeight="42"
                        Margin="0,0,6,6"
                        Padding="12,6,12,8"
                        VerticalContentAlignment="Center"
                        Command="{Binding $parent[Window].((vm:BoxelSurveyStatsViewModel)DataContext).SelectMassCodeCommand}"
                        CommandParameter="{Binding MassCode}">
                  <TextBlock LineHeight="22"
                             VerticalAlignment="Center"
                             Text="{Binding Label}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Row="2"
                     Classes="muted"
                     Margin="0,4,0,6"
                     IsVisible="{Binding HasRecentEntries}"
                     Text="RECENTLY RECORDED" />
          <ItemsControl Grid.Row="3"
                        Margin="0,0,0,10"
                        IsVisible="{Binding HasRecentEntries}"
                        ItemsSource="{Binding RecentEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="search:BoxelSurveyIndexEntry">
                <Button Classes="link"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="RecentRow_Click">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Prefix}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap">
                      <Run Text="Recorded systems: " />
                      <Run Text="{Binding VisitedSystemCount}" />
                      <Run Text=" · highest suffix " />
                      <Run Text="{Binding HighestRecordedSuffix}" />
                    </TextBlock>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Separator Grid.Row="4" Margin="0,2,0,10" />
          <StackPanel Grid.Row="5" Margin="0,0,0,8" Spacing="4">
            <TextBlock Classes="muted" Text="{Binding BrowserTitle}" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       Text="{Binding BrowserDescription}"
                       TextWrapping="Wrap" />
            <Button Classes="link"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding IsBrowsingChildren}"
                    Command="{Binding ShowAllMassCodeCommand}"
                    Content="{Binding ShowAllMassCodeText}" />
          </StackPanel>
          <ListBox Grid.Row="6"
                   ItemsSource="{Binding BrowserRows}"
                   DoubleTapped="BrowserRow_DoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BoxelSurveyBrowserRowViewModel">
                <Button Classes="link"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Margin="{Binding Indent, Converter={StaticResource IndentMarginConverter}}"
                        Click="BrowserRow_Click">
                  <Grid Classes="boxel-stats-browser-row"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="3">
                    <TextBlock FontWeight="SemiBold"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Prefix}" />
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                      <TextBlock Classes="muted"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Glance}" />
                      <TextBlock Grid.Column="1"
                                 Classes="muted"
                                 Text="{Binding Helium}" />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Padding="18">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Spacing="8" IsVisible="{Binding IsBrowserVisible}">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Select a recorded boxel" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="The mass-code filter lists only boxels with recorded statistics at that exact mass code. Open a boxel to explore its recorded children." />
          </StackPanel>
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsDetailVisible}">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding DetailTitle}" />
                  <TextBlock Text="{Binding HeliumText}" />
                  <TextBlock Classes="muted" Text="{Binding VisitedText}" />
                  <TextBlock Classes="muted"
                             IsVisible="{Binding HasConfiguredSystemsText}"
                             Text="{Binding ConfiguredSystemsText}" />
                  <TextBlock Classes="muted" Text="{Binding HighestRecordedSuffixText}" />
                  <TextBlock Classes="muted" Text="{Binding CompletenessText}" />
                  <TextBlock Text="{Binding ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <Button Classes="secondary"
                          Command="{Binding BackCommand}"
                          Content="Back to browser" />
                  <Button Classes="secondary"
                          Click="Export_Click"
                          IsEnabled="{Binding !IsBusy}"
                          Content="Export JSON + CSV…"
                          ToolTip.Tip="Choose a folder, then save both the JSON detail and CSV summary there." />
                  <Button Classes="secondary"
                          IsVisible="{Binding CanExploreChildren}"
                          Command="{Binding ExploreChildrenCommand}"
                          Content="{Binding ExploreChildrenText}" />
                </StackPanel>
              </Grid>
              <Border Background="{DynamicResource RavenSurfaceBrush}"
                      CornerRadius="8"
                      Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Classes="muted" Text="STATISTICS SCOPE" />
                  <StackPanel Orientation="Horizontal" Spacing="20">
                    <RadioButton GroupName="StatisticsScope"
                                 IsChecked="{Binding IsSelectedBoxelScope, Mode=TwoWay}"
                                 Content="Selected boxel"
                                 ToolTip.Tip="Shows statistics and per-boxel fields for only the boxel currently open above." />
                    <RadioButton GroupName="StatisticsScope"
                                 IsEnabled="{Binding CanShowSearchRollup}"
                                 IsChecked="{Binding IsEntireSavedSearchScope, Mode=TwoWay}"
                                 Content="{Binding EntireSavedSearchScopeText}"
                                 ToolTip.Tip="Combines recorded statistics from every boxel belonging to this saved search. Boxels without recorded data add nothing to the totals." />
                  </StackPanel>
                  <TextBlock Classes="muted"
                             MaxWidth="720"
                             Text="{Binding StatisticsScopeDescription}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="80,*,70,90,60,60,60" Margin="0,0,0,4">
                <TextBlock Classes="muted" Text="Type" />
                <TextBlock Grid.Column="1" Classes="muted" Text="Name" />
                <TextBlock Grid.Column="2" Classes="muted" Text="Count" />
                <TextBlock Grid.Column="3" Classes="muted" Text="Average" />
                <TextBlock Grid.Column="4" Classes="muted" Text="TF" />
                <TextBlock Grid.Column="5" Classes="muted" Text="Land" />
                <TextBlock Grid.Column="6" Classes="muted" Text="Atmo" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ClassRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BoxelSurveyClassRowViewModel">
                    <Grid ColumnDefinitions="80,*,70,90,60,60,60" Margin="0,0,0,4">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Code}" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}" />
                      <TextBlock Grid.Column="2" Text="{Binding Count}" />
                      <TextBlock Grid.Column="3" Text="{Binding Average}" />
                      <TextBlock Grid.Column="4" Text="{Binding Terraformable}" />
                      <TextBlock Grid.Column="5" Text="{Binding Landable}" />
                      <TextBlock Grid.Column="6" Text="{Binding Atmospheric}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource RavenSidebarBrush}"
            BorderBrush="{DynamicResource RavenBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <Expander Classes="section-pill" Header="Statistics settings">
          <StackPanel Margin="0,10,0,0" Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
            <CheckBox IsChecked="{Binding TreatNavBeaconAsFullyScanned, Mode=TwoWay}"
                      ToolTip.Tip="Changes only the displayed FSS-complete statistic. It does not affect boxel-search completion, next targets, body counts, or values.">
              <TextBlock Text="Count Nav Beacon scans as FSS complete (statistics only)"
                         TextWrapping="Wrap" />
            </CheckBox>
            <Grid ColumnDefinitions="*,110"
                  ColumnSpacing="12"
                  ToolTip.Tip="Shows averages only after this many systems have recorded statistics. Counts and stored data do not change.">
              <TextBlock VerticalAlignment="Center"
                         Text="Recorded systems required for averages"
                         TextWrapping="Wrap" />
              <NumericUpDown Grid.Column="1"
                             Minimum="1"
                             Maximum="1000"
                             Increment="1"
                             FormatString="0"
                             Value="{Binding MinSystemsForAverages, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,110"
                  ColumnSpacing="12"
                  ToolTip.Tip="Exports only boxels with at least this many recorded systems. Counts and stored data do not change.">
              <TextBlock VerticalAlignment="Center"
                         Text="Recorded systems required for export"
                         TextWrapping="Wrap" />
              <NumericUpDown Grid.Column="1"
                             Minimum="1"
                             Maximum="1000"
                             Increment="1"
                             FormatString="0"
                             Value="{Binding MinSystemsForExport, Mode=TwoWay}" />
            </Grid>
            <TextBlock Classes="muted"
                       Text="Settings apply immediately. Rebuild is only needed to import historical journals."
                       TextWrapping="Wrap" />
            <TextBlock Classes="muted"
                       IsVisible="{Binding HasStatusMessage}"
                       TextWrapping="Wrap"
                       Text="{Binding StatusMessage}" />
          </StackPanel>
        </Expander>
        <Button Grid.Column="1"
                Classes="link"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="AverageHelp_Click"
                Content="How are Averages Calculated?" />
      </Grid>
    </Border>
  </Grid>
</Window>
