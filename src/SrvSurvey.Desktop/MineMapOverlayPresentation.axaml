<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.MineMapOverlayPresentation"
             x:DataType="vm:MineMapViewModel"
             Width="420" Height="440" ClipToBounds="True">
  <Border Padding="8" Background="{DynamicResource RavenWindowBrush}"
          BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="1" CornerRadius="8">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock Classes="overlay-header type-header" Text="MINING OVERVIEW MAP" />
          <TextBlock FontSize="16" Classes="type-title" Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold" Text="{Binding LiveMapTitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock FontSize="9" Grid.Column="1" Classes="monospace type-detail"
                   VerticalAlignment="Bottom" Text="{Binding ZoomText}" />
      </Grid>
      <controls:MineMapControl Grid.Row="1"
                               Survey="{Binding ActiveSurvey}"
                               PlayerLocation="{Binding PlayerLocation}"
                               PlayerHeading="{Binding PlayerHeading}"
                               ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                               VisibleMaterials="{Binding VisibleMaterials}"
                               VisibleMarkerIds="{Binding VisibleMarkerIds}"
                               ShowMarkerLabels="{Binding ShowMarkerLabelsInOverviewMap}"
                               PlanningCircleCenter="{Binding PlanningCircleCenter, Mode=TwoWay}"
                               SurveyGuideTarget="{Binding SurveyGuideTarget}"
                               GridBrush="{DynamicResource RavenMapGridBrush}"
                               AccentBrush="{DynamicResource RavenAccentBrush}"
                               PlayerBrush="{DynamicResource RavenSuccessBrush}"
                               TextBrush="{DynamicResource RavenTextBrush}"
                               ZoneBrush="{DynamicResource RavenWarningBrush}" />
      <TextBlock FontSize="9" Grid.Row="2" Classes="muted type-detail" TextAlignment="Center"
                 Text="{Binding MarkerCountText}" />
    </Grid>
  </Border>
</UserControl>
