<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.QuestIndicatorOverlayWindow"
        x:DataType="vm:QuestIndicatorViewModel"
        mc:Ignorable="d"
        d:DesignWidth="240"
        d:DesignHeight="220"
        Width="240"
        MinHeight="64"
        MaxHeight="500"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey quest indicator overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:QuestIndicatorOverlayPresentation />
  </Border>
</Window>
