<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.OverlayPositionPreviewWindow"
        x:DataType="vm:OverlayPositionPreviewViewModel"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="Overlay position preview">
  <Border Margin="2"
          Padding="10"
          Background="{DynamicResource RavenWindowBrush}"
          BorderBrush="{DynamicResource RavenWarningBrush}"
          BorderThickness="2"
          CornerRadius="8"
          Opacity="0.94">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="4">
      <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                 FontSize="11"
                 FontWeight="SemiBold"
                 Text="{Binding Title}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding Title}" />
      <Border Grid.Row="1"
              Height="1"
              Background="{DynamicResource RavenWarningBrush}"
              Opacity="0.65" />
      <ItemsControl Grid.Row="2"
                    IsVisible="{Binding HasRows}"
                    ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OverlayPositionPreviewRowViewModel">
            <Grid Margin="0,1,0,3"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
              <TextBlock Classes="muted"
                         FontSize="9"
                         Text="{Binding Label}" />
              <TextBlock Grid.Column="1"
                         HorizontalAlignment="Right"
                         FontSize="9"
                         Text="{Binding Value}"
                         TextTrimming="CharacterEllipsis" />
              <ProgressBar Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Height="3"
                           Margin="0,2,0,0"
                           IsVisible="{Binding HasProgress}"
                           Minimum="0"
                           Maximum="100"
                           Value="{Binding Progress}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Grid.Row="3"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource RavenMutedTextBrush}"
                 FontSize="8"
                 IsVisible="{Binding ShowFooter}"
                 Text="PREVIEW DATA • DRAG TO MOVE" />
    </Grid>
  </Border>
</Window>
