<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        xmlns:presentation="using:SrvSurvey.Desktop.Presentation"
        x:Class="SrvSurvey.Desktop.OverlayExceptionsWindow"
        x:DataType="vm:OverlayExceptionCategoryViewModel"
        Classes="app-window"
        Title="{Binding Title}"
        Width="680" Height="740" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" Icon="/Assets/logo.ico">
  <Window.Styles>
    <Style Selector="CheckBox">
      <Setter Property="ContentTemplate">
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter>
    </Style>
  </Window.Styles>
  <Grid x:Name="ExceptionsLayout" RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
    <ScrollViewer x:Name="ExceptionsControlsViewport"
                  MaxHeight="{Binding #ExceptionsLayout.Bounds.Height, Converter={x:Static presentation:WorkspaceLayoutExtentConverter.ExceptionsControlsHeight}}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,0,16,0">
        <TextBlock Classes="page-title" FontSize="28" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Allow this category's overlays for the ship or vehicle you are currently aboard. Checked entries permit the normal overlay rules; unchecked entries hide them. On foot is separate from your parked ship. Editor previews are unaffected." />
        <WrapPanel>
          <Button Classes="secondary" Margin="0,0,8,4" Content="Check All" Command="{Binding CheckAllCommand}" />
          <Button Classes="secondary" Margin="0,0,8,4" Content="Uncheck All" Command="{Binding UncheckAllCommand}" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ExceptionsGroupsScroll" Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,20,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OverlayExceptionGroupViewModel">
            <Border BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="0,16,0,0" Margin="0,0,0,16">
              <StackPanel Spacing="10">
                <TextBlock Classes="card-title" Text="{Binding Name}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Entries}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OverlayExceptionEntryViewModel">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                Width="270" Margin="0,2,8,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <StackPanel Spacing="6">
        <TextBlock Classes="muted" Text="Changes apply immediately." />
        <ScrollViewer x:Name="ExceptionsStatusViewport"
                      MaxHeight="{Binding #ExceptionsLayout.Bounds.Height, Converter={x:Static presentation:WorkspaceLayoutExtentConverter.RecoveryHeight}}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="ExceptionsStatusText" Margin="0,0,16,0" Text="{Binding Status}"
                     TextWrapping="Wrap" Foreground="{DynamicResource RavenWarningBrush}" />
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</Window>
