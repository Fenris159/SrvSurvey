<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:mining="using:SrvSurvey.Core.Mining"
 x:Class="SrvSurvey.Desktop.MiningActivityOverlayPresentation" x:DataType="vm:MiningActivityOverlayViewModel" Width="{Binding PanelWidth}">
 <Border Classes="overlay-panel" Padding="10" Background="{DynamicResource RavenWindowBrush}" CornerRadius="6">
  <StackPanel Spacing="8">
   <TextBlock Classes="overlay-header type-header" Text="{Binding Title}" IsVisible="{Binding IsNotifications}" />
   <StackPanel IsVisible="{Binding IsFiregroups}" Spacing="4">
    <TextBlock Classes="type-title" Text="{Binding GroupLabel}"/>
    <TextBlock Classes="type-body" Text="{Binding PrimaryLabel}" TextWrapping="Wrap"/>
    <TextBlock Classes="type-body" Text="{Binding SecondaryLabel}" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel IsVisible="{Binding IsNotifications}" Spacing="8">
    <Border IsVisible="{Binding HasQualifyingProspect}" BorderBrush="{DynamicResource RavenSuccessBrush}" BorderThickness="2" CornerRadius="4" Padding="8,5">
     <TextBlock Classes="type-title" Foreground="{DynamicResource RavenSuccessBrush}" Text="TARGET FOUND" HorizontalAlignment="Center" />
    </Border>
    <StackPanel IsVisible="{Binding HasProspectReport}" Spacing="4">
     <TextBlock Classes="overlay-header type-header" Text="ACTIVE PROSPECTORS" />
     <ItemsControl ItemsSource="{Binding Prospects}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="vm:MiningProspectOverlayRowViewModel">
        <Border BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,0,0,1" Padding="0,4">
         <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Classes="muted type-detail" Text="{Binding Time}" />
          <StackPanel Grid.Column="1" Spacing="1">
           <TextBlock IsVisible="{Binding Qualifies}" Classes="type-value" Foreground="{DynamicResource RavenSuccessBrush}" Text="{Binding Summary}" TextWrapping="Wrap" />
           <TextBlock IsVisible="{Binding !Qualifies}" Classes="type-body" Text="{Binding Summary}" TextWrapping="Wrap" />
           <TextBlock Classes="muted type-detail" Text="{Binding RemainingLabel}" />
          </StackPanel>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
    <StackPanel IsVisible="{Binding HasRefined}" Spacing="3"><TextBlock Classes="overlay-header type-header" Text="REFINED" /><ItemsControl ItemsSource="{Binding Refined}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="mining:MiningNotice"><TextBlock Classes="type-value" Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <StackPanel IsVisible="{Binding HasCollected}" Spacing="3"><TextBlock Classes="overlay-header type-header" Text="COLLECTED" /><ItemsControl ItemsSource="{Binding Collected}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="mining:MiningNotice"><TextBlock Classes="type-value" Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <TextBlock Classes="muted type-value" Text="{Binding Cargo}" TextWrapping="Wrap" />
   </StackPanel>
  </StackPanel>
 </Border>
</UserControl>
