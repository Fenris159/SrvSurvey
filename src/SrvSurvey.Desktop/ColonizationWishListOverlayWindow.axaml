<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.ColonizationWishListOverlayWindow"
        x:DataType="vm:ColonizationWishListViewModel"
        MinWidth="1" MinHeight="1" SizeToContent="WidthAndHeight"
        CanResize="False" ShowActivated="False" ShowInTaskbar="False"
        WindowDecorations="None" Topmost="True"
        Background="Transparent" TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent" Title="SrvSurvey colonization ShoppingList overlay">
  <Border Background="Transparent" BorderThickness="0">
    <local:ColonizationWishListOverlayPresentation />
  </Border>
</Window>
