<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SrvSurvey.Desktop.Controls"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.RouteBioOverlayWindow"
        x:DataType="vm:RouteBioOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="220"
        d:DesignHeight="420"
        Width="220"
        MinHeight="150"
        MaxHeight="680"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey route bodies overlay">
  <Border Margin="0"
          Padding="5"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <Grid Margin="3"
          RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="3">
      <StackPanel>
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Text="Route bodies" />
        <TextBlock Foreground="{DynamicResource RavenTextBrush}"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Text="{Binding SystemName}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="muted"
                   FontSize="9"
                   Text="Route body destinations" />
      </StackPanel>

      <Border Grid.Row="1"
              Height="1"
              Background="{DynamicResource RavenWarningBrush}"
              Opacity="0.65" />

      <controls:RouteBioTargetList Grid.Row="2"
                                   ItemsSource="{Binding Targets}"
                                   IsInteractive="True"
                                   CompletionRequested="RouteBioTargetRow_CompletionRequested" />

      <TextBlock Grid.Row="3"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource RavenMutedTextBrush}"
                 FontSize="9"
                 Text="{Binding Progress}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</Window>
