<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SrvSurvey.Desktop.Controls"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.RouteBioOverlayWindow"
        x:DataType="vm:RouteBioOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="220"
        d:DesignHeight="420"
        MinWidth="220"
        MinHeight="150"
        MaxHeight="680"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey route bodies overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:RouteBioOverlayPresentation />
  </Border>
</Window>
