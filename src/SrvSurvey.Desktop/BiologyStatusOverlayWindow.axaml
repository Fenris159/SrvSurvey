<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.BiologyStatusOverlayWindow"
        x:DataType="vm:SystemSurveyOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="480"
        d:DesignHeight="80"
        Width="480"
        MaxHeight="220"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey biology status overlay">
  <Border Margin="0"
          Padding="5"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel IsVisible="{Binding Survey.HasBiologyStatus}"
                Spacing="3">
      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="7">
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Text="Biology sample status" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource RavenTextBrush}"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Text="{Binding Survey.BiologyStatus.BodyName}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource RavenPrimaryBrush}"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Text="{Binding Survey.BiologyStatus.ProgressText}" />
      </Grid>

      <Border Height="1"
              Background="{DynamicResource RavenWarningBrush}"
              Opacity="0.65" />

      <ProgressBar Height="2"
                   Minimum="0"
                   Maximum="100"
                   Value="{Binding Survey.BiologyStatus.TrackedCompletionPercent}" />

      <TextBlock HorizontalAlignment="Center"
                 Foreground="{DynamicResource RavenAccentBrush}"
                 FontSize="10"
                 FontWeight="SemiBold"
                 IsVisible="{Binding Survey.BiologyStatus.RequiresDss}"
                 Text="Bio signals detected - DSS scan required" />

      <Grid IsVisible="{Binding Survey.BiologyStatus.HasActiveSample}"
            ColumnDefinitions="96,*"
            ColumnSpacing="8">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="5">
          <Grid Width="24" Height="24">
            <Ellipse Stroke="{DynamicResource RavenPrimaryBrush}"
                     StrokeThickness="1.5" />
            <Ellipse Margin="5"
                     Fill="{DynamicResource RavenPrimaryBrush}"
                     IsVisible="{Binding Survey.BiologyStatus.ActiveSample.IsFirstSampleComplete}" />
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="9"
                       FontWeight="Bold"
                       Text="1" />
          </Grid>
          <Grid Width="24" Height="24">
            <Ellipse Stroke="{DynamicResource RavenPrimaryBrush}"
                     StrokeThickness="1.5" />
            <Ellipse Margin="5"
                     Fill="{DynamicResource RavenPrimaryBrush}"
                     IsVisible="{Binding Survey.BiologyStatus.ActiveSample.IsSecondSampleComplete}" />
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="9"
                       FontWeight="Bold"
                       Text="2" />
          </Grid>
          <Grid Width="24" Height="24">
            <Ellipse Stroke="{DynamicResource RavenPrimaryBrush}"
                     StrokeThickness="1.5" />
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="9"
                       FontWeight="Bold"
                       Text="3" />
          </Grid>
        </StackPanel>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
          <TextBlock Foreground="{DynamicResource RavenPrimaryBrush}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Text="{Binding Survey.BiologyStatus.ActiveSample.DisplayName}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1"
                     HorizontalAlignment="Right"
                     Foreground="{DynamicResource RavenWarningBrush}"
                     FontSize="9"
                     IsVisible="{Binding Survey.BiologyStatus.ActiveSample.HasReward}"
                     Text="{Binding Survey.BiologyStatus.ActiveSample.RewardText}" />
          <ProgressBar Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Height="2"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding Survey.BiologyStatus.ActiveSample.SeparationPercent}" />
          <TextBlock Grid.Row="2"
                     Foreground="{DynamicResource RavenMutedTextBrush}"
                     FontSize="9"
                     Text="{Binding Survey.BiologyStatus.ActiveSample.DistanceText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="2"
                     Grid.Column="1"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="9"
                     Text="{Binding Survey.BiologyStatus.ActiveSample.RequiredDistanceText}" />
        </Grid>
      </Grid>

      <Grid IsVisible="{Binding Survey.BiologyStatus.HasTemperatureRange}"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8">
        <TextBlock Foreground="{DynamicResource RavenMutedTextBrush}"
                   FontSize="9"
                   Text="{Binding Survey.BiologyStatus.TemperatureRange.ExpectedRangeText}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1"
                   Foreground="{DynamicResource RavenPrimaryBrush}"
                   FontSize="9"
                   Text="{Binding Survey.BiologyStatus.TemperatureRange.BodyTemperatureText}" />
        <TextBlock Grid.Column="2"
                   Foreground="{DynamicResource RavenWarningBrush}"
                   FontSize="9"
                   IsVisible="{Binding Survey.BiologyStatus.TemperatureRange.HasLiveTemperature}"
                   Text="{Binding Survey.BiologyStatus.TemperatureRange.LiveTemperatureText}" />
      </Grid>

      <ItemsControl IsVisible="{Binding Survey.BiologyStatus.ShowSignalSummary}"
                    ItemsSource="{Binding Survey.BiologyStatus.Signals}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BiologyStatusSignalViewModel">
            <Grid Margin="0,0,8,0"
                  Opacity="{Binding RowOpacity}">
              <TextBlock Foreground="{DynamicResource RavenPrimaryBrush}"
                         FontSize="9"
                         IsVisible="{Binding !IsAnalyzed}"
                         Text="{Binding DisplayText}" />
              <TextBlock Foreground="{DynamicResource RavenPrimaryDimBrush}"
                         FontSize="9"
                         IsVisible="{Binding IsAnalyzed}"
                         Text="{Binding DisplayText}"
                         TextDecorations="Strikethrough" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock HorizontalAlignment="Center"
                 Foreground="{DynamicResource RavenDangerBrush}"
                 FontSize="9"
                 FontWeight="SemiBold"
                 IsVisible="{Binding Survey.BiologyStatus.HasWarning}"
                 Text="{Binding Survey.BiologyStatus.Warning}"
                 TextWrapping="Wrap" />
      <TextBlock HorizontalAlignment="Center"
                 Foreground="{DynamicResource RavenMutedTextBrush}"
                 FontSize="9"
                 IsVisible="{Binding Survey.BiologyStatus.HasFooter}"
                 Text="{Binding Survey.BiologyStatus.Footer}"
                 TextWrapping="Wrap" />
      <TextBlock HorizontalAlignment="Center"
                 Foreground="{DynamicResource RavenAccentBrush}"
                 FontSize="8"
                 IsVisible="{Binding Survey.BiologyStatus.HasCodexNotification}"
                 Text="{Binding Survey.BiologyStatus.CodexNotification.ActionText}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
