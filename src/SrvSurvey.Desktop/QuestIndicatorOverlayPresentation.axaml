<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.QuestIndicatorOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:QuestIndicatorViewModel"
             mc:Ignorable="d"
             MaxWidth="220"
             HorizontalAlignment="Left"
             ClipToBounds="False">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="6"
            RowSpacing="1">
        <Border MinWidth="18"
                MinHeight="18"
                Padding="2,0"
                Background="{DynamicResource RavenAccentBrush}"
                CornerRadius="4">
          <TextBlock FontSize="10" Classes="type-icon" HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource RavenAccentForegroundBrush}"
                     FontWeight="Bold"
                     Text="Q" />
        </Border>
        <TextBlock FontSize="12" Classes="type-title" Grid.Column="1"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding QuestTitle}" />
        <TextBlock FontSize="9" Classes="type-detail" Grid.Row="1"
                   Grid.Column="1"
                   IsVisible="{Binding HasUnreadMessages}"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   FontWeight="Bold"
                   Text="{Binding UnreadMessageText}"
                   TextTrimming="CharacterEllipsis" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Objectives}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuestObjectiveRowViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,1">
              <TextBlock Classes="type-icon" Foreground="{DynamicResource RavenAccentBrush}"
                         FontWeight="Bold"
                         Text="&#x203A;" />
              <TextBlock FontSize="11" Classes="type-body" Grid.Column="1"
                         Text="{Binding Label}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="10" Grid.Column="2"
                         Classes="monospace type-detail"
                         Text="{Binding Progress}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl ItemsSource="{Binding Locations}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuestIndicatorLocationViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,1">
              <TextBlock Classes="type-icon" Foreground="{DynamicResource RavenAccentBrush}"
                         FontWeight="Bold"
                         Text="{Binding StateGlyph}" />
              <StackPanel Grid.Column="1" Spacing="0">
                <TextBlock FontSize="11" Classes="type-body"
                           FontWeight="SemiBold"
                           Text="{Binding Label}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="9" Classes="muted type-value"
                           Text="{Binding Bearing}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock FontSize="10" Grid.Column="2"
                         Classes="monospace type-value"
                         VerticalAlignment="Center"
                         Text="{Binding Distance}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
