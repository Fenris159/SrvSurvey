<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.MassacreMissionsOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             x:DataType="vm:CombatOverlayViewModel"
             mc:Ignorable="d"
             HorizontalAlignment="Left"
             MaxWidth="360"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBlock Classes="overlay-header type-header"
                   Text="MASSACRE MISSIONS" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Combat.MassacreMissions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MassacreMissionViewModel">
            <Grid Margin="0,1"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6">
              <TextBlock Classes="type-icon" Foreground="{DynamicResource RavenAccentBrush}"
                         FontWeight="Bold"
                         Opacity="{Binding RowOpacity}"
                         Text="&#x25B6;" />
              <StackPanel Grid.Column="1"
                          Opacity="{Binding RowOpacity}"
                          Spacing="0">
                <TextBlock FontSize="11" Classes="type-body" Foreground="{DynamicResource RavenAccentBrush}"
                           FontWeight="SemiBold"
                           IsVisible="{Binding !IsComplete}"
                           Text="{Binding TargetFaction}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="11" Classes="muted type-body"
                           FontWeight="SemiBold"
                           IsVisible="{Binding IsComplete}"
                           Text="{Binding TargetFaction}"
                           TextDecorations="Strikethrough"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="8" Classes="muted type-detail"
                           Text="{Binding MissionGiver}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
               <TextBlock FontSize="11"
                         Classes="monospace type-value"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource RavenWarningBrush}"
                         Opacity="{Binding RowOpacity}"
                         FontWeight="Bold"
                         Text="{Binding ProgressText}" />
               <controls:OverlayRowIconHost VerticalAlignment="Center" ClipToBounds="False" IsVisible="{Binding IsComplete}">
                <Viewbox Height="{Binding #MissionCompletionCheckmark.FontSize}">
                 <TextBlock x:Name="MissionCompletionCheckmark" FontSize="16.5" Classes="type-icon" FontWeight="Bold"
                            FontFamily="avares://SrvSurvey.Desktop/Assets/Fonts/NotoSansSymbols2#Noto Sans Symbols 2"
                            Foreground="{DynamicResource RavenColoniseSurplusBrush}" Text="&#x2713;" />
                </Viewbox>
               </controls:OverlayRowIconHost>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
