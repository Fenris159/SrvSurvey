<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.BiologySurveyOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:presentation="using:SrvSurvey.Desktop.Presentation"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="True">
  <UserControl.Resources>
    <presentation:BiologyVariantColorConverter x:Key="BiologyVariantColorConverter" />
  </UserControl.Resources>
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel IsVisible="{Binding Survey.HasBiologySurvey}"
                Spacing="3">
      <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Text="System biology" />
      <TextBlock Foreground="{DynamicResource RavenTextBrush}"
                 FontSize="10"
                 FontWeight="SemiBold"
                 Text="{Binding Survey.BiologySurveyDisplay.Heading}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock Foreground="{DynamicResource RavenMutedTextBrush}"
                 FontSize="9"
                 Text="{Binding Survey.BiologySurveyDisplay.ProgressText}"
                 TextTrimming="CharacterEllipsis" />

      <Border Classes="overlay-divider"
              Margin="0,1"
              Background="{DynamicResource RavenWarningBrush}"
              Opacity="0.65" />

      <ScrollViewer MaxHeight="620"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="3">
          <ItemsControl IsVisible="{Binding Survey.BiologySurveyDisplay.IsSystemOverview}"
                        ItemsSource="{Binding Survey.BiologySurveyDisplay.Bodies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BiologyBodyRowViewModel">
                <!-- Match Route Bodies visual grammar:
                     body icon | label | reward bands | value (flex right). -->
                <Grid Margin="0,1"
                      ColumnDefinitions="Auto,Auto,Auto,*"
                      ColumnSpacing="5">
                  <Border Width="14"
                          Height="18"
                          Background="Transparent"
                          ToolTip.Tip="{Binding BodyIconAccessibleName}">
                    <Image Width="14"
                           Height="14"
                           HorizontalAlignment="Center"
                           Source="{Binding BodyIconAssetPath, Converter={StaticResource BundledAssetImageConverter}}"
                           Stretch="Uniform"
                           VerticalAlignment="Center" />
                  </Border>
                  <Grid Grid.Column="1">
                    <TextBlock Foreground="{DynamicResource RavenPrimaryBrush}"
                               FontSize="10"
                               IsVisible="{Binding !IsComplete}"
                               Text="{Binding Name}" />
                    <TextBlock Foreground="{DynamicResource RavenPrimaryDimBrush}"
                               FontSize="10"
                               IsVisible="{Binding IsComplete}"
                               Text="{Binding Name}"
                               TextDecorations="Strikethrough" />
                  </Grid>
                  <StackPanel Grid.Column="2"
                              Margin="1,0,3,0"
                              VerticalAlignment="Center"
                              Orientation="Horizontal"
                              Spacing="4">
                    <ItemsControl ItemsSource="{Binding RewardBands}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BiologySignalRewardBandViewModel">
                          <controls:BiologyRewardBandControl Width="13"
                                                             Height="28"
                                                             MinimumReward="{Binding MinimumReward}"
                                                             MaximumReward="{Binding MaximumReward}"
                                                             BucketOneMillions="{Binding RewardBucketOneMillions}"
                                                             BucketTwoMillions="{Binding RewardBucketTwoMillions}"
                                                             BucketThreeMillions="{Binding RewardBucketThreeMillions}"
                                                             IsPrediction="{Binding IsPrediction}"
                                                             IsHighlighted="{Binding IsHighlighted}"
                                                             IsDimmed="{Binding ShouldDim}"
                                                             FilledBrush="{DynamicResource RavenBioConfirmedBrush}"
                                                             PotentialBrush="{DynamicResource RavenBioPotentialBrush}"
                                                             DimmedFilledBrush="{DynamicResource RavenBioConfirmedDimBrush}"
                                                             PredictionFilledBrush="{DynamicResource RavenBioPredictionBrush}"
                                                             PredictionPotentialBrush="{DynamicResource RavenBioPredictionPotentialBrush}"
                                                             HighlightBrush="{DynamicResource RavenBioGoldBrush}"
                                                             DimmedHighlightBrush="{DynamicResource RavenBioGoldDimBrush}"
                                                             UnknownBrush="{DynamicResource RavenBioUnknownBrush}"
                                                             UnknownGlyphBrush="{DynamicResource RavenBioUnknownGlyphBrush}"
                                                             HatchBrush="{DynamicResource RavenBioHatchBrush}"
                                                             EmptyBrush="{DynamicResource RavenBioEmptyBrush}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:CanonnLogoControl Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasCanonnSignals}"
                                                ToolTip.Tip="Canonn has known biological signals for this body" />
                  </StackPanel>
                  <TextBlock Grid.Column="3"
                             MaxWidth="76"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource RavenPrimaryBrush}"
                             FontSize="10"
                             Text="{Binding RewardText}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="9"
                     IsVisible="{Binding Survey.BiologySurveyDisplay.RequiresDss}"
                     Text="DSS scan required"
                     TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding Survey.HasCanonnBiologyHint}"
                      Orientation="Horizontal"
                      Spacing="4">
            <controls:CanonnLogoControl Width="16"
                                        Height="16"
                                        VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       FontSize="9"
                       Text="{Binding Survey.CanonnBiologyHint}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Foreground="{DynamicResource RavenMutedTextBrush}"
                     FontSize="9"
                     IsVisible="{Binding Survey.BiologySurveyDisplay.HasPredictionStatus}"
                     Text="{Binding Survey.BiologySurveyDisplay.PredictionStatus}"
                     TextWrapping="Wrap" />

          <StackPanel IsVisible="{Binding Survey.BiologySurveyDisplay.IsBodyDetail}"
                      Grid.IsSharedSizeScope="True">
            <ItemsControl ItemsSource="{Binding Survey.BiologySurveyDisplay.OrganismGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BiologyOrganismGroupViewModel">
                  <StackPanel>
                    <Grid Margin="0,2"
                          ColumnSpacing="5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BodyBiologyPip" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BodyBiologyGenus" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BodyBiologySpecies" />
                      </Grid.ColumnDefinitions>

                      <!-- The reward PIP remains a fixed two-line-high marker even
                           when a genus has a longer list of possible species. -->
                      <controls:BiologyRewardBandControl Width="13"
                                                         Height="28"
                                                         VerticalAlignment="Top"
                                                         MinimumReward="{Binding MinimumReward}"
                                                         MaximumReward="{Binding MaximumReward}"
                                                         BucketOneMillions="{Binding RewardBucketOneMillions}"
                                                         BucketTwoMillions="{Binding RewardBucketTwoMillions}"
                                                         BucketThreeMillions="{Binding RewardBucketThreeMillions}"
                                                         IsPrediction="{Binding IsPrediction}"
                                                         IsHighlighted="{Binding IsHighlightedFirst}"
                                                         IsDimmed="{Binding ShouldDim}"
                                                         FilledBrush="{DynamicResource RavenBioConfirmedBrush}"
                                                         PotentialBrush="{DynamicResource RavenBioPotentialBrush}"
                                                         DimmedFilledBrush="{DynamicResource RavenBioConfirmedDimBrush}"
                                                         PredictionFilledBrush="{DynamicResource RavenBioPredictionBrush}"
                                                         PredictionPotentialBrush="{DynamicResource RavenBioPredictionPotentialBrush}"
                                                         HighlightBrush="{DynamicResource RavenBioGoldBrush}"
                                                         DimmedHighlightBrush="{DynamicResource RavenBioGoldDimBrush}"
                                                         UnknownBrush="{DynamicResource RavenBioUnknownBrush}"
                                                         UnknownGlyphBrush="{DynamicResource RavenBioUnknownGlyphBrush}"
                                                         HatchBrush="{DynamicResource RavenBioHatchBrush}"
                                                         EmptyBrush="{DynamicResource RavenBioEmptyBrush}" />

                      <Grid Grid.Column="1"
                            RowDefinitions="Auto,Auto"
                            HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="2">
                          <TextBlock Foreground="{DynamicResource RavenBioWhiteBrush}"
                                     FontSize="9"
                                     FontWeight="Bold"
                                     IsVisible="{Binding IsGlobalRegionalFirst}"
                                     Text="&#x2600;"
                                     ToolTip.Tip="First discovery for this Galactic region" />
                          <TextBlock Foreground="{DynamicResource RavenBioGoldBrush}"
                                     FontSize="9"
                                     FontWeight="Bold"
                                     IsVisible="{Binding IsCommanderFirst}"
                                     Text="&#x2691;"
                                     ToolTip.Tip="First discovery for this Commander" />
                          <TextBlock Foreground="{DynamicResource RavenBioGoldBrush}"
                                     FontSize="9"
                                     FontWeight="Bold"
                                     IsVisible="{Binding IsHighlightedRegionalFirst}"
                                     Text="&#x2690;"
                                     ToolTip.Tip="First regional discovery for this Commander" />
                          <TextBlock Foreground="{DynamicResource RavenPrimaryBrush}"
                                     FontSize="9"
                                     IsVisible="{Binding IsStandardRegionalFirst}"
                                     Text="&#x2690;"
                                     ToolTip.Tip="First regional discovery for this Commander" />
                          <TextBlock Foreground="{DynamicResource RavenPrimaryBrush}"
                                     FontSize="9"
                                     FontWeight="SemiBold"
                                     Text="{Binding GenusLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource RavenMutedTextBrush}"
                                   FontSize="8"
                                   Text="{Binding RewardText}" />
                      </Grid>

                      <StackPanel Grid.Column="2">
                        <ItemsControl ItemsSource="{Binding Species}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BiologyOrganismVariantRowViewModel">
                              <StackPanel MinHeight="13"
                                          Orientation="Horizontal"
                                          Spacing="2">
                                <Grid>
                                  <TextBlock Foreground="{DynamicResource RavenPrimaryBrush}"
                                             FontSize="9"
                                             IsVisible="{Binding !HasVariantColor}"
                                             Text="{Binding SpeciesName}" />
                                  <TextBlock Foreground="{Binding VariantName, Converter={StaticResource BiologyVariantColorConverter}}"
                                             FontSize="9"
                                             IsVisible="{Binding HasVariantColor}"
                                             Text="{Binding SpeciesName}"
                                             ToolTip.Tip="{Binding VariantName}" />
                                </Grid>
                                <TextBlock Foreground="{DynamicResource RavenBioWhiteBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           IsVisible="{Binding IsGlobalRegionalFirst}"
                                           Text="&#x2600;"
                                           ToolTip.Tip="First discovery for this Galactic region" />
                                <TextBlock Foreground="{DynamicResource RavenBioGoldBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           IsVisible="{Binding IsCommanderFirst}"
                                           Text="&#x2691;"
                                           ToolTip.Tip="First discovery for this Commander" />
                                <TextBlock Foreground="{DynamicResource RavenBioGoldBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           IsVisible="{Binding IsHighlightedRegionalFirst}"
                                           Text="&#x2690;"
                                           ToolTip.Tip="First regional discovery for this Commander" />
                                <TextBlock Foreground="{DynamicResource RavenPrimaryBrush}"
                                           FontSize="9"
                                           IsVisible="{Binding IsStandardRegionalFirst}"
                                           Text="&#x2690;"
                                           ToolTip.Tip="First regional discovery for this Commander" />
                                <TextBlock Foreground="{DynamicResource RavenBioUnknownGlyphBrush}"
                                           FontSize="9"
                                           IsVisible="{Binding HasPredictionMarkers}"
                                           Text="?"
                                           ToolTip.Tip="{Binding PredictionMarkerToolTip}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="badge overlay-state-pill overlay-state-pill-compact"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding IsAnalyzed}">
                          <TextBlock Foreground="{DynamicResource RavenSuccessBrush}"
                                     FontSize="6"
                                     FontWeight="Bold"
                                     Text="ANALYZED" />
                        </Border>
                      </StackPanel>
                    </Grid>

                    <Border Classes="overlay-divider"
                            Margin="0,2,0,1"
                            Background="{DynamicResource RavenPrimaryDimBrush}"
                            IsVisible="{Binding ShowDivider}"
                            Opacity="0.55" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Foreground="{DynamicResource RavenMutedTextBrush}"
                     FontSize="9"
                     IsVisible="{Binding Survey.BiologySurveyDisplay.HasGeologicalSignals}"
                     Text="{Binding Survey.BiologySurveyDisplay.GeologicalSignalCount, StringFormat={}{0} geological signals}" />
          <ItemsControl IsVisible="{Binding Survey.BiologySurveyDisplay.HasGeologicalSignals}"
                        ItemsSource="{Binding Survey.BiologySurveyDisplay.GeologicalSignals}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Foreground="{DynamicResource RavenPrimaryBrush}"
                           FontSize="9"
                           Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Foreground="{DynamicResource RavenMutedTextBrush}"
                     FontSize="9"
                     IsVisible="{Binding Survey.BiologySurveyDisplay.HasRadicoidaUnicaCount}"
                     Text="{Binding Survey.BiologySurveyDisplay.RadicoidaUnicaCountText}" />
        </StackPanel>
      </ScrollViewer>

      <TextBlock HorizontalAlignment="Center"
                 Foreground="{DynamicResource RavenMutedTextBrush}"
                 FontSize="9"
                 IsVisible="{Binding Survey.BiologySurveyDisplay.HasRewardSummary}"
                 Text="{Binding Survey.BiologySurveyDisplay.RewardSummary}"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock HorizontalAlignment="Center"
                 Foreground="{DynamicResource RavenAccentBrush}"
                 FontSize="9"
                 IsVisible="{Binding Survey.BiologySurveyDisplay.HasFirstFootfallRewardSummary}"
                 Text="{Binding Survey.BiologySurveyDisplay.FirstFootfallRewardSummary}"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Border>
</UserControl>
