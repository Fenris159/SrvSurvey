<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.SystemStatusOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             MinWidth="120"
             MaxWidth="220"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="Border.ring-layer">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.ring-layer.slot">
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.ring-a.unscanned">
      <Setter Property="BorderBrush" Value="{DynamicResource RavenWarningBrush}" />
    </Style>
    <Style Selector="Border.ring-b.unscanned">
      <Setter Property="BorderBrush" Value="{DynamicResource RavenSuccessBrush}" />
    </Style>
    <Style Selector="Border.ring-c.unscanned">
      <Setter Property="BorderBrush" Value="{DynamicResource RavenSuccessDimBrush}" />
    </Style>
    <Style Selector="Border.ring-b.slot.inner-a">
      <Setter Property="Padding" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.ring-c.slot.inner-a">
      <Setter Property="Padding" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.ring-c.slot.inner-b">
      <Setter Property="Padding" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.ring-c.slot.inner-a.inner-b">
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Styles>
  <!-- Content-sized live/editor presentation; the editor folder tab is host
       chrome and does not alter this panel's runtime dimensions. -->
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="3">
      <TextBlock FontSize="10" Classes="type-body" Foreground="{DynamicResource RavenTextBrush}"
                 FontWeight="SemiBold"
                 Text="{Binding Survey.SystemStatusText}"
                 TextWrapping="Wrap" />

      <StackPanel IsVisible="{Binding Survey.HasDssBodies}" Spacing="2">
        <TextBlock FontSize="9" Classes="muted type-header"
                   Text="{Binding Survey.DssHeading}"
                   TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Survey.DssBodies}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SurveyBodyReferenceViewModel">
              <Border Classes="ring-layer ring-c"
                      Classes.slot="{Binding HasUnscannedRingC}"
                      Classes.unscanned="{Binding HasUnscannedRingC}"
                      Classes.inner-a="{Binding HasUnscannedRingA}"
                      Classes.inner-b="{Binding HasUnscannedRingB}"
                      Margin="0,0,6,2"
                      VerticalAlignment="Center">
                <Border Classes="ring-layer ring-b"
                        Classes.slot="{Binding HasUnscannedRingB}"
                        Classes.unscanned="{Binding HasUnscannedRingB}"
                        Classes.inner-a="{Binding HasUnscannedRingA}">
                  <Border Classes="ring-layer ring-a"
                          Classes.slot="{Binding HasUnscannedRingA}"
                          Classes.unscanned="{Binding HasUnscannedRingA}">
                    <Border Padding="5,2"
                            Background="{DynamicResource RavenAccentMutedBrush}"
                            CornerRadius="3">
                      <Grid>
                        <TextBlock FontSize="9" Classes="type-body"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource RavenSecondaryBrush}"
                                   IsVisible="{Binding !IsDestination}"
                                   Text="{Binding Name}" />
                        <TextBlock FontSize="9" Classes="type-body"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource RavenWarningBrush}"
                                   IsVisible="{Binding IsDestination}"
                                   Text="{Binding Name}" />
                      </Grid>
                    </Border>
                  </Border>
                </Border>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding Survey.HasBiologicalBodies}" Spacing="2">
        <TextBlock FontSize="9" Classes="type-header" Foreground="{DynamicResource RavenBioGoldBrush}"
                   FontWeight="SemiBold"
                   Text="{Binding Survey.BiologicalHeading}"
                   TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Survey.BiologicalBodies}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SurveyBodyReferenceViewModel">
              <TextBlock FontSize="9" Classes="type-body" Margin="0,0,8,2"
                         Foreground="{DynamicResource RavenPrimaryBrush}"
                         FontWeight="SemiBold"
                         Text="{Binding Name}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock FontSize="9" Classes="muted type-body"
                 IsVisible="{Binding Survey.HasNonBodySignals}"
                 Text="{Binding Survey.NonBodySignalsText}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
