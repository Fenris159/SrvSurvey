<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.MiniTrackOverlayWindow"
        x:DataType="vm:SurfaceSurveyOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="240"
        d:DesignHeight="96"
        Width="240"
        MinHeight="80"
        MaxHeight="260"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey quick tracker overlay">
  <Border Padding="10,8"
          Background="{DynamicResource RavenWindowBrush}"
          BorderBrush="{DynamicResource RavenBorderBrush}"
          BorderThickness="1"
          CornerRadius="10"
          Opacity="0.97">
    <ItemsControl ItemsSource="{Binding SurfaceSurvey.QuickTrackerGroups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SurfaceTrackerGroupViewModel">
          <ItemsControl Margin="2"
                        ItemsSource="{Binding Targets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SurfaceRadarMarkerViewModel">
                <Border Margin="2"
                        Padding="7,5"
                        MinWidth="48"
                        Background="{DynamicResource RavenSurfaceBrush}"
                        CornerRadius="7">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="{Binding Name}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               FontSize="15"
                               Text="▲">
                      <TextBlock.RenderTransform>
                        <RotateTransform Angle="{Binding RelativeBearingDegrees}" />
                      </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center"
                               Classes="monospace"
                               FontSize="9"
                               Text="{Binding DistanceText}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</Window>
