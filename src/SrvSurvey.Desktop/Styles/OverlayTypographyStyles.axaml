<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window.srv-overlay">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>

  <!-- Font-role classes own size only so panel scaling stays independent from
       colour, weight, and family classes. -->
  <Style Selector="Window.srv-overlay TextBlock.type-header">
    <Setter Property="FontSize" Value="{DynamicResource RavenOverlayHeaderFontSize}" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.type-title">
    <Setter Property="FontSize" Value="{DynamicResource RavenOverlayTitleFontSize}" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.type-value">
    <Setter Property="FontSize" Value="{DynamicResource RavenOverlayValueFontSize}" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.type-body">
    <Setter Property="FontSize" Value="{DynamicResource RavenOverlayBodyFontSize}" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.type-detail">
    <Setter Property="FontSize" Value="{DynamicResource RavenOverlayDetailFontSize}" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.type-caption">
    <Setter Property="FontSize" Value="{DynamicResource RavenOverlayCaptionFontSize}" />
  </Style>

  <!-- Appearance roles remain free to control family, colour, and emphasis. -->
  <Style Selector="Window.srv-overlay TextBlock.overlay-header">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource RavenHeaderBrush}" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-title">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-value">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-body">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-detail">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-caption">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.eyebrow">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.muted">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.monospace">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-title">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-legacy-middle">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-legacy-middle-bold">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-legacy-small">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-legacy-small-bold">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
</Styles>
