<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window.srv-overlay">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>

  <!-- Overlay typography uses role-based sizing. Oxanium carries titles,
       body copy, and values; Rajdhani compresses labels and longer detail. -->
  <Style Selector="Window.srv-overlay TextBlock.overlay-title">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-value">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-body">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-detail">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.overlay-caption">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
    <Setter Property="FontSize" Value="9" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.eyebrow">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.muted">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.monospace">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-title">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-legacy-middle">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-legacy-middle-bold">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Oxanium#Oxanium" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-legacy-small">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
  <Style Selector="Window.srv-overlay TextBlock.guardian-legacy-small-bold">
    <Setter Property="FontFamily"
            Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
  </Style>
</Styles>
