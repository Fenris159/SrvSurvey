<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The commander console reads as one instrument surface. Emblems and the
       location readout carry its identity; routine details use open rows. -->
  <Style Selector=".commander-console TextBlock.console-identity, .commander-readout TextBlock.flight-location, .commander-readout TextBlock.console-value">
    <Setter Property="FontFamily" Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=".commander-console TextBlock.console-identity">
    <Setter Property="FontSize" Value="32" />
  </Style>
  <Style Selector=".commander-readout TextBlock.flight-location">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="LineHeight" Value="36" />
  </Style>
  <Style Selector=".commander-readout TextBlock.console-value">
    <Setter Property="FontSize" Value="27" />
  </Style>
  <Style Selector=".commander-console TextBlock.console-label, .commander-readout TextBlock.console-label">
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector=".commander-readout Border.flight-readout">
    <Setter Property="Background" Value="{DynamicResource RavenSidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="20,20,16,18" />
  </Style>
  <Style Selector=".commander-readout Border.finance-readout">
    <Setter Property="BorderBrush" Value="{DynamicResource RavenStrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,4,0,14" />
  </Style>
  <Style Selector=".commander-readout StackPanel.finance-item">
    <Setter Property="Margin" Value="0,10,0,4" />
    <Setter Property="Spacing" Value="3" />
  </Style>
  <Style Selector=".commander-readout Border.commander-rank">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="4,14,12,14" />
    <Setter Property="Margin" Value="0,0,16,0" />
    <Setter Property="MinHeight" Value="112" />
  </Style>
  <Style Selector=".commander-console Border.card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,8" />
  </Style>
  <Style Selector=".commander-console Border.dashboard-row, .commander-readout Border.console-data-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,10" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector=".commander-readout Border.commander-faction">
    <Setter Property="Padding" Value="0,12" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="MinHeight" Value="72" />
  </Style>
  <Style Selector=".commander-console Expander.profile-section /template/ ToggleButton, .commander-readout Expander.console-section /template/ ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenStrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,10" />
  </Style>
  <Style Selector=".commander-console Expander.profile-section /template/ ToggleButton /template/ Border#ToggleButtonBackground, .commander-readout Expander.console-section /template/ ToggleButton /template/ Border#ToggleButtonBackground">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector=".commander-console Expander.profile-section /template/ ToggleButton:pointerover, .commander-readout Expander.console-section /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenInteractiveHoverBrush}" />
  </Style>
  <Style Selector=".commander-console Expander.profile-section /template/ Border, .commander-readout Expander.console-section /template/ Border">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector=".commander-console TabItem.commander-profile-tab">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector=".commander-console Button.console-account">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector=".commander-console Button.console-account:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenInteractiveHoverBrush}" />
  </Style>
  <Style Selector=".commander-subpage TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector=".commander-subpage TextBlock.console-page-title">
    <Setter Property="FontFamily" Value="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector=".commander-subpage TextBlock.console-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    <Setter Property="LetterSpacing" Value="0" />
  </Style>
  <Style Selector=".commander-subpage Border.console-page-header">
    <Setter Property="Background" Value="{DynamicResource RavenSidebarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector=".commander-subpage Border.detail-tile, .commander-subpage Border.module-group, .commander-subpage Border.subexpander-panel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0,8" />
  </Style>
  <Style Selector=".commander-subpage Border.console-loadout">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector=".commander-subpage Border.console-goal">
    <Setter Property="BorderBrush" Value="{DynamicResource RavenStrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,8,0,20" />
  </Style>
</Styles>
