    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.dashboard-subexpander:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
  </Style>
  <Style Selector="Button.dashboard-subexpander:pressed">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
  </Style>
