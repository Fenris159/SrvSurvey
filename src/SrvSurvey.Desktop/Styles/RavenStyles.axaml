<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource RavenWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.monospace">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.card.raised">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
  </Style>
  <Style Selector="Border.accent-line">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <!-- Divider rules consume the width selected by their parent. They have no
       intrinsic width and therefore cannot make a content-sized overlay grow. -->
  <Style Selector="Border.overlay-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,9" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Button.commander-card">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Button.commander-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Button.commander-card.selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Button.compact-danger">
    <Setter Property="Foreground" Value="{DynamicResource RavenDangerBrush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <Style Selector="Button.favorite-star">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.favorite-star:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.favorite-star:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.favorite-star TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>

  <Style Selector="ListBox.guide-categories">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>

  <Style Selector="TextBox.guide-search">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.guide-search:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentForegroundBrush}" />
  </Style>
  <Style Selector="Expander.theme-selector">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
  </Style>
  <Style Selector="Expander.theme-selector /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
  </Style>
  <Style Selector="Expander.theme-selector /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Expander.profile-section">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Expander.profile-section /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander.profile-section /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Expander.profile-subsection">
    <Setter Property="Background" Value="{DynamicResource RavenWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Expander.profile-subsection /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="Border.rank-card">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.detail-tile">
    <Setter Property="Background" Value="{DynamicResource RavenWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.dashboard-row">
    <Setter Property="Background" Value="{DynamicResource RavenWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,0,5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.dashboard-row.compact">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,0,0,3" />
  </Style>
  <Style Selector="Border.subexpander-panel">
    <Setter Property="Background" Value="{DynamicResource RavenWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Button.dashboard-subexpander">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.dashboard-subexpander:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
  </Style>
  <Style Selector="Button.dashboard-subexpander:pressed">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
  </Style>
  <Style Selector="Border.module-group">
    <Setter Property="Background" Value="{DynamicResource RavenWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.module-group-toggle">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.module-group-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
  </Style>
  <Style Selector="Button.module-group-toggle:pressed">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
  </Style>
  <Style Selector="Border.module-row">
    <Setter Property="Background" Value="{DynamicResource RavenWindowBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="9,8" />
  </Style>
  <Style Selector="Border.module-icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Border.module-class-badge">
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Height" Value="25" />
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.module-engineering">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="TextBlock.table-heading">
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabItem.commander-profile-tab">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="TabControl.theme-selector">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
  </Style>
  <Style Selector="TabItem.theme-selector">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource RavenBorderBrush}" />
  </Style>
</Styles>
