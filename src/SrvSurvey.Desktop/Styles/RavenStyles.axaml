<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource RavenWindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.monospace">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.card.raised">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
  </Style>
  <Style Selector="Border.accent-line">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.badge.overlay-state-pill">
    <Setter Property="Width" Value="66" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.badge.overlay-state-pill TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge.overlay-state-pill.overlay-state-pill-compact">
    <Setter Property="Width" Value="42" />
    <Setter Property="Padding" Value="4,1" />
  </Style>

  <!-- Divider rules consume the width selected by their parent. They have no
       intrinsic width and therefore cannot make a content-sized overlay grow. -->
  <Style Selector="Border.overlay-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,9" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource RavenControlAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenControlAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenControlAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenControlAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource RavenSecondaryFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenInteractiveHoverBrush}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource RavenDangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenDangerBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenDangerBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button:focus-visible, ToggleButton:focus-visible, TextBox:focus-visible, ComboBox:focus-visible, NumericUpDown:focus-visible, CheckBox:focus-visible, RadioButton:focus-visible, ToggleSwitch:focus-visible, Slider:focus-visible, TabItem:focus-visible, ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource RavenFocusRingBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled, ToggleButton:disabled, TextBox:disabled, ComboBox:disabled, NumericUpDown:disabled, CheckBox:disabled, RadioButton:disabled, ToggleSwitch:disabled, Slider:disabled, TabItem:disabled, ListBoxItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource RavenTertiaryTextBrush}" />
    <Setter Property="Opacity" Value="0.78" />
  </Style>
  <Style Selector="Button.commander-card">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Button.commander-card:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Button.commander-card.selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Button.compact-danger">
    <Setter Property="Foreground" Value="{DynamicResource RavenDangerBrush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.link TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="TextBlock.system-copy-link">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.system-copy-link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentHoverBrush}" />
  </Style>

  <Style Selector="Button.nav-overlay-settings">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
  </Style>
  <Style Selector="Button.nav-overlay-settings:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
  </Style>

  <Style Selector="Border.nav-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="Border.nav-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Border.nav-row.selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="Button.nav-item">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
  </Style>
  <Style Selector="Button.nav-item:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="Border.nav-row.selected Button.nav-item">
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="Button.nav-group-heading">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav-group-heading:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="Button.nav-group-heading.expanded">
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
  </Style>
  <Style Selector="Button.footer-link">
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="ScrollViewer[IsExpanded=true] /template/ Panel#PART_ScrollBarsSeparator">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="False" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="16" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="8"
                Padding="4,3">
          <Track Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="True">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_PageUpButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            Opacity="0" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_PageDownButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            Opacity="0" />
            </Track.IncreaseButton>
            <Thumb MinWidth="8"
                   MinHeight="32"
                   Background="{DynamicResource RavenMutedTextBrush}"
                   Opacity="0.42">
              <Thumb.Template>
                <ControlTemplate>
                  <Border Classes="scrollbar-thumb"
                          Background="{TemplateBinding Background}"
                          CornerRadius="999" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="16" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="8"
                Padding="3,4">
          <Track Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_PageUpButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            Opacity="0" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_PageDownButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            Opacity="0" />
            </Track.IncreaseButton>
            <Thumb MinWidth="32"
                   MinHeight="8"
                   Background="{DynamicResource RavenMutedTextBrush}"
                   Opacity="0.42">
              <Thumb.Template>
                <ControlTemplate>
                  <Border Classes="scrollbar-thumb"
                          Background="{TemplateBinding Background}"
                          CornerRadius="999" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ScrollBar:horizontal /template/ Thumb">
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Opacity" Value="0.68" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Button.favorite-star">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.favorite-star:pointerover">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.favorite-star:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.favorite-star TextBlock">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>

  <Style Selector="ListBox.guide-categories">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ListBox.guide-categories ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>

  <Style Selector="ListBox.system-pages">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="FlyoutPresenter.system-page-picker">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.system-pages ListBoxItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.system-pages ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="ListBox.system-pages ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentForegroundBrush}" />
  </Style>
  <Style Selector="ListBox.system-pages ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentForegroundBrush}" />
  </Style>

  <Style Selector="TextBox, NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenStrongBorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="TextBox.guide-search">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenStrongBorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBox.guide-search:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenStrongBorderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="{DynamicResource RavenSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenAccentForegroundBrush}" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource RavenHighestSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenStrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Expander.theme-selector">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Expander.theme-selector /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="Padding" Value="16,11" />
  </Style>
  <Style Selector="Expander.theme-selector /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Expander.theme-selector /template/ ToggleButton /template/ Border#ToggleButtonBackground">
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Expander.profile-section">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Expander.profile-section /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Padding" Value="16,11" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander.profile-section /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Expander.profile-section /template/ ToggleButton /template/ Border#ToggleButtonBackground">
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Expander.profile-subsection">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Expander.profile-subsection /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Padding" Value="14,9" />
  </Style>
  <Style Selector="Expander.profile-subsection /template/ ToggleButton /template/ Border#ToggleButtonBackground">
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Expander.section-pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Expander.section-pill /template/ ToggleButton">
    <Setter Property="Background" Value="{DynamicResource RavenRaisedSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,9" />
  </Style>
  <Style Selector="Expander.section-pill /template/ ToggleButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
  </Style>
  <Style Selector="Expander.section-pill /template/ ToggleButton /template/ Border#ToggleButtonBackground">
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Border.guide-step">
    <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RavenAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <Style Selector="Border.guide-detail">
    <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="12,5" />
