<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.StationInfoOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:StationInfoOverlayViewModel"
             mc:Ignorable="d"
             MaxWidth="220"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto,Auto"
            ColumnSpacing="6"
            RowSpacing="2">
        <TextBlock Classes="overlay-header type-header" Text="STATION INFORMATION" />
        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="7">
            <LayoutTransformControl Classes="type-icon" IsVisible="{Binding StationInfo.IsQuestTagged}">
              <Border Classes="badge">
                <TextBlock FontSize="9" Foreground="{DynamicResource RavenWarningBrush}"
                           FontWeight="Bold"
                           Text="Q" />
              </Border>
            </LayoutTransformControl>
            <TextBlock FontSize="17" Classes="type-title" Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding StationInfo.StationName}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <LayoutTransformControl Grid.Column="1" Classes="type-icon" VerticalAlignment="Top">
          <Border Classes="badge">
            <TextBlock FontSize="8" Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="Bold"
                       Text="{Binding InputMode}" />
          </Border>
        </LayoutTransformControl>
        <TextBlock FontSize="10" Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Classes="muted type-detail"
                   Text="{Binding StationInfo.StationType}" />
      </Grid>

      <StackPanel Spacing="4">
        <Border Padding="9,7"
                Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="7">
          <TextBlock FontSize="10" Classes="type-value"
                     Text="{Binding StationInfo.LargestPadText}"
                     TextWrapping="Wrap" />
        </Border>
        <Border Padding="9,7"
                Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="7">
          <TextBlock FontSize="10" Classes="type-detail"
                     Text="{Binding StationInfo.PrimaryEconomyText}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Classes="eyebrow type-header" Text="ECONOMIES" />
        <ItemsControl ItemsSource="{Binding StationInfo.EconomyLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StationInfoLineViewModel">
              <Grid ColumnDefinitions="Auto,Auto"
                    ColumnSpacing="8"
                    HorizontalAlignment="Left">
                <TextBlock FontSize="10" Classes="type-body" Text="{Binding Label}" />
                <TextBlock FontSize="10" Grid.Column="1"
                           Classes="monospace type-value"
                           Foreground="{DynamicResource RavenAccentBrush}"
                           Text="{Binding Value}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Classes="eyebrow type-header" Text="CONTROLLING FACTION" />
        <TextBlock FontSize="10" Classes="type-body"
                   Text="{Binding StationInfo.FactionText}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="4"
                  IsVisible="{Binding StationInfo.HasRelevantServices}">
        <TextBlock Classes="eyebrow type-header" Text="RELEVANT SERVICES" />
        <ItemsControl ItemsSource="{Binding StationInfo.RelevantServices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="10" Classes="type-body" Margin="2,1"
                         Foreground="{DynamicResource RavenAccentBrush}"
                         Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="4"
                  IsVisible="{Binding StationInfo.HasProhibitedCommodities}">
        <TextBlock Classes="eyebrow type-header" Text="PROHIBITED" />
        <ItemsControl ItemsSource="{Binding StationInfo.ProhibitedCommodities}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="10" Classes="type-body" Margin="2,1"
                         Foreground="{DynamicResource RavenWarningBrush}"
                         Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock FontSize="9" Classes="muted type-detail"
                 Text="{Binding StationInfo.UpdatedText}" />
    </StackPanel>
  </Border>
</UserControl>
