<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.StationInfoOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:StationInfoOverlayViewModel"
             mc:Ignorable="d"
             MaxWidth="220"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto,Auto"
            ColumnSpacing="6"
            RowSpacing="2">
        <TextBlock Classes="overlay-header type-header" Text="STATION INFORMATION" />
        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="7">
            <Border Classes="badge"
                    IsVisible="{Binding StationInfo.IsQuestTagged}">
              <TextBlock Classes="type-detail" Foreground="{DynamicResource RavenWarningBrush}"
                         FontWeight="Bold"
                         Text="Q" />
            </Border>
            <TextBlock Classes="type-title" Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding StationInfo.StationName}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top">
          <TextBlock Classes="type-caption" Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="Bold"
                     Text="{Binding InputMode}" />
        </Border>
        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Classes="muted type-detail"
                   Text="{Binding StationInfo.StationType}" />
      </Grid>

      <StackPanel Spacing="4">
        <Border Padding="9,7"
                Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="7">
          <TextBlock Classes="type-detail"
                     Text="{Binding StationInfo.LargestPadText}"
                     TextWrapping="Wrap" />
        </Border>
        <Border Padding="9,7"
                Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="7">
          <TextBlock Classes="type-detail"
                     Text="{Binding StationInfo.PrimaryEconomyText}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Classes="eyebrow type-header" Text="ECONOMIES" />
        <ItemsControl ItemsSource="{Binding StationInfo.EconomyLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StationInfoLineViewModel">
              <Grid ColumnDefinitions="Auto,Auto"
                    ColumnSpacing="8"
                    HorizontalAlignment="Left">
                <TextBlock Classes="type-detail" Text="{Binding Label}" />
                <TextBlock Grid.Column="1"
                           Classes="monospace type-detail"
                           Foreground="{DynamicResource RavenAccentBrush}"
                           Text="{Binding Value}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="3">
        <TextBlock Classes="eyebrow type-header" Text="CONTROLLING FACTION" />
        <TextBlock Classes="type-detail"
                   Text="{Binding StationInfo.FactionText}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="4"
                  IsVisible="{Binding StationInfo.HasRelevantServices}">
        <TextBlock Classes="eyebrow type-header" Text="RELEVANT SERVICES" />
        <ItemsControl ItemsSource="{Binding StationInfo.RelevantServices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Classes="type-detail" Margin="2,1"
                         Foreground="{DynamicResource RavenAccentBrush}"
                         Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="4"
                  IsVisible="{Binding StationInfo.HasProhibitedCommodities}">
        <TextBlock Classes="eyebrow type-header" Text="PROHIBITED" />
        <ItemsControl ItemsSource="{Binding StationInfo.ProhibitedCommodities}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Classes="type-detail" Margin="2,1"
                         Foreground="{DynamicResource RavenWarningBrush}"
                         Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Classes="muted type-detail"
                 Text="{Binding StationInfo.UpdatedText}" />
    </StackPanel>
  </Border>
</UserControl>
