<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.ColonizationCommodityOverlayWindow"
        x:DataType="vm:ColonizationCommodityOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="270"
        d:DesignHeight="400"
        Width="270"
        Height="1"
        MaxHeight="480"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey construction commodities overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:ColonizationCommodityOverlayPresentation />
  </Border>
</Window>
