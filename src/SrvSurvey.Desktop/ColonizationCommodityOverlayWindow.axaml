<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.ColonizationCommodityOverlayWindow"
        x:DataType="vm:ColonizationCommodityOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="480"
        d:DesignHeight="700"
        Width="480"
        Height="700"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey construction commodities overlay">
  <Border Margin="8"
          Padding="16"
          Background="{DynamicResource RavenWindowBrush}"
          BorderBrush="{DynamicResource RavenBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Opacity="0.96">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Classes="eyebrow" Text="CONSTRUCTION SHOPPING" />
          <TextBlock Classes="card-title"
                     FontSize="18"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding Title}" />
        </StackPanel>
        <Border Grid.Column="1"
                Classes="badge"
                VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                       FontSize="10"
                       FontWeight="Bold"
                       IsVisible="{Binding HasPendingCargo}"
                       Text="SYNCING" />
            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Text="{Binding InputMode}" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="7">
        <ItemsControl IsVisible="{Binding HasMultipleProjects}"
                      ItemsSource="{Binding ProjectNames}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Classes="muted"
                         FontSize="11"
                         Text="{Binding StringFormat='  › {0}'}"
                         TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Background="{DynamicResource RavenRaisedSurfaceBrush}"
                CornerRadius="7"
                IsVisible="{Binding HasWarning}"
                Padding="10">
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Text="{Binding WarningText}" />
        </Border>
        <Border Background="{DynamicResource RavenRaisedSurfaceBrush}"
                CornerRadius="7"
                IsVisible="{Binding IsConstructionComplete}"
                Padding="12">
          <TextBlock Foreground="{DynamicResource RavenSuccessBrush}"
                     FontSize="16"
                     FontWeight="Bold"
                     Text="Construction complete" />
        </Border>
        <Grid ColumnDefinitions="*,70,70,70,44"
              ColumnSpacing="8"
              Margin="4,2,4,0">
          <TextBlock Classes="muted" FontSize="10" Text="COMMODITY" />
          <TextBlock Grid.Column="1"
                     Classes="muted"
                     FontSize="10"
                     HorizontalAlignment="Right"
                     Text="NEED" />
          <TextBlock Grid.Column="2"
                     Classes="muted"
                     FontSize="10"
                     HorizontalAlignment="Right"
                     Text="{Binding FleetCarrierColumnHeader}" />
          <TextBlock Grid.Column="3"
                     Classes="muted"
                     FontSize="10"
                     HorizontalAlignment="Right"
                     Text="{Binding ShipColumnHeader}" />
        </Grid>
      </StackPanel>

      <ScrollViewer Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ColonizationCommodityGroupViewModel">
              <StackPanel Margin="0,0,0,10" Spacing="4">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                             FontSize="11"
                             FontWeight="Bold"
                             Text="{Binding Name}" />
                  <Border Grid.Column="1"
                          Height="1"
                          VerticalAlignment="Center"
                          Background="{DynamicResource RavenBorderBrush}" />
                </Grid>
                <TextBlock Classes="muted"
                           FontSize="10"
                           IsVisible="{Binding IsCollapsed}"
                           Text="{Binding CollapsedSummary}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColonizationCommodityOverlayRowViewModel">
                      <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                              BorderThickness="0,1,0,0"
                              Opacity="{Binding RowOpacity}"
                              Padding="4,7">
                        <Grid ColumnDefinitions="*,70,70,70,44"
                              ColumnSpacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       IsVisible="{Binding HasAssignment}"
                                       Text="{Binding AssignmentText}" />
                            <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       IsVisible="{Binding HasMarketBadge}"
                                       Text="{Binding MarketBadgeText}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     HorizontalAlignment="Right"
                                     Text="{Binding NeededText}" />
                          <TextBlock Grid.Column="2"
                                     Foreground="{DynamicResource RavenAccentBrush}"
                                     HorizontalAlignment="Right"
                                     IsVisible="{Binding IsFleetCarrierValueNormal}"
                                     Text="{Binding OnFleetCarriersText}" />
                          <TextBlock Grid.Column="2"
                                     Foreground="{DynamicResource RavenWarningBrush}"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Right"
                                     IsVisible="{Binding IsFleetCarrierLoadHighlighted}"
                                     Text="{Binding OnFleetCarriersText}" />
                          <TextBlock Grid.Column="3"
                                     Foreground="{DynamicResource RavenSuccessBrush}"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Right"
                                     Text="{Binding InShipText}" />
                          <TextBlock Grid.Column="4"
                                     Foreground="{DynamicResource RavenSuccessBrush}"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     IsVisible="{Binding IsSatisfied}"
                                     Text="✓" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="3" Spacing="7">
        <Border Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="7"
                Padding="10">
          <TextBlock FontWeight="SemiBold"
                     Text="{Binding RemainingSummary}" />
        </Border>
        <TextBlock Classes="muted"
                   FontSize="10"
                   IsVisible="{Binding HasFleetCarriers}"
                   TextWrapping="Wrap"
                   Text="{Binding FleetCarrierSummary}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Classes="muted"
                     FontSize="9"
                     Text="{Binding PlatformStatus}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1"
                     Classes="muted"
                     FontSize="9"
                     Text="{Binding CollapseModeText}" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
