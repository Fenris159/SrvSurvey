<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.RouteWindow"
        x:DataType="vm:RouteWorkspaceViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="760"
        Width="1100"
        Height="760"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Title="{Binding WindowTitle}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource RavenSidebarBrush}"
            BorderBrush="{DynamicResource RavenBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="3">
          <TextBlock Classes="eyebrow" Text="{Binding WorkspaceEyebrow}" />
          <TextBlock Classes="page-title" FontSize="24" Text="{Binding WorkspaceHeading}" />
          <TextBlock Classes="muted"
                     Text="{Binding WorkspaceDescription}" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="10">
          <Button Classes="secondary"
                  Command="{Binding NotesCommand}"
                  Content="Notes" />
          <Button Classes="secondary"
                  Command="{Binding RefreshCommand}"
                  Content="Reload" />
          <Button Classes="secondary" Click="Close_Click" Content="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="310,*">
      <Border x:Name="RouteSidebar"
              Background="{DynamicResource RavenSidebarBrush}"
              BorderBrush="{DynamicResource RavenBorderBrush}"
              BorderThickness="0,0,1,0"
              Padding="18,18,6,18">
        <ScrollViewer x:Name="RouteSidebarScroller"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="RouteSidebarPanels"
                      Margin="0,0,12,0"
                      Spacing="16">
            <Border Classes="card raised" Padding="18">
              <StackPanel Spacing="11">
                <TextBlock Classes="muted" FontSize="10" Text="NEXT SYSTEM" />
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource RavenAccentBrush}"
                           Text="{Binding NextHopName}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="muted"
                           Text="{Binding ProgressSummary}"
                           TextWrapping="Wrap" />
                <Button Classes="primary"
                        HorizontalAlignment="Left"
                        Command="{Binding CopyNextHopCommand}"
                        Content="Copy next hop" />
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
              <StackPanel Spacing="12">
                <TextBlock Classes="card-title" Text="Route behavior" />
                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                          IsEnabled="{Binding CanActivate}"
                          Content="Actively follow this route" />
                <CheckBox IsChecked="{Binding AutoCopy, Mode=TwoWay}"
                          Content="Auto-copy the next hop" />
                <TextBlock Classes="muted"
                           FontSize="11"
                           Text="{Binding AutoCopySummary}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
              <StackPanel Spacing="11">
                <TextBlock Classes="card-title" Text="Replace from import" />
                <TextBlock Classes="muted"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Imports replace the on-screen draft. Nothing is written until Saved." />
                <Button Classes="secondary"
                        Click="ImportSpansh_Click"
                        IsEnabled="{Binding !IsBusy}"
                        Content="Spansh URL from clipboard" />
                <Button Classes="secondary"
                        Click="ImportNames_Click"
                        IsEnabled="{Binding !IsBusy}"
                        Content="System names from clipboard" />
                <Button Classes="secondary"
                        Click="ImportFile_Click"
                        IsEnabled="{Binding !IsBusy}"
                        Content="System names from file" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="4">
              <TextBlock Classes="muted" FontSize="10" Text="COMMANDER CONTEXT" />
              <TextBlock FontWeight="SemiBold" Text="{Binding CurrentSystem}" />
              <TextBlock Classes="muted"
                         FontSize="11"
                         Text="{Binding RouteFileName}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid x:Name="RouteHopWorkspace"
            Grid.Column="1"
            Margin="20,20,6,20"
            RowDefinitions="*">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,14,0"
                    Spacing="7"
                    IsVisible="{Binding !HasRoute}">
          <TextBlock Classes="page-title" FontSize="22" Text="No route loaded" />
          <TextBlock Classes="muted"
                     Text="Import a Spansh route or a list of system names." />
        </StackPanel>

        <ScrollViewer x:Name="RouteHopScroller"
                      IsVisible="{Binding HasRoute}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="RouteHopTable" Margin="0,0,14,0" Spacing="10">
            <Border x:Name="RouteHopHeader"
                    Classes="card"
                    Padding="12,9"
                    IsVisible="{Binding !IsFleetCarrierWorkspace}">
              <Grid ColumnDefinitions="48,*,112,2*" ColumnSpacing="12">
                <TextBlock Classes="muted" Text="DONE" />
                <TextBlock Grid.Column="1" Classes="muted" Text="SYSTEM" />
                <TextBlock Grid.Column="2" Classes="muted" Text="DISTANCE" />
                <TextBlock Grid.Column="3" Classes="muted" Text="GUIDANCE / NOTES" />
              </Grid>
            </Border>

            <Border x:Name="FleetCarrierRouteHopHeader"
                    Classes="card"
                    Width="1540"
                    Padding="12,9"
                    IsVisible="{Binding IsFleetCarrierWorkspace}">
              <Grid ColumnDefinitions="48,270,110,125,90,135,145,135,105,100,140"
                    ColumnSpacing="10">
                <TextBlock Classes="muted" Text="DONE" />
                <TextBlock Grid.Column="1" Classes="muted" Text="SYSTEM NAME" />
                <TextBlock Grid.Column="2" Classes="muted" Text="DISTANCE (LY)" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Classes="muted" Text="REMAINING (LY)" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Classes="muted" Text="JUMPS LEFT" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Classes="muted" Text="FUEL LEFT (TONNES)" TextAlignment="Right" />
                <TextBlock Grid.Column="6" Classes="muted" Text="TRITIUM IN MARKET" TextAlignment="Right" />
                <TextBlock Grid.Column="7" Classes="muted" Text="FUEL USED (TONNES)" TextAlignment="Right" />
                <TextBlock Grid.Column="8" Classes="muted" Text="ICY RING" TextAlignment="Center" />
                <TextBlock Grid.Column="9" Classes="muted" Text="RESTOCK?" TextAlignment="Center" />
                <TextBlock Grid.Column="10" Classes="muted" Text="RESTOCK AMOUNT" TextAlignment="Right" />
              </Grid>
            </Border>

            <ItemsControl x:Name="RouteHopItems"
                          ItemsSource="{Binding Hops}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RouteHopItemViewModel">
                  <Border Classes="card" Padding="12" Margin="0,0,0,8">
                    <Grid>
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="48,*,112,2*"
                          ColumnSpacing="12"
                          IsVisible="{Binding IsStandardHop}">
                      <CheckBox HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsReached, Mode=OneWay}"
                                Click="HopCheckBox_Click" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock Classes="muted"
                                     Text="{Binding Number, StringFormat='#{0}'}" />
                          <TextBlock Grid.Column="1"
                                     FontWeight="SemiBold"
                                     Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Border Classes="badge"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding HasState}"
                                Padding="7,2">
                          <TextBlock FontSize="9"
                                     Foreground="{DynamicResource RavenAccentBrush}"
                                     Text="{Binding State}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Column="2"
                                 VerticalAlignment="Center"
                                 Classes="monospace"
                                 Text="{Binding Distance}" />
                      <StackPanel Grid.Column="3"
                                  VerticalAlignment="Center"
                                  Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Classes="badge"
                                  Background="{DynamicResource RavenRouteGuidanceBadgeBrush}"
                                  IsVisible="{Binding Refuel}"
                                  Padding="7,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Image Width="14"
                                     Height="14"
                                     Source="avares://SrvSurvey.Desktop/Assets/Routes/refuel-star.png"
                                     Stretch="Uniform" />
                              <TextBlock VerticalAlignment="Center"
                                         FontSize="9"
                                         Foreground="#FF8A00"
                                         Text="REFUEL" />
                            </StackPanel>
                          </Border>
                          <Border Classes="badge"
                                  Background="{DynamicResource RavenRouteGuidanceBadgeBrush}"
                                  IsVisible="{Binding Neutron}"
                                  Padding="7,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <Image Width="14"
                                     Height="14"
                                     Source="avares://SrvSurvey.Desktop/Assets/Routes/neutron-star.png"
                                     Stretch="Uniform" />
                              <TextBlock VerticalAlignment="Center"
                                         FontSize="9"
                                         Foreground="#4A9EE8"
                                         Text="NEUTRON" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="muted"
                                   IsVisible="{Binding HasNotes}"
                                   Text="{Binding RouteNotes}"
                                   TextWrapping="Wrap" />
                        <TextBlock Classes="muted"
                                   IsVisible="{Binding !HasGuidance}"
                                   Text="—" />
                      </StackPanel>
                      <StackPanel Grid.Row="1"
                                  Grid.ColumnSpan="4"
                                  Margin="60,12,0,0"
                                  Spacing="6"
                                  IsVisible="{Binding HasBioTargets}">
                        <TextBlock Classes="muted" Text="BODIES" />
                        <ItemsControl ItemsSource="{Binding BioTargets}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" ItemWidth="520" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RouteBioTargetItemViewModel">
                              <Border Margin="0,0,8,8"
                                    Padding="9,7"
                                    Background="{DynamicResource RavenPanelBrush}"
                                    BorderBrush="{DynamicResource RavenBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                              <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="7">
                                  <CheckBox VerticalAlignment="Center"
                                            IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                            Click="BioTargetCheckBox_Click" />
                                  <Border Grid.Column="1"
                                          Width="40"
                                          Height="40"
                                          Padding="3"
                                          VerticalAlignment="Center"
                                          Background="Transparent"
                                          CornerRadius="20"
                                          ToolTip.Tip="{Binding BodyIconAccessibleName}">
                                    <Image Source="{Binding BodyIconAssetPath, Converter={StaticResource BundledAssetImageConverter}}"
                                           Stretch="Uniform" />
                                  </Border>
                                  <TextBlock Grid.Column="2"
                                             VerticalAlignment="Center"
                                             FontWeight="SemiBold"
                                             Text="{Binding BodyName}" />
                                  <TextBlock Grid.Column="3"
                                             VerticalAlignment="Center"
                                             Classes="eyebrow"
                                             FontSize="9"
                                             Text="{Binding CompletionLabel}" />
                                 </Grid>
                                 <WrapPanel Margin="74,0,0,0"
                                            IsVisible="{Binding HasDetails}">
                                   <Border Classes="badge"
                                           Margin="0,0,5,5"
                                           IsVisible="{Binding HasSubtype}">
                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                       <TextBlock Classes="eyebrow" FontSize="9" Text="TYPE" />
                                       <TextBlock Classes="muted" FontSize="10" Text="{Binding Subtype}" />
                                     </StackPanel>
                                   </Border>
                                   <Border Classes="badge"
                                           Margin="0,0,5,5"
                                           IsVisible="{Binding HasDistanceToArrival}">
                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                       <TextBlock Classes="eyebrow" FontSize="9" Text="ARRIVAL" />
                                       <TextBlock Classes="muted" FontSize="10" Text="{Binding DistanceToArrival}" />
                                     </StackPanel>
                                   </Border>
                                   <Border Classes="badge"
                                           Margin="0,0,5,5"
                                           IsVisible="{Binding HasEstimatedScanValue}">
                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                       <TextBlock Classes="eyebrow" FontSize="9" Text="SCAN" />
                                       <TextBlock Classes="muted" FontSize="10" Text="{Binding EstimatedScanValue}" />
                                     </StackPanel>
                                   </Border>
                                   <Border Classes="badge"
                                           Margin="0,0,5,5"
                                           IsVisible="{Binding HasEstimatedMappingValue}">
                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                       <TextBlock Classes="eyebrow" FontSize="9" Text="MAP" />
                                       <TextBlock Classes="muted" FontSize="10" Text="{Binding EstimatedMappingValue}" />
                                     </StackPanel>
                                   </Border>
                                   <Border Classes="badge"
                                           Margin="0,0,5,5"
                                           IsVisible="{Binding HasEstimatedBiologyValue}">
                                     <StackPanel Orientation="Horizontal" Spacing="4">
                                       <TextBlock Classes="eyebrow" FontSize="9" Text="BIO" />
                                       <TextBlock Classes="muted" FontSize="10" Text="{Binding EstimatedBiologyValue}" />
                                     </StackPanel>
                                   </Border>
                                   <Border Classes="badge"
                                           Margin="0,0,5,5"
                                           IsVisible="{Binding IsTerraformable}">
                                     <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                                                FontSize="9"
                                                Text="TERRAFORMABLE" />
                                   </Border>
                                 </WrapPanel>
                                 <ItemsControl Margin="74,0,0,0"
                                               IsVisible="{Binding HasSpecies}"
                                              ItemsSource="{Binding Species}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Classes="muted"
                                                 FontSize="11"
                                                 Text="{Binding StringFormat=• {0}}"
                                                 TextWrapping="Wrap" />
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="74,0,0,0"
                                           Classes="muted"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           IsVisible="{Binding NeedsScan}"
                                           Text="Scan for biological signals" />
                              </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                    <Grid Width="1516"
                          ColumnDefinitions="48,270,110,125,90,135,145,135,105,100,140"
                          ColumnSpacing="10"
                          IsVisible="{Binding IsFleetCarrierHop}">
                      <CheckBox HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsReached, Mode=OneWay}"
                                Click="HopCheckBox_Click" />
                      <StackPanel Grid.Column="1" Spacing="3">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                          <TextBlock Classes="muted"
                                     Text="{Binding Number, StringFormat='#{0}'}" />
                          <TextBlock Grid.Column="1"
                                     FontWeight="SemiBold"
                                     Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Border Classes="badge"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding HasState}"
                                Padding="7,2">
                          <TextBlock FontSize="9"
                                     Foreground="{DynamicResource RavenAccentBrush}"
                                     Text="{Binding State}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Column="2"
                                 VerticalAlignment="Center"
                                 Classes="monospace"
                                 Text="{Binding CarrierDistance}"
                                 TextAlignment="Right" />
                      <TextBlock Grid.Column="3"
                                 VerticalAlignment="Center"
                                 Classes="monospace"
                                 Text="{Binding CarrierRemaining}"
                                 TextAlignment="Right" />
                      <TextBlock Grid.Column="4"
                                 VerticalAlignment="Center"
                                 Classes="monospace"
                                 Text="{Binding JumpsRemaining}"
                                 TextAlignment="Right" />
                      <TextBlock Grid.Column="5"
                                 VerticalAlignment="Center"
                                 Classes="monospace"
                                 Text="{Binding CarrierFuelRemaining}"
                                 TextAlignment="Right" />
                      <TextBlock Grid.Column="6"
                                 VerticalAlignment="Center"
                                 Classes="monospace"
                                 Text="{Binding CarrierTritiumInMarket}"
                                 TextAlignment="Right" />
                      <TextBlock Grid.Column="7"
                                 VerticalAlignment="Center"
                                 Classes="monospace"
                                 Text="{Binding CarrierFuelUsed}"
                                 TextAlignment="Right" />
                      <TextBlock Grid.Column="8"
                                 VerticalAlignment="Center"
                                 Classes="eyebrow"
                                 FontSize="10"
                                 Foreground="{DynamicResource RavenAccentBrush}"
                                 Text="{Binding CarrierIcyRing}"
                                 TextAlignment="Center" />
                      <TextBlock Grid.Column="9"
                                 VerticalAlignment="Center"
                                 Classes="eyebrow"
                                 FontSize="10"
                                 Foreground="{DynamicResource RavenWarningBrush}"
                                 Text="{Binding CarrierRestock}"
                                 TextAlignment="Center" />
                      <TextBlock Grid.Column="10"
                                 VerticalAlignment="Center"
                                 Classes="monospace"
                                 Text="{Binding CarrierRestockAmount}"
                                 TextAlignment="Right" />
                    </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource RavenSurfaceBrush}"
            BorderBrush="{DynamicResource RavenBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,13">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Classes="badge"
                  IsVisible="{Binding IsDirty}"
                  Padding="8,3">
            <TextBlock FontSize="9"
                       Foreground="{DynamicResource RavenWarningBrush}"
                       Text="UNSAVED" />
          </Border>
          <TextBlock Classes="muted"
                     VerticalAlignment="Center"
                     Text="{Binding StatusMessage}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="secondary compact-danger"
                  Width="44"
                  Command="{Binding DeleteCommand}"
                  ToolTip.Tip="Delete saved route">
            <Path Width="17"
                  Height="17"
                  Data="M 3,5 L 17,5 M 7,5 L 7,3 L 13,3 L 13,5 M 5,5 L 6,18 L 14,18 L 15,5 M 8,8 L 8.5,15 M 12,8 L 11.5,15"
                  Stroke="{DynamicResource RavenDangerBrush}"
                  StrokeLineCap="Round"
                  StrokeThickness="1.7"
                  Stretch="Uniform" />
          </Button>
          <Button Classes="secondary"
                  Command="{Binding NewCommand}"
                  Content="New" />
          <Button Classes="secondary"
                  Command="{Binding SaveAsCommand}"
                  Content="Save As..." />
          <Button Classes="secondary"
                  Command="{Binding ResetCommand}"
                  Content="Reset" />
          <Button Classes="secondary"
                  Command="{Binding DiscardCommand}"
                  Content="Undo" />
          <Button Classes="primary"
                  Command="{Binding SaveCommand}"
                  Content="Save Changes" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="3"
          Panel.ZIndex="20"
          Background="#99000000"
          IsVisible="{Binding IsNewConfirmationVisible}">
      <Border Classes="card raised"
              Width="430"
              Padding="26"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <TextBlock Classes="page-title" FontSize="22" Text="Start a new route?" />
          <TextBlock Text="Are you sure? Unsaved changes in the workspace will be lost. Saved route files will not be deleted."
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10">
            <Button Classes="secondary"
                    Command="{Binding CancelDialogCommand}"
                    Content="No" />
            <Button Classes="primary"
                    Command="{Binding ConfirmNewCommand}"
                    Content="Yes" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="3"
          Panel.ZIndex="20"
          Background="#99000000"
          IsVisible="{Binding IsDeleteConfirmationVisible}">
      <Border Classes="card raised"
              Width="430"
              Padding="26"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <TextBlock Classes="page-title"
                     FontSize="22"
                     Foreground="{DynamicResource RavenDangerBrush}"
                     Text="Delete this route?" />
          <TextBlock Text="Are you sure? The saved route will be removed from the library and the workspace will return to a new route."
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10">
            <Button Classes="secondary"
                    Command="{Binding CancelDialogCommand}"
                    Content="No" />
            <Button Classes="secondary compact-danger"
                    Command="{Binding ConfirmDeleteCommand}"
                    Content="Yes" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="3"
          Panel.ZIndex="20"
          Background="#99000000"
          IsVisible="{Binding IsSaveAsVisible}">
      <Border Classes="card raised"
              Width="480"
              Padding="26"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="15">
          <TextBlock Classes="page-title" FontSize="22" Text="Save route as" />
          <TextBlock Classes="muted"
                     Text="Enter a name for this route. It will be stored in your commander route library."
                     TextWrapping="Wrap" />
          <TextBox Text="{Binding SaveAsName, Mode=TwoWay}"
                   PlaceholderText="Route name" />
          <TextBlock Foreground="{DynamicResource RavenDangerBrush}"
                     IsVisible="{Binding HasSaveAsError}"
                     Text="{Binding SaveAsError}"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10">
            <Button Classes="secondary"
                    Command="{Binding CancelDialogCommand}"
                    Content="Cancel" />
            <Button Classes="primary"
                    Command="{Binding ConfirmSaveAsCommand}"
                    Content="Save" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="3"
          Panel.ZIndex="20"
          Background="#99000000"
          IsVisible="{Binding IsNotesVisible}">
      <Border Classes="card raised"
              Width="620"
              Padding="26"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="15">
          <TextBlock Classes="page-title" FontSize="22" Text="Route notes" />
          <TextBlock Classes="muted"
                     Text="Add planning notes, reminders, or a description for this route."
                     TextWrapping="Wrap" />
          <TextBox Height="260"
                   AcceptsReturn="True"
                   Text="{Binding NotesDraft, Mode=TwoWay}"
                   TextWrapping="Wrap"
                   PlaceholderText="Write route notes..." />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10">
            <Button Classes="secondary"
                    Command="{Binding CancelDialogCommand}"
                    Content="Cancel" />
            <Button Classes="primary"
                    Command="{Binding SaveNotesCommand}"
                    Content="Save" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
