<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.MultiGameCommanderOverlayWindow"
        x:DataType="vm:CommanderInstancesViewModel"
        mc:Ignorable="d"
        d:DesignWidth="190"
        d:DesignHeight="36"
        MinWidth="100"
        MaxWidth="400"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey active Commander">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:MultiGameCommanderOverlayPresentation />
  </Border>
</Window>
