<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.FleetCarrierRouteOverlayWindow"
        x:DataType="vm:FleetCarrierRouteOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="460"
        d:DesignHeight="430"
        MinWidth="460"
        MinHeight="250"
        MaxHeight="560"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey fleet carrier route overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:FleetCarrierRouteOverlayPresentation />
  </Border>
</Window>
