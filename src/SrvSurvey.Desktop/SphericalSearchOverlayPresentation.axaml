<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.SphericalSearchOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SphericalSearchOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBlock Classes="overlay-header type-header"
                   Text="SEARCH GUIDANCE" />
        <TextBlock FontSize="8" Classes="type-icon" Grid.Column="1"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   FontWeight="SemiBold"
                   Text="{Binding InputMode}" />
      </Grid>

      <Border Padding="7,6"
              Background="{DynamicResource RavenSurfaceBrush}"
              CornerRadius="5"
              IsVisible="{Binding Sphere.ShouldShowGalaxyMapOverlay}">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <TextBlock Classes="eyebrow type-header" Text="SPHERICAL LIMIT" />
            <LayoutTransformControl Grid.Column="1" Classes="type-icon">
              <Border Classes="badge">
                <TextBlock FontSize="8" Foreground="{DynamicResource RavenAccentBrush}"
                           Text="{Binding Sphere.LimitSummary}" />
              </Border>
            </LayoutTransformControl>
          </Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="5" RowSpacing="5">
            <TextBlock Classes="muted type-caption" Text="FROM" />
            <TextBlock Classes="type-body" Grid.Column="1"
                       Text="{Binding SphereCenterSystemName}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Classes="muted type-caption" Text="TO" />
            <TextBlock Classes="type-body" Grid.Row="1" Grid.Column="1"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding SphereDestinationSystemName}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Classes="muted type-caption" Text="DISTANCE" />
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="monospace type-value"
                         Text="{Binding Sphere.DestinationDistance}" />
              <TextBlock FontSize="10" Classes="type-detail" Foreground="{DynamicResource RavenWarningBrush}"
                         FontWeight="SemiBold"
                         Text="{Binding Sphere.DestinationResult}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Padding="7,6"
              Background="{DynamicResource RavenSurfaceBrush}"
              CornerRadius="5"
              IsVisible="{Binding Boxel.ShouldShowGalaxyMapOverlay}">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <TextBlock Classes="eyebrow type-header" Text="BOXEL SEARCH" />
            <TextBlock FontSize="9" Grid.Column="1"
                       Classes="monospace type-detail"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       Text="{Binding Boxel.BoxelProgress}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="5" RowSpacing="5">
            <TextBlock Classes="muted type-caption" Text="BOXEL" />
            <TextBlock Classes="type-body" Grid.Column="1"
                       Text="{Binding Boxel.CurrentBoxelName}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Classes="muted type-caption" Text="VISITED" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Classes="monospace type-value"
                       Text="{Binding Boxel.SystemProgress}" />
            <TextBlock Grid.Row="2" Classes="muted type-caption" Text="NEXT" />
            <TextBlock FontSize="13" Classes="type-title" Grid.Row="2" Grid.Column="1"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding BoxelNextSystem}"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
          <Border Padding="9,6"
                  Background="{DynamicResource RavenAccentMutedBrush}"
                  CornerRadius="7">
            <TextBlock FontSize="10" Classes="type-detail"
                       FontWeight="SemiBold"
                       Text="{Binding Boxel.DestinationStatus}"
                       TextWrapping="Wrap" />
          </Border>
          <TextBlock FontSize="9" Classes="type-detail" HorizontalAlignment="Right"
                     Foreground="{DynamicResource RavenSuccessBrush}"
                     FontWeight="Bold"
                     Text="{Binding BoxelClipboardStatus}" />
        </StackPanel>
      </Border>

      <Border Padding="7,6"
              Background="{DynamicResource RavenSurfaceBrush}"
              CornerRadius="5"
              IsVisible="{Binding Route.ShouldShowGalaxyMapOverlay}">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <TextBlock Classes="eyebrow type-header" Text="FOLLOWED ROUTE" />
            <TextBlock FontSize="9" Grid.Column="1"
                       Classes="monospace type-detail"
                       Text="{Binding Route.ProgressSummary}" />
          </Grid>
          <TextBlock FontSize="13" Classes="type-title" Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold"
                     Text="{Binding RouteNextHopName}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock FontSize="10" Classes="monospace type-detail"
                     Text="{Binding Route.NextHopDistance}" />
          <TextBlock Classes="type-body" IsVisible="{Binding Route.HasNextHopGuidance}"
                     Text="{Binding Route.NextHopGuidance}"
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
            <TextBlock FontSize="9" Classes="type-detail" Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="Bold"
                       Text="{Binding Route.NextHopDestinationStatus}" />
            <TextBlock FontSize="9" Classes="type-detail" Grid.Column="1"
                       Foreground="{DynamicResource RavenSuccessBrush}"
                       FontWeight="Bold"
                       Text="{Binding Route.NextHopClipboardStatus}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
