<Window Classes="app-window"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SrvSurvey.Desktop.RavenBodyRemovalDialog"
        Title="Remove bodies from Raven?" Width="620" SizeToContent="Height" MaxHeight="700"
        CanResize="True" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
    <TextBlock Classes="page-title" FontSize="24" Text="Remove bodies from Raven?" />
    <TextBlock Grid.Row="1" x:Name="SystemText" TextWrapping="Wrap" />
    <TextBlock Grid.Row="2" TextWrapping="Wrap"
               Text="Spansh and EDSM did not return the following bodies. Continuing will remove them from Raven's body catalog. Do you want to proceed?" />
    <ScrollViewer Grid.Row="3" MaxHeight="360" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="RemovedBodies">
        <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="NoButton" Classes="secondary" Content="No" Click="No_Click" IsCancel="True" />
      <Button Classes="danger" Content="Yes" Click="Yes_Click" />
    </StackPanel>
  </Grid>
</Window>
