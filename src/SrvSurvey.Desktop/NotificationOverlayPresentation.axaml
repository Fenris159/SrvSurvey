<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.NotificationOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:NotificationViewModel"
             mc:Ignorable="d"
             MinWidth="160"
             MaxWidth="360"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NotificationMessageViewModel">
            <Grid Margin="0,3" ColumnDefinitions="Auto,*" ColumnSpacing="9">
              <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                         FontWeight="Bold"
                         Text="&#x203A;" />
              <TextBlock Grid.Column="1"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Text="{Binding Text}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ProgressBar Grid.Row="1"
                   Height="2"
                   Minimum="0"
                   Maximum="100"
                   IsHitTestVisible="False"
                   ToolTip.Tip="Notification time remaining"
                   Value="{Binding ProgressPercent}" />
    </Grid>
  </Border>
</UserControl>
