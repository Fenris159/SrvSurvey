<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.GalaxyMapOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:GalaxyMapOverlayViewModel"
             mc:Ignorable="d"
             MaxWidth="240"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <StackPanel Spacing="3">
          <TextBlock Classes="overlay-header type-header" Text="GALAXY MAP" />
          <TextBlock Classes="muted overlay-detail type-detail"
                     Text="Selected system and route intelligence" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   IsVisible="{Binding IsLoading}"
                   Classes="muted overlay-detail type-detail"
                   Text="Loading&#x2026;" />
      </Grid>

      <Border IsVisible="{Binding HasPrimarySystem}"
              Padding="12"
              Background="{DynamicResource RavenSurfaceBrush}"
              BorderBrush="{DynamicResource RavenBorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <StackPanel Spacing="5">
          <TextBlock Classes="eyebrow type-header"
                     Text="{Binding PrimarySystemDisplay.Label}" />
          <DockPanel>
            <LayoutTransformControl DockPanel.Dock="Left" Margin="0,0,7,0" Classes="type-icon" IsVisible="{Binding PrimarySystemDisplay.IsQuestTagged}" ToolTip.Tip="Quest-tagged system">
              <Border Classes="badge">
                <TextBlock Classes="overlay-caption"
                           Foreground="{DynamicResource RavenWarningBrush}"
                           FontWeight="Bold"
                           Text="Q" />
              </Border>
            </LayoutTransformControl>
            <TextBlock Classes="overlay-title type-title"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       Text="{Binding PrimarySystemDisplay.Name}"
                       TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Classes="overlay-body type-body"
                     Text="{Binding PrimarySystemDisplay.DiscoveryText}"
                     TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding PrimarySystemDisplay.HasDiscoveredBy}"
                     Classes="muted overlay-detail type-detail"
                     Text="{Binding PrimarySystemDisplay.DiscoveredByText}"
                     TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding PrimarySystemDisplay.HasUpdated}"
                     Classes="muted overlay-detail type-detail"
                     Text="{Binding PrimarySystemDisplay.UpdatedText}"
                     TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding PrimarySystemDisplay.HasDetails}"
                     Classes="overlay-body type-body"
                     Foreground="{DynamicResource RavenSuccessBrush}"
                     FontWeight="SemiBold"
                       Text="{Binding PrimarySystemDisplay.DetailsText}" />
          <StackPanel IsVisible="{Binding HasPrimaryPois}" Spacing="5">
            <TextBlock Classes="overlay-header type-header" Text="EDAstro POIs" />
            <ItemsControl ItemsSource="{Binding PrimaryPois}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExplorationPoiItemViewModel">
                  <StackPanel Spacing="3" Margin="0,3">
                    <TextBlock IsVisible="{Binding ShowOverlayTitle}" Classes="overlay-title type-title"
                               Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBlock Classes="overlay-detail type-detail" Text="{Binding Categories}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="muted type-detail" Text="{Binding RatingText}" />
                    </Grid>
                    <TextBlock Classes="overlay-body type-body" Text="{Binding Summary}" MaxLines="2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted type-detail" Text="GEC · CC BY-NC-SA 3.0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding HasSecondarySystem}"
              Padding="12"
              Background="{DynamicResource RavenSurfaceBrush}"
              BorderBrush="{DynamicResource RavenBorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <StackPanel Spacing="4">
          <TextBlock Classes="eyebrow type-header"
                     Text="{Binding SecondarySystemDisplay.Label}" />
          <DockPanel>
            <LayoutTransformControl DockPanel.Dock="Left" Margin="0,0,7,0" Classes="type-icon" IsVisible="{Binding SecondarySystemDisplay.IsQuestTagged}" ToolTip.Tip="Quest-tagged system">
              <Border Classes="badge">
                <TextBlock Classes="overlay-caption"
                           Foreground="{DynamicResource RavenWarningBrush}"
                           FontWeight="Bold"
                           Text="Q" />
              </Border>
            </LayoutTransformControl>
            <TextBlock Classes="overlay-title type-title"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       Text="{Binding SecondarySystemDisplay.Name}" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Classes="overlay-body type-body"
                     Text="{Binding SecondarySystemDisplay.DiscoveryText}"
                     TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding SecondarySystemDisplay.HasDiscoveredBy}"
                     Classes="muted overlay-detail type-detail"
                     Text="{Binding SecondarySystemDisplay.DiscoveredByText}"
                     TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding SecondarySystemDisplay.HasUpdated}"
                     Classes="muted overlay-detail type-detail"
                     Text="{Binding SecondarySystemDisplay.UpdatedText}"
                     TextWrapping="Wrap" />
          <TextBlock IsVisible="{Binding SecondarySystemDisplay.HasDetails}"
                     Classes="overlay-body type-body"
                     Foreground="{DynamicResource RavenSuccessBrush}"
                       Text="{Binding SecondarySystemDisplay.DetailsText}" />
          <StackPanel IsVisible="{Binding HasSecondaryPois}" Spacing="5">
            <TextBlock Classes="overlay-header type-header" Text="EDAstro POIs" />
            <ItemsControl ItemsSource="{Binding SecondaryPois}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ExplorationPoiItemViewModel">
                  <StackPanel Spacing="3" Margin="0,3">
                    <TextBlock IsVisible="{Binding ShowOverlayTitle}" Classes="overlay-title type-title"
                               Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
                    <TextBlock Classes="overlay-detail type-detail" Text="{Binding Categories}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted type-detail" Text="{Binding RatingText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock IsVisible="{Binding HasRouteFooter}"
                 Classes="monospace overlay-body type-detail"
                 Foreground="{DynamicResource RavenWarningBrush}"
                 FontWeight="SemiBold"
                 Text="{Binding RouteFooter}" />

      <StackPanel IsVisible="{Binding HasFactions}" Spacing="6">
        <Border Classes="overlay-divider"
                Background="{DynamicResource RavenBorderBrush}" />
        <TextBlock Classes="eyebrow type-header" Text="FACTIONS" />
        <ItemsControl ItemsSource="{Binding Factions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GalaxyMapFactionViewModel">
              <Grid Margin="0,2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Classes="overlay-body type-body"
                             Text="{Binding Name}" />
                  <TextBlock IsVisible="{Binding HasState}"
                             Classes="muted overlay-detail type-detail"
                             Text="{Binding State}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Classes="monospace overlay-body type-value"
                           Foreground="{DynamicResource RavenAccentBrush}"
                           Text="{Binding Influence}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Classes="muted overlay-detail type-detail"
                 Text="{Binding DataStatus}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
