<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.FssInfoOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             MaxWidth="270"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <StackPanel Spacing="3">
          <TextBlock Classes="overlay-header" Text="FSS SURVEY" />
          <TextBlock Classes="overlay-title"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     Text="{Binding Survey.SystemTitle}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top">
          <TextBlock Classes="overlay-detail"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold"
                     Text="{Binding InputMode}" />
        </Border>
      </Grid>

      <StackPanel Spacing="3">
        <TextBlock Classes="monospace overlay-body"
                   FontWeight="SemiBold"
                   Text="{Binding Survey.ScanSummary}" />
        <TextBlock Classes="muted overlay-detail"
                   MaxWidth="220"
                   HorizontalAlignment="Left"
                   Text="{Binding Survey.FssFilterDescription}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="overlay-divider"
              Background="{DynamicResource RavenBorderBrush}" />

      <TextBlock Classes="muted overlay-detail"
                 IsVisible="{Binding !Survey.HasFssBodies}"
                 Text="{Binding Survey.FssEmptyText}"
                 TextWrapping="Wrap" />

      <StackPanel IsVisible="{Binding Survey.HasFssBodies}"
                  Spacing="0">
        <ScrollViewer MaxHeight="{Binding Survey.FssBodyListMaxHeight}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Survey.FssBodies}">
          <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FssBodyRowViewModel">
            <Border Margin="0,0,0,3"
                    Padding="3"
                    Background="{DynamicResource RavenSurfaceBrush}"
                    BorderBrush="{DynamicResource RavenBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                  <Grid>
                    <TextBlock Classes="overlay-body"
                               LineHeight="14"
                               IsVisible="{Binding !IsHighlighted}"
                               FontWeight="SemiBold"
                               Text="{Binding Name}" />
                    <TextBlock Classes="overlay-body"
                               LineHeight="14"
                               IsVisible="{Binding IsHighlighted}"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding Name}" />
                  </Grid>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="4">
                    <TextBlock Classes="muted overlay-detail"
                               LineHeight="14"
                               Text="{Binding BodyClass}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="overlay-caption"
                               Foreground="{DynamicResource RavenWarningBrush}"
                               LineHeight="14"
                               FontWeight="SemiBold"
                               IsVisible="{Binding IsLandable}"
                               Text="LANDABLE" />
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             Classes="monospace overlay-body"
                             LineHeight="14"
                             HorizontalAlignment="Right"
                             Text="{Binding ScanValue}" />
                </Grid>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                               Classes="overlay-caption"
                               LineHeight="12"
                               FontWeight="SemiBold"
                               IsVisible="{Binding HasMarkers}"
                               Text="{Binding Markers}" />
                    <TextBlock Classes="muted overlay-caption"
                               LineHeight="12"
                               IsVisible="{Binding ShowSeparatorBeforeGeologicalSignals}"
                               Text="&#x2022;" />
                    <Grid IsVisible="{Binding HasGeologicalSignals}">
                      <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                                 Classes="overlay-detail"
                                 LineHeight="12"
                                 IsVisible="{Binding !AreGeologicalSignalsComplete}"
                                 Text="{Binding GeologicalSignalsText}" />
                      <TextBlock Classes="muted overlay-detail"
                                 LineHeight="12"
                                 IsVisible="{Binding AreGeologicalSignalsComplete}"
                                 Text="{Binding GeologicalSignalsText}"
                                 TextDecorations="Strikethrough" />
                    </Grid>
                    <TextBlock Classes="muted overlay-caption"
                               LineHeight="12"
                               IsVisible="{Binding ShowSeparatorBeforeBiologicalSignals}"
                               Text="&#x2022;" />
                    <Grid IsVisible="{Binding HasBiologicalSignals}">
                      <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                                 Classes="overlay-detail"
                                 LineHeight="12"
                                 FontWeight="SemiBold"
                                 IsVisible="{Binding !AreBiologicalSignalsComplete}"
                                 Text="{Binding BiologicalSignalsText}" />
                      <TextBlock Classes="muted overlay-detail"
                                 LineHeight="12"
                                 FontWeight="SemiBold"
                                 IsVisible="{Binding AreBiologicalSignalsComplete}"
                                 Text="{Binding BiologicalSignalsText}"
                                 TextDecorations="Strikethrough" />
                    </Grid>
                  </StackPanel>

                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Spacing="4">
                    <Border Classes="badge"
                            Padding="4,0"
                            IsVisible="{Binding IsSurfaceScanned}">
                      <TextBlock Classes="overlay-caption"
                                 LineHeight="12"
                                 Foreground="{DynamicResource RavenAccentBrush}"
                                 FontWeight="SemiBold"
                                 Text="SCANNED" />
                    </Border>
                    <TextBlock Classes="monospace overlay-detail"
                               LineHeight="12"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               IsVisible="{Binding HasDssValue}"
                               Text="{Binding DssValue, StringFormat=DSS {0}}" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Classes="overlay-divider"
                Background="{DynamicResource RavenBorderBrush}" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBlock Classes="muted overlay-caption"
                   Text="SCAN VALUE &#x00B7; DSS VALUE" />
        <TextBlock Grid.Column="1"
                   Classes="muted overlay-caption"
                   Text="0% UNDISCOVERED" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
