<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        xmlns:views="using:SrvSurvey.Desktop.Views"
        x:Class="SrvSurvey.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="600"
        Title="SrvSurvey">
  <Grid ColumnDefinitions="248,*">
    <Border Background="{DynamicResource RavenSidebarBrush}"
            BorderBrush="{DynamicResource RavenBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="18"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="38" Height="38"
                  Background="{DynamicResource RavenAccentBrush}"
                  CornerRadius="10">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource RavenAccentForegroundBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       Text="SRV" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="SrvSurvey" />
            <TextBlock Classes="muted" FontSize="11" Text="CROSS-PLATFORM" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="9"
                Padding="12">
          <StackPanel Spacing="3">
            <TextBlock Classes="muted" FontSize="10" Text="ACTIVE COMMANDER" />
            <TextBlock FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding CommanderName}" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding SystemDescription}" />
          </StackPanel>
        </Border>

        <ListBox Grid.Row="2"
                 Classes="nav"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedNavigation}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItemViewModel">
              <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="8">
                <TextBlock Foreground="{Binding $parent[ListBoxItem].Foreground}"
                           FontWeight="SemiBold"
                           Text="{Binding Glyph}" />
                <TextBlock Grid.Column="1"
                           Foreground="{Binding $parent[ListBoxItem].Foreground}"
                           FontWeight="SemiBold"
                           Text="{Binding Label}" />
                <TextBlock Grid.Column="2"
                           Foreground="{DynamicResource RavenMutedTextBrush}"
                           FontSize="9"
                           Text="{Binding StatusLabel}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Spacing="10">
          <Separator />
          <TextBlock Classes="muted"
                     FontSize="10"
                     TextWrapping="Wrap"
                     Text="Avalonia migration build • feature parity in progress" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <views:OverviewView IsVisible="{Binding IsOverviewSelected}" />
      <views:ExplorationView IsVisible="{Binding IsExplorationSelected}" />
      <views:ExobiologyView IsVisible="{Binding IsExobiologySelected}" />
      <views:TravelView IsVisible="{Binding IsTravelSelected}" />
      <views:SearchView IsVisible="{Binding IsSearchSelected}" />
      <views:GuardianView IsVisible="{Binding IsGuardianSelected}" />
      <views:DiagnosticsView IsVisible="{Binding IsDiagnosticsSelected}" />
      <views:SettingsView IsVisible="{Binding IsSettingsSelected}" />
      <views:PendingView IsVisible="{Binding IsPendingSelected}" />
    </Grid>
  </Grid>
</Window>
