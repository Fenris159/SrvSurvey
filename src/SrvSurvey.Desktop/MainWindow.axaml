<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        xmlns:views="using:SrvSurvey.Desktop.Views"
        x:Class="SrvSurvey.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="600"
        Icon="/Assets/logo.ico"
        Title="SrvSurvey-XP">
  <Window.Resources>
    <DataTemplate x:Key="NavigationRowTemplate"
                  x:DataType="vm:NavigationItemViewModel">
      <Border Classes="nav-row"
              Classes.selected="{Binding IsSelected}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
          <Button Classes="nav-item"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  CommandParameter="{Binding}"
                  Click="SelectNavigationItem_Click"
                  ToolTip.Tip="{Binding Description}">
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding Label}"
                       TextTrimming="CharacterEllipsis" />
          </Button>
          <Button Grid.Column="1"
                  Classes="nav-overlay-settings"
                  IsVisible="{Binding HasOverlaySettings}"
                  CommandParameter="{Binding Key}"
                  Click="OpenCategoryOverlaySettings_Click"
                  ToolTip.Tip="Open category overlay settings">
            <PathIcon Width="18"
                      Height="18"
                      Data="{StaticResource window_multiple_regular}" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <LayoutTransformControl x:Name="ApplicationScaleContainer">
  <Grid ColumnDefinitions="248,*">
    <Border Background="{DynamicResource RavenSidebarBrush}"
            BorderBrush="{DynamicResource RavenBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="16"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Image Width="42"
                 Height="42"
                 Source="/Assets/logo-remastered-linux-windows-split.png"
                 Stretch="Uniform"
                 ToolTip.Tip="SrvSurvey-XP" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="SrvSurvey-XP" />
            <TextBlock Classes="muted" FontSize="10" Text="CMDR'S COMPANION" />
          </StackPanel>
        </Grid>

        <Button Grid.Row="1"
                Classes="commander-card"
                Classes.selected="{Binding IsProfileSelected}"
                Command="{Binding ShowProfileCommand}"
                ToolTip.Tip="Open Frontier commander profile">
          <StackPanel Spacing="3">
            <TextBlock Classes="muted" FontSize="10" Text="ACTIVE COMMANDER" />
            <TextBlock FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding CommanderName}" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding SystemDescription}" />
          </StackPanel>
        </Button>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <ItemsControl ItemsSource="{Binding OverviewNavigationItems}"
                          ItemTemplate="{StaticResource NavigationRowTemplate}" />

            <Separator Margin="0,6" />

            <Button Classes="nav-group-heading"
                    Classes.expanded="{Binding IsSurveyNavigationExpanded}"
                    CommandParameter="survey"
                    Click="ToggleNavigationGroup_Click"
                    Content="Survey"
                    ToolTip.Tip="Show exploration, exobiology, and Boxel workspaces" />
            <Border Classes="nav-group-container"
                    Classes.expanded="{Binding IsSurveyNavigationExpanded}"
                    Classes.reduced-motion="{Binding DesktopBehavior.ReduceMotion}">
              <ItemsControl Margin="10,0,0,4"
                            ItemsSource="{Binding SurveyNavigationItems}"
                            ItemTemplate="{StaticResource NavigationRowTemplate}" />
            </Border>

            <Button Classes="nav-group-heading"
                    Classes.expanded="{Binding IsNavigationNavigationExpanded}"
                    CommandParameter="navigation"
                    Click="ToggleNavigationGroup_Click"
                    Content="Navigation"
                    ToolTip.Tip="Show travel and search workspaces" />
            <Border Classes="nav-group-container"
                    Classes.expanded="{Binding IsNavigationNavigationExpanded}"
                    Classes.reduced-motion="{Binding DesktopBehavior.ReduceMotion}">
              <ItemsControl Margin="10,0,0,4"
                            ItemsSource="{Binding NavigationWorkspaceItems}"
                            ItemTemplate="{StaticResource NavigationRowTemplate}" />
            </Border>

            <Button Classes="nav-group-heading"
                    Classes.expanded="{Binding IsActivitiesNavigationExpanded}"
                    CommandParameter="activities"
                    Click="ToggleNavigationGroup_Click"
                    Content="Activities"
                    ToolTip.Tip="Show Guardian, quest, and colonization workspaces" />
            <Border Classes="nav-group-container"
                    Classes.expanded="{Binding IsActivitiesNavigationExpanded}"
                    Classes.reduced-motion="{Binding DesktopBehavior.ReduceMotion}">
              <ItemsControl Margin="10,0,0,4"
                            ItemsSource="{Binding ActivityNavigationItems}"
                            ItemTemplate="{StaticResource NavigationRowTemplate}" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Spacing="8">
          <Separator />
          <ItemsControl ItemsSource="{Binding UtilityNavigationItems}"
                        ItemTemplate="{StaticResource NavigationRowTemplate}" />
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Classes="muted"
                       Margin="4,0,4,0"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Text="Ask questions at" />
            <Button Classes="link footer-link"
                    Click="OpenDiscord_Click"
                    ToolTip.Tip="Open Guardian Science Corps on Discord"
                    Content="Guardian Science Corps" />
            <TextBlock Classes="muted"
                       Margin="4,0,0,0"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Text="on Discord" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <ContentControl IsVisible="{Binding IsProfileSelected}">
        <views:CommanderProfileView DataContext="{Binding FrontierProfile}" />
      </ContentControl>
      <views:OverviewView IsVisible="{Binding IsOverviewSelected}" />
      <views:ExplorationView IsVisible="{Binding IsExplorationSelected}" />
      <views:ExobiologyView IsVisible="{Binding IsExobiologySelected}" />
      <views:TravelView IsVisible="{Binding IsTravelSelected}" />
      <views:BoxelView IsVisible="{Binding IsBoxelSelected}" />
      <views:SearchView IsVisible="{Binding IsSearchSelected}" />
      <views:GuardianView IsVisible="{Binding IsGuardianSelected}" />
      <views:QuestView IsVisible="{Binding IsQuestsSelected}" />
      <views:ColonizationView IsVisible="{Binding IsColonizationSelected}" />
      <views:DiagnosticsView x:Name="DiagnosticsPage"
                             IsVisible="{Binding IsDiagnosticsSelected}" />
      <views:SettingsView IsVisible="{Binding IsSettingsSelected}" />
      <views:ThemeView IsVisible="{Binding IsThemeSelected}" />
      <views:GuidesView IsVisible="{Binding IsGuidesSelected}" />
    </Grid>

    <Border Grid.ColumnSpan="2"
            ZIndex="100"
            IsVisible="{Binding ReleaseUpdates.ShouldShowUpdateNotification}"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            MaxWidth="760"
            Margin="24"
            Padding="16,13"
            Background="{DynamicResource RavenWindowBrush}"
            BorderBrush="{DynamicResource RavenAccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            BoxShadow="{DynamicResource RavenFloatingPanelShadow}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="&#x2191;" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" Text="New release available" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding ReleaseUpdates.UpdateNotificationText}" />
        </StackPanel>
        <Button Grid.Column="2"
                Classes="primary"
                Command="{Binding ReleaseUpdates.OpenUpdateDiagnosticsCommand}"
                Content="{Binding ReleaseUpdates.UpdateNotificationActionText}" />
        <Button Grid.Column="3"
                Classes="secondary"
                MinWidth="36"
                Padding="8,5"
                Command="{Binding ReleaseUpdates.DismissNotificationCommand}"
                ToolTip.Tip="Dismiss this release notification"
                Content="&#x00D7;" />
      </Grid>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
