<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        xmlns:views="using:SrvSurvey.Desktop.Views"
        x:Class="SrvSurvey.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="600"
        Icon="/Assets/logo.ico"
        Title="SrvSurvey">
  <LayoutTransformControl x:Name="ApplicationScaleContainer">
  <Grid ColumnDefinitions="248,*">
    <Border Background="{DynamicResource RavenSidebarBrush}"
            BorderBrush="{DynamicResource RavenBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="18"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="38" Height="38"
                  Background="{DynamicResource RavenAccentBrush}"
                  CornerRadius="10">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource RavenAccentForegroundBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       Text="SRV" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="SrvSurvey" />
            <TextBlock Classes="muted" FontSize="11" Text="CROSS-PLATFORM" />
          </StackPanel>
        </Grid>

        <Button Grid.Row="1"
                Classes="commander-card"
                Classes.selected="{Binding IsProfileSelected}"
                Command="{Binding ShowProfileCommand}"
                ToolTip.Tip="Open Frontier commander profile">
          <StackPanel Spacing="3">
            <TextBlock Classes="muted" FontSize="10" Text="ACTIVE COMMANDER" />
            <TextBlock FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding CommanderName}" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding SystemDescription}" />
          </StackPanel>
        </Button>

        <ListBox Grid.Row="2"
                 Classes="nav"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedNavigation}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItemViewModel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{Binding $parent[ListBoxItem].Foreground}"
                           FontWeight="SemiBold"
                           Text="{Binding Label}" />
                <Button Grid.Column="1"
                        Classes="nav-overlay-settings"
                        IsVisible="{Binding HasOverlaySettings}"
                        CommandParameter="{Binding Key}"
                        Click="OpenCategoryOverlaySettings_Click"
                        ToolTip.Tip="Open category overlay settings">
                  <PathIcon Width="18"
                            Height="18"
                            Data="{StaticResource window_multiple_regular}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Spacing="10">
          <Separator />
          <TextBlock Classes="muted"
                     FontSize="10"
                     TextWrapping="Wrap"
                     Text="Cross-platform exploration companion" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <ContentControl IsVisible="{Binding IsProfileSelected}">
        <views:CommanderProfileView DataContext="{Binding FrontierProfile}" />
      </ContentControl>
      <views:OverviewView IsVisible="{Binding IsOverviewSelected}" />
      <views:ExplorationView IsVisible="{Binding IsExplorationSelected}" />
      <views:ExobiologyView IsVisible="{Binding IsExobiologySelected}" />
      <views:TravelView IsVisible="{Binding IsTravelSelected}" />
      <views:SearchView IsVisible="{Binding IsSearchSelected}" />
      <views:GuardianView IsVisible="{Binding IsGuardianSelected}" />
      <views:QuestView IsVisible="{Binding IsQuestsSelected}" />
      <views:ColonizationView IsVisible="{Binding IsColonizationSelected}" />
      <views:DiagnosticsView IsVisible="{Binding IsDiagnosticsSelected}" />
      <views:SettingsView IsVisible="{Binding IsSettingsSelected}" />
      <views:GuidesView IsVisible="{Binding IsGuidesSelected}" />
    </Grid>

    <Border Grid.ColumnSpan="2"
            ZIndex="100"
            IsVisible="{Binding ReleaseUpdates.ShouldShowUpdateNotification}"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            MaxWidth="760"
            Margin="24"
            Padding="16,13"
            Background="{DynamicResource RavenWindowBrush}"
            BorderBrush="{DynamicResource RavenAccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            BoxShadow="0 8 24 0 #66000000">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="&#x2191;" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" Text="New release available" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding ReleaseUpdates.UpdateNotificationText}" />
        </StackPanel>
        <Button Grid.Column="2"
                Classes="primary"
                Command="{Binding ReleaseUpdates.OpenUpdateDiagnosticsCommand}"
                Content="{Binding ReleaseUpdates.UpdateNotificationActionText}" />
        <Button Grid.Column="3"
                Classes="secondary"
                MinWidth="36"
                Padding="8,5"
                Command="{Binding ReleaseUpdates.DismissNotificationCommand}"
                ToolTip.Tip="Dismiss this release notification"
                Content="&#x00D7;" />
      </Grid>
    </Border>
  </Grid>
  </LayoutTransformControl>
</Window>
