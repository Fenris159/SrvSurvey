<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        xmlns:views="using:SrvSurvey.Desktop.Views"
        x:Class="SrvSurvey.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        Width="1180"
        Height="760"
        MinWidth="860"
        MinHeight="600"
        Icon="/Assets/logo.ico"
        Title="SrvSurvey">
  <Grid ColumnDefinitions="248,*">
    <Border Background="{DynamicResource RavenSidebarBrush}"
            BorderBrush="{DynamicResource RavenBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="18"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="38" Height="38"
                  Background="{DynamicResource RavenAccentBrush}"
                  CornerRadius="10">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource RavenAccentForegroundBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       Text="SRV" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="SrvSurvey" />
            <TextBlock Classes="muted" FontSize="11" Text="CROSS-PLATFORM" />
          </StackPanel>
        </Grid>

        <Button Grid.Row="1"
                Classes="commander-card"
                Classes.selected="{Binding IsProfileSelected}"
                Command="{Binding ShowProfileCommand}"
                ToolTip.Tip="Open Frontier commander profile">
          <StackPanel Spacing="3">
            <TextBlock Classes="muted" FontSize="10" Text="ACTIVE COMMANDER" />
            <TextBlock FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding CommanderName}" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding SystemDescription}" />
          </StackPanel>
        </Button>

        <ListBox Grid.Row="2"
                 Classes="nav"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedNavigation}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItemViewModel">
              <TextBlock Foreground="{Binding $parent[ListBoxItem].Foreground}"
                         FontWeight="SemiBold"
                         Text="{Binding Label}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Spacing="10">
          <Separator />
          <TextBlock Classes="muted"
                     FontSize="10"
                     TextWrapping="Wrap"
                     Text="Cross-platform exploration companion" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <ContentControl IsVisible="{Binding IsProfileSelected}">
        <views:CommanderProfileView DataContext="{Binding FrontierProfile}" />
      </ContentControl>
      <views:OverviewView IsVisible="{Binding IsOverviewSelected}" />
      <views:ExplorationView IsVisible="{Binding IsExplorationSelected}" />
      <views:ExobiologyView IsVisible="{Binding IsExobiologySelected}" />
      <views:TravelView IsVisible="{Binding IsTravelSelected}" />
      <views:SearchView IsVisible="{Binding IsSearchSelected}" />
      <views:GuardianView IsVisible="{Binding IsGuardianSelected}" />
      <views:QuestView IsVisible="{Binding IsQuestsSelected}" />
      <views:ColonizationView IsVisible="{Binding IsColonizationSelected}" />
      <views:DiagnosticsView IsVisible="{Binding IsDiagnosticsSelected}" />
      <views:SettingsView IsVisible="{Binding IsSettingsSelected}" />
      <views:GuidesView IsVisible="{Binding IsGuidesSelected}" />
    </Grid>
  </Grid>
</Window>
