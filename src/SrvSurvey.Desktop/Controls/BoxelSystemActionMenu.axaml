<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Controls.BoxelSystemActionMenu"
             x:DataType="vm:BoxelSystemRowViewModel"
             Width="110"
             Height="52">
  <UserControl.Resources>
    <!-- The inward arcs follow the launcher while leaving the wider outer
         portions available for action labels. -->
    <StreamGeometry x:Key="RadialOptionTopGeometry">M 4,22 C 26,1 92,1 114,22 L 80,63 C 68,53 50,53 38,63 Z</StreamGeometry>
    <StreamGeometry x:Key="RadialOptionLeftGeometry">M 26,0 A 81,81 0 0 0 26,118 L 60,77 A 28,28 0 0 1 60,41 Z</StreamGeometry>
    <StreamGeometry x:Key="RadialOptionRightGeometry">M 36,0 A 81,81 0 0 1 36,118 L 2,77 A 28,28 0 0 0 2,41 Z</StreamGeometry>
    <StreamGeometry x:Key="RadialOptionBottomGeometry">M 38,3 C 50,17 68,17 80,3 L 114,44 C 92,65 26,65 4,44 Z</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.radial-launcher">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0">
            <ContentPresenter Background="Transparent"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              Opacity="1"
                              Padding="{TemplateBinding Padding}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.radial-launcher:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Canvas.radial-glyph">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="0" />
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:1">
            <TransformOperationsTransition.Easing>
              <CubicEaseOut />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.radial-launcher.engaged Canvas.radial-glyph">
      <Setter Property="RenderTransform">
        <RotateTransform Angle="45" />
      </Setter>
    </Style>
    <Style Selector="Path.radial-slice">
      <Setter Property="Stroke" Value="{DynamicResource RavenAccentBrush}" />
      <Setter Property="RenderTransform">
        <TranslateTransform X="0" Y="0" />
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:1.5">
            <TransformOperationsTransition.Easing>
              <CubicEaseOut />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Ellipse.radial-center">
      <Setter Property="Fill" Value="{DynamicResource RavenAccentBrush}" />
    </Style>
    <Style Selector="Button.radial-launcher.engaged Path.radial-slice">
      <Setter Property="Stroke" Value="{DynamicResource RavenAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.radial-launcher.engaged Ellipse.radial-center">
      <Setter Property="Fill" Value="{DynamicResource RavenAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.radial-launcher.engaged Path.slice-top-right">
      <Setter Property="RenderTransform">
        <TranslateTransform X="5" Y="-5" />
      </Setter>
    </Style>
    <Style Selector="Button.radial-launcher.engaged Path.slice-bottom-right">
      <Setter Property="RenderTransform">
        <TranslateTransform X="5" Y="5" />
      </Setter>
    </Style>
    <Style Selector="Button.radial-launcher.engaged Path.slice-bottom-left">
      <Setter Property="RenderTransform">
        <TranslateTransform X="-5" Y="5" />
      </Setter>
    </Style>
    <Style Selector="Button.radial-launcher.engaged Path.slice-top-left">
      <Setter Property="RenderTransform">
        <TranslateTransform X="-5" Y="-5" />
      </Setter>
    </Style>
    <Style Selector="Canvas.radial-menu-surface">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="0.78" ScaleY="0.78" />
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.55">
            <TransformOperationsTransition.Easing>
              <CubicEaseOut />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Canvas.radial-menu-surface.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="1" ScaleY="1" />
      </Setter>
    </Style>
    <Style Selector="Button.radial-option">
      <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RavenWarningBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Foreground" Value="{DynamicResource RavenTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Path Classes="option-chrome"
                  Data="{TemplateBinding Clip}"
                  Fill="{TemplateBinding Background}"
                  Stroke="{TemplateBinding BorderBrush}" />
            <Path Classes="option-disabled-shade"
                  Data="{TemplateBinding Clip}"
                  Fill="#000000"
                  IsHitTestVisible="False"
                  Opacity="0" />
            <ContentPresenter Background="Transparent"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              Padding="{TemplateBinding Padding}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.32" />
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.55">
            <TransformOperationsTransition.Easing>
              <CubicEaseOut />
            </TransformOperationsTransition.Easing>
          </TransformOperationsTransition>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.radial-option.complete">
      <Setter Property="Width" Value="118" />
      <Setter Property="Height" Value="66" />
      <Setter Property="Padding" Value="20,6" />
      <Setter Property="Clip" Value="{StaticResource RadialOptionTopGeometry}" />
      <Setter Property="RenderTransform">
        <TranslateTransform X="0" Y="50" />
      </Setter>
    </Style>
    <Style Selector="Button.radial-option.reopen">
      <Setter Property="Width" Value="62" />
      <Setter Property="Height" Value="118" />
      <Setter Property="Padding" Value="2,4,6,4" />
      <Setter Property="Clip" Value="{StaticResource RadialOptionLeftGeometry}" />
      <Setter Property="RenderTransform">
        <TranslateTransform X="50" Y="2" />
      </Setter>
    </Style>
    <Style Selector="Button.radial-option.defer">
      <Setter Property="Width" Value="62" />
      <Setter Property="Height" Value="118" />
      <Setter Property="Padding" Value="6,4,2,4" />
      <Setter Property="Clip" Value="{StaticResource RadialOptionRightGeometry}" />
      <Setter Property="RenderTransform">
        <TranslateTransform X="-50" Y="2" />
      </Setter>
    </Style>
    <Style Selector="Button.radial-option.start-here">
      <Setter Property="Width" Value="118" />
      <Setter Property="Height" Value="66" />
      <Setter Property="Padding" Value="20,6" />
      <Setter Property="Clip" Value="{StaticResource RadialOptionBottomGeometry}" />
      <Setter Property="RenderTransform">
        <TranslateTransform X="0" Y="-46" />
      </Setter>
    </Style>
    <Style Selector="Canvas.radial-menu-surface.open Button.radial-option">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform">
        <TranslateTransform X="0" Y="0" />
      </Setter>
    </Style>
    <Style Selector="Button.radial-option /template/ Path.option-chrome">
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.radial-option /template/ ContentPresenter">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.radial-option:pointerover">
      <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RavenWarningBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.radial-option:pointerover /template/ Path.option-chrome">
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="Button.radial-option:disabled">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Background" Value="{DynamicResource RavenAccentMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RavenBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="Foreground" Value="{DynamicResource RavenMutedTextBrush}" />
    </Style>
    <Style Selector="Button.radial-option:disabled /template/ Path.option-chrome">
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Button.radial-option:disabled /template/ Path.option-disabled-shade">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.radial-option:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <Button x:Name="Launcher"
            Classes="radial-launcher"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="Launcher_Click"
            KeyDown="Launcher_KeyDown"
            PointerEntered="Menu_PointerEntered"
            PointerExited="Menu_PointerExited">
      <Viewbox Width="34" Height="34">
        <Canvas Width="100"
                Height="100"
                Classes="radial-glyph"
                RenderTransformOrigin="50%,50%">
          <Path Classes="radial-slice slice-top-right"
                Data="M 54,12 A 38,38 0 0 1 88,46 L 68,46 A 18,18 0 0 0 54,32 Z"
                Fill="{DynamicResource RavenSurfaceBrush}"
                StrokeThickness="4" />
          <Path Classes="radial-slice slice-bottom-right"
                Data="M 88,54 A 38,38 0 0 1 54,88 L 54,68 A 18,18 0 0 0 68,54 Z"
                Fill="{DynamicResource RavenSurfaceBrush}"
                StrokeThickness="4" />
          <Path Classes="radial-slice slice-bottom-left"
                Data="M 46,88 A 38,38 0 0 1 12,54 L 32,54 A 18,18 0 0 0 46,68 Z"
                Fill="{DynamicResource RavenSurfaceBrush}"
                StrokeThickness="4" />
          <Path Classes="radial-slice slice-top-left"
                Data="M 12,46 A 38,38 0 0 1 46,12 L 46,32 A 18,18 0 0 0 32,46 Z"
                Fill="{DynamicResource RavenSurfaceBrush}"
                StrokeThickness="4" />
          <Ellipse Classes="radial-center"
                   Width="9"
                   Height="9"
                   Canvas.Left="45.5"
                   Canvas.Top="45.5" />
        </Canvas>
      </Viewbox>
    </Button>

    <Popup x:Name="MenuPopup"
           PlacementTarget="{Binding #Launcher}"
           Placement="AnchorAndGravity"
           PlacementAnchor="None"
           PlacementGravity="None"
           IsLightDismissEnabled="False">
      <Canvas x:Name="MenuHitSurface"
              Width="330"
              Height="190"
              Background="Transparent"
              PointerEntered="Menu_PointerEntered"
              PointerExited="Menu_PointerExited"
              PointerWheelChanged="Menu_PointerWheelChanged">
        <Canvas x:Name="MenuSurface"
                Width="330"
                Height="190"
                Classes="radial-menu-surface"
                IsVisible="False">
          <Button x:Name="CompleteActionButton"
                  Classes="radial-option complete"
                  Canvas.Left="106"
                  Canvas.Top="12"
                  Command="{Binding CompleteCommand}"
                  Click="Action_Click"
                  Content="Complete"
                  ToolTip.Tip="Mark this recorded system complete." />
          <Button x:Name="ReopenActionButton"
                  Classes="radial-option reopen"
                  Canvas.Left="84"
                  Canvas.Top="34"
                  Command="{Binding ReopenCommand}"
                  Click="Action_Click"
                  Content="Reopen"
                  ToolTip.Tip="Return a completed or empty system to the active survey." />
          <Button x:Name="DeferActionButton"
                  Classes="radial-option defer"
                  Canvas.Left="184"
                  Canvas.Top="34"
                  Command="{Binding DeferCommand}"
                  Click="Action_Click"
                  Content="Defer"
                  ToolTip.Tip="Skip this unfinished system and keep it for later." />
          <Button x:Name="StartHereActionButton"
                  Classes="radial-option start-here"
                  Canvas.Left="106"
                  Canvas.Top="108"
                  Command="{Binding StartHereCommand}"
                  Click="Action_Click"
                  Content="Start Here"
                  ToolTip.Tip="Defer unfinished systems before this one in the current sort direction." />
        </Canvas>
      </Canvas>
    </Popup>
  </Grid>
</UserControl>
