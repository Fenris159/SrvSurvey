<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.FootCombatOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:CombatOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBlock Classes="overlay-header type-header"
                   Text="{Binding Combat.SettlementHeader}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock FontSize="8" Classes="type-icon" Grid.Column="1"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   FontWeight="SemiBold"
                   Text="{Binding InputMode}" />
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <StackPanel Spacing="0">
          <TextBlock FontSize="8" Classes="muted type-caption" Text="KILLS" />
          <TextBlock FontSize="16" Classes="monospace type-title"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="Bold"
                     Text="{Binding Combat.FootCombatKills}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="0">
          <TextBlock FontSize="8" Classes="muted type-caption" Text="BONDS" />
          <TextBlock FontSize="12" Classes="monospace type-value"
                     FontWeight="SemiBold"
                     Text="{Binding Combat.FootCombatBonds}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
