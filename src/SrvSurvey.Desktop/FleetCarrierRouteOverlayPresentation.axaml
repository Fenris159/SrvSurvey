<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.FleetCarrierRouteOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             x:DataType="vm:FleetCarrierRouteOverlayViewModel"
             mc:Ignorable="d"
             MaxWidth="260"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBlock Classes="overlay-header type-header"
                   Text="{Binding Header}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1"
                   Classes="eyebrow type-header"
                   Text="{Binding HopProgress}" />
      </Grid>

      <TextBlock Classes="overlay-title type-title"
                 Foreground="{DynamicResource RavenAccentBrush}"
                 Text="{Binding SystemName}"
                 TextWrapping="Wrap" />
      <TextBlock Classes="overlay-body type-body"
                 IsVisible="{Binding HasJumpSummary}"
                 Text="{Binding JumpSummary}"
                 TextWrapping="Wrap" />
      <TextBlock Classes="muted overlay-detail type-detail"
                 IsVisible="{Binding HasRouteDetails}"
                 Text="{Binding JumpsLeft}"
                 TextWrapping="Wrap" />

      <Border Classes="overlay-divider"
              IsVisible="{Binding HasTritiumDetails}"
              Background="{DynamicResource RavenBorderBrush}" />

      <TextBlock Classes="eyebrow type-header" Text="TRITIUM" IsVisible="{Binding HasTritiumDetails}" />
      <Grid ColumnDefinitions="Auto,Auto" IsVisible="{Binding HasTritiumDetails}"
            ColumnSpacing="24"
            HorizontalAlignment="Left"
            RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Classes="muted overlay-detail type-caption" Text="{Binding FuelLeftLabel}" IsVisible="{Binding HasFuelLeft}" />
        <TextBlock Grid.Column="1"
                   Classes="overlay-body type-value"
                   IsVisible="{Binding HasFuelLeft}"
                   Text="{Binding FuelLeft}" />
        <TextBlock Grid.Row="1"
                   Classes="muted overlay-detail type-caption"
                   IsVisible="{Binding HasMarketTritium}"
                   Text="In market" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Classes="overlay-body type-value"
                   IsVisible="{Binding HasMarketTritium}"
                   Text="{Binding TritiumInMarket}" />
        <TextBlock Grid.Row="2"
                   Classes="muted overlay-detail type-caption"
                   IsVisible="{Binding HasJumpFuel}"
                   Text="{Binding JumpFuelLabel}" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Classes="overlay-body type-value"
                   IsVisible="{Binding HasJumpFuel}"
                   Text="{Binding JumpFuel}" />
        <TextBlock Grid.Row="3" Classes="muted overlay-detail type-caption" Text="In depot now" IsVisible="{Binding HasDepotFuel}" />
        <TextBlock Grid.Row="3" Grid.Column="1" Classes="overlay-body type-value" Text="{Binding DepotFuel}" IsVisible="{Binding HasDepotFuel}" />
      </Grid>

      <WrapPanel IsVisible="{Binding HasMiningResources}">
      <LayoutTransformControl Classes="type-icon"
                              Margin="0,0,6,0"
                              HorizontalAlignment="Left"
                              IsVisible="{Binding HasIcyRing}">
        <Border Classes="badge">
          <TextBlock Classes="overlay-detail"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold"
                     Text="{Binding IcyRingLabel, StringFormat='[ {0} ]'}" />
        </Border>
      </LayoutTransformControl>
      <LayoutTransformControl Classes="type-icon" IsVisible="{Binding HasIcyBody}">
        <Border Classes="badge">
          <TextBlock Classes="overlay-detail" Foreground="{DynamicResource RavenAccentBrush}" FontWeight="SemiBold" Text="[ ICY BODY ]" />
        </Border>
      </LayoutTransformControl>
      </WrapPanel>

      <Grid ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8"
            HorizontalAlignment="Left"
            IsVisible="{Binding HasRestockWarning}">
        <controls:OverlayRowIconHost VerticalAlignment="Center" ClipToBounds="False">
          <Viewbox Height="{Binding #CarrierWarningLabel.FontSize}">
            <Path x:Name="CarrierWarningIcon" Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource RavenWarningBrush}" StrokeThickness="2" StrokeJoin="Round" Data="M12,2 L23,22 L1,22 Z M12,8 L12,14 M12,18 L12,19" />
          </Viewbox>
        </controls:OverlayRowIconHost>
          <TextBlock x:Name="CarrierWarningLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource RavenWarningBrush}"
                     Classes="overlay-body type-title"
                     FontWeight="Bold"
                     TextWrapping="Wrap"
                     Text="{Binding WarningLabel}" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding HasWarningAmount}"
                   Foreground="{DynamicResource RavenWarningBrush}"
                   Classes="overlay-body type-value"
                   FontWeight="Bold"
                   Text="{Binding RestockAmount}" />
      </Grid>

      <StackPanel Spacing="7" IsVisible="{Binding HasCountdown}">
        <Border Classes="overlay-divider"
                Background="{DynamicResource RavenBorderBrush}" />
        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12"
              HorizontalAlignment="Left">
          <TextBlock Classes="eyebrow type-header"
                     Text="{Binding CountdownTitle}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1"
                     Classes="overlay-value type-value"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="Bold"
                     Text="{Binding Countdown}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="12"
              HorizontalAlignment="Left">
          <TextBlock Classes="muted overlay-detail type-detail"
                     FontWeight="SemiBold"
                     Text="{Binding CountdownPhase}" />
          <TextBlock Grid.Column="1"
                     Classes="muted overlay-detail type-detail"
                     FontWeight="SemiBold"
                     IsVisible="{Binding HasCountdownPhaseTime}"
                     Text="{Binding CountdownPhaseTime}" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
