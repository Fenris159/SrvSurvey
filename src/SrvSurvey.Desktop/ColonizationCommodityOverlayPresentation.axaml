<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.ColonizationCommodityOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:ColonizationCommodityOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="True"
             HorizontalAlignment="Left">
  <UserControl.Styles>
    <Style Selector="Border.commodity-row">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.commodity-row.alternate">
      <Setter Property="Background" Value="{DynamicResource RavenColoniseRowHighlightBrush}" />
    </Style>
    <Style Selector="Border.commodity-row.carrier-load">
      <Setter Property="Background" Value="{DynamicResource RavenColoniseLoadHighlightBrush}" />
    </Style>
    <Style Selector="Grid.commodity-headers">
      <Setter Property="Margin" Value="3,1,3,0" />
    </Style>
    <Style Selector="Grid.commodity-headers.compact-scrolling">
      <Setter Property="Margin" Value="3,1,17,0" />
    </Style>
    <Style Selector="TextBlock.carrier-load">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>
  <!-- Slim shopping list: shared column widths, content-sized commodity. Compact mode caps ~15 rows. -->
  <Border Margin="0"
          Padding="4"
          HorizontalAlignment="Left"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="3"
          HorizontalAlignment="Left"
          Grid.IsSharedSizeScope="True">
      <Grid RowDefinitions="Auto,Auto"
            MaxWidth="{Binding #CommodityColumnHeaders.Bounds.Width}">
        <StackPanel Spacing="0" MaxWidth="{Binding #CommodityColumnHeaders.Bounds.Width}">
          <TextBlock x:Name="ProjectHeaderText" Classes="overlay-header type-header"
                     Text="{Binding HeaderTitle}"
                     TextWrapping="Wrap" />
          <ItemsControl IsVisible="{Binding HasMultipleProjects}"
                        ItemsSource="{Binding ProjectNames}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="9" Classes="muted type-detail"
                           Text="{Binding StringFormat='&#x203A; {0}'}"
                           TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="3">
        <Border Background="{DynamicResource RavenRaisedSurfaceBrush}"
                CornerRadius="3"
                IsVisible="{Binding HasWarning}"
                MaxWidth="{Binding #CommodityColumnHeaders.Bounds.Width}"
                Padding="6,3">
          <TextBlock FontSize="9" Classes="type-body" Foreground="{DynamicResource RavenWarningBrush}"
                     FontWeight="SemiBold"
                     Text="{Binding WarningText}"
                     TextWrapping="Wrap" />
        </Border>
        <TextBlock FontSize="11" Classes="type-title" Foreground="{DynamicResource RavenSuccessBrush}"
                   FontWeight="Bold"
                   IsVisible="{Binding IsConstructionComplete}"
                   MaxWidth="{Binding #CommodityColumnHeaders.Bounds.Width}" TextWrapping="Wrap"
                   Text="Construction complete" />
        <!-- Match row Padding (3). Compact scrolling reserves a scrollbar gutter. -->
        <Grid x:Name="CommodityColumnHeaders" Classes="commodity-headers"
              Classes.compact-scrolling="{Binding UseCompactScrollingCommoditiesList}"
              HorizontalAlignment="Left"
              ColumnSpacing="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="ColoniseCommodity" />
            <ColumnDefinition Width="Auto"
                              MinWidth="40"
                              SharedSizeGroup="ColoniseNeed" />
            <ColumnDefinition Width="Auto"
                              MinWidth="{Binding FleetCarrierColumnMinWidth}"
                              SharedSizeGroup="ColoniseFc" />
            <ColumnDefinition Width="Auto"
                              MinWidth="{Binding ShipColumnMinWidth}"
                              SharedSizeGroup="ColoniseShip" />
          </Grid.ColumnDefinitions>
          <TextBlock FontSize="8" Classes="type-title commodity-column-label"
                     Foreground="{DynamicResource RavenPrimaryBrush}" Text="COMMODITY" />
          <TextBlock FontSize="8" Grid.Column="1"
                     Margin="3,0,0,0"
                     Classes="type-title commodity-column-label"
                     Foreground="{DynamicResource RavenPrimaryBrush}"
                     HorizontalAlignment="Right"
                     Text="NEED" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                      VerticalAlignment="Top" Margin="3,0,0,0"
                      IsVisible="{Binding ShowFleetCarrierColumn}"
                      AutomationProperties.Name="{Binding FleetCarrierColumnHeader}">
            <TextBlock x:Name="FleetCarrierHeaderText" FontSize="8" Classes="type-title commodity-column-label"
                       Foreground="{DynamicResource RavenPrimaryBrush}" Text="{Binding FleetCarrierColumnLabel}" />
            <Viewbox Height="{Binding #FleetCarrierHeaderText.FontSize}" Margin="3,0,0,0"
                     VerticalAlignment="Center" IsVisible="{Binding ShowFleetCarrierDeltaIndicator}">
              <TextBlock FontSize="8" Classes="type-title"
                         Foreground="{DynamicResource RavenPrimaryBrush}" Text="Δ" />
            </Viewbox>
          </StackPanel>
          <TextBlock FontSize="8" Grid.Column="3"
                     Margin="3,0,0,0"
                     Classes="type-title commodity-column-label"
                     Foreground="{DynamicResource RavenPrimaryBrush}"
                     IsVisible="{Binding ShowShipColumn}"
                     HorizontalAlignment="Right"
                     Text="{Binding ShipColumnHeader}" />
        </Grid>
      </StackPanel>

      <!-- Compact mode caps ~15 commodity rows at ~18px before scroll; full list sizes to content. -->
      <ScrollViewer Grid.Row="2"
                    MaxHeight="{Binding CommodityListMaxHeight}"
                    HorizontalAlignment="Left"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Groups}"
                      HorizontalAlignment="Left">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ColonizationCommodityGroupViewModel">
              <StackPanel Margin="0,0,0,3" Spacing="0" HorizontalAlignment="Left">
                <TextBlock FontSize="9" Classes="type-header" Foreground="{DynamicResource RavenColoniseCategoryBrush}"
                           FontWeight="Bold"
                           Text="{Binding Name}" />
                <TextBlock FontSize="8" Classes="muted type-detail"
                           IsVisible="{Binding IsCollapsed}"
                           Text="{Binding CollapsedSummary}" />
                <ItemsControl ItemsSource="{Binding Rows}"
                              HorizontalAlignment="Left">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColonizationCommodityOverlayRowViewModel">
                      <!-- Carrier-loading highlights replace the alternating row fill. -->
                      <Border Classes="commodity-row"
                              Classes.alternate="{Binding IsAlternateRow}"
                              Classes.carrier-load="{Binding IsFleetCarrierLoadHighlighted}"
                              Margin="0,0,0,1"
                              Padding="3,2"
                              CornerRadius="1"
                              HorizontalAlignment="Left"
                              Opacity="{Binding RowOpacity}">
                        <Grid ColumnSpacing="0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ColoniseCommodity" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="40"
                                              SharedSizeGroup="ColoniseNeed" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="{Binding FleetCarrierColumnMinWidth}"
                                              SharedSizeGroup="ColoniseFc" />
                            <ColumnDefinition Width="Auto"
                                              MinWidth="{Binding ShipColumnMinWidth}"
                                              SharedSizeGroup="ColoniseShip" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="0">
                              <Viewbox Height="{Binding #CommodityNameText.FontSize}"
                                       VerticalAlignment="Center" IsVisible="{Binding IsSatisfied}">
                                <TextBlock FontSize="10" Classes="type-icon" FontWeight="Bold"
                                           FontFamily="avares://SrvSurvey.Desktop/Assets/Fonts/NotoSansSymbols2#Noto Sans Symbols 2"
                                           Foreground="{DynamicResource RavenColoniseSurplusBrush}" Text="&#x2713;" />
                              </Viewbox>
                              <TextBlock x:Name="CommodityNameText" FontSize="10" Classes="type-body" VerticalAlignment="Center"
                                         Foreground="{DynamicResource RavenColoniseItemBrush}"
                                         IsVisible="{Binding IsActiveItem}"
                                         Text="{Binding DisplayName}" />
                              <TextBlock FontSize="10" Classes="type-body" VerticalAlignment="Center"
                                         Foreground="{DynamicResource RavenColoniseItemDimBrush}"
                                         IsVisible="{Binding IsDimmedItem}"
                                         Text="{Binding DisplayName}" />
                            </StackPanel>
                            <TextBlock FontSize="8" Classes="type-icon" Foreground="{DynamicResource RavenColoniseHighlightBrush}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasAssignment}"
                                       Text="{Binding AssignmentText}" />
                            <TextBlock FontSize="8" Classes="type-icon" Foreground="{DynamicResource RavenColoniseHighlightBrush}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding HasMarketBadge}"
                                       Text="{Binding MarketBadgeText}" />
                          </StackPanel>
                          <TextBlock FontSize="10" Classes="type-value" Grid.Column="1"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Right"
                                     Foreground="{DynamicResource RavenColoniseNeedBrush}"
                                     Text="{Binding NeededText}" />
                          <TextBlock FontSize="10" Classes="type-value" Grid.Column="2"
                                     Margin="3,0,0,0"
                                     Classes.carrier-load="{Binding IsFleetCarrierLoadHighlighted}"
                                     HorizontalAlignment="Right"
                                     Foreground="{DynamicResource RavenColoniseHaveBrush}"
                                     IsVisible="{Binding ShowFleetCarrierSum}"
                                     Text="{Binding OnFleetCarriersText}" />
                          <TextBlock FontSize="10" Classes="type-value" Grid.Column="2"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Right"
                                     Foreground="{DynamicResource RavenColoniseDeficitBrush}"
                                     IsVisible="{Binding IsActiveDeficit}"
                                     Text="{Binding OnFleetCarriersText}" />
                          <TextBlock FontSize="10" Classes="type-value" Grid.Column="2"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Right"
                                     Foreground="{DynamicResource RavenColoniseDeficitDimBrush}"
                                     IsVisible="{Binding IsDimmedDeficit}"
                                     Text="{Binding OnFleetCarriersText}" />
                          <TextBlock FontSize="10" Classes="type-value" Grid.Column="2"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Right"
                                     Foreground="{DynamicResource RavenColoniseSurplusBrush}"
                                     IsVisible="{Binding IsActiveSurplus}"
                                     Text="{Binding OnFleetCarriersText}" />
                          <TextBlock FontSize="10" Classes="type-value" Grid.Column="2"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Right"
                                     Foreground="{DynamicResource RavenColoniseSurplusDimBrush}"
                                     IsVisible="{Binding IsDimmedSurplus}"
                                     Text="{Binding OnFleetCarriersText}" />
                          <TextBlock FontSize="10" Classes="type-value" Grid.Column="3"
                                     Margin="3,0,0,0" IsVisible="{Binding !InlineFleetCarrierCargo}"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Right"
                                     Foreground="{DynamicResource RavenColoniseShipBrush}"
                                     Text="{Binding InShipText}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="3" Spacing="2" HorizontalAlignment="Left"
                  MaxWidth="{Binding #CommodityColumnHeaders.Bounds.Width}">
        <TextBlock FontSize="10" Classes="type-value"
                   FontWeight="SemiBold"
                   Text="{Binding RemainingSummary}" TextWrapping="Wrap" />
        <TextBlock FontSize="8" Classes="muted type-caption"
                   IsVisible="{Binding HasFleetCarriers}"
                   Text="{Binding FleetCarrierSummary}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
