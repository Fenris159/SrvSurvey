<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.FlightWarningOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenDangerDimBrush}"
          CornerRadius="6">
    <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
        <Border Width="24"
                Height="24"
                Background="{DynamicResource RavenDangerBrush}"
                CornerRadius="12">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="White"
                     FontSize="13"
                     FontWeight="Bold"
                     Text="!" />
        </Border>
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
          <TextBlock Classes="eyebrow" Text="FLIGHT WARNING" />
          <TextBlock Foreground="{DynamicResource RavenDangerBrush}"
                     FontSize="13"
                     FontWeight="Bold"
                     Text="{Binding Survey.FlightWarningText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2"
                Classes="badge"
                VerticalAlignment="Center">
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="8"
                     FontWeight="SemiBold"
                     Text="{Binding InputMode}" />
        </Border>
      </Grid>
    </Border>
  </Border>
</UserControl>
