<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.FlightWarningOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="False">
  <Border Margin="0"
          Padding="4"
          Background="{Binding Survey.FlightWarningDimBrush}"
          CornerRadius="6">
    <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
      <Grid ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="6"
            RowSpacing="2">
        <Border MinWidth="24"
                MinHeight="24"
                Padding="4,1"
                Background="{Binding Survey.FlightWarningBrush}"
                CornerRadius="999">
          <Grid>
            <TextBlock Classes="type-title" HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="White"
                     FontWeight="Bold"
                     IsVisible="{Binding !Survey.IsExtremeFlightWarning}"
                     Text="!" />
            <TextBlock Classes="type-title" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       IsVisible="{Binding Survey.IsExtremeFlightWarning}"
                       Text="💀" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
          <TextBlock Classes="overlay-header type-header"
                     Foreground="{Binding Survey.FlightWarningBrush}"
                     Text="FLIGHT WARNING" />
          <TextBlock Classes="type-title" Foreground="{Binding Survey.FlightWarningBrush}"
                     FontWeight="Bold"
                     Text="{Binding Survey.FlightWarningText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2"
                Classes="badge"
                VerticalAlignment="Center">
          <TextBlock Classes="type-caption" Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold"
                     Text="{Binding InputMode}" />
        </Border>
        <TextBlock Classes="type-detail" Grid.Row="1"
                   Grid.ColumnSpan="3"
                   HorizontalAlignment="Center"
                   Foreground="#A8B0B8"
                   FontFamily="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani"
                   Text="{Binding Survey.FlightWarningNote}"
                   TextAlignment="Center" />
      </Grid>
    </Border>
  </Border>
</UserControl>
