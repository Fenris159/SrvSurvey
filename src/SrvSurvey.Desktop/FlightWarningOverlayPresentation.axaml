<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.FlightWarningOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{Binding Survey.FlightWarningDimBrush}"
          CornerRadius="6">
    <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
      <Grid ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="6"
            RowSpacing="2">
        <Border Width="24"
                Height="24"
                Background="{Binding Survey.FlightWarningBrush}"
                CornerRadius="12">
          <Grid>
            <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="White"
                     FontSize="13"
                     FontWeight="Bold"
                     IsVisible="{Binding !Survey.IsExtremeFlightWarning}"
                     Text="!" />
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="13"
                       IsVisible="{Binding Survey.IsExtremeFlightWarning}"
                       Text="💀" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
          <TextBlock Classes="overlay-header" Text="FLIGHT WARNING" />
          <TextBlock Foreground="{Binding Survey.FlightWarningBrush}"
                     FontSize="13"
                     FontWeight="Bold"
                     Text="{Binding Survey.FlightWarningText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2"
                Classes="badge"
                VerticalAlignment="Center">
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="8"
                     FontWeight="SemiBold"
                     Text="{Binding InputMode}" />
        </Border>
        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="3"
                   HorizontalAlignment="Center"
                   Foreground="#A8B0B8"
                   FontFamily="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani"
                   FontSize="9"
                   Text="{Binding Survey.FlightWarningNote}"
                   TextAlignment="Center" />
      </Grid>
    </Border>
  </Border>
</UserControl>
