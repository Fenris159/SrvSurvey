<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.LastFssBodyOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             MaxWidth="240"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="controls|BiologyRewardBandControl">
      <Setter Property="FilledSegmentEdgeBrush" Value="{DynamicResource RavenBioConfirmedSegmentEdgeBrush}" />
      <Setter Property="PotentialSegmentEdgeBrush" Value="{DynamicResource RavenBioConfirmedPotentialSegmentEdgeBrush}" />
      <Setter Property="DimmedFilledSegmentEdgeBrush" Value="{DynamicResource RavenBioConfirmedDimSegmentEdgeBrush}" />
      <Setter Property="DimmedPotentialSegmentEdgeBrush" Value="{DynamicResource RavenBioConfirmedDimPotentialSegmentEdgeBrush}" />
      <Setter Property="PredictionFilledSegmentEdgeBrush" Value="{DynamicResource RavenBioPredictionSegmentEdgeBrush}" />
      <Setter Property="PredictionPotentialSegmentEdgeBrush" Value="{DynamicResource RavenBioPredictionPotentialSegmentEdgeBrush}" />
      <Setter Property="HighlightFilledSegmentEdgeBrush" Value="{DynamicResource RavenBioGoldSegmentEdgeBrush}" />
      <Setter Property="HighlightPotentialSegmentEdgeBrush" Value="{DynamicResource RavenBioGoldPotentialSegmentEdgeBrush}" />
      <Setter Property="DimmedHighlightFilledSegmentEdgeBrush" Value="{DynamicResource RavenBioGoldDimSegmentEdgeBrush}" />
      <Setter Property="DimmedHighlightPotentialSegmentEdgeBrush" Value="{DynamicResource RavenBioGoldDimPotentialSegmentEdgeBrush}" />
      <Setter Property="GlobalRegionalFilledSegmentEdgeBrush" Value="{DynamicResource RavenBioGalacticRegionSegmentEdgeBrush}" />
      <Setter Property="GlobalRegionalPotentialSegmentEdgeBrush" Value="{DynamicResource RavenBioGalacticRegionPotentialSegmentEdgeBrush}" />
      <Setter Property="DimmedPotentialBrush" Value="{DynamicResource RavenBioConfirmedDimPotentialBrush}" />
      <Setter Property="HighlightPotentialBrush" Value="{DynamicResource RavenBioGoldPotentialBrush}" />
      <Setter Property="DimmedHighlightPotentialBrush" Value="{DynamicResource RavenBioGoldDimPotentialBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto,Auto"
            ColumnSpacing="6"
            RowSpacing="2">
        <TextBlock Classes="eyebrow" Text="LAST FSS SCAN" />
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Right"
                    Spacing="4">
          <TextBlock Classes="overlay-value"
                     HorizontalAlignment="Right"
                     IsVisible="{Binding Survey.HasFssTuningIndicator}"
                     Text="{Binding Survey.FssTuningIndicator}"
                     ToolTip.Tip="FSS tuning detector status" />
          <Border Classes="badge" HorizontalAlignment="Right">
            <TextBlock Classes="overlay-caption"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding InputMode}" />
          </Border>
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Classes="overlay-title"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   Text="{Binding Survey.LastFssBodyName}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="2"
                   Grid.ColumnSpan="2"
                   Classes="overlay-detail"
                   Text="{Binding Survey.LastFssBodyDistance}" />
      </Grid>

      <TextBlock Classes="muted overlay-detail"
                 Text="{Binding Survey.LastFssBodyClass}"
                 TextWrapping="Wrap" />

      <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                 Classes="overlay-caption"
                 FontWeight="SemiBold"
                 IsVisible="{Binding Survey.HasLastFssMarkers}"
                 Text="{Binding Survey.LastFssMarkers}" />

      <Grid IsVisible="{Binding Survey.HasLastFssBody}"
            ColumnDefinitions="Auto,Auto"
            ColumnSpacing="5"
            HorizontalAlignment="Left">
        <Border Padding="8,6"
                Background="{DynamicResource RavenSurfaceBrush}"
                CornerRadius="8">
          <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow overlay-caption" Text="SCAN VALUE" />
            <TextBlock Classes="monospace overlay-value"
                       Text="{Binding Survey.LastFssScanValue}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1"
                Padding="8,6"
                Background="{DynamicResource RavenAccentMutedBrush}"
                CornerRadius="8">
          <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow overlay-caption" Text="WITH SURFACE SCAN" />
            <TextBlock Classes="monospace overlay-value"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       Text="{Binding Survey.LastFssMappedValue}" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel IsVisible="{Binding Survey.HasLastFssSignals}"
                  Spacing="3">
        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     Classes="overlay-detail"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Text="{Binding Survey.LastFssSignalsText}" />
          <ItemsControl Grid.Column="1"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Survey.LastFssBiologyRewardBands}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BiologySignalRewardBandViewModel">
                <controls:BiologyRewardBandControl Width="10"
                                                    Height="24"
                                                    MinimumReward="{Binding MinimumReward}"
                                                    MaximumReward="{Binding MaximumReward}"
                                                    BucketOneMillions="{Binding RewardBucketOneMillions}"
                                                    BucketTwoMillions="{Binding RewardBucketTwoMillions}"
                                                    BucketThreeMillions="{Binding RewardBucketThreeMillions}"
                                                    IsPrediction="{Binding IsPrediction}"
                                                    IsHighlighted="{Binding IsHighlighted}"
                                                    IsGlobalRegionalFirst="{Binding IsGlobalRegionalFirst}"
                                                    IsDimmed="{Binding ShouldDim}"
                                                    FilledBrush="{DynamicResource RavenBioConfirmedBrush}"
                                                    DimmedFilledBrush="{DynamicResource RavenBioConfirmedDimBrush}"
                                                    PotentialBrush="{DynamicResource RavenBioPotentialBrush}"
                                                    PredictionFilledBrush="{DynamicResource RavenBioPredictionBrush}"
                                                    PredictionPotentialBrush="{DynamicResource RavenBioPredictionPotentialBrush}"
                                                    HighlightBrush="{DynamicResource RavenBioGoldFillBrush}"
                                                    DimmedHighlightBrush="{DynamicResource RavenBioGoldDimFillBrush}"
                                                    GlobalRegionalBrush="{DynamicResource RavenBioGalacticRegionBrush}"
                                                    GlobalRegionalPotentialBrush="{DynamicResource RavenBioGalacticRegionPotentialBrush}"
                                                    UnknownBrush="{DynamicResource RavenBioUnknownBrush}"
                                                    UnknownGlyphBrush="{DynamicResource RavenBioUnknownGlyphBrush}"
                                                    HatchBrush="{DynamicResource RavenBioHatchBrush}"
                                                    EmptyBrush="{DynamicResource RavenBioEmptyBrush}"
                                                    FilledEdgeBrush="{DynamicResource RavenBioConfirmedEdgeBrush}"
                                                    DimmedFilledEdgeBrush="{DynamicResource RavenBioConfirmedDimEdgeBrush}"
                                                    PredictionEdgeBrush="{DynamicResource RavenBioPredictionEdgeBrush}"
                                                    HighlightEdgeBrush="{DynamicResource RavenBioGoldEdgeBrush}"
                                                    DimmedHighlightEdgeBrush="{DynamicResource RavenBioGoldDimEdgeBrush}"
                                                    GlobalRegionalEdgeBrush="{DynamicResource RavenBioGalacticRegionEdgeBrush}"
                                                    UnknownEdgeBrush="{DynamicResource RavenBioUnknownEdgeBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <TextBlock Classes="monospace overlay-caption"
                   Foreground="{DynamicResource RavenBioWhiteBrush}"
                   FontWeight="SemiBold"
                   IsVisible="{Binding Survey.HasLastFssBiologyRewards}"
                   Text="{Binding Survey.LastFssBiologyRewardText}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
