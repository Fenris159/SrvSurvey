<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.MassacreMissionsOverlayWindow"
        x:DataType="vm:CombatOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="240"
        d:DesignHeight="260"
        MinWidth="240"
        MinHeight="118"
        MaxHeight="620"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey massacre mission overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:MassacreMissionsOverlayPresentation />
  </Border>
</Window>
