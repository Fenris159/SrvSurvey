<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.OverlayPositionEditorWindow"
        x:DataType="vm:OverlayInteractionViewModel"
        Width="620"
        MinHeight="116"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="Edit overlay positions">
  <Border Margin="4"
          Padding="12,10"
          Background="{DynamicResource RavenSurfaceBrush}"
          BorderBrush="{DynamicResource RavenAccentBrush}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          RowSpacing="5">
      <Border x:Name="OverlaySettingsPanel"
              Grid.Row="0"
              Margin="0,0,0,4"
              Padding="9"
              Background="{DynamicResource RavenWindowBrush}"
              BorderBrush="{DynamicResource RavenAccentBrush}"
              BorderThickness="1"
              CornerRadius="7"
              IsVisible="{Binding IsOverlaySettingsOpen}">
        <StackPanel Spacing="7">
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     FontWeight="SemiBold"
                     Text="{Binding SelectedOverlaySettingsTitle}" />
          <TextBlock Classes="muted"
                     FontSize="10"
                     Text="Right-click another preview to edit that pane. The toolbar checkmark saves every change and closes the editor."
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="OPACITY" />
              <CheckBox Content="Use global opacity"
                        IsChecked="{Binding UseGlobalOverlayOpacity, Mode=TwoWay}"
                        IsThreeState="False" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Slider IsEnabled="{Binding !UseGlobalOverlayOpacity}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        Value="{Binding SelectedOverlayOpacityPercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="1"
                           MinWidth="42"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedOverlayOpacityLabel}" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="eyebrow" Text="SCALE" />
              <CheckBox Content="Use global scale"
                        IsChecked="{Binding UseGlobalOverlayScale, Mode=TwoWay}"
                        IsThreeState="False" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Slider IsEnabled="{Binding !UseGlobalOverlayScale}"
                        Minimum="0"
                        Maximum="{Binding SelectedOverlayScaleMaximum}"
                        TickFrequency="1"
                        Value="{Binding SelectedOverlayScaleOrdinal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1"
                           MinWidth="50"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedOverlayScaleLabel}" />
              </Grid>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Grid x:Name="EditorToolbarPanel"
            Grid.Row="1"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
            ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Overlay category" />
        <ComboBox Grid.Column="1"
                  MinWidth="310"
                  Height="38"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
        <Button Grid.Column="2"
                Width="40"
                Height="38"
                Padding="0"
                Command="{Binding SnapToCenterCommand}"
                FontSize="26"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Snap every overlay in this category to the center"
                Content="&#x25CE;" />
        <Button Grid.Column="3"
                Width="40"
                Height="38"
                Padding="0"
                Classes="primary"
                Command="{Binding SaveCommand}"
                FontSize="28"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Save overlay positions, opacity, and scale"
                Content="&#x2713;" />
        <Button Grid.Column="4"
                Width="40"
                Height="38"
                Padding="0"
                Command="{Binding CancelCommand}"
                FontSize="30"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Cancel overlay position, opacity, and scale changes"
                Content="&#x00D7;" />
      </Grid>
      <Grid Grid.Row="2"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Text="Global overlay opacity" />
        <Grid Grid.Column="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
          <Slider Minimum="0"
                  Maximum="100"
                  TickFrequency="1"
                  Value="{Binding GlobalOpacityPercent, Mode=TwoWay}" />
          <TextBlock Grid.Column="1"
                     MinWidth="38"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="{Binding GlobalOpacityLabel}" />
        </Grid>
      </Grid>
      <TextBlock Grid.Row="3"
                 HorizontalAlignment="Center"
                 Classes="muted"
                 FontSize="11"
                 Text="Right Click Panels to edit individual Opacity/Scale" />
      <TextBlock Grid.Row="4"
                 Classes="muted"
                 FontSize="11"
                 Text="{Binding StatusMessage}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</Window>
