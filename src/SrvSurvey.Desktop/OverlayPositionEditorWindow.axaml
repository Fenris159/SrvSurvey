<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.OverlayPositionEditorWindow"
        x:DataType="vm:OverlayInteractionViewModel"
        Width="620"
        MinHeight="116"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey position editor overlay">
  <Border Margin="4"
          Padding="12,10"
          Background="{DynamicResource RavenSurfaceBrush}"
          BorderBrush="{DynamicResource RavenAccentBrush}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
          RowSpacing="5">
      <Border x:Name="OverlaySettingsPanel"
              Grid.Row="0"
              Margin="0,0,0,4"
              Padding="9"
              Background="{DynamicResource RavenWindowBrush}"
              BorderBrush="{DynamicResource RavenAccentBrush}"
              BorderThickness="1"
              CornerRadius="7"
              IsVisible="{Binding IsOverlaySettingsOpen}">
        <StackPanel Spacing="7">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{Binding SelectedOverlaySettingsTitle}" />
            <Button x:Name="TypographyButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{Binding ToggleTypographySettingsCommand}"
                    FontFamily="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani"
                    FontSize="15"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Adjust text size by role for this panel"
                    Content="Aa" />
          </Grid>
          <TextBlock Classes="muted"
                     FontSize="10"
                     Text="Right-click another preview to edit that pane. The toolbar checkmark saves every change and closes the editor."
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="OPACITY" />
              <CheckBox Content="Use global opacity"
                        IsChecked="{Binding UseGlobalOverlayOpacity, Mode=TwoWay}"
                        IsThreeState="False" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Slider IsEnabled="{Binding !UseGlobalOverlayOpacity}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        Value="{Binding SelectedOverlayOpacityPercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="1"
                           MinWidth="42"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedOverlayOpacityLabel}" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="eyebrow" Text="SCALE" />
              <CheckBox Content="Use global scale"
                        IsChecked="{Binding UseGlobalOverlayScale, Mode=TwoWay}"
                        IsThreeState="False" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Slider IsEnabled="{Binding !UseGlobalOverlayScale}"
                        Minimum="0"
                        Maximum="{Binding SelectedOverlayScaleMaximum}"
                        TickFrequency="1"
                        Value="{Binding SelectedOverlayScaleOrdinal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1"
                           MinWidth="50"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedOverlayScaleLabel}" />
              </Grid>
            </StackPanel>
          </Grid>
          <Popup PlacementTarget="{Binding #TypographyButton}"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="True"
                 IsOpen="{Binding IsTypographySettingsOpen, Mode=TwoWay}">
            <Border Width="420"
                    Padding="12"
                    Background="{DynamicResource RavenWindowBrush}"
                    BorderBrush="{DynamicResource RavenAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
              <StackPanel Spacing="8">
                <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                           FontWeight="SemiBold"
                           Text="Text scale from baseline" />
                <TextBlock Classes="muted"
                           FontSize="10"
                           Text="Each role grows or shrinks independently. Zero uses the theme's baseline size."
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding TypographyRoles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OverlayTypographyRoleViewModel">
                      <Grid Margin="0,2"
                            ColumnDefinitions="76,*,52"
                            ColumnSpacing="8">
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding DisplayName}" />
                        <Slider Grid.Column="1"
                                Minimum="-50"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Percent, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding Label}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </Border>
      <Grid x:Name="EditorToolbarPanel"
            Grid.Row="1"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
            ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Overlay category" />
        <ComboBox Grid.Column="1"
                  MinWidth="310"
                  Height="38"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
        <Button Grid.Column="2"
                Width="40"
                Height="38"
                Padding="0"
                Command="{Binding SnapToCenterCommand}"
                FontSize="26"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Snap every overlay in this category to the center"
                Content="&#x25CE;" />
        <Button Grid.Column="3"
                Width="40"
                Height="38"
                Padding="0"
                Classes="primary"
                Command="{Binding SaveCommand}"
                FontSize="28"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Save overlay positions and appearance"
                Content="&#x2713;" />
        <Button Grid.Column="4"
                Width="40"
                Height="38"
                Padding="0"
                Command="{Binding CancelCommand}"
                FontSize="30"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Cancel overlay position and appearance changes"
                Content="&#x00D7;" />
      </Grid>
      <Grid Grid.Row="2"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Text="Global overlay opacity" />
        <Grid Grid.Column="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
          <Slider Minimum="0"
                  Maximum="100"
                  TickFrequency="1"
                  Value="{Binding GlobalOpacityPercent, Mode=TwoWay}" />
          <TextBlock Grid.Column="1"
                     MinWidth="38"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="{Binding GlobalOpacityLabel}" />
        </Grid>
      </Grid>
      <TextBlock Grid.Row="3"
                 HorizontalAlignment="Center"
                 Classes="muted"
                 FontSize="11"
                 Text="Right-click panels to edit opacity, panel scale, and text scale" />
      <TextBlock Grid.Row="4"
                 Classes="muted"
                 FontSize="11"
                 Text="{Binding StatusMessage}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</Window>
