<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.OverlayPositionEditorWindow"
        x:DataType="vm:OverlayInteractionViewModel"
        Width="620"
        Height="116"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="Edit overlay positions">
  <Border Margin="4"
          Padding="12,10"
          Background="{DynamicResource RavenSurfaceBrush}"
          BorderBrush="{DynamicResource RavenAccentBrush}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto"
          ColumnSpacing="8" RowSpacing="5">
      <TextBlock VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Text="Overlay category" />
      <ComboBox Grid.Column="1"
                MinWidth="310"
                Height="38"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
      <Button Grid.Column="2"
              Width="40"
              Height="38"
              Padding="0"
              Classes="primary"
              Command="{Binding SaveCommand}"
              FontSize="28"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              ToolTip.Tip="Save overlay positions, opacity, and scale"
              Content="&#x2713;" />
      <Button Grid.Column="3"
              Width="40"
              Height="38"
              Padding="0"
              Command="{Binding CancelCommand}"
              FontSize="30"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              ToolTip.Tip="Cancel overlay position, opacity, and scale changes"
              Content="&#x00D7;" />
      <TextBlock Grid.Row="1"
                 VerticalAlignment="Center"
                 FontSize="11"
                 FontWeight="SemiBold"
                 Text="Global overlay opacity" />
      <Grid Grid.Row="1"
            Grid.Column="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
        <Slider Minimum="0"
                Maximum="100"
                TickFrequency="1"
                Value="{Binding GlobalOpacityPercent, Mode=TwoWay}" />
        <TextBlock Grid.Column="1"
                   MinWidth="38"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="{Binding GlobalOpacityLabel}" />
      </Grid>
      <TextBlock Grid.Row="2"
                 Grid.ColumnSpan="4"
                 Classes="muted"
                 FontSize="11"
                 Text="{Binding StatusMessage}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</Window>
