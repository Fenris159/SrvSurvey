<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:overlay="using:SrvSurvey.Desktop.Platform.Overlay"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.OverlayPositionEditorWindow"
        x:DataType="vm:OverlayInteractionViewModel"
        Width="620"
        MinHeight="116"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey position editor overlay">
  <Border Margin="4"
          Padding="12,10"
          Background="{DynamicResource RavenSurfaceBrush}"
          BorderBrush="{DynamicResource RavenAccentBrush}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          RowSpacing="5">
      <Border x:Name="TypographySettingsPanel"
              Grid.Row="0"
              Width="420"
              Margin="0,0,0,4"
              Padding="12"
              HorizontalAlignment="Right"
              Background="{DynamicResource RavenWindowBrush}"
              BorderBrush="{DynamicResource RavenAccentBrush}"
              BorderThickness="1"
              CornerRadius="8"
              IsVisible="{Binding IsTypographySettingsOpen}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="Text scale from baseline" />
            <Button Grid.Column="1"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Command="{Binding ResetTypographyCommand}"
                    FontSize="20"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Reset every text and icon scale in this panel to 0%"
                    Content="&#x21BA;" />
          </Grid>
          <TextBlock Classes="muted"
                     FontSize="10"
                     Text="Each role grows or shrinks independently. Zero uses the theme's baseline size."
                     TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding TypographyRoles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OverlayTypographyRoleViewModel">
                <Grid Margin="0,2"
                      ColumnDefinitions="76,*,52"
                      ColumnSpacing="8">
                  <TextBlock VerticalAlignment="Center"
                             FontWeight="SemiBold"
                             Text="{Binding DisplayName}" />
                  <Slider Grid.Column="1"
                          Minimum="-50"
                          Maximum="100"
                          TickFrequency="5"
                          IsSnapToTickEnabled="True"
                          Value="{Binding Percent, Mode=TwoWay}" />
                  <TextBlock Grid.Column="2"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold"
                             Text="{Binding Label}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border x:Name="OverlaySettingsPanel"
              Grid.Row="1"
              Margin="0,0,0,4"
              Padding="9"
              Background="{DynamicResource RavenWindowBrush}"
              BorderBrush="{DynamicResource RavenAccentBrush}"
              BorderThickness="1"
              CornerRadius="7"
              IsVisible="{Binding IsOverlaySettingsOpen}">
        <StackPanel Spacing="7">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{Binding SelectedOverlaySettingsTitle}" />
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{Binding ResetOverlaySizeCommand}"
                    FontSize="19"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Restore this panel's original measured size"
                    Content="&#x2922;" />
            <Button x:Name="TypographyButton"
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{Binding ToggleTypographySettingsCommand}"
                    FontFamily="avares://SrvSurvey.Desktop/Assets/Fonts/Rajdhani#Rajdhani"
                    FontSize="15"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Adjust text size by role for this panel"
                    Content="Aa" />
          </Grid>
          <TextBlock Classes="muted"
                     FontSize="10"
                     Text="Right-click another preview to edit that pane. The toolbar checkmark saves every change and closes the editor."
                     TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="OPACITY" />
              <CheckBox Content="Use global opacity"
                        IsChecked="{Binding UseGlobalOverlayOpacity, Mode=TwoWay}"
                        IsThreeState="False" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Slider IsEnabled="{Binding !UseGlobalOverlayOpacity}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        Value="{Binding SelectedOverlayOpacityPercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="1"
                           MinWidth="42"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedOverlayOpacityLabel}" />
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="eyebrow" Text="SCALE" />
              <CheckBox Content="Use global scale"
                        IsChecked="{Binding UseGlobalOverlayScale, Mode=TwoWay}"
                        IsThreeState="False" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Slider IsEnabled="{Binding !UseGlobalOverlayScale}"
                        Minimum="-100"
                        Maximum="200"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding SelectedOverlayScalePercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="1"
                           MinWidth="50"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedOverlayScaleLabel}" />
              </Grid>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border x:Name="OverlayCategoryMenu"
            Grid.Row="2"
            Width="310"
            Margin="124,0,0,4"
            Padding="9"
            HorizontalAlignment="Left"
            Background="{DynamicResource RavenWindowBrush}"
            BorderBrush="{DynamicResource RavenAccentBrush}"
            BorderThickness="1"
            CornerRadius="7"
            IsVisible="{Binding IsCategoryMenuOpen}">
        <StackPanel Spacing="5">
          <TextBlock Classes="eyebrow" Text="Overlay category" />
          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="overlay:OverlayLayoutCategoryDefinition">
                <Button Classes="secondary"
                        Margin="0,2"
                        Padding="10,6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding $parent[Window].((vm:OverlayInteractionViewModel)DataContext).SelectCategoryCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Grid x:Name="EditorToolbarPanel"
            Grid.Row="3"
            ColumnDefinitions="Auto,*,Auto,Auto,Auto"
            ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="Overlay category" />
        <Button x:Name="OverlayCategorySelector"
                Grid.Column="1"
                Classes="secondary overlay-category"
                MinWidth="310"
                Height="38"
                Padding="10,6"
                HorizontalContentAlignment="Stretch"
                Command="{Binding ToggleCategoryMenuCommand}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding SelectedCategory.DisplayName}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="▲"
                       IsVisible="{Binding IsCategoryMenuOpen}" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Text="▼"
                       IsVisible="{Binding !IsCategoryMenuOpen}" />
          </Grid>
        </Button>
        <Button Grid.Column="2"
                Width="40"
                Height="38"
                Padding="0"
                Command="{Binding SnapToCenterCommand}"
                FontSize="26"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Snap every overlay in this category to the center"
                Content="&#x25CE;" />
        <Button Grid.Column="3"
                Width="40"
                Height="38"
                Padding="0"
                Classes="primary"
                Command="{Binding SaveCommand}"
                FontSize="28"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Save overlay positions and appearance"
                Content="&#x2713;" />
        <Button Grid.Column="4"
                Width="40"
                Height="38"
                Padding="0"
                Command="{Binding CancelCommand}"
                FontSize="30"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Cancel overlay position and appearance changes"
                Content="&#x00D7;" />
      </Grid>
      <Grid Grid.Row="4"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8">
        <TextBlock VerticalAlignment="Center"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Text="Global overlay opacity" />
        <Grid Grid.Column="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
          <Slider Minimum="0"
                  Maximum="100"
                  TickFrequency="1"
                  Value="{Binding GlobalOpacityPercent, Mode=TwoWay}" />
          <TextBlock Grid.Column="1"
                     MinWidth="38"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="{Binding GlobalOpacityLabel}" />
        </Grid>
      </Grid>
      <TextBlock Grid.Row="5"
                 HorizontalAlignment="Center"
                 Classes="muted"
                 FontSize="11"
                 Text="Right-click panels to edit opacity, panel scale, and text scale" />
      <TextBlock Grid.Row="6"
                 Classes="muted"
                 FontSize="11"
                 Text="{Binding StatusMessage}"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Border>
</Window>
