<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.NotificationOverlayWindow"
        x:DataType="vm:NotificationViewModel"
        mc:Ignorable="d"
        d:DesignWidth="200"
        d:DesignHeight="160"
        MinWidth="200"
        MinHeight="56"
        MaxHeight="420"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey notifications">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:NotificationOverlayPresentation />
  </Border>
</Window>
