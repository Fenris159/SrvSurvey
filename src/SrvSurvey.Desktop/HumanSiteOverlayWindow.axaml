<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SrvSurvey.Desktop.Controls"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.HumanSiteOverlayWindow"
        x:DataType="vm:HumanSiteOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="500"
        d:DesignHeight="600"
        Width="500"
        Height="600"
        MinWidth="320"
        MinHeight="320"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey human settlement overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:HumanSiteOverlayPresentation />
  </Border>
</Window>
