<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SrvSurvey.Desktop.Controls"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.HumanSiteOverlayWindow"
        x:DataType="vm:HumanSiteOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="500"
        d:DesignHeight="600"
        Width="500"
        Height="600"
        MinWidth="320"
        MinHeight="320"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey human settlement overlay">
  <Border Margin="8"
          Padding="14"
          Background="{DynamicResource RavenWindowBrush}"
          BorderBrush="{DynamicResource RavenBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Opacity="0.97">
    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="eyebrow" Text="HUMAN SETTLEMENT" />
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Text="{Binding HumanSite.SiteName}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted"
                     FontSize="10"
                     Text="{Binding HumanSite.TemplateText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Right"
                    Spacing="4">
          <Border Classes="badge" HorizontalAlignment="Right">
            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                       FontSize="8"
                       FontWeight="Bold"
                       Text="{Binding InputMode}" />
          </Border>
          <TextBlock Classes="monospace"
                     FontSize="10"
                     HorizontalAlignment="Right"
                     Text="{Binding HumanSite.ZoomText}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <controls:HumanSiteMapControl
            IsVisible="{Binding HumanSite.HasKnownGeometry}"
            Projection="{Binding HumanSite.MapProjection}"
            CommanderOffset="{Binding HumanSite.CommanderOffset}"
            CommanderHeading="{Binding HumanSite.RelativeHeading}"
            ScaleMultiplier="{Binding HumanSite.Zoom}"
            ShowOriginWarning="{Binding HumanSite.ShowOriginWarning}"
            MapBackground="{DynamicResource RavenRaisedSurfaceBrush}"
            GridBrush="{DynamicResource RavenBorderBrush}"
            AccentBrush="{DynamicResource RavenAccentBrush}"
            MutedBrush="{DynamicResource RavenMutedTextBrush}"
            SurfaceBrush="{DynamicResource RavenSurfaceBrush}"
            SuccessBrush="{DynamicResource RavenSuccessBrush}"
            WarningBrush="{DynamicResource RavenWarningBrush}"
            DangerBrush="{DynamicResource RavenDangerBrush}"
            TextBrush="{DynamicResource RavenTextBrush}" />

        <Border Padding="16"
                Background="{DynamicResource RavenRaisedSurfaceBrush}"
                BorderBrush="{DynamicResource RavenBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                IsVisible="{Binding !HumanSite.HasKnownGeometry}">
          <StackPanel VerticalAlignment="Center" Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="SETTLEMENT ALIGNMENT" />
              <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="{Binding HumanSite.GeometryStatus}"
                         TextWrapping="Wrap" />
              <TextBlock Classes="muted"
                         FontSize="11"
                         Text="Land or stand near the centre of a landing pad so SrvSurvey can identify the layout and align the map."
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="11"
                    Background="{DynamicResource RavenAccentMutedBrush}"
                    CornerRadius="8">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="APPROACH" />
                <TextBlock Classes="monospace"
                           FontSize="13"
                           Text="{Binding HumanSite.ApproachDistanceText}" />
                <TextBlock FontSize="10"
                           Text="{Binding HumanSite.FactionText}"
                           TextWrapping="Wrap" />
                <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           IsVisible="{Binding HumanSite.IsAnarchy}"
                           Text="Anarchy government" />
                <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                           FontSize="10"
                           IsVisible="{Binding HumanSite.HasInterstellarFactors}"
                           Text="Interstellar Factors available" />
              </StackPanel>
            </Border>

            <Border Padding="11"
                    Background="{DynamicResource RavenSurfaceBrush}"
                    CornerRadius="8"
                    IsVisible="{Binding HumanSite.HasDockingStatus}">
              <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="{Binding HumanSite.DockingStatusText}"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <StackPanel Spacing="2">
          <TextBlock Classes="monospace"
                     FontSize="9"
                     Text="{Binding HumanSite.CommanderPositionText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="muted"
                     FontSize="8"
                     Text="{Binding PlatformStatus}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Classes="monospace"
                   FontSize="9"
                   HorizontalAlignment="Right"
                   Text="{Binding HumanSite.DistanceText}" />
      </Grid>
    </Grid>
  </Border>
</Window>
