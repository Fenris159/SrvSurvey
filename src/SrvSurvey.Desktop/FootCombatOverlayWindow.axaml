<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.FootCombatOverlayWindow"
        x:DataType="vm:CombatOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="160"
        d:DesignHeight="96"
        Width="160"
        MinHeight="72"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey ground combat zone overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:FootCombatOverlayPresentation />
  </Border>
</Window>
