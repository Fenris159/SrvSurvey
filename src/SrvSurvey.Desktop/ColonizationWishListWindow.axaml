<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors"
        x:Class="SrvSurvey.Desktop.ColonizationWishListWindow"
        x:DataType="vm:ColonizationWishListViewModel"
        Title="Colonization wish list" Width="580" Height="500" MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="Button.remove-wish">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource RavenDangerBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.system-link">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource RavenAccentBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="8">
    <StackPanel Spacing="3">
      <TextBlock Text="Wish List" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="Planned purchases (tonnes)" FontSize="12" Classes="muted" />
    </StackPanel>
    <TreeView x:Name="WishListTree" Grid.Row="1" ItemsSource="{Binding Stations}"
              IsVisible="{Binding HasItems}" Background="Transparent" BorderThickness="0">
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:ColonizationWishListNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="remove-wish" Content="×" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove from wish list" AutomationProperties.Name="Remove from wish list" />
            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
            <Button Classes="system-link" IsVisible="{Binding HasSystem}" Content="{Binding System}"
                    behaviors:ClipboardCopyBehavior.Text="{Binding System}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
    <TextBlock Grid.Row="1" IsVisible="{Binding !HasItems}" FontSize="12" Classes="muted" TextWrapping="Wrap"
               Text="Select a station or commodities in Search Markets to build your wish list." />
    <TextBlock Grid.Row="2" Text="{Binding Summary}" FontSize="11" Classes="muted" />
  </Grid>
</Window>
