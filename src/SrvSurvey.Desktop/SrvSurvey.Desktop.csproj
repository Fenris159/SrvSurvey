<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SrvSurvey.Desktop</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Version>2.1.3.0-rc.31</Version>
    <FileVersion>2.1.3.0</FileVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="OVRSharp" Version="1.2.0" />
    <PackageReference Include="SDL3-CS" Version="3.4.12.3" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.12.1" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.12.1" />
    <PackageReference Include="SharpHook" Version="7.1.3" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- OVRSharp 1.2.0 requires System.Drawing.Common 5.0.0. Keep this
         explicit patched-version override until the OpenVR binding is replaced. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\baseline-localization.json"
                      LogicalName="SrvSurvey.Desktop.Resources.baseline-localization.json" />
    <EmbeddedResource Include="Resources\avalonia-localization.json"
                      LogicalName="SrvSurvey.Desktop.Resources.avalonia-localization.json" />
    <EmbeddedResource Include="Resources\avalonia-localization-source.json"
                      LogicalName="SrvSurvey.Desktop.Resources.avalonia-localization-source.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SrvSurvey.Core\SrvSurvey.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(InaraApplicationApiKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SrvSurvey.Inara.ReadKey</_Parameter1>
      <_Parameter2>$(InaraApplicationApiKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(VoxStellarSharedKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SrvSurvey.VoxStellar.SharedKey</_Parameter1>
      <_Parameter2>$(VoxStellarSharedKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\plotters.json"
             Link="plotters.json"
             CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\logo.ico" />
    <AvaloniaResource Include="Assets\Frontier\**\*.png" />
    <AvaloniaResource Include="Assets\Routes\**\*.png" />
    <AvaloniaResource Include="Assets\Bodies\**\*.png" />
    <AvaloniaResource Include="Assets\GuardianMaps\*-background.png" />
    <AvaloniaResource Include="Assets\GuardianGuidance\*.png" />
    <AvaloniaResource Include="Assets\SettingsVisualAids\*.png" />
    <AvaloniaResource Include="Assets\VoxStellar\*.png" />
    <AvaloniaResource Include="Assets\Fonts\**\*.ttf" />
    <Content Include="Assets\Fonts\**\OFL.txt"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
