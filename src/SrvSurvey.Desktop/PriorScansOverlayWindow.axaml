<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SrvSurvey.Desktop.Controls"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.PriorScansOverlayWindow"
        x:DataType="vm:PriorScansOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="308"
        d:DesignHeight="720"
        Width="308"
        MinHeight="170"
        MaxHeight="760"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey prior scans overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:PriorScansOverlayPresentation />
  </Border>
</Window>
