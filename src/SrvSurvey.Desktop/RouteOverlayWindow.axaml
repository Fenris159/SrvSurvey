<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.RouteOverlayWindow"
        x:DataType="vm:RouteOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="390"
        d:DesignHeight="270"
        Width="390"
        Height="270"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey followed route overlay">
  <Border Margin="8"
          Padding="16"
          Background="{DynamicResource RavenWindowBrush}"
          BorderBrush="{DynamicResource RavenBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Opacity="0.96">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="11">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Classes="eyebrow" Text="FOLLOWED ROUTE" />
          <TextBlock Classes="muted"
                     FontSize="11"
                     Text="Galaxy Map guidance" />
        </StackPanel>
        <Border Grid.Column="1"
                Classes="badge"
                VerticalAlignment="Top">
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Text="{Binding InputMode}" />
        </Border>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock Classes="muted"
                   FontSize="10"
                   Text="NEXT SYSTEM" />
        <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="{Binding Route.NextHopName}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="monospace"
                   FontSize="11"
                   Text="{Binding Route.NextHopDistance}" />
        <TextBlock Classes="muted"
                   FontSize="10"
                   Text="{Binding Route.ProgressSummary}" />
      </StackPanel>

      <Border Grid.Row="2"
              Classes="card raised"
              Padding="11"
              IsVisible="{Binding Route.HasNextHopGuidance}">
        <TextBlock Text="{Binding Route.NextHopGuidance}"
                   TextWrapping="Wrap" />
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                   FontSize="10"
                   FontWeight="Bold"
                   Text="{Binding Route.NextHopDestinationStatus}" />
        <TextBlock Grid.Column="1"
                   Foreground="{DynamicResource RavenSuccessBrush}"
                   FontSize="10"
                   FontWeight="Bold"
                   Text="{Binding Route.NextHopClipboardStatus}" />
      </Grid>
    </Grid>
  </Border>
</Window>
