<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.StationInfoOverlayWindow"
        x:DataType="vm:StationInfoOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="220"
        d:DesignHeight="560"
        MinWidth="1"
        MaxWidth="220"
        MinHeight="180"
        MaxHeight="720"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey station information overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:StationInfoOverlayPresentation />
  </Border>
</Window>
