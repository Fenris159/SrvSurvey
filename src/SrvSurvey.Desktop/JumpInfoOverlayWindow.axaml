<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SrvSurvey.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SrvSurvey.Desktop.Controls"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.JumpInfoOverlayWindow"
        x:DataType="vm:JumpInfoOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="600"
        d:DesignHeight="390"
        MinWidth="600"
        MinHeight="166"
        MaxHeight="580"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey next-jump overlay">
  <Border Background="Transparent"
          BorderThickness="0">
    <local:JumpInfoOverlayPresentation />
  </Border>
</Window>
