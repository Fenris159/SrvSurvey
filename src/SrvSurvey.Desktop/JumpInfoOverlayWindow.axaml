<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:SrvSurvey.Desktop.Controls"
        xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
        x:Class="SrvSurvey.Desktop.JumpInfoOverlayWindow"
        x:DataType="vm:JumpInfoOverlayViewModel"
        mc:Ignorable="d"
        d:DesignWidth="620"
        d:DesignHeight="390"
        Width="620"
        MinHeight="166"
        MaxHeight="580"
        SizeToContent="Height"
        CanResize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        Title="SrvSurvey next-jump overlay">
  <Border Margin="8"
          Padding="18"
          Background="{DynamicResource RavenWindowBrush}"
          BorderBrush="{DynamicResource RavenBorderBrush}"
          BorderThickness="1"
          CornerRadius="12"
          Opacity="0.97">
    <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Classes="eyebrow" Text="NEXT JUMP" />
          <TextBlock Classes="muted"
                     FontSize="11"
                     Text="Route and destination intelligence" />
        </StackPanel>
        <Border Grid.Column="1"
                Classes="badge"
                VerticalAlignment="Top">
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Text="{Binding InputMode}" />
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="badge" IsVisible="{Binding JumpInfo.IsQuestTagged}">
            <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                       FontSize="9"
                       FontWeight="Bold"
                       Text="Q" />
          </Border>
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="27"
                     FontWeight="SemiBold"
                     Text="{Binding TargetName}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Classes="monospace"
                   Foreground="{DynamicResource RavenWarningBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Text="{Binding JumpInfo.StarClass}" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <TextBlock Classes="monospace"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Text="{Binding JumpInfo.JumpProgress}" />
        <controls:JumpRouteProgressControl Grid.Column="1"
                                           Height="34"
                                           MinWidth="220"
                                           VerticalAlignment="Center"
                                           Legs="{Binding JumpInfo.RouteLegs}"
                                           TargetLegIndex="{Binding JumpInfo.TargetLegIndex}"
                                           AheadBrush="{DynamicResource RavenAccentBrush}"
                                           BehindBrush="{DynamicResource RavenMutedTextBrush}"
                                           TargetBrush="{DynamicResource RavenSuccessBrush}"
                                           BoostBrush="{DynamicResource RavenWarningBrush}"
                                           BackgroundLineBrush="{DynamicResource RavenBorderBrush}" />
        <TextBlock Grid.Column="2"
                   Classes="monospace"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Text="{Binding JumpInfo.TotalDistance}" />
      </Grid>

      <StackPanel IsVisible="{Binding JumpInfo.ShowDetails}" Spacing="8">
        <Border Height="1"
                Background="{DynamicResource RavenBorderBrush}" />
        <TextBlock IsVisible="{Binding JumpInfo.HasDiscoveryText}"
                   Text="{Binding JumpInfo.DiscoveryText}"
                   TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding JumpInfo.HasTraffic}"
                   Text="{Binding JumpInfo.TrafficText}"
                   TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding JumpInfo.HasPointsOfInterest}"
                   Text="{Binding JumpInfo.PointsOfInterestText}"
                   TextWrapping="Wrap" />
        <ItemsControl IsVisible="{Binding JumpInfo.HasDetailLines}"
                      ItemsSource="{Binding JumpInfo.DetailLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JumpInfoDetailLineViewModel">
              <Grid Margin="0,2" ColumnDefinitions="Auto,*" ColumnSpacing="7">
                <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                           FontWeight="SemiBold"
                           Text="{Binding Label, StringFormat={}{0}:}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted"
                   FontSize="10"
                   IsVisible="{Binding JumpInfo.HasDataStatus}"
                   Text="{Binding JumpInfo.DataStatus}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
