<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:mining="using:SrvSurvey.Core.Mining"
 x:Class="SrvSurvey.Desktop.MiningSessionOverlayPresentation"
 x:DataType="vm:MiningSessionOverlayViewModel" Width="340">
 <Border Padding="8" Background="{DynamicResource RavenWindowBrush}" CornerRadius="5">
  <StackPanel Spacing="6">
   <Grid ColumnDefinitions="*,Auto">
    <TextBlock Classes="overlay-header type-header" Text="SESSION" />
    <TextBlock Grid.Column="1" Classes="type-caption" Foreground="{DynamicResource RavenWarningBrush}" Text="{Binding State}" />
   </Grid>
   <TextBlock Classes="type-title" Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding Location}" TextWrapping="Wrap" />
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
    <TextBlock Classes="type-value" Text="{Binding Yield}" />
    <TextBlock Grid.Column="1" Classes="type-value" Text="{Binding Duration}" />
   </Grid>
   <TextBlock Classes="type-body" Text="{Binding Activity}" />
   <TextBlock Classes="type-detail" Text="{Binding Limpets}" />
   <TextBlock Classes="type-header" Text="Prospecting yields" />
   <TextBlock Classes="type-detail muted" Text="No prospecting data yet." IsVisible="{Binding !HasProspectingYields}" TextWrapping="Wrap" />
   <StackPanel Spacing="4" IsVisible="{Binding HasProspectingYields}" Grid.IsSharedSizeScope="True">
    <Grid ColumnSpacing="10">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" SharedSizeGroup="SessionFinds" />
      <ColumnDefinition Width="Auto" SharedSizeGroup="SessionQuality" />
     </Grid.ColumnDefinitions>
     <TextBlock Classes="type-caption muted" Text="Mineral" />
     <TextBlock Grid.Column="1" Classes="type-caption muted" Text="Finds" />
     <TextBlock Grid.Column="2" Classes="type-caption muted" Text="Quality hits" />
    </Grid>
    <ItemsControl ItemsSource="{Binding ProspectingYields}">
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="mining:MiningMaterialSummary">
       <Grid RowDefinitions="Auto,Auto" ColumnSpacing="10" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" SharedSizeGroup="SessionFinds" />
         <ColumnDefinition Width="Auto" SharedSizeGroup="SessionQuality" />
        </Grid.ColumnDefinitions>
        <TextBlock Classes="type-body" Foreground="{DynamicResource RavenSuccessBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Classes="type-detail" Text="{Binding Finds}" />
        <TextBlock Grid.Column="2" Classes="type-detail" Text="{Binding QualityHits}" />
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3">
         <TextBlock Classes="type-detail muted" Text="Average" Margin="0,0,5,0" />
         <TextBlock Classes="type-detail" Text="{Binding Average, StringFormat={}{0:0.0}%}" Margin="0,0,12,0" />
         <TextBlock Classes="type-detail muted" Text="Best" Margin="0,0,5,0" />
         <TextBlock Classes="type-detail" Text="{Binding Best, StringFormat={}{0:0.0}%}" />
        </WrapPanel>
       </Grid>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
   <TextBlock Classes="type-caption" Text="{Binding Notes}" IsVisible="{Binding HasNotes}" TextWrapping="Wrap" />
  </StackPanel>
 </Border>
</UserControl>
