<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.PriorScansOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:PriorScansOverlayViewModel"
             mc:Ignorable="d"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="5">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <StackPanel Spacing="3">
          <TextBlock Classes="overlay-header type-header" Text="CANONN PRIOR SCANS" />
          <TextBlock FontSize="14" Classes="type-title" Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold"
                     Text="{Binding BodyName}"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontSize="10" Classes="monospace type-detail"
                       Text="{Binding HeadingText}" />
            <TextBlock FontSize="10" Classes="muted type-detail"
                       Text="{Binding SpeciesCountText}" />
          </StackPanel>
        </StackPanel>
        <LayoutTransformControl Grid.Column="1" Classes="type-icon" VerticalAlignment="Top">
          <Border Classes="badge overlay-state-pill">
            <TextBlock FontSize="9" Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding InputMode}" />
          </Border>
        </LayoutTransformControl>
      </Grid>

      <Border Grid.Row="1"
              Classes="overlay-divider"
              Background="{DynamicResource RavenBorderBrush}" />

      <Border Grid.Row="2"
              ClipToBounds="True"
              CornerRadius="4"
              IsVisible="{Binding ShowRadar}">
        <controls:PriorScanRadarControl
            Height="180"
            ClipToBounds="True"
            Targets="{Binding RadarTargets}"
            UseSmallCircles="{Binding UseSmallRadarCircles}"
            BackgroundBrush="{DynamicResource RavenRaisedSurfaceBrush}"
            GridBrush="{DynamicResource RavenBorderBrush}"
            AccentBrush="{DynamicResource RavenAccentBrush}"
            MutedBrush="{DynamicResource RavenMutedTextBrush}"
            CloseBrush="{DynamicResource RavenSuccessBrush}" />
      </Border>

      <ScrollViewer x:Name="PriorScansScroller"
                    Grid.Row="3"
                    MaxHeight="200"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Species}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PriorScanSpeciesViewModel">
              <Border Margin="0,0,0,7"
                      Padding="10"
                      Background="{DynamicResource RavenSurfaceBrush}"
                      BorderBrush="{DynamicResource RavenBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Opacity="{Binding RowOpacity}">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Classes="type-body" FontWeight="SemiBold"
                                 Text="{Binding DisplayName}"
                                 TextTrimming="CharacterEllipsis" />
                      <LayoutTransformControl Classes="type-icon" IsVisible="{Binding IsActive}">
                        <Border Classes="badge overlay-state-pill" Height="24" Padding="0">
                          <TextBlock FontSize="8" Foreground="{DynamicResource RavenAccentBrush}"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     Text="ACTIVE" />
                        </Border>
                      </LayoutTransformControl>
                      <LayoutTransformControl Classes="type-icon" IsVisible="{Binding IsAnalyzed}">
                        <Border Classes="badge overlay-state-pill" Height="24" Padding="0">
                          <TextBlock FontSize="8" Foreground="{DynamicResource RavenSuccessBrush}"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Center"
                                     Text="ANALYZED" />
                        </Border>
                      </LayoutTransformControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                Spacing="2">
                      <TextBlock FontSize="10" Classes="monospace type-value"
                                 Foreground="{DynamicResource RavenAccentBrush}"
                                 FontWeight="SemiBold"
                                 Text="{Binding RewardText}" />
                      <TextBlock FontSize="9" Classes="monospace type-detail"
                                 Foreground="{DynamicResource RavenWarningBrush}"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasShallowApproach}"
                                 Text="{Binding ApproachText}" />
                      <TextBlock FontSize="9" Classes="monospace type-detail"
                                 Foreground="{DynamicResource RavenAccentBrush}"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasIdealApproach}"
                                 Text="{Binding ApproachText}" />
                      <TextBlock FontSize="9" Classes="monospace type-detail"
                                 Foreground="{DynamicResource RavenDangerBrush}"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasSteepApproach}"
                                 Text="{Binding ApproachText}" />
                      <TextBlock FontSize="9" Classes="monospace type-detail"
                                 Foreground="{DynamicResource RavenMutedTextBrush}"
                                 HorizontalAlignment="Right"
                                 IsVisible="{Binding HasTooSteepApproach}"
                                 Text="{Binding ApproachText}" />
                    </StackPanel>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PriorScanTargetViewModel">
                        <Border Margin="0,0,6,5"
                                Padding="7,4"
                                Background="{DynamicResource RavenRaisedSurfaceBrush}"
                                BorderBrush="{DynamicResource RavenBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <LayoutTransformControl Classes="type-icon">
                              <controls:DirectionalChevronControl
                                  Width="16"
                                  Height="16"
                                  BearingDegrees="{Binding RelativeBearingDegrees}"
                                  IsFar="{Binding IsFar}"
                                  Stroke="{DynamicResource RavenAccentBrush}"
                                  StrokeThickness="1.8" />
                            </LayoutTransformControl>
                            <TextBlock FontSize="10" Classes="monospace type-value"
                                       Text="{Binding BearingText}" />
                            <TextBlock FontSize="10" Classes="monospace type-value"
                                       Text="{Binding DistanceText}" />
                            <TextBlock FontSize="8" Classes="type-caption" Foreground="{DynamicResource RavenSuccessBrush}"
                                       FontWeight="Bold"
                                       IsVisible="{Binding IsClose}"
                                       Text="NEAR" />
                            <TextBlock FontSize="8" Classes="type-caption" Foreground="{DynamicResource RavenWarningBrush}"
                                       FontWeight="Bold"
                                       IsVisible="{Binding IsFar}"
                                       Text="DISTANT" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="5">
        <StackPanel Spacing="2">
          <TextBlock FontSize="9" Classes="muted type-detail"
                     Text="{Binding FilterText}" />
          <TextBlock FontSize="9" Classes="muted type-detail"
                     Text="{Binding StatusText}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock FontSize="9" Grid.Column="1"
                   Classes="monospace type-detail"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   IsVisible="{Binding IsLoading}"
                   Text="SYNC" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
