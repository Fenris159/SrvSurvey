<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.MiniTrackOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SurfaceSurveyOverlayViewModel"
             mc:Ignorable="d"
             MaxWidth="360"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <ItemsControl ItemsSource="{Binding SurfaceSurvey.QuickTrackerGroups}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SurfaceTrackerGroupViewModel">
          <ItemsControl Margin="2"
                        ItemsSource="{Binding Targets}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SurfaceRadarMarkerViewModel">
                <Border Margin="2"
                        Padding="7,5"
                        MinWidth="48"
                        Background="{DynamicResource RavenSurfaceBrush}"
                        CornerRadius="7">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="{Binding Name}" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               FontSize="15"
                               Text="&#x25B2;">
                      <TextBlock.RenderTransform>
                        <RotateTransform Angle="{Binding RelativeBearingDegrees}" />
                      </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center"
                               Classes="monospace"
                               FontSize="9"
                               Text="{Binding DistanceText}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>
