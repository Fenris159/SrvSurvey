<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.BiologyStatusOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             Width="260"
             ClipToBounds="True">
  <!-- Compact PlotBioStatus: progress and sample metadata stay grouped around
       the circles/range scale instead of reserving a legacy 480px row. -->
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="0">
    <!-- BiologyStatus is intentionally nullable while the current body or
         overlay state changes. Keep the nullable hop outside the template so
         descendants are not instantiated against a missing status object. -->
    <ContentControl IsVisible="{Binding Survey.HasBiologyStatus}"
                    Content="{Binding Survey.BiologyStatus}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:BiologyStatusViewModel">
          <Grid RowDefinitions="Auto,*,Auto"
                MinHeight="68">
      <Grid ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="7"
            ClipToBounds="True">
        <TextBlock Classes="eyebrow"
                   Foreground="{DynamicResource RavenWarningBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Text="{Binding ProgressText}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1"
                   Classes="muted"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Text="{Binding CompletionPercentText}" />
        <ProgressBar Grid.Column="2"
                     MinWidth="0"
                     Height="8"
                     Margin="0,0,1,0"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding CompletionPercent}" />
      </Grid>

      <Grid Grid.Row="1"
            Margin="0,6,0,4"
            RowDefinitions="Auto,Auto,Auto">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Classes="muted"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   IsVisible="{Binding RequiresDss}"
                   Text="DSS required" />

        <Grid Grid.Row="1"
              IsVisible="{Binding HasActiveSample}"
              ColumnDefinitions="92,*"
              ColumnSpacing="6"
              MinHeight="40">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Spacing="6">
            <!-- Stage 1: always filled once an active sample exists -->
            <Grid Width="24" Height="24">
              <Ellipse Stroke="{DynamicResource RavenWarningBrush}"
                       StrokeThickness="2"
                       Fill="{DynamicResource RavenPrimaryDimBrush}" />
            </Grid>
            <!-- Stage 2: filled after the second sample -->
            <Grid Width="24" Height="24">
              <Ellipse Stroke="{DynamicResource RavenWarningBrush}"
                       StrokeThickness="2"
                       Fill="{DynamicResource RavenPrimaryDimBrush}"
                       IsVisible="{Binding ActiveSampleDisplay.IsSecondSampleComplete}" />
              <Ellipse Stroke="{DynamicResource RavenWarningBrush}"
                       StrokeThickness="2"
                       IsVisible="{Binding !ActiveSampleDisplay.IsSecondSampleComplete}" />
            </Grid>
            <!-- Stage 3: always empty outline -->
            <Grid Width="24" Height="24">
              <Ellipse Stroke="{DynamicResource RavenWarningBrush}"
                       StrokeThickness="2" />
            </Grid>
          </StackPanel>

          <Grid Grid.Column="1"
                RowDefinitions="Auto,Auto">
            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="{Binding ActiveSampleDisplay.DisplayName}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="40" />
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
              <Border Height="2"
                      Width="{Binding ActiveSampleDisplay.SampleScaleBarWidth}"
                      VerticalAlignment="Center"
                      Background="{DynamicResource RavenAccentBrush}" />
              <TextBlock Classes="muted"
                         Foreground="{DynamicResource RavenAccentBrush}"
                         FontSize="10"
                         Text="{Binding ActiveSampleDisplay.SampleScaleLabel}" />
            </StackPanel>
          </Grid>
        </Grid>

        <ItemsControl Grid.Row="2"
                      IsVisible="{Binding ShowSignalSummary}"
                      Margin="16,2,8,0"
                      ItemsSource="{Binding Signals}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BiologyStatusSignalViewModel">
              <Grid Margin="0,0,8,2"
                    Opacity="{Binding RowOpacity}">
                <TextBlock Classes="muted"
                           Foreground="{DynamicResource RavenAccentBrush}"
                           FontSize="10"
                           IsVisible="{Binding !IsAnalyzed}"
                           Text="{Binding DisplayText}" />
                <TextBlock Classes="muted"
                           Foreground="{DynamicResource RavenWarningBrush}"
                           FontSize="10"
                           IsVisible="{Binding IsAnalyzed}"
                           Text="{Binding DisplayText}"
                           TextDecorations="Strikethrough" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <Grid Grid.Row="2" MinHeight="18">
        <Grid ColumnDefinitions="*,4*,*"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              IsVisible="{Binding IsStaleActiveSample}">
          <Border Grid.Column="0"
                  Height="10"
                  Margin="0,0,6,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  Background="{DynamicResource RavenDangerBrush}"
                  Opacity="0.9" />
          <TextBlock Grid.Column="1"
                     Classes="muted"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource RavenDangerBrush}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Text="{Binding Warning}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <Border Grid.Column="2"
                  Height="10"
                  Margin="6,0,0,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  Background="{DynamicResource RavenDangerBrush}"
                  Opacity="0.9" />
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    IsVisible="{Binding !IsStaleActiveSample}">
          <TextBlock Classes="muted"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="10"
                     Text="{Binding Footer}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     FontSize="10"
                     IsVisible="{Binding ActiveSampleDisplay.HasReward}"
                     Text="{Binding ActiveSampleDisplay.RewardText}" />
          <Panel Width="28"
                 Height="28"
                 IsVisible="{Binding ShowCodexImageIndicator}">
            <Border Width="22"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource RavenAccentBrush}"
                    BorderThickness="1.5"
                    CornerRadius="2"
                    Background="Transparent" />
            <Border Width="10"
                    Height="10"
                    Margin="0,0,0,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{DynamicResource RavenAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="5" />
            <Path IsVisible="{Binding !HasCodexImage}"
                  Stroke="{DynamicResource RavenDangerBrush}"
                  StrokeThickness="2"
                  Data="M 4,4 L 24,24 M 24,4 L 4,24"
                  Width="28"
                  Height="28"
                  Stretch="None" />
          </Panel>
        </StackPanel>
      </Grid>
          </Grid>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Border>
</UserControl>
