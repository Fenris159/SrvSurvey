<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SrvSurvey.Desktop.BodyInformationOverlayPresentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:DataType="vm:SystemSurveyOverlayViewModel"
             mc:Ignorable="d"
             MaxWidth="260"
             HorizontalAlignment="Left"
             ClipToBounds="True">
  <Border Margin="0"
          Padding="4"
          Background="{DynamicResource RavenWindowBrush}"
          BorderThickness="0"
          CornerRadius="5">
    <StackPanel IsVisible="{Binding Survey.HasBodyInformation}"
                Spacing="5">
      <Grid RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,Auto"
            ColumnSpacing="6"
            RowSpacing="3"
            HorizontalAlignment="Left">
        <TextBlock Classes="eyebrow" Text="BODY INFORMATION" />
        <Border Grid.Column="1"
                Classes="badge overlay-state-pill"
                Padding="7,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
          <TextBlock Classes="overlay-caption"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     FontWeight="SemiBold"
                     LineHeight="12"
                     Text="{Binding InputMode}" />
        </Border>
        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Classes="overlay-title"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   Text="{Binding Survey.BodyInformationDisplay.Name}"
                   TextTrimming="CharacterEllipsis" />
      </Grid>

      <WrapPanel Orientation="Horizontal">
        <TextBlock Margin="0,0,6,0"
                   Classes="muted overlay-detail"
                   Text="{Binding Survey.BodyInformationDisplay.BodyClass}"
                   TextWrapping="Wrap" />
        <TextBlock Classes="overlay-detail"
                   Text="{Binding Survey.BodyInformationDisplay.Distance}" />
      </WrapPanel>

      <Border Padding="11"
              Background="{DynamicResource RavenAccentMutedBrush}"
              CornerRadius="8"
              IsVisible="{Binding Survey.BodyInformationDisplay.IsScanRequired}">
        <TextBlock Classes="overlay-body"
                   Foreground="{DynamicResource RavenAccentBrush}"
                   FontWeight="SemiBold"
                   Text="Detailed scan required" />
      </Border>

      <StackPanel IsVisible="{Binding !Survey.BodyInformationDisplay.IsScanRequired}"
                  Spacing="5">
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   Classes="overlay-caption"
                   FontWeight="SemiBold"
                   IsVisible="{Binding Survey.BodyInformationDisplay.HasMarkers}"
                   Text="{Binding Survey.BodyInformationDisplay.Markers}" />

        <Grid ColumnDefinitions="Auto,Auto"
              ColumnSpacing="5"
              HorizontalAlignment="Left">
          <Border Padding="8,6"
                  Background="{DynamicResource RavenSurfaceBrush}"
                  CornerRadius="8">
            <StackPanel Spacing="2">
              <TextBlock Classes="eyebrow overlay-caption" Text="SCAN VALUE" />
              <TextBlock Classes="monospace overlay-value"
                         IsVisible="{Binding !Survey.BodyInformationDisplay.IsHighValue}"
                         Text="{Binding Survey.BodyInformationDisplay.ScanValue}" />
              <TextBlock Classes="monospace overlay-value"
                         Foreground="{DynamicResource RavenAccentBrush}"
                         IsVisible="{Binding Survey.BodyInformationDisplay.IsHighValue}"
                         Text="{Binding Survey.BodyInformationDisplay.ScanValue}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1"
                  Padding="8,6"
                  Background="{DynamicResource RavenAccentMutedBrush}"
                  CornerRadius="8"
                  IsVisible="{Binding Survey.BodyInformationDisplay.HasMappedValue}">
            <StackPanel Spacing="2">
              <TextBlock Classes="eyebrow overlay-caption" Text="WITH SURFACE SCAN" />
              <TextBlock Classes="monospace overlay-value"
                         Foreground="{DynamicResource RavenAccentBrush}"
                         Text="{Binding Survey.BodyInformationDisplay.MappedValue}" />
            </StackPanel>
          </Border>
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,Auto"
              ColumnSpacing="12"
              HorizontalAlignment="Left">
          <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow overlay-caption" Text="TEMPERATURE" />
            <TextBlock Classes="monospace overlay-body"
                       Text="{Binding Survey.BodyInformationDisplay.Temperature}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      IsVisible="{Binding Survey.BodyInformationDisplay.IsPlanet}"
                      Spacing="2">
            <TextBlock Classes="eyebrow overlay-caption" Text="GRAVITY" />
            <TextBlock Classes="monospace overlay-body"
                       IsVisible="{Binding !Survey.BodyInformationDisplay.IsHighGravity}"
                       Text="{Binding Survey.BodyInformationDisplay.Gravity}" />
            <TextBlock Classes="monospace overlay-body"
                       Foreground="{DynamicResource RavenDangerBrush}"
                       FontWeight="Bold"
                       IsVisible="{Binding Survey.BodyInformationDisplay.IsHighGravity}"
                       Text="{Binding Survey.BodyInformationDisplay.Gravity}" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      IsVisible="{Binding Survey.BodyInformationDisplay.IsPlanet}"
                      Spacing="2">
            <TextBlock Classes="eyebrow overlay-caption" Text="PRESSURE" />
            <TextBlock Classes="monospace overlay-body"
                       Text="{Binding Survey.BodyInformationDisplay.Pressure}" />
          </StackPanel>
        </Grid>

        <WrapPanel Orientation="Horizontal">
          <StackPanel Margin="0,0,14,0"
                      IsVisible="{Binding Survey.BodyInformationDisplay.HasBiologicalSignals}"
                      Spacing="2">
            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                       Classes="overlay-detail"
                       FontWeight="SemiBold"
                       Text="{Binding Survey.BodyInformationDisplay.BiologicalSignals}" />
            <TextBlock Classes="overlay-caption"
                       IsVisible="{Binding Survey.BodyInformationDisplay.HasBiologicalReward}"
                       Text="{Binding Survey.BodyInformationDisplay.BiologicalReward}" />
          </StackPanel>
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     Classes="overlay-detail"
                     FontWeight="SemiBold"
                     IsVisible="{Binding Survey.BodyInformationDisplay.HasGeologicalSignals}"
                     Text="{Binding Survey.BodyInformationDisplay.GeologicalSignals}" />
        </WrapPanel>

        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="72,*"
              RowSpacing="4">
          <TextBlock Classes="muted overlay-detail"
                     IsVisible="{Binding Survey.BodyInformationDisplay.HasVolcanism}"
                     Text="VOLCANISM" />
          <TextBlock Grid.Column="1"
                     Classes="overlay-detail"
                     IsVisible="{Binding Survey.BodyInformationDisplay.HasVolcanism}"
                     Text="{Binding Survey.BodyInformationDisplay.Volcanism}"
                     TextWrapping="Wrap" />
          <TextBlock Grid.Row="1"
                     Classes="muted overlay-detail"
                     IsVisible="{Binding Survey.BodyInformationDisplay.IsPlanet}"
                     Text="ATMOSPHERE" />
          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     Classes="overlay-detail"
                     IsVisible="{Binding Survey.BodyInformationDisplay.IsPlanet}"
                     Text="{Binding Survey.BodyInformationDisplay.Atmosphere}"
                     TextWrapping="Wrap" />
        </Grid>

        <StackPanel IsVisible="{Binding Survey.BodyInformationDisplay.HasAtmosphereComposition}"
                    Spacing="5">
          <TextBlock Classes="eyebrow overlay-caption"
                     Text="ATMOSPHERE COMPOSITION" />
          <ItemsControl MaxWidth="210"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Survey.BodyInformationDisplay.AtmosphereComposition}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BodyCompositionRowViewModel">
                <Grid Margin="0,0,10,3"
                      ColumnDefinitions="Auto,Auto"
                      ColumnSpacing="5">
                  <TextBlock Classes="muted overlay-caption"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Classes="overlay-caption"
                             Text="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding Survey.BodyInformationDisplay.HasMaterials}"
                    Spacing="5">
          <TextBlock Classes="eyebrow overlay-caption" Text="MATERIALS" />
          <ItemsControl MaxWidth="210"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Survey.BodyInformationDisplay.Materials}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BodyCompositionRowViewModel">
                <Border Margin="0,0,6,4"
                        Padding="7,4"
                        Background="{DynamicResource RavenSurfaceBrush}"
                        CornerRadius="6">
                  <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="5">
                    <TextBlock Classes="muted overlay-caption"
                               IsVisible="{Binding !IsRare}"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                               Classes="overlay-caption"
                               FontWeight="SemiBold"
                               IsVisible="{Binding IsRare}"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Classes="overlay-caption"
                               FontWeight="SemiBold"
                               Text="{Binding Value}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding Survey.BodyInformationDisplay.HasRings}"
                    Spacing="5">
          <TextBlock Classes="eyebrow overlay-caption" Text="RINGS" />
          <ItemsControl ItemsSource="{Binding Survey.BodyInformationDisplay.Rings}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BodyRingRowViewModel">
                <Border Margin="0,0,7,3"
                        Padding="7,3"
                        Background="{DynamicResource RavenAccentMutedBrush}"
                        CornerRadius="999">
                  <TextBlock Classes="overlay-caption"
                             Text="{Binding DisplayText}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
