<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             x:Class="SrvSurvey.Desktop.Views.GuidesView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Resources>
                <DataTemplate x:Key="GuideIconTemplate" x:DataType="vm:GuideIconViewModel">
                  <Border Classes="card" Margin="0,0,0,14" Padding="14">
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="14">
                      <Grid Width="72"
                            Height="72"
                            VerticalAlignment="Top">
                        <controls:GuideIconPreviewControl IsVisible="{Binding !HasAsset}"
                                                          Kind="{Binding Kind}"
                                                          Symbol="{Binding Symbol}"
                                                          BackgroundBrush="{DynamicResource RavenOverlayWindowBrush}"
                                                          PrimaryBrush="{DynamicResource RavenOverlayPrimaryBrush}"
                                                          SecondaryBrush="{DynamicResource RavenOverlaySecondaryBrush}"
                                                          MutedBrush="{DynamicResource RavenOverlayMutedTextBrush}"
                                                          SuccessBrush="{DynamicResource RavenOverlaySuccessBrush}"
                                                          WarningBrush="{DynamicResource RavenOverlayWarningBrush}"
                                                          DangerBrush="{DynamicResource RavenOverlayDangerBrush}"
                                                          GoldBrush="{DynamicResource RavenOverlayBioGoldBrush}"
                                                          PipConfirmedBrush="{DynamicResource RavenOverlayBioConfirmedBrush}"
                                                          PipConfirmedDimBrush="{DynamicResource RavenOverlayBioConfirmedDimBrush}"
                                                          PipPotentialBrush="{DynamicResource RavenOverlayBioPotentialBrush}"
                                                          PipConfirmedDimPotentialBrush="{DynamicResource RavenOverlayBioConfirmedDimPotentialBrush}"
                                                          PipPredictionBrush="{DynamicResource RavenOverlayBioPredictionBrush}"
                                                          PipPredictionPotentialBrush="{DynamicResource RavenOverlayBioPredictionPotentialBrush}"
                                                          PipHighlightBrush="{DynamicResource RavenOverlayBioGoldFillBrush}"
                                                          PipHighlightPotentialBrush="{DynamicResource RavenOverlayBioGoldPotentialBrush}"
                                                          PipGlobalRegionalBrush="{DynamicResource RavenOverlayBioGalacticRegionBrush}"
                                                          PipGlobalRegionalPotentialBrush="{DynamicResource RavenOverlayBioGalacticRegionPotentialBrush}"
                                                          PipUnknownBrush="{DynamicResource RavenOverlayBioUnknownBrush}"
                                                          PipUnknownGlyphBrush="{DynamicResource RavenOverlayBioUnknownGlyphBrush}"
                                                          PipHatchBrush="{DynamicResource RavenOverlayBioHatchBrush}"
                                                          PipEmptyBrush="{DynamicResource RavenOverlayBioEmptyBrush}"
                                                          PipConfirmedEdgeBrush="{DynamicResource RavenOverlayBioConfirmedEdgeBrush}"
                                                          PipConfirmedDimEdgeBrush="{DynamicResource RavenOverlayBioConfirmedDimEdgeBrush}"
                                                          PipPredictionEdgeBrush="{DynamicResource RavenOverlayBioPredictionEdgeBrush}"
                                                          PipHighlightEdgeBrush="{DynamicResource RavenOverlayBioGoldEdgeBrush}"
                                                          PipGlobalRegionalEdgeBrush="{DynamicResource RavenOverlayBioGalacticRegionEdgeBrush}"
                                                          PipUnknownEdgeBrush="{DynamicResource RavenOverlayBioUnknownEdgeBrush}"
                                                          PipConfirmedSegmentEdgeBrush="{DynamicResource RavenOverlayBioConfirmedSegmentEdgeBrush}"
                                                          PipConfirmedPotentialSegmentEdgeBrush="{DynamicResource RavenOverlayBioConfirmedPotentialSegmentEdgeBrush}"
                                                          PipConfirmedDimSegmentEdgeBrush="{DynamicResource RavenOverlayBioConfirmedDimSegmentEdgeBrush}"
                                                          PipConfirmedDimPotentialSegmentEdgeBrush="{DynamicResource RavenOverlayBioConfirmedDimPotentialSegmentEdgeBrush}"
                                                          PipPredictionSegmentEdgeBrush="{DynamicResource RavenOverlayBioPredictionSegmentEdgeBrush}"
                                                          PipPredictionPotentialSegmentEdgeBrush="{DynamicResource RavenOverlayBioPredictionPotentialSegmentEdgeBrush}"
                                                          PipHighlightSegmentEdgeBrush="{DynamicResource RavenOverlayBioGoldSegmentEdgeBrush}"
                                                          PipHighlightPotentialSegmentEdgeBrush="{DynamicResource RavenOverlayBioGoldPotentialSegmentEdgeBrush}"
                                                          PipGlobalRegionalSegmentEdgeBrush="{DynamicResource RavenOverlayBioGalacticRegionSegmentEdgeBrush}"
                                                          PipGlobalRegionalPotentialSegmentEdgeBrush="{DynamicResource RavenOverlayBioGalacticRegionPotentialSegmentEdgeBrush}" />
                        <Border IsVisible="{Binding HasAsset}"
                                Background="{DynamicResource RavenOverlayWindowBrush}"
                                BorderBrush="{DynamicResource RavenOverlayMutedTextBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                          <Image Margin="8"
                                 Source="{Binding AssetPath, Converter={StaticResource BundledAssetImageConverter}}"
                                 Stretch="Uniform" />
                        </Border>
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding Name}" />
                        <TextBlock Classes="muted"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="{Binding Meaning}" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource RavenAccentBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding AppearsIn, StringFormat=Appears in: {0}}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <StackPanel Spacing="4">
      <TextBlock Classes="eyebrow" Text="FIELD MANUAL" />
      <TextBlock Classes="page-title" Text="Guides" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Expand a category and choose a subject, or search for a feature, setting, command, or symbol." />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBox x:Name="GuideSearch" Classes="guide-search"
               PlaceholderText="Search all guides"
               Text="{Binding Guides.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Button Grid.Column="1" Classes="secondary" Content="Clear search"
              IsVisible="{Binding Guides.IsSearching}" Command="{Binding Guides.ClearSearchCommand}" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="270,*" ColumnSpacing="20">
      <Border Classes="card" Padding="8">
        <ScrollViewer x:Name="GuideNavigationScroller" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Guides.Navigation}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GuideNavigationCategoryViewModel">
                <Expander Classes="guide-category" HorizontalAlignment="Stretch"
                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                  </Expander.Header>
                  <ItemsControl Margin="8,4,0,8" ItemsSource="{Binding Topics}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GuideTopicViewModel">
                        <Button Classes="guide-topic" Classes.selected="{Binding IsSelected}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding OpenCommand}">
                          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <ScrollViewer x:Name="GuideReader" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="16">
          <StackPanel x:Name="TopicReader" IsVisible="{Binding Guides.IsBrowsing}" Spacing="18">
            <Border Classes="card raised">
              <StackPanel Spacing="8">
                <TextBlock Classes="eyebrow" TextWrapping="Wrap" Text="{Binding Guides.SelectedTopic.Category.Title}" />
                <TextBlock FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Guides.SelectedTopic.Title}" />
                <SelectableTextBlock IsVisible="{Binding Guides.SelectedTopic.HasInstructions}" FontSize="14" TextWrapping="Wrap" Text="{Binding Guides.SelectedTopic.Summary}" />
              </StackPanel>
            </Border>
            <Border Classes="card" IsVisible="{Binding Guides.SelectedTopic.HasSteps}">
              <StackPanel Spacing="12">
                <TextBlock Classes="card-title" Text="What to do" />
                <ItemsControl ItemsSource="{Binding Guides.SelectedTopic.Steps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GuideStepViewModel">
                      <Grid ColumnDefinitions="28,*" ColumnSpacing="10" Margin="0,0,0,14">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding Number}" />
                        <SelectableTextBlock Grid.Column="1" FontSize="14" TextWrapping="Wrap" Text="{Binding Text}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <ItemsControl IsVisible="{Binding Guides.SelectedTopic.HasIllustrations}"
                          ItemsSource="{Binding Guides.SelectedTopic.Illustrations}"
                          ItemTemplate="{StaticResource GuideIconTemplate}" />
            <Border Classes="card" IsVisible="{Binding Guides.SelectedTopic.HasDetails}">
              <StackPanel Spacing="12">
                <TextBlock Classes="card-title" Text="Good to know" />
                <ItemsControl ItemsSource="{Binding Guides.SelectedTopic.Details}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <SelectableTextBlock Margin="0,0,0,12" FontSize="14" TextWrapping="Wrap" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="GuideSearchResults" IsVisible="{Binding Guides.IsSearching}" Spacing="14">
            <TextBlock Classes="eyebrow" Text="SEARCH RESULTS" />
            <TextBlock Classes="card-title" Text="{Binding Guides.SearchSummary}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Select a result to open the complete guide." />
            <ItemsControl IsVisible="{Binding Guides.HasSearchResults}" ItemsSource="{Binding Guides.SearchResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GuideSearchResultViewModel">
                  <Button Classes="guide-result" Margin="0,0,0,12" Padding="18"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Command="{Binding OpenCommand}">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="eyebrow" TextWrapping="Wrap" Text="{Binding Category}" />
                      <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Summary}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="card" IsVisible="{Binding Guides.HasNoSearchResults}">
              <TextBlock TextWrapping="Wrap" Text="No matching subjects. Try a feature name, a setting label, or a chat command. You can also browse the categories on the left." />
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
