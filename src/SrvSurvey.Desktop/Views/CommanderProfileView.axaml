<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:SrvSurvey.Desktop.Views"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.CommanderProfileView"
             x:DataType="vm:CommanderProfileViewModel"
             Classes="commander-console" SizeChanged="Console_SizeChanged">
  <Grid>
    <ScrollViewer IsVisible="{Binding IsUnlinked}" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="24" MinHeight="480" MaxWidth="660" HorizontalAlignment="Left">
        <Border BorderBrush="{DynamicResource RavenAccentBrush}" BorderThickness="3,0,0,0"
                Padding="24,8,0,8" VerticalAlignment="Center">
          <StackPanel Spacing="20">
            <StackPanel Spacing="8">
              <TextBlock Classes="console-identity" Text="Commander" />
              <TextBlock FontSize="21" TextWrapping="Wrap" Text="Connect to Frontier to view this page." />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ActiveCommanderDescription}" />
            </StackPanel>
            <StackPanel Spacing="7" MaxWidth="440" HorizontalAlignment="Left">
              <TextBlock Classes="console-label" Text="View commander" />
              <ComboBox x:Name="UnlinkedCommanderSelector" MinWidth="240" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding CommanderSelectionOptions}"
                        SelectedItem="{Binding SelectedCommanderOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FrontierCommanderSelectionOption">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding CommanderSelectionDescription}" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="SrvSurvey stores the authorization and cached profile data only on this device. It does not send your Frontier account information to SrvSurvey or share it with third parties." />
            <WrapPanel ItemSpacing="10" LineSpacing="8">
              <Button x:Name="ConnectFrontier" Classes="primary" Command="{Binding ConnectCommand}" Content="{Binding ConnectButtonText}" />
              <Button Classes="secondary" IsVisible="{Binding IsConnecting}" Command="{Binding CancelConnectionCommand}" Content="Cancel" />
            </WrapPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <Grid IsVisible="{Binding IsLinked}" RowDefinitions="Auto,*" Margin="24,18,24,18">
      <Border BorderBrush="{DynamicResource RavenStrongBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14">
        <Grid x:Name="ConsoleHeader" ColumnDefinitions="*,300,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="8">
          <StackPanel Spacing="3">
            <TextBlock Classes="console-label" Text="Commander" />
            <TextBlock x:Name="CommanderIdentity" Classes="console-identity" TextWrapping="Wrap" Text="{Binding CommanderName}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding CommanderId, StringFormat=Frontier commander ID: {0}}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding LastUpdated}" />
          </StackPanel>
          <StackPanel x:Name="CommanderAccountSelection" Grid.Column="1" Spacing="5" Width="300" HorizontalAlignment="Left">
            <TextBlock Classes="console-label" Text="View commander" />
            <ComboBox x:Name="CommanderSelector" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding CommanderSelectionOptions}"
                      SelectedItem="{Binding SelectedCommanderOption, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FrontierCommanderSelectionOption">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding CommanderSelectionDescription}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,20,0,0">
            <Button x:Name="RefreshFrontier" Classes="secondary" Command="{Binding RefreshCommand}" Content="Refresh Frontier" />
            <Button x:Name="CommanderAccountMenu" Classes="console-account" AutomationProperties.Name="Frontier account">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Account" />
                <PathIcon Width="8" Height="5" Data="M 0,0 L 8,0 L 4,4 Z" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem x:Name="UnlinkFrontier" Command="{Binding UnlinkCommand}" Header="Unlink Frontier" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <StackPanel x:Name="CommanderFeedback" Grid.Row="2" Grid.ColumnSpan="3" Spacing="6">
            <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Grid>
      </Border>
      <TabControl x:Name="CommanderProfileTabs" Grid.Row="1" Margin="0,6,0,0">
        <TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></TabControl.ItemsPanel>
        <TabItem Classes="commander-profile-tab" Header="Commander"><views:FrontierCommanderTabView /></TabItem>
        <TabItem Classes="commander-profile-tab" Header="Current Ship"><views:FrontierCurrentShipTabView /></TabItem>
        <TabItem Classes="commander-profile-tab" Header="Fleet Carrier"><views:FrontierCarrierTabView /></TabItem>
        <TabItem Classes="commander-profile-tab" Header="Market"><views:FrontierMarketTabView /></TabItem>
        <TabItem Classes="commander-profile-tab" Header="Shipyard"><views:FrontierShipyardTabView /></TabItem>
        <TabItem Classes="commander-profile-tab" Header="Community Goals"><views:FrontierCommunityGoalsTabView /></TabItem>
      </TabControl>
    </Grid>
  </Grid>
</UserControl>
