<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:views="using:SrvSurvey.Desktop.Views" xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors" x:Class="SrvSurvey.Desktop.Views.PowerplayRingAcquireSharedCluster" x:DataType="vm:PowerplayRingAcquireClusterViewModel">
  <Grid x:Name="ClusterGrid" ColumnDefinitions="Auto,40,Auto" MinWidth="1280" Margin="0,0,0,12">
    <StackPanel Grid.Column="0">
      <TextBlock Text="Sell Systems • Progress • State" Foreground="{DynamicResource RavenAccentBrush}" Margin="2,0,0,6"/>
      <ItemsControl x:Name="SellItems" ItemsSource="{Binding SellNodes}">
        <ItemsControl.Styles><Style Selector="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PowerplayRingAcquireSellNode">
            <Border x:Name="SellLinkAnchor" Classes="acquire-sell" Classes.selected="{Binding IsSelected}" Background="{DynamicResource RavenSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="1" Margin="0,0,0,8" Cursor="Hand">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto">
                <Border Grid.ColumnSpan="3" Classes="acquire-header first" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding SelectionGlyph}" Foreground="{DynamicResource RavenAccentBrush}" VerticalAlignment="Center"/>
                    <Button Classes="link" Padding="0" HorizontalAlignment="Left" behaviors:ClipboardCopyBehavior.Text="{Binding Row.Target}">
                      <TextBlock Text="{Binding Title}" TextWrapping="NoWrap"/>
                    </Button>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Classes="acquire-header first">
                  <Button Classes="link" Padding="0" Command="{Binding SellDistanceSortCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="DST"/><TextBlock Text="{Binding SellDistanceSortIndicator}"/></StackPanel>
                  </Button>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Classes="acquire-header"><TextBlock Text="Power"/></Border>
                <Border Grid.Row="1" Grid.Column="2" Classes="acquire-header">
                  <Button Classes="link" Padding="0" Command="{Binding BestStationSortCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Best Sell Station"/><TextBlock Text="{Binding BestStationSortIndicator}"/></StackPanel>
                  </Button>
                </Border>
                <Border Grid.Row="2" Classes="acquire-cell"><TextBlock Text="{Binding Row.Distance}" Foreground="{DynamicResource RavenAccentBrush}" VerticalAlignment="Top"/></Border>
                <Border Grid.Row="2" Grid.Column="1" Classes="acquire-cell"><ItemsControl ItemsSource="{Binding Row.PowerLines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PowerplayPowerLineViewModel"><TextBlock Text="{Binding Display}" Foreground="{Binding ColorHex}" TextWrapping="NoWrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                <Border Grid.Row="2" Grid.Column="2" Classes="acquire-cell" Padding="6,4">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding VisibleStations}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PowerplayRingAcquireStationNode">
                          <StackPanel Spacing="2" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource RavenAccentBrush}" TextWrapping="Wrap"/>
                              <Button Grid.Column="1" Classes="link" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" IsVisible="{Binding CanToggle}" Padding="2,0"/>
                            </Grid>
                            <TextBlock Text="{Binding Arrival}" Foreground="{DynamicResource RavenMutedTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding Updated}" IsVisible="{Binding HasUpdated}" Foreground="{DynamicResource RavenMutedTextBrush}" FontSize="12" FontStyle="Italic"/>
                            <ItemsControl ItemsSource="{Binding VisibleQuotes}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AcquireQuoteViewModel">
                                  <Grid ColumnDefinitions="40,140,*" Margin="0,1">
                                    <Border Classes="commodity-code" Classes.material="{Binding UseMaterialColor}" Classes.unavailable="{Binding IsUnavailable}" Padding="0">
                                      <Grid Width="38" Height="18" ClipToBounds="True">
                                        <Path Data="M -8,18 L 10,0 M 0,18 L 18,0 M 8,18 L 26,0 M 16,18 L 34,0 M 24,18 L 42,0 M 32,18 L 50,0" Stroke="{DynamicResource RavenDangerBrush}" StrokeThickness="2" Opacity="0.5" IsVisible="{Binding IsUnavailable}" ToolTip.Tip="No matching Spansh ring within acquisition reach"/>
                                        <TextBlock Text="{Binding Code}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Price}" Foreground="{DynamicResource RavenAccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Demand}" Foreground="{DynamicResource RavenTextBrush}" VerticalAlignment="Center"/>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding StationToggleLabel}" Command="{Binding ToggleStationsCommand}" IsVisible="{Binding CanToggleStations}" Padding="2,0" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Canvas x:Name="LinkCanvas" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="False">
      <Path x:Name="InactiveLinks" Stroke="{DynamicResource RavenAccentBrush}" StrokeThickness="1.5" Opacity="0.28"/>
      <Path x:Name="ActiveLinks" Stroke="{DynamicResource RavenAccentBrush}" StrokeThickness="2.5"/>
    </Canvas>
    <StackPanel x:Name="MiningColumn" Grid.Column="2" VerticalAlignment="Top" MinWidth="650">
      <Grid ColumnDefinitions="28*,72*">
        <Border Classes="acquire-header first"><TextBlock Text="Mining System"/></Border>
        <Border Grid.Column="1" Classes="acquire-header"><TextBlock Text="Ring Details"/></Border>
      </Grid>
      <ItemsControl x:Name="MiningItems" ItemsSource="{Binding VisibleMiningSystems}">
        <ItemsControl.Styles><Style Selector="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PowerplayRingAcquireMiningNode">
            <Border x:Name="MiningLinkAnchor" Background="{DynamicResource RavenSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="1,0,1,1" Opacity="{Binding EmphasisOpacity}">
              <Grid ColumnDefinitions="28*,72*">
                <Border Classes="acquire-cell">
                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Top">
                    <Button Classes="link" Width="18" Padding="0" FontSize="16" Content="{Binding Chevron}" Command="{Binding ToggleCommand}" IsVisible="{Binding HasAdditionalSignals}"/>
                    <Button Classes="link" HorizontalAlignment="Left" behaviors:ClipboardCopyBehavior.Text="{Binding System}"><TextBlock Text="{Binding System}" TextWrapping="Wrap"/></Button>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="acquire-cell">
                  <ItemsControl ItemsSource="{Binding VisibleRingLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MeritLineViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                          <views:MiningIcon Kind="{Binding Icon}" Width="14" Height="14" IsVisible="{Binding ShowPlanet}"/>
                          <Border Width="14" IsVisible="{Binding ShowSpacer}"/>
                          <TextBlock Text="{Binding RingName}" IsVisible="{Binding ShowMineral}"/>
                          <views:MiningIcon Kind="{Binding RingTypeIcon}" Width="14" Height="14" IsVisible="{Binding ShowRingType}"/>
                          <views:MiningIcon Kind="{Binding ReserveIcon}" Width="14" Height="13" IsVisible="{Binding ShowReserve}"/>
                          <views:MiningIcon Kind="Hotspot" Width="12" Height="12" IsVisible="{Binding ShowMineral}"/>
                          <TextBlock Text="{Binding Mineral}" TextWrapping="Wrap" IsVisible="{Binding ShowMineral}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
