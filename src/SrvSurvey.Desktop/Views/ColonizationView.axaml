<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             xmlns:colonization="using:SrvSurvey.Core.Colonization"
             x:Class="SrvSurvey.Desktop.Views.ColonizationView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="1100">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="5">
          <TextBlock Classes="eyebrow" Text="RAVEN COLONIAL" />
          <TextBlock Classes="page-title" Text="Colonization projects" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Track active builds, choose which projects feed the cargo list, and inspect live construction requirements." />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinWidth="132"
                VerticalAlignment="Center"
                Command="{Binding Colonization.RefreshCommand}"
                Content="{Binding Colonization.RefreshButtonText}" />
      </Grid>

      <Border Classes="card raised" Padding="0">
        <Grid ColumnDefinitions="6,*">
          <Border Classes="accent-line" CornerRadius="12,0,0,12" />
          <Grid Grid.Column="1"
                Margin="26"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="20">
            <StackPanel Spacing="6">
              <TextBlock Classes="card-title" Text="External data consent" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="When enabled, SrvSurvey can fetch your commander projects and keep newly recorded construction contributions, depot requirements, completion, and docking faction metadata in sync with Raven Colonial. Startup history is never published. This is off by default." />
              <TextBlock FontWeight="SemiBold"
                         Text="{Binding Colonization.CommanderStatus}" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      IsChecked="{Binding Colonization.IsEnabled, Mode=TwoWay}"
                       Content="Enable colonization features" />
          </Grid>
        </Grid>
      </Border>

      <Expander HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False">
        <Expander.Header>
          <StackPanel Spacing="3">
            <TextBlock Classes="card-title" Text="Fleet Carrier cargo sync" />
            <TextBlock Classes="muted"
                       Text="Configure the commander-scoped Raven credential and opt-in Market.json publishing." />
          </StackPanel>
        </Expander.Header>
        <Border Margin="0,12,0,0" Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="The API key is validated against the active commander before it is stored in that commander profile. When sync is enabled, only cargo counts from a freshly opened market on a linked Fleet Carrier are sent to Raven Colonial." />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding Colonization.RavenApiKey, Mode=TwoWay}"
                       PasswordChar="*"
                       IsEnabled="{Binding Colonization.HasCommanderProfile}"
                       PlaceholderText="Raven Colonial API key" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Command="{Binding Colonization.SaveRavenApiKeyCommand}"
                      Content="Save key" />
              <Button Grid.Column="2"
                      Classes="secondary"
                      Click="OpenRavenApiKeyPage_Click"
                      Content="Get API key" />
            </Grid>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Colonization.RavenCredentialStatus}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock VerticalAlignment="Center"
                         Classes="muted"
                         TextWrapping="Wrap"
                         Text="Dock at a Fleet Carrier to publish and link it. Registration preserves Raven's existing cargo; a freshly opened market is reconciled afterward." />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Command="{Binding Colonization.PublishFleetCarrierCommand}"
                      Content="{Binding Colonization.FleetCarrierPublishButtonText}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <CheckBox VerticalAlignment="Center"
                        IsChecked="{Binding Colonization.FleetCarrierCargoSyncEnabled, Mode=TwoWay}"
                        IsEnabled="{Binding Colonization.HasStoredRavenApiKey}"
                        Content="Sync linked Fleet Carrier cargo automatically" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Command="{Binding Colonization.SyncFleetCarrierCargoCommand}"
                      Content="{Binding Colonization.FleetCarrierSyncButtonText}" />
            </Grid>
            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Colonization.FleetCarrierSyncStatus}" />
            <CheckBox IsChecked="{Binding Colonization.ShipCargoPublishingEnabled, Mode=TwoWay}"
                      IsEnabled="{Binding Colonization.HasStoredRavenApiKey}"
                      Content="Track and publish cargo on ship (Needs API Key)" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="This publishes the ship name, type, capacity, and Cargo.json counts only while visible colonization projects are active." />
            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding Colonization.ShipCargoPublishingStatus}" />
          </StackPanel>
        </Border>
      </Expander>

      <Expander HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False">
        <Expander.Header>
          <StackPanel Spacing="3">
            <TextBlock Classes="card-title" Text="Raven system sites" />
            <TextBlock Classes="muted"
                       Text="Reconcile planned and completed sites with live journal discoveries." />
          </StackPanel>
        </Expander.Header>
        <Border Margin="0,12,0,0" Classes="card">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
              <StackPanel Spacing="3">
                <TextBlock Classes="eyebrow" Text="SYSTEM EDITOR" />
                <TextBlock Classes="card-title"
                           Text="{Binding Colonization.SystemEditor.SystemTitle}" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="Load is read-only. Edits remain local until a fresh Raven comparison passes and you explicitly confirm the publish." />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="secondary"
                      VerticalAlignment="Center"
                      Click="OpenRavenSystem_Click"
                      IsEnabled="{Binding Colonization.SystemEditor.IsLoaded}"
                      Content="Open on Raven" />
              <Button Grid.Column="2"
                      Classes="secondary"
                      VerticalAlignment="Center"
                      Click="OpenRavenVisualizer_Click"
                      Content="Visualizer" />
              <Button Grid.Column="3"
                      Classes="secondary"
                      VerticalAlignment="Center"
                      Click="OpenRavenUpdaterGuide_Click"
                      Content="Guide" />
              <Button Grid.Column="4"
                      Classes="primary"
                      VerticalAlignment="Center"
                      Command="{Binding Colonization.SystemEditor.LoadCommand}"
                      Content="Load system" />
            </Grid>

            <Border Background="{DynamicResource RavenSurfaceBrush}"
                    CornerRadius="8"
                    Padding="12">
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding Colonization.SystemEditor.StatusMessage}" />
            </Border>

            <Border BorderBrush="{DynamicResource RavenWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsVisible="{Binding Colonization.SystemEditor.NeedsBodyImport}"
                    Padding="14">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock FontWeight="Bold"
                               Text="Raven has no body catalog for this system" />
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="Importing bodies is a separate Raven operation and never publishes the local site table." />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding Colonization.SystemEditor.RequestBodyImportCommand}"
                          Content="Review body import" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="10"
                      IsVisible="{Binding Colonization.SystemEditor.IsBodyImportConfirmationPending}">
                  <TextBlock VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Text="Confirm the external body import request?" />
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding Colonization.SystemEditor.CancelBodyImportCommand}"
                          Content="Cancel" />
                  <Button Grid.Column="2"
                          Classes="primary"
                          Command="{Binding Colonization.SystemEditor.ConfirmBodyImportCommand}"
                          Content="Confirm import" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Spacing="14"
                        IsVisible="{Binding Colonization.SystemEditor.IsLoaded}">
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="3">
                  <TextBlock Classes="muted" Text="ARCHITECT" />
                  <TextBlock FontWeight="SemiBold"
                             Text="{Binding Colonization.SystemEditor.Architect}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="muted" Text="JOURNAL COVERAGE" />
                  <TextBlock Text="{Binding Colonization.SystemEditor.ScanSummary}" />
                </StackPanel>
                <CheckBox Grid.Column="2"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding Colonization.SystemEditor.CanEdit}"
                          IsChecked="{Binding Colonization.SystemEditor.CaptureUnknownSurfaceSites, Mode=TwoWay}"
                          Content="Capture selected surface sites" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding Colonization.SystemEditor.NewSiteName, Mode=TwoWay}"
                         IsEnabled="{Binding Colonization.SystemEditor.CanEdit}"
                         PlaceholderText="New site name" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Command="{Binding Colonization.SystemEditor.AddSiteCommand}"
                        Content="Add local site" />
                <Button Grid.Column="2"
                        Classes="secondary"
                        Command="{Binding Colonization.SystemEditor.RemoveSiteCommand}"
                        Content="Remove selected" />
              </Grid>

              <Grid ColumnDefinitions="2*,90,150,135,110"
                    ColumnSpacing="10"
                    Margin="12,0">
                <TextBlock Classes="muted" Text="SITE" />
                <TextBlock Grid.Column="1" Classes="muted" Text="BODY" />
                <TextBlock Grid.Column="2" Classes="muted" Text="BUILD TYPE" />
                <TextBlock Grid.Column="3" Classes="muted" Text="MARKET ID" />
                <TextBlock Grid.Column="4" Classes="muted" Text="STATUS" />
              </Grid>

              <ListBox ItemsSource="{Binding Colonization.SystemEditor.Sites}"
                       SelectedItem="{Binding Colonization.SystemEditor.SelectedSite, Mode=TwoWay}"
                       IsEnabled="{Binding Colonization.SystemEditor.CanEdit}"
                       MaxHeight="360">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ColonizationSystemSiteRowViewModel">
                    <Grid ColumnDefinitions="2*,90,150,135,110"
                          ColumnSpacing="10"
                          Margin="4,5">
                      <TextBox Text="{Binding Name, Mode=TwoWay}" />
                      <NumericUpDown Grid.Column="1"
                                     Minimum="-1"
                                     Maximum="10000"
                                     Increment="1"
                                     FormatString="0"
                                     Value="{Binding BodyNumber, Mode=TwoWay}" />
                      <TextBox Grid.Column="2"
                               Text="{Binding BuildType, Mode=TwoWay}"
                               PlaceholderText="Unknown" />
                      <TextBox Grid.Column="3"
                               Text="{Binding MarketId, Mode=TwoWay}"
                               PlaceholderText="Unknown" />
                      <ComboBox Grid.Column="4"
                                ItemsSource="{Binding AllowedStatuses}"
                                SelectedItem="{Binding Status, Mode=TwoWay}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Colonization.SystemEditor.CanEdit}"
                         Text="Journal signals, settlement approaches, docking details, and the opt-in destination capture update only this local workspace until review." />

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource RavenAccentBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding Colonization.SystemEditor.ReviewSummary}" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding Colonization.SystemEditor.ReviewCommand}"
                        Content="Review Raven changes" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Colonization.SystemEditor.Conflicts}"
                            IsVisible="{Binding Colonization.SystemEditor.HasConflicts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="colonization:ColonizationSystemSiteConflict">
                    <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                               TextWrapping="Wrap">
                      <Run Text="{Binding Site}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Field}" />
                      <Run Text=": " />
                      <Run Text="{Binding Message}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Background="{DynamicResource RavenSurfaceBrush}"
                      BorderBrush="{DynamicResource RavenWarningBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      IsVisible="{Binding Colonization.SystemEditor.IsPublishConfirmationPending}"
                      Padding="14">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="3">
                    <TextBlock FontWeight="Bold" Text="Confirm external publish" />
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="Only the reviewed updates and stable deletions will be sent. Concurrent and remote-only data is retained." />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding Colonization.SystemEditor.CancelPublishCommand}"
                          Content="Cancel" />
                  <Button Grid.Column="2"
                          Classes="primary"
                          Command="{Binding Colonization.SystemEditor.ConfirmPublishCommand}"
                          Content="Confirm publish" />
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </Expander>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel Spacing="3">
              <TextBlock Classes="card-title" Text="My build projects" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Selected projects appear in aggregate cargo requirements. Changes are sent only when you choose Save selection." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Click="OpenRavenBuilds_Click"
                    Content="Open Raven builds" />
            <Button Grid.Column="2"
                    Classes="primary"
                    Command="{Binding Colonization.SaveProjectsCommand}"
                    Content="{Binding Colonization.SaveButtonText}" />
          </Grid>

          <Border Background="{DynamicResource RavenSurfaceBrush}"
                  CornerRadius="8"
                  Padding="12">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{DynamicResource RavenAccentBrush}"
                       Text="{Binding Colonization.ProjectSummary}" />
          </Border>

          <Grid ColumnDefinitions="Auto,*,150,220,150,Auto"
                ColumnSpacing="12"
                Margin="4,0">
            <TextBlock Classes="muted" Text="SHOW" />
            <TextBlock Grid.Column="1" Classes="muted" Text="PROJECT" />
            <TextBlock Grid.Column="2" Classes="muted" Text="PROGRESS" />
            <TextBlock Grid.Column="3" Classes="muted" Text="TYPE" />
            <TextBlock Grid.Column="4" Classes="muted" Text="SYSTEM" />
            <TextBlock Grid.Column="5" Classes="muted" Text="PRIMARY" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Colonization.Projects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ColonizationProjectRowViewModel">
                <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="4,12">
                  <Grid ColumnDefinitions="Auto,*,150,220,150,Auto"
                        ColumnSpacing="12">
                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding IsShown, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock FontWeight="SemiBold"
                                 Text="{Binding BuildName}" />
                      <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Text="{Binding PrimaryLabel}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="{Binding ProgressText}" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding TypeDescription}" />
                    <StackPanel Grid.Column="4"
                                VerticalAlignment="Center"
                                Spacing="2">
                      <Button Classes="link" HorizontalAlignment="Left"
                              behaviors:ClipboardCopyBehavior.Text="{Binding SystemName}">
                        <TextBlock TextTrimming="CharacterEllipsis"
                                   Text="{Binding SystemName}" />
                      </Button>
                      <Button Classes="link" HorizontalAlignment="Left"
                              behaviors:ClipboardCopyBehavior.Text="{Binding Project.SystemAddress}">
                        <TextBlock Classes="muted monospace" FontSize="9"
                                   Text="{Binding SystemAddressText}" />
                      </Button>
                    </StackPanel>
                    <Button Grid.Column="5"
                            Classes="secondary"
                            MinWidth="110"
                            Command="{Binding TogglePrimaryCommand}"
                            Content="{Binding PrimaryActionLabel}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="muted"
                     IsVisible="{Binding Colonization.HasNoProjects}"
                     TextWrapping="Wrap"
                     Text="No active project rows are loaded." />
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding Colonization.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="LIVE DEPOT" />
            <TextBlock Classes="card-title"
                       Text="{Binding Colonization.ConstructionTitle}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Colonization.ConstructionStatus}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Colonization.ConstructionResources}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ColonizationResourceRowViewModel">
                <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="4,10">
                  <Grid ColumnDefinitions="*,150,150,110" ColumnSpacing="14">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               Text="{Binding RemainingText}" />
                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" />
                    <TextBlock Grid.Column="3"
                               Classes="muted"
                               Text="{Binding PaymentText}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="NEW BUILD" />
              <TextBlock Classes="card-title" Text="Create a project" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Prepare uses the current construction depot and reads matching Raven site data. Nothing is published until you review and confirm." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    VerticalAlignment="Center"
                    Command="{Binding Colonization.ProjectEditor.PrepareCommand}"
                    Content="{Binding Colonization.ProjectEditor.PrepareButtonText}" />
          </Grid>

          <Border Background="{DynamicResource RavenSurfaceBrush}"
                  CornerRadius="8"
                  Padding="12">
            <TextBlock TextWrapping="Wrap"
                       Text="{Binding Colonization.ProjectEditor.StatusMessage}" />
          </Border>

          <StackPanel IsVisible="{Binding Colonization.ProjectEditor.IsEditorVisible}"
                      Spacing="16">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="PLANNED RAVEN SITE" />
                <ComboBox ItemsSource="{Binding Colonization.ProjectEditor.SystemSites}"
                          SelectedItem="{Binding Colonization.ProjectEditor.SelectedSystemSite, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColonizationSystemSiteOptionViewModel">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="muted" Text="PROJECT NAME" />
                <TextBox Text="{Binding Colonization.ProjectEditor.ProjectName, Mode=TwoWay}"
                         PlaceholderText="Project name" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="150,*,*" ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="LOCATION" />
                <ComboBox IsEnabled="{Binding Colonization.ProjectEditor.IsBuildSelectionEnabled}"
                          ItemsSource="{Binding Colonization.ProjectEditor.Locations}"
                          SelectedItem="{Binding Colonization.ProjectEditor.SelectedLocation, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="muted" Text="BUILD TYPE" />
                <ComboBox IsEnabled="{Binding Colonization.ProjectEditor.IsBuildSelectionEnabled}"
                          ItemsSource="{Binding Colonization.ProjectEditor.BuildOptions}"
                          SelectedItem="{Binding Colonization.ProjectEditor.SelectedBuild, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColonizationBuildOptionViewModel">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="LAYOUT" />
                <ComboBox IsEnabled="{Binding Colonization.ProjectEditor.IsBuildSelectionEnabled}"
                          ItemsSource="{Binding Colonization.ProjectEditor.Layouts}"
                          SelectedItem="{Binding Colonization.ProjectEditor.SelectedLayout, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,140,*" ColumnSpacing="18">
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="ARCHITECT" />
                <TextBox Text="{Binding Colonization.ProjectEditor.ArchitectName, Mode=TwoWay}"
                         PlaceholderText="Commander or architect" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="muted" Text="BODY NUMBER" />
                <TextBox Text="{Binding Colonization.ProjectEditor.BodyNumberText, Mode=TwoWay}"
                         PlaceholderText="-1" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Classes="muted" Text="BODY NAME" />
                <TextBox Text="{Binding Colonization.ProjectEditor.BodyName, Mode=TwoWay}"
                         PlaceholderText="Optional" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="NOTES" />
              <TextBox AcceptsReturn="True"
                       MinHeight="72"
                       Text="{Binding Colonization.ProjectEditor.Notes, Mode=TwoWay}"
                       TextWrapping="Wrap"
                       PlaceholderText="Optional project notes" />
            </StackPanel>

            <Button Classes="primary"
                    HorizontalAlignment="Left"
                    MinWidth="150"
                    Command="{Binding Colonization.ProjectEditor.ReviewCommand}"
                    Content="{Binding Colonization.ProjectEditor.ReviewButtonText}" />

            <Border Background="{DynamicResource RavenSurfaceBrush}"
                    BorderBrush="{DynamicResource RavenWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsVisible="{Binding Colonization.ProjectEditor.IsConfirmationPending}"
                    Padding="16">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                  <TextBlock FontWeight="Bold" Text="Confirm external publish" />
                  <TextBlock TextWrapping="Wrap"
                             Text="{Binding Colonization.ProjectEditor.ConfirmationSummary}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="secondary"
                        Command="{Binding Colonization.ProjectEditor.CancelReviewCommand}"
                        Content="Cancel" />
                <Button Grid.Column="2"
                        Classes="primary"
                        Command="{Binding Colonization.ProjectEditor.ConfirmCommand}"
                        Content="Confirm publish" />
              </Grid>
            </Border>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="12"
                IsVisible="{Binding Colonization.ProjectEditor.HasCreatedProject}">
            <TextBlock Foreground="{DynamicResource RavenSuccessBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{Binding Colonization.ProjectEditor.CreatedProjectSummary}" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Click="OpenCreatedProject_Click"
                    Content="Open created project" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
