<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.OverviewView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="1180">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="5">
          <TextBlock Classes="page-title" Text="Overview" />
          <TextBlock Classes="muted"
                     Text="Commander identity, journal health, and companion status." />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="secondary"
                MinWidth="116"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}"
                Content="{Binding RefreshButtonText}" />
      </Grid>

      <Border Classes="card raised" Padding="18,14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Border Width="8" Height="8" CornerRadius="4"
                  Background="{DynamicResource RavenAccentBrush}"
                  VerticalAlignment="Top" Margin="0,5,0,0" />
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock FontWeight="SemiBold" Text="Journal status" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding StatusMessage}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card" Padding="0">
        <Grid ColumnDefinitions="6,*">
          <Border Classes="accent-line" CornerRadius="12,0,0,12" />
          <Grid Grid.Column="1"
                Margin="24"
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="2*,*"
                RowSpacing="22"
                ColumnSpacing="26">
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" FontSize="12" Text="COMMANDER" />
              <TextBlock FontSize="26"
                         FontWeight="SemiBold"
                         Text="{Binding CommanderName}" />
              <TextBlock Classes="muted" Text="{Binding FrontierId, StringFormat=Frontier ID: {0}}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <Border Classes="badge" HorizontalAlignment="Right">
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource RavenAccentBrush}"
                           Text="{Binding SessionState}" />
              </Border>
              <TextBlock Classes="muted"
                         HorizontalAlignment="Right"
                         Text="{Binding GameDescription}" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Grid.ColumnSpan="2"
                  ColumnDefinitions="2*,*,*"
                  ColumnSpacing="28">
              <StackPanel Spacing="4">
                <TextBlock Classes="muted" FontSize="12" Text="LOCATION" />
                <Button Classes="link" HorizontalAlignment="Left"
                        behaviors:ClipboardCopyBehavior.Text="{Binding OverviewSystemName}">
                  <TextBlock Classes="card-title"
                             TextWrapping="Wrap"
                             Text="{Binding OverviewSystemName}" />
                </Button>
                <Button Classes="link" HorizontalAlignment="Left"
                        IsVisible="{Binding HasOverviewSystemAddress}"
                        behaviors:ClipboardCopyBehavior.Text="{Binding OverviewSystemAddress}">
                  <TextBlock Classes="muted monospace"
                             Text="{Binding OverviewSystemAddressText}" />
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="muted" FontSize="12" Text="BODY" />
                <TextBlock FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="{Binding BodyName}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Classes="muted" FontSize="12" Text="MODE" />
                <TextBlock FontWeight="SemiBold" Text="{Binding GameMode}" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Trip since reset" />
            <Grid x:Name="ExplorationTripMetrics"
                  ColumnDefinitions="1*,2*,2*"
                  ColumnSpacing="18">
              <StackPanel HorizontalAlignment="Stretch" Spacing="3">
                <TextBlock Classes="metric"
                           TextAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ExplorationJumps}" />
                <TextBlock Classes="muted"
                           FontSize="12"
                           TextAlignment="Left"
                           Text="Jumps" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Spacing="3">
                <TextBlock Classes="metric"
                           TextAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding ExplorationDistance}" />
                <TextBlock Classes="muted"
                           FontSize="12"
                           TextAlignment="Left"
                           Text="Distance" />
              </StackPanel>
              <StackPanel Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          Spacing="3">
                <TextBlock Classes="metric"
                           TextAlignment="Left"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding EstimatedExplorationValue}" />
                <TextBlock Classes="muted"
                           FontSize="12"
                           TextAlignment="Left"
                           Text="Estimated" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="muted"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{Binding ExplorationBodies}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Unclaimed biology" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
              <StackPanel Spacing="3">
                <TextBlock Classes="metric" Text="{Binding UnclaimedBioScans}" />
                <TextBlock Classes="muted" FontSize="12" Text="Unclaimed scans" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="metric" Text="{Binding UnclaimedBioRewards}" />
                <TextBlock Classes="muted" FontSize="12" Text="Unclaimed rewards" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="muted"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="{Binding OrganicScanProgress}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Multiple commanders" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Launch another isolated SrvSurvey process for a saved commander profile." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding CommanderInstances.RefreshCommand}"
                    Content="Refresh profiles" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Classes="muted"
                       VerticalAlignment="Center"
                       Text="Current" />
            <TextBlock Grid.Column="1"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Text="{Binding CommanderInstances.CurrentCommander}" />
            <Button Grid.Column="2"
                    Classes="secondary"
                    Command="{Binding CommanderInstances.SwitchWindowCommand}"
                    Content="Focus next Elite window" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ComboBox ItemsSource="{Binding CommanderInstances.Commanders}"
                      SelectedItem="{Binding CommanderInstances.SelectedCommander}"
                      PlaceholderText="Choose another commander">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CommanderInstanceOptionViewModel">
                  <StackPanel Margin="4" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               Text="{Binding Modes}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1"
                    Classes="primary"
                    MinWidth="150"
                    Command="{Binding CommanderInstances.LaunchCommand}"
                    Content="Launch instance" />
          </Grid>

          <TextBlock Classes="muted"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Text="{Binding CommanderInstances.StatusMessage}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
