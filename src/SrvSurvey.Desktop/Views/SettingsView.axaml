<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:localization="using:SrvSurvey.Desktop.Localization"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             xmlns:views="using:SrvSurvey.Desktop.Views"
             x:Class="SrvSurvey.Desktop.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <UserControl.Styles>
    <Style Selector="TextBox.overlay-theme-hex.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource RavenWarningBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Slider.overlay-theme-opacity /template/ Thumb#thumb">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="1100">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="QUICK ACCESS" />
        <Button Classes="link"
                HorizontalAlignment="Left"
                Click="ScrollToLegacyImport_Click">
          <TextBlock Text="Import SrvSurvey User Data" />
        </Button>
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="Jump directly to the source picker and the backed-up, verified import workflow." />
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="APPEARANCE" />
        <TextBlock Classes="page-title" Text="Themes" />
        <TextBlock Classes="muted"
                   Text="Use the same five visual identities available on Raven Colonial." />
      </StackPanel>

      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto"
              ColumnDefinitions="*,260,Auto"
              ColumnSpacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Language" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Uses the original SrvSurvey translations where available. New port-only text falls back to English." />
          </StackPanel>
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding Localization.Languages}"
                    SelectedItem="{Binding Localization.SelectedLanguage, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="localization:LocalizationLanguage">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2"
                  Classes="primary"
                  IsVisible="{Binding Localization.IsRestartRequired}"
                  Command="{Binding Localization.RestartCommand}"
                  Content="Restart to apply" />
          <TextBlock Grid.Row="1"
                     Grid.ColumnSpan="3"
                     Classes="muted"
                     Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Text="{Binding Localization.StatusMessage}" />
        </Grid>
      </Border>

      <Border Padding="1,1,1,24"
              Background="{DynamicResource RavenSurfaceBrush}"
              BorderBrush="{DynamicResource RavenBorderBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <Expander Classes="theme-selector"
                  ExpandDirection="Down"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  IsExpanded="True">
          <Expander.Header>
            <StackPanel Margin="4,0,0,8" Spacing="2">
              <TextBlock Classes="card-title" Text="Theme selection" />
              <TextBlock Classes="muted"
                         FontSize="11"
                         Text="Application theme, in-game overlay appearance, and overlay configuration" />
            </StackPanel>
          </Expander.Header>
          <TabControl Classes="theme-selector"
                      HorizontalContentAlignment="Stretch">
        <TabItem Classes="theme-selector" Header="Application theme">
          <StackPanel Margin="0,16,0,0" Spacing="18">
            <Border Classes="card raised">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="4">
                  <TextBlock Classes="card-title" Text="Current application theme" />
                  <TextBlock Classes="muted" Text="{Binding SelectedThemeName}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center">
                  <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                             FontWeight="SemiBold"
                             Text="SAVED LOCALLY" />
                </Border>
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding ThemeOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemWidth="250" ItemHeight="184" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                  <Button Classes="secondary"
                          Width="238"
                          Height="172"
                          Margin="0,0,12,12"
                          Padding="0"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          Command="{Binding SelectCommand}">
                    <Border Background="{Binding WindowBrush}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                      <Grid RowDefinitions="*,Auto" RowSpacing="14">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Foreground="{Binding TextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding DisplayName}" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{Binding AccentBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Text="{Binding ModeLabel}" />
                          </Grid>
                          <Border Height="48"
                                  Background="{Binding SurfaceBrush}"
                                  CornerRadius="6"
                                  Padding="10">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                              <Border Width="72" Height="7"
                                      HorizontalAlignment="Left"
                                      Background="{Binding TextBrush}"
                                      CornerRadius="4" />
                              <Border Grid.Column="1" Width="38" Height="20"
                                      Background="{Binding AccentBrush}"
                                      CornerRadius="5" />
                            </Grid>
                          </Border>
                        </StackPanel>
                        <Border Grid.Row="1" Height="4"
                                Background="{Binding AccentBrush}"
                                CornerRadius="2" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="card-title" Text="Application theme scope" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="These choices style only the Avalonia application shell and native light/dark controls. They never change the in-game overlay palette." />
                <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding ThemeStatusMessage}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

        <TabItem Classes="theme-selector" Header="In-game overlay appearance">
          <StackPanel Margin="0,16,0,0" Spacing="18">
            <Border x:Name="OverlayThemePresetCard"
                    Classes="card raised">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Classes="card-title" Text="Overlay theme presets and saved states" />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="Built-in presets fill the editor without changing theme.json until you apply them. Your named states remain stored separately from the active in-game overlay palette." />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <ComboBox ItemsSource="{Binding OverlayTheme.SavedStates}"
                            SelectedItem="{Binding OverlayTheme.SelectedSavedState, Mode=TwoWay}"
                            PlaceholderText="Select an overlay theme" />
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding OverlayTheme.LoadStateCommand}"
                          Content="Load" />
                  <Button Grid.Column="2"
                          Classes="secondary"
                          Command="{Binding OverlayTheme.DeleteStateCommand}"
                          Content="Delete" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding OverlayTheme.StateName, Mode=TwoWay}"
                           MaxLength="80"
                           PlaceholderText="Name this overlay theme state" />
                  <Button Grid.Column="1"
                          Classes="primary"
                          Command="{Binding OverlayTheme.SaveStateCommand}"
                          Content="Save named state" />
                </Grid>
              </StackPanel>
            </Border>

            <Border x:Name="OverlayThemeActionsCard"
                    Classes="card raised">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock VerticalAlignment="Center"
                           Classes="muted"
                           TextWrapping="Wrap"
                           Text="{Binding OverlayTheme.StatusMessage}" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Command="{Binding OverlayTheme.PreviewCommand}"
                        Content="Refresh preview" />
                <Button Grid.Column="2"
                        Classes="secondary"
                        Command="{Binding OverlayTheme.ReloadActiveCommand}"
                        Content="Discard changes" />
                <Button Grid.Column="3"
                        Classes="secondary"
                        Command="{Binding OverlayTheme.RestoreDefaultsCommand}"
                        Content="Load Defaults" />
                <Button Grid.Column="4"
                        Classes="primary"
                        Command="{Binding OverlayTheme.ApplyCommand}"
                        Content="Apply to overlays" />
              </Grid>
            </Border>

            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Choose any colour swatch to open its visual picker, or use the hex field for exact values. Alpha is supported for translucent overlays." />

            <ItemsControl x:Name="OverlayThemeColorEditorList"
                          ItemsSource="{Binding OverlayTheme.Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OverlayThemeCategoryViewModel">
                  <Border Classes="card" Margin="0,0,0,12">
                    <StackPanel Spacing="10">
                      <TextBlock Classes="card-title" Text="{Binding Name}" />
                      <ItemsControl ItemsSource="{Binding Colors}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="490" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:OverlayThemeColorEditorViewModel">
                            <Grid Width="476"
                                  Height="36"
                                  Margin="0,0,12,6"
                                  Classes="overlay-theme-color-row"
                                  ColumnDefinitions="64,128,*,118"
                                  ColumnSpacing="8">
                              <ColorPicker Width="64"
                                           Height="32"
                                           MinHeight="0"
                                           MaxHeight="32"
                                           VerticalAlignment="Center"
                                           Color="{Binding Color, Mode=TwoWay}"
                                           ColorModel="Rgba"
                                           HexInputAlphaPosition="Trailing"
                                           IsAlphaEnabled="True"
                                           IsAlphaVisible="True"
                                           ToolTip.Tip="Open colour picker" />
                              <StackPanel Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Spacing="0">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted"
                                           FontSize="9"
                                           Text="{Binding Key}"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <Grid Grid.Column="2"
                                    VerticalAlignment="Center"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="5"
                                    ToolTip.Tip="Opacity">
                                <Slider x:Name="OverlayThemeOpacitySlider"
                                        Classes="overlay-theme-opacity"
                                        Height="32"
                                        MinHeight="0"
                                        MaxHeight="32"
                                        Minimum="0"
                                        Maximum="100"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding OpacityPercent, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1"
                                           Classes="monospace"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Width="34"
                                           Text="{Binding OpacityPercent, StringFormat={}{0}%}" />
                              </Grid>
                              <TextBox x:Name="OverlayThemeHexTextBox"
                                       Grid.Column="3"
                                       Height="32"
                                       MinHeight="0"
                                       MaxHeight="32"
                                       VerticalContentAlignment="Center"
                                       Classes="overlay-theme-hex"
                                       Classes.invalid="{Binding HasValidationError}"
                                       Text="{Binding HexValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       ToolTip.Tip="{Binding ValidationMessage}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </TabItem>
        <TabItem Classes="theme-selector" Header="Overlay Settings">
          <views:OverlaySettingsView />
        </TabItem>
          </TabControl>
        </Expander>
      </Border>

      <Border x:Name="DesktopBehaviorCard" Classes="card raised">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Desktop behavior" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Choose where the application opens and preserve the original hand-off to the selected Elite Dangerous window." />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
            <StackPanel Spacing="10">
              <CheckBox IsChecked="{Binding DesktopBehavior.FocusGameOnStart, Mode=TwoWay}"
                        Content="Set focus on Elite Dangerous when starting Srv Survey." />
              <CheckBox IsChecked="{Binding DesktopBehavior.FocusGameOnMinimize, Mode=TwoWay}"
                        Content="Set focus on Elite Dangerous when minimizing Srv Survey." />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="10">
              <CheckBox IsChecked="{Binding DesktopBehavior.FocusGameAfterFsdJump, Mode=TwoWay}"
                        Content="Set focus on Elite Dangerous after each FSD jump." />
              <CheckBox IsChecked="{Binding DesktopBehavior.MinimizeToTray, Mode=TwoWay}"
                        Content="Minimize to system tray" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
            <StackPanel Spacing="7">
              <TextBlock FontWeight="SemiBold" Text="Default monitor" />
              <ComboBox x:Name="DefaultMonitorComboBox"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DesktopBehavior.MonitorOptions}"
                        SelectedItem="{Binding DesktopBehavior.SelectedMonitor, Mode=TwoWay}" />
              <TextBlock Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Text="The last on-screen position is restored when possible. This monitor is used when no saved position is available or its display is disconnected." />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="7">
              <TextBlock FontWeight="SemiBold" Text="Application window scale" />
              <ComboBox x:Name="ApplicationWindowScaleComboBox"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DesktopBehavior.ApplicationWindowScaleOptions}"
                        SelectedItem="{Binding DesktopBehavior.SelectedApplicationWindowScale, Mode=TwoWay}" />
              <TextBlock Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Text="Scales the complete application interface. Oversized choices are reduced only as needed to fit the active monitor." />
            </StackPanel>
          </Grid>
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     IsVisible="{Binding DesktopBehavior.HasStatusMessage}"
                     TextWrapping="Wrap"
                     Text="{Binding DesktopBehavior.StatusMessage}" />
          <TextBlock Classes="muted"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="Passive overlays are click-through and never activate, replacing the legacy force-refocus workaround." />
        </StackPanel>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Preferred commander" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Pin this SrvSurvey instance to one commander's stable Frontier ID, or follow the newest active journal automatically." />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <ComboBox ItemsSource="{Binding CommanderPreference.Options}"
                      SelectedItem="{Binding CommanderPreference.SelectedOption, Mode=TwoWay}"
                      IsEnabled="{Binding !CommanderPreference.IsCommandLineOverride}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CommanderPreferenceOptionViewModel">
                  <TextBlock Margin="4" Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1"
                    Classes="primary"
                    Command="{Binding CommanderPreference.SaveAndRestartCommand}"
                    Content="Save and restart" />
          </Grid>
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding CommanderPreference.StatusMessage}" />
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="Imported name-only preferences are applied only when exactly one profile matches, preventing data from being written to the wrong commander." />
        </StackPanel>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="System nicknames" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Show personal system-nick-names.json labels first, then imported Raven Colonial public names, in Galaxy Map guidance overlays." />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      IsChecked="{Binding SystemNicknames.Enabled, Mode=TwoWay}"
                      Content="Use system nicknames" />
          </Grid>
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding SystemNicknames.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Codex reference images" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Use the original local-flora naming contract, retain an imported image cache, or download biology references for offline browsing." />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding CodexImages.CacheDirectory, Mode=TwoWay}"
                     PlaceholderText="Absolute cache directory" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Click="ChooseCodexCacheFolder_Click"
                    Content="Choose cache..." />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding CodexImages.LocalFloraDirectory, Mode=TwoWay}"
                     PlaceholderText="Optional local flora directory" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Click="ChooseLocalFloraFolder_Click"
                    Content="Choose local images..." />
          </Grid>
          <CheckBox IsChecked="{Binding CodexImages.PreDownload, Mode=TwoWay}"
                    Content="Pre-download all available biology images" />
          <ProgressBar IsIndeterminate="True"
                       IsVisible="{Binding CodexImages.IsPreDownloading}" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding CodexImages.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Dock-to-dock travel log" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Append live completed trips, jump distance, ingress and egress timing, ship details, and departure cargo using the original CSV columns." />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      IsChecked="{Binding DockToDock.Enabled, Mode=TwoWay}"
                      Content="Log dock-to-dock times to .csv file" />
          </Grid>
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding DockToDock.StatusMessage}" />
        </StackPanel>
      </Border>

      <Separator />

      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="SCREENSHOTS" />
        <TextBlock Classes="page-title" Text="Automatic conversion" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="Convert Elite Dangerous BMP screenshots into organized PNG files on Windows or Linux." />
      </StackPanel>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Screenshot processor" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Journal Screenshot events are matched to completed BMP files; each PNG is decoded and verified before it replaces or removes anything." />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      IsChecked="{Binding ScreenshotProcessing.Enabled, Mode=TwoWay}"
                      Content="Convert .bmp screenshots into .png files" />
          </Grid>

          <StackPanel Spacing="5">
            <TextBlock Classes="eyebrow" Text="SOURCE BMP FOLDER" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding ScreenshotProcessing.SourceFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                       PlaceholderText="Absolute folder containing Elite screenshots" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Click="ChooseScreenshotSourceFolder_Click"
                      Content="Choose folder" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Classes="eyebrow" Text="TARGET PNG FOLDER" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Text="{Binding ScreenshotProcessing.TargetFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                       PlaceholderText="Absolute destination for converted screenshots" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Click="ChooseScreenshotTargetFolder_Click"
                      Content="Choose folder" />
            </Grid>
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
            <StackPanel Spacing="10">
              <CheckBox IsChecked="{Binding ScreenshotProcessing.AddBanner, Mode=TwoWay}"
                        Content="Embed location details within image, if known" />
              <CheckBox IsChecked="{Binding ScreenshotProcessing.BannerLocalTime, Mode=TwoWay}"
                        Content="Use local time" />
              <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" Text="Banner colour" />
                <TextBox Grid.Column="1"
                         Text="{Binding ScreenshotProcessing.BannerColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         PlaceholderText="#FFFF00" />
              </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="10">
              <CheckBox IsChecked="{Binding ScreenshotProcessing.DeleteOriginal, Mode=TwoWay}"
                        Content="Remove original files after conversion" />
              <CheckBox IsChecked="{Binding ScreenshotProcessing.UseGuardianAerialFolder, Mode=TwoWay}"
                        Content="Save Ruins aerial screenshots into site-type sub-folders" />
              <CheckBox IsChecked="{Binding ScreenshotProcessing.RotateAlphaAerial, Mode=TwoWay}"
                        IsEnabled="{Binding ScreenshotProcessing.UseGuardianAerialFolder}"
                        Content="Rotate Alpha site screenshots by 90° and truncate." />
              <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                         TextWrapping="Wrap"
                         Text="Deletion occurs only after the PNG has been written atomically and reopened with matching dimensions." />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Aerial copies need to be within 50 m of site origin, altitude 500–2000 m (e.g. 'Aerial alpha'). Alt+Ctrl+I toggles data banners for future screenshots." />
            </StackPanel>
          </Grid>

          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding ScreenshotProcessing.StatusMessage}" />
        </StackPanel>
      </Border>

      <Separator />

      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="PRIVACY" />
        <TextBlock Classes="page-title" Text="Network publication" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="All publication remains off unless you explicitly enable it. Imported profiles retain the original choices." />
      </StackPanel>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Classes="card-title" Text="EDDN" />
                <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center">
                  <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                             FontWeight="SemiBold"
                             Text="OPT-IN" />
                </Border>
              </Grid>
              <CheckBox IsChecked="{Binding NetworkPrivacy.EddnUploadEnabled, Mode=TwoWay}"
                        Content="Share supported live data with EDDN" />
              <CheckBox IsChecked="{Binding NetworkPrivacy.EddnUseTestSchemas, Mode=TwoWay}"
                        IsEnabled="{Binding NetworkPrivacy.EddnUploadEnabled}"
                        Content="Use EDDN test schemas" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Shares supported new journal events, signal batches, market, outfitting, shipyard, Fleet Carrier material, and navigation-route data. Startup history and multicrew activity are never uploaded." />
              <TextBlock Classes="muted"
                          TextWrapping="Wrap"
                          Text="All uploads use the live EDDN gateway. Enable test schemas only for uploader testing or non-live game data; test-schema messages are not consumed as production data. No EDDN account, API key, or token is required." />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="When multiple Elite windows are detected, EDDN queueing and delivery pause without deleting pending uploads. Only one SrvSurvey process can own the durable outbox at a time." />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
              <TextBlock Classes="card-title" Text="Spansh lookup" />
              <CheckBox IsChecked="{Binding JumpInfo.UseSpanshLastUpdated, Mode=TwoWay}"
                        Content="Use last updated time from Spansh not EDSM" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Uses the Spansh system timestamp instead of the newest EDSM body timestamp in Jump Info and Galaxy Map summaries. This is a read-only lookup and does not publish journal data." />
              <Separator Margin="0,4" />
              <TextBlock Classes="card-title" Text="Green Gas Giants" />
              <CheckBox IsChecked="{Binding NetworkPrivacy.UploadGreenGasGiantCandidates, Mode=TwoWay}"
                        Content="Upload GGG candidates" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="When enabled, matching live Scan journal events include commander name, system coordinates, and the original scan payload. Startup history is never uploaded." />
              <Button Classes="secondary"
                      HorizontalAlignment="Left"
                      Click="OpenGreenGasGiantGuide_Click"
                      Content="Open Green Gas Giant guide" />
            </StackPanel>
          </Grid>
          <Separator />
          <StackPanel Spacing="8">
            <TextBlock Classes="card-title" Text="Human settlements" />
            <CheckBox IsChecked="{Binding NetworkPrivacy.UploadHumanSettlementGeometry, Mode=TwoWay}"
                      Content="Upload newly calculated settlement geometry to Canonn" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="When enabled, only a new live docking or manual alignment uploads the settlement identity, coordinates, pad layout, commander position, ship type, and calculated heading. Imported data, startup history, and Canonn lookups are never republished." />
          </StackPanel>
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     IsVisible="{Binding NetworkPrivacy.HasStatusMessage}"
                     TextWrapping="Wrap"
                     Text="{Binding NetworkPrivacy.StatusMessage}" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding SettingsLinkStatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Inara" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Share supported live commander activity using the active commander's personal Inara API key." />
            </StackPanel>
            <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center">
              <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                         FontWeight="SemiBold"
                         Text="OPT-IN" />
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
            <StackPanel Spacing="12">
              <CheckBox IsChecked="{Binding Inara.UploadEnabled, Mode=TwoWay}"
                        Content="Upload supported commander data to Inara" />
              <CheckBox IsChecked="{Binding Inara.DeveloperTestMode, Mode=TwoWay}"
                        IsEnabled="{Binding Inara.UploadEnabled}"
                        Content="Developer test mode" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Developer test mode is off by default. Enable it for the initial live verification; once Artie confirms the application for production on Inara, leave it off." />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="New live events are batched for about 35 seconds. Credit changes are reconstructed from journal transactions and coalesced to Inara's hourly recommendation, with session-boundary updates." />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="10">
              <TextBlock FontWeight="SemiBold"
                         Text="{Binding Inara.CommanderDisplayName}" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding Inara.ApiKey, Mode=TwoWay}"
                         PasswordChar="*"
                         IsEnabled="{Binding Inara.HasCommanderProfile}"
                         PlaceholderText="Personal Inara API key" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Command="{Binding Inara.SaveApiKeyCommand}"
                        Content="Save key" />
                <Button Grid.Column="2"
                        Classes="secondary"
                        Click="OpenInaraApiKeyPage_Click"
                        Content="Get API key" />
              </Grid>
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{Binding Inara.CredentialStatus}" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="The personal key is stored only in this commander profile. No application token is embedded or required for write events." />
            </StackPanel>
          </Grid>

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Startup history, Legacy/alpha/beta sessions, and multicrew activity are not uploaded. With multiple Elite windows, shared Cargo.json, ShipLocker.json, and Status.json data is suppressed while attributable journal activity continues for this instance's commander." />
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     IsVisible="{Binding Inara.HasPublicationStatus}"
                     TextWrapping="Wrap"
                     Text="{Binding Inara.PublicationStatus}" />
        </StackPanel>
      </Border>

      <Separator />

      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="INPUT" />
        <TextBlock Classes="page-title" Text="Global shortcuts" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="Use the original SrvSurvey shortcuts while either this application or Elite Dangerous has focus." />
      </StackPanel>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Keyboard hook" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Keyboard capture stays off until you enable it here. Synthetic key events are ignored." />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      IsChecked="{Binding InputSettings.KeyboardEnabled, Mode=TwoWay}"
                      IsEnabled="{Binding InputSettings.IsKeyboardAvailable}"
                      Content="Enable key chords" />
          </Grid>
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding InputSettings.RuntimeStatus}" />
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     IsVisible="{Binding InputSettings.HasPersistenceStatus}"
                     TextWrapping="Wrap"
                     Text="{Binding InputSettings.PersistenceStatus}" />
          <TextBlock Classes="muted"
                     IsVisible="{Binding InputSettings.HasLastActionStatus}"
                     TextWrapping="Wrap"
                     Text="{Binding InputSettings.LastActionStatus}" />
        </StackPanel>
      </Border>

      <Expander HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False">
        <Expander.Header>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="3">
              <TextBlock Classes="card-title" Text="Shortcut bindings" />
              <TextBlock Classes="muted"
                         Text="Expand to edit all original keyboard actions." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding InputSettings.ResetBindingsCommand}"
                    Content="Restore defaults" />
          </Grid>
        </Expander.Header>
        <ItemsControl Margin="0,14,0,0"
                      ItemsSource="{Binding InputSettings.Bindings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InputBindingViewModel">
              <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="4,12">
                <Grid ColumnDefinitions="*,220" ColumnSpacing="20">
                  <StackPanel Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding Description}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBox Text="{Binding Chord, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             PlaceholderText="Leave blank to disable" />
                    <TextBlock Classes="muted"
                               FontSize="10"
                               Text="{Binding DefaultChord}" />
                    <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                               FontSize="10"
                               IsVisible="{Binding HasValidationError}"
                               TextWrapping="Wrap"
                               Text="{Binding ValidationMessage}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Controller input" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="SDL supports standard gamepads, joysticks, and HOTAS devices. Input is accepted while SrvSurvey or Elite Dangerous has focus." />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      VerticalAlignment="Center"
                      IsChecked="{Binding InputSettings.ControllerEnabled, Mode=TwoWay}"
                      IsEnabled="{Binding InputSettings.CanEnableControllerInput}"
                      Content="Enable controller/joystick key chords" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ComboBox MinWidth="360"
                      ItemsSource="{Binding InputSettings.ControllerDevices}"
                      SelectedItem="{Binding InputSettings.SelectedController, Mode=TwoWay}"
                      PlaceholderText="Select a connected controller">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ControllerDeviceOptionViewModel">
                  <StackPanel Margin="4" Spacing="2">
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding DisplayName}" />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               Text="{Binding Description}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding InputSettings.RefreshControllersCommand}"
                    Content="Refresh devices" />
          </Grid>

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding InputSettings.ControllerDiscoveryStatus}" />
          <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding InputSettings.ControllerRuntimeStatus}" />
        </StackPanel>
      </Border>

      <Separator />

      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="DATA &amp; MIGRATION" />
        <TextBlock Classes="page-title" Text="Data sources and migration" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="Bring settings, commander state, surveys, routes, journeys, caches, and every other legacy profile file into the cross-platform application." />
      </StackPanel>

      <Border Classes="card raised">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Elite journal source" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Use a persisted folder for non-default Windows installations, Proton prefixes, and copied profiles." />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding JournalSettings.DirectoryPath, Mode=TwoWay}"
                     IsEnabled="{Binding !JournalSettings.IsCommandLineOverride}"
                     PlaceholderText="Elite Dangerous journal folder" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    IsEnabled="{Binding !JournalSettings.IsCommandLineOverride}"
                    Click="ChooseJournalFolder_Click"
                    Content="Choose folder" />
          </Grid>
          <Button Classes="primary"
                  HorizontalAlignment="Left"
                  Command="{Binding JournalSettings.SaveAndRestartCommand}"
                  Content="Save journal folder and restart" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding JournalSettings.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border x:Name="LegacyImportSection"
              Classes="card raised">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="5">
              <TextBlock Classes="card-title" Text="Detected source" />
              <ComboBox MinWidth="360"
                        ItemsSource="{Binding LegacyProfiles}"
                        SelectedItem="{Binding SelectedLegacyProfile}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LegacyProfileOptionViewModel">
                    <StackPanel Margin="4" Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                      <TextBlock Classes="muted"
                                 FontSize="11"
                                 Text="{Binding Path}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding LegacyProfileSourcePath, Mode=TwoWay}"
                         PlaceholderText="Path to the original SrvSurvey profile" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Click="ChooseLegacyProfileFolder_Click"
                        Content="Choose folder" />
              </Grid>
              <TextBlock Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Text="Automatic detection is available on Windows. Use Choose folder for copied profiles, older installs, or migration on Linux." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="primary"
                    VerticalAlignment="Bottom"
                    Command="{Binding ImportLegacyProfileCommand}"
                    Content="{Binding ImportProfileButtonText}" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="6">
            <TextBlock Classes="muted" Text="New profile" />
            <TextBlock Grid.Column="1"
                       TextWrapping="Wrap"
                       Text="{Binding ProfileDataDirectory}" />
            <TextBlock Grid.Row="1" Classes="muted" Text="Backups" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       TextWrapping="Wrap"
                       Text="{Binding ProfileBackupDirectory}" />
          </Grid>

          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     TextWrapping="Wrap"
                     Text="{Binding ProfileStatusMessage}" />
          <TextBlock Classes="muted"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="A successful import restarts SrvSurvey automatically so no pre-import in-memory state can overwrite migrated data." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
