<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.CockpitPanelAngleView"
             x:DataType="vm:CockpitOverlayViewModel">
  <Grid Margin="0,10,0,4" ColumnDefinitions="140,*" ColumnSpacing="16">
    <StackPanel Spacing="5">
      <controls:PanelRotationOrb Width="130" Height="130"
          Yaw="{Binding Yaw, Mode=TwoWay}"
          Pitch="{Binding Pitch, Mode=TwoWay}"
          Roll="{Binding Roll, Mode=TwoWay}"
          Depth="{Binding Depth, Mode=TwoWay}"
          Accent="{DynamicResource RavenAccentBrush}"
          GuideBrush="{DynamicResource RavenBorderBrush}"
          PanelBrush="{DynamicResource RavenSurfaceBrush}"
          AutomationProperties.Name="Panel rotation"
          ToolTip.Tip="Drag the center to tilt; drag the rim to roll. Arrow keys tilt, Control plus Left or Right rolls; Shift changes by five degrees." />
      <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                 Text="Drag center to tilt. Drag rim to roll." />
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="8">
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
        <StackPanel Spacing="3">
          <TextBlock Text="Yaw (°)" />
          <NumericUpDown MinWidth="0" Minimum="-85" Maximum="85" Increment="1" FormatString="0"
                         Value="{Binding Yaw, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="3">
          <TextBlock Text="Pitch (°)" />
          <NumericUpDown MinWidth="0" Minimum="-85" Maximum="85" Increment="1" FormatString="0"
                         Value="{Binding Pitch, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="3">
          <TextBlock Text="Roll (°)" />
          <NumericUpDown MinWidth="0" Minimum="-180" Maximum="180" Increment="1" FormatString="0"
                         Value="{Binding Roll, Mode=TwoWay}" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,126" ColumnSpacing="12" ToolTip.Tip="Greater distance makes this panel smaller, as it would in VR.">
        <StackPanel Spacing="3">
          <TextBlock Text="Panel distance" />
          <Slider Minimum="0.25" Maximum="5" SmallChange="0.05"
                  Value="{Binding Depth, Mode=TwoWay}" />
        </StackPanel>
        <NumericUpDown MinWidth="0" Grid.Column="1" Minimum="0.25" Maximum="5" Increment="0.05" FormatString="0.00"
                       Value="{Binding Depth, Mode=TwoWay}" VerticalAlignment="Bottom" />
      </Grid>
      <Button Classes="secondary" Content="Reset angle and depth" Command="{Binding ResetPanelCommand}" />
      <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                 Text="The orb previews this panel's perspective. Save or cancel with the editor toolbar; headset calibration is separate." />
    </StackPanel>
  </Grid>
</UserControl>
