<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:SrvSurvey.Core.Frontier"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             x:Class="SrvSurvey.Desktop.Views.FrontierCommanderTabView"
             x:DataType="vm:CommanderProfileViewModel"
             Classes="commander-readout" SizeChanged="Readout_SizeChanged">
  <ScrollViewer x:Name="CommanderScroller" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,14,8,18" Spacing="20">
      <Border x:Name="CommanderFlightReadout" Classes="flight-readout">
        <StackPanel Spacing="16">
          <Grid x:Name="FlightLayout" ColumnDefinitions="Auto,1.4*,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="14">
            <Image Width="60" Height="60" VerticalAlignment="Top" Margin="0,4,0,0"
                   IsVisible="{Binding HasFactionIcon}"
                   Source="{Binding FactionIconPath, Converter={StaticResource FrontierAssetImageConverter}}" Stretch="Uniform" />
            <StackPanel x:Name="FlightLocation" Grid.Column="1" Spacing="5">
              <TextBlock Classes="console-label" Text="Current location" />
              <TextBlock x:Name="CommanderLocation" Classes="flight-location" Text="{Binding CurrentLocation}" TextWrapping="Wrap" />
              <WrapPanel ItemSpacing="16" LineSpacing="4">
                <TextBlock FontWeight="SemiBold" Text="{Binding CommanderState}" />
                <TextBlock Classes="muted" Text="{Binding LocationAllegiance}" />
              </WrapPanel>
            </StackPanel>
            <StackPanel x:Name="FlightShip" Grid.Column="2" Spacing="7">
              <TextBlock Classes="console-label" Text="Current ship" />
              <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CurrentShipDescription}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding CurrentShipHealth}" />
            </StackPanel>
          </Grid>
          <WrapPanel ItemSpacing="16" LineSpacing="5">
            <TextBlock Classes="console-label" Text="Last docked services" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding StationServices}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="14" LineSpacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock FontSize="12" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="finance-readout">
        <controls:ResponsiveColumnsPanel x:Name="CommanderFinance" MaximumColumns="4" MinimumColumnWidth="200" Spacing="14">
          <StackPanel Classes="finance-item">
            <TextBlock Classes="console-label" Text="Available balance" />
            <TextBlock Classes="console-value" TextWrapping="Wrap" Text="{Binding Balance}" />
          </StackPanel>
          <StackPanel Classes="finance-item">
            <TextBlock Classes="console-label" Text="Estimated net worth" />
            <TextBlock Classes="console-value" TextWrapping="Wrap" Text="{Binding NetWorth}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Cash, fleet and carrier bank" />
          </StackPanel>
          <StackPanel Classes="finance-item">
            <TextBlock Classes="console-label" Text="Fleet value" />
            <TextBlock Classes="console-value" TextWrapping="Wrap" Text="{Binding FleetValue}" />
            <TextBlock Classes="muted" FontSize="11" Text="{Binding FleetCount}" />
          </StackPanel>
          <StackPanel x:Name="CommanderDebt" Classes="finance-item" IsVisible="{Binding HasDebt}">
            <TextBlock Classes="console-label" Text="Debt" />
            <TextBlock Classes="console-value" TextWrapping="Wrap" Text="{Binding Debt}" />
          </StackPanel>
        </controls:ResponsiveColumnsPanel>
      </Border>

      <StackPanel Spacing="2">
        <TextBlock Classes="card-title" Text="Ranks" />
        <ItemsControl x:Name="CommanderRanks" ItemsSource="{Binding Ranks}" SizeChanged="Ranks_SizeChanged">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FrontierRankCardViewModel">
              <Border Classes="rank-card commander-rank" ToolTip.Tip="{Binding Source}">
                <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                  <Panel Width="52" Height="52" VerticalAlignment="Center">
                    <Image IsVisible="{Binding HasOriginalIcon}" Source="{Binding IconPath, Converter={StaticResource FrontierAssetImageConverter}}" Stretch="Uniform" />
                    <Border Classes="theme-rank-emblem" IsVisible="{Binding HasThemeIconTint}" Background="{DynamicResource RavenTextBrush}">
                      <Border.OpacityMask>
                        <ImageBrush Source="{Binding IconPath, Converter={StaticResource FrontierAssetImageConverter}}" Stretch="Uniform" />
                      </Border.OpacityMask>
                    </Border>
                    <Border IsVisible="{Binding HasIconTint}" Background="{Binding IconTint}">
                      <Border.OpacityMask>
                        <ImageBrush Source="{Binding IconPath, Converter={StaticResource FrontierAssetImageConverter}}" Stretch="Uniform" />
                      </Border.OpacityMask>
                    </Border>
                  </Panel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                      <TextBlock Classes="console-label" VerticalAlignment="Center" Text="{Binding Category}" />
                      <Image Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                             IsVisible="{Binding HasRankBadge}" Source="{Binding RankBadgeIconPath, Converter={StaticResource FrontierAssetImageConverter}}"
                             RenderOptions.BitmapInterpolationMode="HighQuality" Stretch="Uniform" />
                    </Grid>
                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding RankText}" IsVisible="{Binding HasDetail}" />
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding MeritsText}" IsVisible="{Binding HasMerits}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid x:Name="CommanderSupport" ColumnDefinitions="*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="18">
        <Expander x:Name="CommanderReputation" Classes="profile-section console-section" HorizontalAlignment="Stretch"
                  IsExpanded="{Binding PaneStates.CommanderFactionReputation.IsExpanded, Mode=TwoWay}">
          <Expander.Header><TextBlock Text="{Binding CommanderReputation.Count, StringFormat=Faction reputation ({0})}" /></Expander.Header>
          <ItemsControl ItemsSource="{Binding CommanderReputation}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FrontierReputationRowViewModel">
                <Border Classes="console-data-row">
                  <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                    <Image Width="30" Height="30" Source="{Binding IconPath, Converter={StaticResource FrontierAssetImageConverter}}" Stretch="Uniform" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Faction}" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Score}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
        <Expander x:Name="CommanderFleet" Grid.Column="1" Classes="profile-section console-section" HorizontalAlignment="Stretch"
                  IsExpanded="{Binding PaneStates.CommanderOwnedFleet.IsExpanded, Mode=TwoWay}">
          <Expander.Header>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="Owned fleet" />
              <TextBlock Grid.Column="1" Classes="muted" Text="{Binding FleetCount}" />
            </Grid>
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding Ships}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FrontierShipRowViewModel">
                <Border Classes="console-data-row">
                  <Grid ColumnDefinitions="1.2*,*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Text="{Binding Name}" />
                      <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding Type}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Classes="muted" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Text="{Binding Location}" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding Status}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding Value}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </Grid>

      <StackPanel Spacing="9" IsVisible="{Binding HasCapabilities}">
        <TextBlock Classes="console-label" Text="Account capabilities" />
        <ItemsControl ItemsSource="{Binding Capabilities}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="16" LineSpacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock FontSize="12" Text="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Expander Classes="profile-section console-section" HorizontalAlignment="Stretch"
                IsExpanded="{Binding PaneStates.CommanderProfileData.IsExpanded, Mode=TwoWay}">
        <Expander.Header><TextBlock Text="{Binding ProfileData.Count, StringFormat=All profile data points ({0})}" /></Expander.Header>
        <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding ProfileData}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:FrontierDataPointSnapshot">
                <Border Classes="console-data-row">
                  <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="12">
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding Path}" />
                    <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Text="{Binding Value}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
