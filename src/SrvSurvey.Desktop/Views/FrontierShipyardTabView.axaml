<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="using:SrvSurvey.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SrvSurvey.Desktop.Views.FrontierShipyardTabView" x:DataType="vm:CommanderProfileViewModel" Classes="commander-subpage" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:core="using:SrvSurvey.Core.Frontier">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" x:Name="FrontierPageScroller">
    <StackPanel Margin="0,14,8,18" Spacing="22">
      <Border Classes="card" IsVisible="{Binding HasShipyardError}">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Shipyard update warning" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ShipyardError}" />
        </StackPanel>
      </Border>
      <Border Classes="card console-page-header">
        <StackPanel Spacing="4">
          <TextBlock Classes="console-label" Text="Shipyard &amp; outfitting" />
          <TextBlock Text="{Binding ShipyardTitle}" Classes="console-page-title" TextWrapping="Wrap" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ShipyardSubtitle}" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding !HasShipyard}">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="Shipyard and outfitting information becomes available after Frontier has a supported last-docked station for the commander." />
      </Border>
      <StackPanel IsVisible="{Binding HasShipyard}" Spacing="16">
        <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.ShipyardShips.IsExpanded, Mode=TwoWay}">
          <Expander.Header>
            <TextBlock Text="{Binding ShipyardShips.Count, StringFormat=Ships for sale ({0})}" />
          </Expander.Header>
          <ScrollViewer x:Name="ShipyardShipsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="460" Focusable="True">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="8">
              <Grid ColumnSpacing="12" Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="220" SharedSizeGroup="ShipSaleName" />
                  <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="ShipSalePrice" />
                  <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="ShipSaleStock" />
                  <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="ShipSaleSku" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="table-heading" Text="Ship" />
                <TextBlock Grid.Column="1" Classes="table-heading" Text="Price" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Classes="table-heading" Text="Stock" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Classes="table-heading" Text="SKU" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ShipyardShips}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FrontierShipForSaleRowViewModel">
                    <Border Classes="dashboard-row">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" MinWidth="220" SharedSizeGroup="ShipSaleName" />
                          <ColumnDefinition Width="Auto" MinWidth="120" SharedSizeGroup="ShipSalePrice" />
                          <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="ShipSaleStock" />
                          <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="ShipSaleSku" />
                        </Grid.ColumnDefinitions>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding Price}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding Stock}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Classes="muted" TextWrapping="Wrap" Text="{Binding Sku}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Expander>
        <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.ShipyardModules.IsExpanded, Mode=TwoWay}">
          <Expander.Header>
            <TextBlock Text="{Binding ShipyardModules.Count, StringFormat=Outfitting modules ({0})}" />
          </Expander.Header>
          <ScrollViewer x:Name="ShipyardModulesScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="460" Focusable="True">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="8">
              <Grid ColumnSpacing="12" Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="ModuleCategory" />
                  <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="ModuleName" />
                  <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="ModulePrice" />
                  <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="ModuleStock" />
                  <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="ModuleSku" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="table-heading" Text="Category" />
                <TextBlock Grid.Column="1" Classes="table-heading" Text="Module" />
                <TextBlock Grid.Column="2" Classes="table-heading" Text="Price" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Classes="table-heading" Text="Stock" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Classes="table-heading" Text="SKU" />
              </Grid>
              <ItemsControl ItemsSource="{Binding ShipyardModules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FrontierOutfittingModuleRowViewModel">
                    <Border Classes="dashboard-row">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="ModuleCategory" />
                          <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="ModuleName" />
                          <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="ModulePrice" />
                          <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="ModuleStock" />
                          <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="ModuleSku" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Category}" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Name}" />
                        <TextBlock Grid.Column="2" Text="{Binding Price}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding Stock}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Classes="muted" TextWrapping="Wrap" Text="{Binding Sku}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Expander>
        <controls:ResponsiveColumnsPanel MinimumColumnWidth="340" MaximumColumns="2" Spacing="24">
          <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.ShipyardServices.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <TextBlock Text="{Binding ShipyardServices.Count, StringFormat=Station services ({0})}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding ShipyardServices}" Margin="8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:FrontierNamedValueSnapshot">
                  <Border Classes="dashboard-row compact">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock TextWrapping="Wrap" Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Value}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.ShipyardData.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <TextBlock Text="{Binding ShipyardData.Count, StringFormat=All shipyard data points ({0})}" />
            </Expander.Header>
            <ScrollViewer MaxHeight="500" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ShipyardData}" Margin="8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:FrontierDataPointSnapshot">
                    <Border Classes="dashboard-row compact">
                      <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="12">
                        <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding Path}" />
                        <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding Value}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>
        </controls:ResponsiveColumnsPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
