<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="using:SrvSurvey.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SrvSurvey.Desktop.Views.FrontierCommunityGoalsTabView" x:DataType="vm:CommanderProfileViewModel" Classes="commander-subpage" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:core="using:SrvSurvey.Core.Frontier">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" x:Name="FrontierPageScroller">
    <StackPanel Margin="0,14,8,18" Spacing="22">
      <Border Classes="card" IsVisible="{Binding HasCommunityGoalsError}">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Community Goals update warning" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding CommunityGoalsError}" />
        </StackPanel>
      </Border>
      <Border Classes="card console-page-header">
        <StackPanel Spacing="4">
          <TextBlock Classes="console-label" Text="Community goals" />
          <TextBlock Text="Galactic initiatives" Classes="console-page-title" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding CommunityGoalsMessage}" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding !HasCommunityGoals}">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="There are no active or recently completed Community Goals associated with this commander right now." />
      </Border>
      <ItemsControl ItemsSource="{Binding CommunityGoals}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FrontierCommunityGoalCardViewModel">
            <Border Classes="console-goal" Margin="0,0,0,12">
              <StackPanel Spacing="14">
                <controls:ResponsiveColumnsPanel MinimumColumnWidth="260" MaximumColumns="2" Spacing="16">
                  <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="console-label" Text="{Binding GoalReference}" />
                      <TextBlock Classes="console-label" Text="·" />
                      <TextBlock Classes="console-label" Text="{Binding Activity}" />
                    </StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                  </StackPanel>
                  <Border Classes="detail-tile" Padding="12,8" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="console-label" Text="{Binding Status}" />
                    </StackPanel>
                  </Border>
                </controls:ResponsiveColumnsPanel>
                <controls:ResponsiveColumnsPanel MinimumColumnWidth="220" MaximumColumns="3" Spacing="24">
                  <Border Classes="detail-tile" IsVisible="{Binding HasLocation}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="console-label" Text="Destination" />
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Market}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding System}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="detail-tile" IsVisible="{Binding HasObjective}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="console-label" Text="Objective" />
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Objective}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Activity}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="detail-tile">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="console-label" Text="Deadline" />
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Expiry}" />
                      <TextBlock Classes="muted" Text="{Binding TimeRemaining}" />
                    </StackPanel>
                  </Border>
                </controls:ResponsiveColumnsPanel>
                <Border Classes="detail-tile">
                  <StackPanel Spacing="8">
                    <controls:ResponsiveColumnsPanel MinimumColumnWidth="260" MaximumColumns="2" Spacing="16">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="console-label" Text="Global progress" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ProgressText}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ProgressPercent}" />
                        <TextBlock Classes="muted" IsVisible="{Binding HasTarget}" Text="{Binding RemainingText}" />
                      </StackPanel>
                    </controls:ResponsiveColumnsPanel>
                    <ProgressBar Minimum="0" Maximum="100" Height="10" Value="{Binding Progress}" />
                  </StackPanel>
                </Border>
                <controls:ResponsiveColumnsPanel MinimumColumnWidth="220" MaximumColumns="3" Spacing="24">
                  <Border Classes="detail-tile">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="console-label" Text="Your contribution" />
                      <TextBlock TextWrapping="Wrap" Text="{Binding PlayerContribution}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PlayerStanding}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="detail-tile">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="console-label" Text="Community" />
                      <TextBlock Text="{Binding Contributors}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="detail-tile">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="console-label" Text="Current tier" />
                      <TextBlock TextWrapping="Wrap" Text="{Binding Tier}" />
                    </StackPanel>
                  </Border>
                </controls:ResponsiveColumnsPanel>
                <Border Classes="detail-tile" IsVisible="{Binding HasBriefing}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="console-label" Text="Mission briefing" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22" Text="{Binding Briefing}" MaxWidth="680" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
                <Border Classes="detail-tile" IsVisible="{Binding HasReward}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="console-label" Text="Reward" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding Reward}" />
                  </StackPanel>
                </Border>
                <TextBlock Classes="muted" FontSize="11" IsVisible="{Binding HasSourceStatus}" TextWrapping="Wrap" Text="{Binding SourceStatus}" />
                <Expander Classes="profile-subsection" IsExpanded="{Binding PaneState.IsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <TextBlock Text="{Binding DataPoints.Count, StringFormat=Raw endpoint fields ({0})}" />
                  </Expander.Header>
                  <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DataPoints}" Margin="8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:FrontierDataPointSnapshot">
                          <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="12" Margin="4,3">
                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding Path}" />
                            <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding Value}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.CommunityResponseData.IsExpanded, Mode=TwoWay}">
        <Expander.Header>
          <TextBlock Text="{Binding CommunityGoalsData.Count, StringFormat=All Community Goals response data ({0})}" />
        </Expander.Header>
        <ScrollViewer MaxHeight="500" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding CommunityGoalsData}" Margin="8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:FrontierDataPointSnapshot">
                <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="12" Margin="4,3">
                  <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding Path}" />
                  <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
