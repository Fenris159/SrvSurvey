<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:SrvSurvey.Core.Frontier"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.FrontierCommunityGoalsTabView"
             x:DataType="vm:CommanderProfileViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="4,16,4,18" Spacing="16">
      <Border Classes="card" IsVisible="{Binding HasCommunityGoalsError}">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Community Goals update warning" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding CommunityGoalsError}" />
        </StackPanel>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="4">
          <TextBlock Classes="eyebrow" Text="COMMUNITY GOALS" />
          <TextBlock FontSize="24" FontWeight="SemiBold" Text="Galactic initiatives" />
          <TextBlock Classes="muted" Text="{Binding CommunityGoalsMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding !HasCommunityGoals}">
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="There are no active or recently completed Community Goals associated with this commander right now." />
      </Border>

      <ItemsControl ItemsSource="{Binding CommunityGoals}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FrontierCommunityGoalCardViewModel">
            <Border Classes="card raised" Margin="0,0,0,12">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="5">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="eyebrow" Text="{Binding GoalReference}" />
                      <TextBlock Classes="eyebrow" Text="·" />
                      <TextBlock Classes="eyebrow" Text="{Binding Activity}" />
                    </StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" Text="{Binding Title}" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="detail-tile"
                          Padding="12,8" VerticalAlignment="Top">
                    <StackPanel Spacing="2" HorizontalAlignment="Right">
                      <TextBlock Classes="eyebrow" HorizontalAlignment="Right"
                                 Text="{Binding Status}" />
                      <TextBlock Classes="muted" HorizontalAlignment="Right"
                                 Text="{Binding TimeRemaining}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                  <Border Classes="detail-tile" IsVisible="{Binding HasLocation}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="eyebrow" Text="DESTINATION" />
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                 Text="{Binding Market}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="{Binding System}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="detail-tile"
                          IsVisible="{Binding HasObjective}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="eyebrow" Text="OBJECTIVE" />
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                 Text="{Binding Objective}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="{Binding Activity}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="detail-tile">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="eyebrow" Text="DEADLINE" />
                      <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                 Text="{Binding Expiry}" />
                      <TextBlock Classes="muted" Text="{Binding TimeRemaining}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="detail-tile">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="2">
                        <TextBlock Classes="eyebrow" Text="GLOBAL PROGRESS" />
                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                   Text="{Binding ProgressText}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Text="{Binding ProgressPercent}" />
                        <TextBlock Classes="muted" HorizontalAlignment="Right"
                                   IsVisible="{Binding HasTarget}" Text="{Binding RemainingText}" />
                      </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Height="10" Value="{Binding Progress}" />
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                  <Border Classes="detail-tile">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="eyebrow" Text="YOUR CONTRIBUTION" />
                      <TextBlock TextWrapping="Wrap" Text="{Binding PlayerContribution}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PlayerStanding}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="detail-tile">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="eyebrow" Text="COMMUNITY" />
                      <TextBlock Text="{Binding Contributors}" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="detail-tile">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="eyebrow" Text="CURRENT TIER" />
                      <TextBlock TextWrapping="Wrap" Text="{Binding Tier}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Classes="detail-tile" IsVisible="{Binding HasBriefing}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow" Text="MISSION BRIEFING" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22"
                               Text="{Binding Briefing}" />
                  </StackPanel>
                </Border>

                <Border Classes="detail-tile" IsVisible="{Binding HasReward}">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="REWARD" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding Reward}" />
                  </StackPanel>
                </Border>

                <Expander Classes="profile-subsection"
                          IsExpanded="{Binding PaneState.IsExpanded, Mode=TwoWay}">
                  <Expander.Header>
                    <TextBlock Text="{Binding DataPoints.Count, StringFormat=Raw endpoint fields ({0})}" />
                  </Expander.Header>
                  <ItemsControl ItemsSource="{Binding DataPoints}" Margin="8" MaxHeight="400">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:FrontierDataPointSnapshot">
                        <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="12" Margin="4,3">
                          <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding Path}" />
                          <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding Value}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Expander Classes="profile-section"
                IsExpanded="{Binding PaneStates.CommunityResponseData.IsExpanded, Mode=TwoWay}">
        <Expander.Header>
          <TextBlock Text="{Binding CommunityGoalsData.Count, StringFormat=All Community Goals response data ({0})}" />
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding CommunityGoalsData}" Margin="8" MaxHeight="500">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:FrontierDataPointSnapshot">
              <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="12" Margin="4,3">
                <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding Path}" />
                <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding Value}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
