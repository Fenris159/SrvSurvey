<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:views="using:SrvSurvey.Desktop.Views" xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors" x:Class="SrvSurvey.Desktop.Views.PowerplayAcquireSharedCluster" x:DataType="vm:PowerplayAcquireClusterViewModel">
  <Grid x:Name="ClusterGrid" ColumnDefinitions="Auto,40,Auto" MinWidth="1280" Margin="0,0,0,12">
    <StackPanel Grid.Column="0">
      <TextBlock Text="Sell Systems • Progress • State" Foreground="{DynamicResource RavenAccentBrush}" Margin="2,0,0,6"/>
      <ItemsControl x:Name="SellItems" ItemsSource="{Binding SellNodes}">
        <ItemsControl.Styles><Style Selector="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PowerplayAcquireSellNode">
            <Border x:Name="SellLinkAnchor" Classes="acquire-sell" Classes.selected="{Binding IsSelected}" Background="{DynamicResource RavenSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="1" Margin="0,0,0,8" Cursor="Hand">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto">
                <Border Grid.ColumnSpan="3" Classes="acquire-header first" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding SelectionGlyph}" Foreground="{DynamicResource RavenAccentBrush}" VerticalAlignment="Center"/>
                    <Button Classes="link" Padding="0" HorizontalAlignment="Left" behaviors:ClipboardCopyBehavior.Text="{Binding Row.Target}">
                      <TextBlock Text="{Binding Title}" TextWrapping="NoWrap"/>
                    </Button>
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Classes="acquire-header first">
                  <Button Classes="link" Padding="0" Command="{Binding SellDistanceSortCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="DST"/><TextBlock Text="{Binding SellDistanceSortIndicator}"/></StackPanel>
                  </Button>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Classes="acquire-header"><TextBlock Text="Power"/></Border>
                <Border Grid.Row="1" Grid.Column="2" Classes="acquire-header">
                  <Button Classes="link" Padding="0" Command="{Binding BestStationSortCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Best Sell Station"/><TextBlock Text="{Binding BestStationSortIndicator}"/></StackPanel>
                  </Button>
                </Border>
                <Border Grid.Row="2" Classes="acquire-cell"><TextBlock Text="{Binding Row.Distance}" Foreground="{DynamicResource RavenAccentBrush}" VerticalAlignment="Top"/></Border>
                <Border Grid.Row="2" Grid.Column="1" Classes="acquire-cell"><ItemsControl ItemsSource="{Binding Row.PowerLines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PowerplayPowerLineViewModel"><TextBlock Text="{Binding Display}" Foreground="{Binding ColorHex}" TextWrapping="NoWrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                <Border Grid.Row="2" Grid.Column="2" Classes="acquire-cell" Padding="0"><views:MiningStationList Stations="{Binding Row.VisibleStations}" ToggleCommand="{Binding Row.ToggleStationsCommand}" ToggleLabel="{Binding Row.StationToggleLabel}"/></Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Canvas x:Name="LinkCanvas" Grid.Column="1" IsHitTestVisible="False" ClipToBounds="False">
      <Path x:Name="InactiveLinks" Stroke="{DynamicResource RavenAccentBrush}" StrokeThickness="1.5" Opacity="0.28"/>
      <Path x:Name="ActiveLinks" Stroke="{DynamicResource RavenAccentBrush}" StrokeThickness="2.5"/>
    </Canvas>
    <StackPanel x:Name="MiningColumn" Grid.Column="2" VerticalAlignment="Top" MinWidth="650">
      <Grid ColumnDefinitions="28*,72*">
        <Border Classes="acquire-header first"><TextBlock Text="Mining System"/></Border>
        <Border Grid.Column="1" Classes="acquire-header"><TextBlock Text="Body Details"/></Border>
      </Grid>
      <ItemsControl x:Name="MiningItems" ItemsSource="{Binding VisibleMiningSystems}">
        <ItemsControl.Styles><Style Selector="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PowerplayAcquireMiningNode">
            <Border x:Name="MiningLinkAnchor" Background="{DynamicResource RavenSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="1,0,1,1" Opacity="{Binding EmphasisOpacity}">
              <Grid ColumnDefinitions="28*,72*">
                <Border Classes="acquire-cell">
                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Top">
                    <Button Classes="link" Width="18" Padding="0" FontSize="16" Content="{Binding Chevron}" Command="{Binding ToggleCommand}" IsVisible="{Binding HasAdditionalBodies}"/>
                    <Button Classes="link" HorizontalAlignment="Left" behaviors:ClipboardCopyBehavior.Text="{Binding System}"><TextBlock Text="{Binding System}" TextWrapping="Wrap"/></Button>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="acquire-cell">
                  <ItemsControl ItemsSource="{Binding VisibleBodies}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SurfaceBodyLine">
                        <StackPanel Margin="0,0,0,3">
                          <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SurfaceBodyTag"><Border Classes="commodity-code" Classes.matched="{Binding MatchesStation}" Classes.extra="{Binding IsExtraMaterial}" IsVisible="{Binding IsVisible}" Margin="0,0,4,2"><TextBlock Text="{Binding Code}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
