<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.GuardianView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <UserControl.Styles>
    <Style Selector="Expander.guardian-map-legend /template/ ToggleButton /template/ Border#ToggleButtonBackground">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Expander.guardian-map-legend.monochrome /template/ ToggleButton /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="#1C1C1C" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Expander.guardian-map-legend /template/ Border#ExpanderContent">
      <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
      <Setter Property="BorderThickness" Value="1,0,1,1" />
      <Setter Property="CornerRadius" Value="0,0,12,12" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="10,0,0,0" />
      <Setter Property="MinWidth" Value="290" />
      <Setter Property="MinHeight" Value="270" />
    </Style>
    <Style Selector="Expander.guardian-map-legend:expanded /template/ Border#ExpanderContent">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Expander.guardian-map-legend.monochrome /template/ Border#ExpanderContent">
      <Setter Property="Background" Value="#2B2B2B" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="20" MaxWidth="1050">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="5">
          <TextBlock Classes="eyebrow" Text="GUARDIAN" />
          <TextBlock Classes="page-title" Text="Guardian operations" />
          <TextBlock Classes="muted"
                     Text="Explore sites, review surveys, and track both Ram Tah research missions." />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="secondary"
                MinWidth="116"
                VerticalAlignment="Center"
                Command="{Binding Guardian.RefreshCommand}"
                Content="{Binding Guardian.RefreshButtonText}" />
      </Grid>

      <TabControl SelectedIndex="{Binding Guardian.SelectedWorkspaceTabIndex, Mode=TwoWay}">
        <TabItem Header="Sites &amp; surveys">
          <StackPanel Margin="0,16,0,0" Spacing="20">
      <Border Classes="card raised">
        <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="18">
          <Border Background="{DynamicResource RavenAccentBrush}"
                  CornerRadius="4" />
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Classes="eyebrow" Text="LIVE SITE" />
            <TextBlock Classes="card-title"
                       Text="{Binding Guardian.ActiveSiteTitle}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.ActiveSiteDescription}" />
            <WrapPanel Margin="0,5,0,0">
              <TextBlock Classes="monospace"
                         Margin="0,0,18,0"
                         Text="{Binding Guardian.ActiveSiteLocation}" />
              <TextBlock Classes="muted"
                         Text="{Binding Guardian.ActiveSiteVisit}" />
            </WrapPanel>
          </StackPanel>
          <Border Grid.Column="2"
                  Classes="badge"
                  VerticalAlignment="Top">
            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding Guardian.ActiveSiteReference}" />
          </Border>
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid x:Name="GuardianOriginAndCatalog"
              ColumnDefinitions="*,*"
              ColumnSpacing="24">
          <StackPanel Spacing="8">
            <Grid x:Name="GuardianOriginHeader"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="12">
              <TextBlock Classes="muted"
                         VerticalAlignment="Center"
                         Text="DISTANCE ORIGIN" />
              <StackPanel x:Name="GuardianOriginActions"
                          Grid.Column="1"
                          HorizontalAlignment="Right"
                          Orientation="Horizontal"
                          Spacing="8">
                <Button Classes="secondary"
                        Command="{Binding Guardian.LookupOriginCommand}"
                        Content="{Binding Guardian.OriginLookupButtonText}" />
                <Button Classes="secondary"
                        IsVisible="{Binding Guardian.HasCustomOrigin}"
                        Command="{Binding Guardian.ClearOriginCommand}"
                        Content="Use current" />
              </StackPanel>
            </Grid>
            <controls:SystemNameEntry
                HorizontalAlignment="Stretch"
                Text="{Binding Guardian.OriginSystemName, Mode=TwoWay}"
                PlaceholderText="System name or id64" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.OriginLookupStatus}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Classes="muted" Text="RAM TAH CATALOG DATA" />
            <StackPanel x:Name="GuardianRamTahOptions"
                        Orientation="Vertical"
                        Spacing="6">
              <CheckBox
                        IsChecked="{Binding Guardian.IncludeRamTahLogs, Mode=TwoWay}"
                        Content="Show logs available at each site" />
              <CheckBox
                        IsEnabled="{Binding Guardian.IncludeRamTahLogs}"
                        IsChecked="{Binding Guardian.ShowOnlyNeededRamTahLogs, Mode=TwoWay}"
                        Content="Show only logs still needed" />
            </StackPanel>
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Needed-only mode follows the active Ram Tah mission and commander checklist; inactive mission types show no log codes." />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="8,3*,2*" ColumnSpacing="18">
          <Border Background="{DynamicResource RavenAccentBrush}"
                  CornerRadius="4" />
          <StackPanel Grid.Column="1" Spacing="7">
            <TextBlock Classes="eyebrow" Text="LIVE SCANNER" />
            <TextBlock Classes="card-title"
                       Text="{Binding Guardian.CurrentObeliskTitle}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.CurrentObeliskLogText}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.NearbyPointText}" />
            <TextBlock Classes="monospace"
                       FontSize="11"
                       Text="{Binding Guardian.SiteDistanceText}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="10">
            <Border Classes="badge"
                    HorizontalAlignment="Left">
              <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                         FontWeight="SemiBold"
                         FontSize="11"
                         Text="{Binding Guardian.CurrentObeliskArtifactStatus}" />
            </Border>
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="REQUIRED ARTIFACTS" />
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding Guardian.CurrentObeliskRequirementsText}" />
            </StackPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.CurrentObeliskMissionStatus}" />
            <Button Classes="secondary"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding Guardian.HasCurrentObelisk}"
                    Command="{Binding Guardian.ToggleCurrentObeliskScannedCommand}"
                    Content="{Binding Guardian.ToggleCurrentObeliskScannedText}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card raised">
        <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="SEARCH" />
            <TextBox Text="{Binding Guardian.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="System, body, ID, address, type, or notes" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="muted" Text="SITE KIND" />
            <ComboBox ItemsSource="{Binding Guardian.KindFilters}"
                      SelectedItem="{Binding Guardian.SelectedKindFilter, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Classes="muted" Text="VISIT STATE" />
            <ComboBox ItemsSource="{Binding Guardian.VisitFilters}"
                      SelectedItem="{Binding Guardian.SelectedVisitFilter, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="6">
            <TextBlock Classes="muted" Text="SITE TYPE" />
            <ComboBox ItemsSource="{Binding Guardian.SiteTypeFilters}"
                      SelectedItem="{Binding Guardian.SelectedSiteTypeFilter, Mode=TwoWay}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card" Padding="0">
        <StackPanel>
          <TextBlock Margin="18,10,18,0"
                     Classes="muted"
                     FontSize="10"
                     Text="{Binding Guardian.SortStatusText}" />
          <ScrollViewer x:Name="GuardianSitesTableScroller"
                        Height="430"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <Grid Width="1480" RowDefinitions="Auto,Auto,Auto">
              <Grid x:Name="GuardianSitesTableHeader"
                    Margin="10,8"
                    ColumnDefinitions="72,200,100,90,90,105,110,55,65,80,170,250"
                    ColumnSpacing="8">
                <Button Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Id">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="ID" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.IdSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="System">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="SYSTEM" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.SystemSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Body">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="BODY" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.BodySortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Distance">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="DISTANCE" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.DistanceSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Arrival">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="ARRIVAL" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.ArrivalSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Visited">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="VISITED" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.VisitedSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="6" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Type">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="TYPE" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.TypeSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="7" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Index">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="INDEX" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.IndexSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="8" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Images">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="IMAGES" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.ImagesSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="9" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Survey">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="SURVEY" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.SurveySortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="10" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="RamTah">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="RAM TAH" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.RamTahSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="11" Classes="link" Padding="0" HorizontalContentAlignment="Left"
                        Command="{Binding Guardian.SortSitesCommand}" CommandParameter="Notes">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="table-heading" Text="NOTES" />
                    <TextBlock Classes="table-heading" Text="{Binding Guardian.NotesSortIndicator}" />
                  </StackPanel>
                </Button>
              </Grid>
              <Separator Grid.Row="1" />
              <ListBox Grid.Row="2"
                       Classes="table-rows"
                       Height="370"
                       BorderThickness="0"
                       Background="Transparent"
                       ItemsSource="{Binding Guardian.Rows}"
                       SelectedItem="{Binding Guardian.SelectedSite, Mode=TwoWay}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GuardianSiteRowViewModel">
                    <Grid Margin="10,5"
                          ColumnDefinitions="72,200,100,90,90,105,110,55,65,80,170,250"
                          ColumnSpacing="8">
                      <TextBlock Classes="monospace" VerticalAlignment="Center" Text="{Binding DisplayId}" />
                      <TextBlock Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Reference.SystemName}" />
                      <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Reference.BodyName}" />
                      <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding DistanceText}" />
                      <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding ArrivalText}" />
                      <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding VisitText}" />
                      <TextBlock Grid.Column="6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Text="{Binding Reference.SiteType}" />
                      <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{Binding Reference.Index}" />
                      <TextBlock Grid.Column="8" VerticalAlignment="Center" Text="{Binding ImagesText}" />
                      <TextBlock Grid.Column="9" VerticalAlignment="Center"
                                 Foreground="{DynamicResource RavenAccentBrush}" FontWeight="SemiBold"
                                 Text="{Binding SurveyText}" />
                      <TextBlock Grid.Column="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 Text="{Binding RamTahLogsText}" />
                      <TextBlock Grid.Column="11" Classes="muted" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Notes}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
        <Border Classes="card">
          <StackPanel Spacing="15">
            <ContentControl Content="{Binding Guardian.SelectedSite}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:GuardianSiteRowViewModel">
                  <StackPanel Spacing="15">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="3">
                        <Button Classes="link" HorizontalAlignment="Left"
                                behaviors:ClipboardCopyBehavior.Text="{Binding Reference.SystemName}">
                          <TextBlock Classes="card-title"
                                     Text="{Binding Reference.SystemName}" />
                        </Button>
                        <TextBlock Classes="muted" Text="{Binding Reference.BodyName}" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top">
                        <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                                   FontSize="11"
                                   Text="{Binding SiteDescription}" />
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="muted" Text="SYSTEM ADDRESS" />
                        <Button Classes="link" HorizontalAlignment="Left"
                                behaviors:ClipboardCopyBehavior.Text="{Binding Reference.SystemAddress}">
                          <TextBlock Classes="monospace"
                                     Text="{Binding Reference.SystemAddress, StringFormat='id64 {0}'}" />
                        </Button>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="muted" Text="ARRIVAL DISTANCE" />
                        <TextBlock Text="{Binding ArrivalText}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="muted" Text="GALACTIC POSITION" />
                      <TextBlock Classes="monospace" Text="{Binding GalacticPosition}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="muted" Text="SURFACE LOCATION" />
                      <TextBlock Classes="monospace" Text="{Binding SurfaceLocation}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <WrapPanel>
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSurvey}"
                      Command="{Binding Guardian.OpenSelectedSurveyCommand}"
                      Content="Open survey" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Command="{Binding Guardian.OpenShareWorkspaceCommand}"
                      Content="Share data" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopySystem_Click"
                      Content="Copy system" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopyBody_Click"
                      Content="Copy body" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopyAddress_Click"
                      Content="Copy address" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopyPosition_Click"
                      Content="Copy position" />
              <Button Classes="secondary"
                      Margin="0,0,0,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopySurface_Click"
                      Content="Copy lat/long" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopyNotes_Click"
                      Content="Copy notes" />
            </WrapPanel>
            <WrapPanel>
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="OpenCanonn_Click"
                      Content="Canonn Signals" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="OpenSpansh_Click"
                      Content="Spansh" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="OpenEdsm_Click"
                      Content="EDSM" />
              <Button Classes="secondary"
                      Margin="0,0,0,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="OpenImages_Click"
                      Content="Open images folder" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="card-title" Text="Commander record" />
            <ContentControl Content="{Binding Guardian.SelectedSite}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:GuardianSiteRowViewModel">
                  <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="muted" Text="VISIT" />
                      <TextBlock Text="{Binding VisitText}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="muted" Text="SURVEY" />
                      <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                                 FontWeight="SemiBold"
                                 Text="{Binding SurveyText}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <TextBlock Classes="muted" Text="NOTES / RELATED SITE" />
                      <TextBlock TextWrapping="Wrap" Text="{Binding Notes}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <StackPanel Spacing="4"
                        IsVisible="{Binding Guardian.IncludeRamTahLogs}">
              <TextBlock Classes="muted" Text="RAM TAH LOGS" />
              <ContentControl Content="{Binding Guardian.SelectedSite}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:GuardianSiteRowViewModel">
                    <TextBlock TextWrapping="Wrap" Text="{Binding RamTahLogsText}" />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="5">
          <TextBlock Classes="card-title" Text="Guardian data status" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding Guardian.Summary}" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding Guardian.OriginStatus}" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding Guardian.StatusMessage}" />
        </StackPanel>
      </Border>
          </StackPanel>
        </TabItem>

        <TabItem Header="Survey map">
          <StackPanel Margin="0,16,0,0" Spacing="18">
            <Grid x:Name="GuardianSurveyMapTop"
                  ColumnDefinitions="3*,2*"
                  ColumnSpacing="18">
              <Border Classes="card"
                      Padding="12"
                      VerticalAlignment="Top">
                <Grid RowDefinitions="640,Auto" RowSpacing="10">
                  <controls:GuardianSiteMapControl
                      x:Name="GuardianSurveyMap"
                      ClipToBounds="True"
                      Cursor="Hand"
                      AllowViewportInteraction="True"
                      Projection="{Binding Guardian.MapProjection}"
                      CommanderMapPosition="{Binding Guardian.SelectedMapCommanderPosition}"
                      Proximity="{Binding Guardian.SelectedMapCommanderPosition}"
                      CommanderHeading="{Binding Guardian.ActiveMapRelativeHeading}"
                      RotateMapWithCommander="False"
                      TargetPointName="{Binding Guardian.SelectedMapTargetPointName}"
                      HighlightedPointName="{Binding Guardian.SelectedMapPointName}"
                      SelectedPointName="{Binding Guardian.SurveyEditor.SelectedPointName, Mode=TwoWay}"
                      ShowLegend="False"
                      MapBackground="{DynamicResource RavenRaisedSurfaceBrush}"
                      GridBrush="{DynamicResource RavenBorderBrush}"
                      AccentBrush="{DynamicResource RavenAccentBrush}"
                      MutedBrush="{DynamicResource RavenMutedTextBrush}"
                      PresentBrush="{DynamicResource RavenSuccessBrush}"
                      AbsentBrush="{DynamicResource RavenDangerBrush}"
                      EmptyBrush="{DynamicResource RavenWarningBrush}" />
                  <Grid Grid.Row="1"
                        ColumnDefinitions="Auto,*,Auto,Auto"
                        ColumnSpacing="10">
                    <TextBlock Classes="eyebrow"
                               VerticalAlignment="Center"
                               Text="ZOOM" />
                    <Slider Grid.Column="1"
                            Minimum="1"
                            Maximum="15"
                            TickFrequency="0.1"
                            Value="{Binding ViewportZoom, ElementName=GuardianSurveyMap, Mode=TwoWay}"
                            ToolTip.Tip="1x fits the full map. Zoom in, then drag the map to pan." />
                    <TextBlock Grid.Column="2"
                               MinWidth="52"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding ViewportZoom, ElementName=GuardianSurveyMap, StringFormat='{}{0:N2}x'}" />
                    <StackPanel Grid.Column="3"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="4">
                      <TextBlock Classes="muted"
                                 VerticalAlignment="Center"
                                 Text="Orientation" />
                      <Button Classes="link"
                              Width="18"
                              Height="18"
                              Padding="2"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Guardian map orientation information"
                              ToolTip.Tip="The legacy aerial image is fixed to the Guardian site template's surveyed origin and scale. Site, tower, marker, and commander geometry uses that same alignment.">
                        <PathIcon Width="14"
                                  Height="14"
                                  Data="{StaticResource question_circle_regular}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>

              <StackPanel x:Name="GuardianSurveyMapSidebar"
                          Grid.Column="1"
                          Spacing="18">
                <Border x:Name="GuardianSurveyMapLegend"
                        Margin="0"
                        Padding="0"
                        IsVisible="{Binding Guardian.ShowMapLegend}">
                  <Expander x:Name="GuardianSurveyMapLegendExpander"
                            Classes="guardian-map-legend"
                            Classes.monochrome="{Binding IsMonochromeTheme}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False">
                    <Expander.Header>
                      <TextBlock Margin="20,16"
                                 Classes="card-title"
                                 Text="Map legend" />
                    </Expander.Header>
                    <controls:GuardianSiteMapControl
                        Height="270"
                        Margin="20,0,0,0"
                        ClipToBounds="True"
                        IsLegendOnly="True"
                        Projection="{Binding Guardian.MapProjection}"
                        ShowLegend="False"
                        MapBackground="{DynamicResource RavenSurfaceBrush}"
                        GridBrush="{DynamicResource RavenBorderBrush}"
                        AccentBrush="{DynamicResource RavenAccentBrush}"
                        MutedBrush="{DynamicResource RavenTextBrush}"
                        PresentBrush="{DynamicResource RavenSuccessBrush}"
                        AbsentBrush="{DynamicResource RavenDangerBrush}"
                        EmptyBrush="{DynamicResource RavenWarningBrush}" />
                  </Expander>
                </Border>

                <Border x:Name="GuardianSelectedMap"
                        Classes="card raised"
                        IsVisible="{Binding Guardian.SurveyEditor.IsMapSummaryVisible}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow" Text="SELECTED MAP" />
                    <TextBlock Classes="card-title"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.MapTitle}" />
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.MapSummary}" />
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.MapStatus}" />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Hover a marker to highlight it; click to select its survey details. At higher zoom, drag empty map space to pan." />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Gradient wedges mark active obelisks: gray is unscanned, orange is scanned, and cyan is still needed for Ram Tah." />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Map-layout tools are shared by every site of this type. Start with a blank map or edit the existing shared map; this site's heading, origin, notes, and observations are saved separately below." />
                    <WrapPanel IsVisible="{Binding Guardian.TemplateAuthoring.CanStart}">
                      <Button Classes="secondary"
                              Margin="0,0,8,8"
                              Command="{Binding Guardian.TemplateAuthoring.StartCommand}"
                              Content="Start map draft" />
                      <Button Classes="secondary"
                              Margin="0,0,0,8"
                              Command="{Binding Guardian.TemplateAuthoring.EditCommand}"
                              Content="Edit Current Map" />
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal">
                      <CheckBox Margin="0,0,14,0"
                                IsChecked="{Binding Guardian.ShowMapLegend, Mode=TwoWay}"
                                Content="Show legend" />
                      <CheckBox IsChecked="{Binding Guardian.ShowMapNotes, Mode=TwoWay}"
                                Content="Show notes" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border x:Name="GuardianSurveyPoints"
                        Classes="card raised"
                        IsVisible="{Binding Guardian.SurveyEditor.IsMapSummaryVisible}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="muted" Text="SURVEY POINTS" />
                    <ListBox Height="210"
                             ItemsSource="{Binding Guardian.SurveyEditor.Points}"
                             SelectedItem="{Binding Guardian.SurveyEditor.SelectedPoint, Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuardianSurveyPoiViewModel">
                          <Grid Margin="4,2"
                                ColumnDefinitions="44,78,*,Auto"
                                ColumnSpacing="6">
                            <TextBlock Classes="monospace"
                                       FontSize="12"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="1"
                                       Classes="muted"
                                       FontSize="12"
                                       Text="{Binding TypeText}" />
                            <TextBlock Grid.Column="2"
                                       Classes="muted"
                                       FontSize="12"
                                       Text="{Binding PositionText}" />
                            <TextBlock Grid.Column="3"
                                       FontSize="12"
                                       Text="{Binding Status}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>

                <Border x:Name="GuardianSelectedMapPointEditor"
                        Classes="card raised"
                        IsVisible="{Binding Guardian.SurveyEditor.HasSelectedMapMarker}">
                  <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow"
                               Text="SELECTED SURVEY POINT" />
                    <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                               IsVisible="{Binding Guardian.SurveyEditor.IsSelectedPointReadOnly}"
                               TextWrapping="Wrap"
                               Text="Reference marker preview. Survey values remain locked until you choose Start map draft or Edit Current Map; map geometry is shared by every site of this type." />
                    <StackPanel x:Name="GuardianSelectedTemplatePointEditor"
                                Spacing="10"
                                IsVisible="{Binding Guardian.TemplateAuthoring.HasSelectedPoint}">
                      <TextBlock Classes="muted"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Text="Map-point geometry is shared by every site of this type. Draft changes preview here and persist only through a verified catalog export." />
                      <StackPanel x:Name="GuardianSelectedTemplatePointFields"
                                  Spacing="8"
                                  IsEnabled="{Binding Guardian.TemplateAuthoring.IsAuthoring}">
                        <StackPanel x:Name="GuardianSelectedTemplateIdentityFields"
                                    Spacing="8">
                          <TextBox MinWidth="132"
                                   Text="{Binding Guardian.TemplateAuthoring.PointName, Mode=TwoWay}"
                                   PlaceholderText="Point name" />
                          <ComboBox MinWidth="132"
                                    ItemsSource="{Binding Guardian.TemplateAuthoring.PointTypes}"
                                    SelectedItem="{Binding Guardian.TemplateAuthoring.PointType, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <TextBlock Classes="muted"
                                     MinWidth="72"
                                     VerticalAlignment="Center"
                                     Text="ANGLE" />
                          <NumericUpDown Grid.Column="1"
                                         MinWidth="132"
                                         Minimum="0"
                                         Maximum="359.999"
                                         Increment="0.1"
                                         FormatString="0.0"
                                         Value="{Binding Guardian.TemplateAuthoring.PointAngle, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <TextBlock Classes="muted"
                                     MinWidth="72"
                                     VerticalAlignment="Center"
                                     Text="DISTANCE" />
                          <NumericUpDown Grid.Column="1"
                                         MinWidth="132"
                                         Minimum="0"
                                         Maximum="100000"
                                         Increment="0.1"
                                         FormatString="0.0"
                                         Value="{Binding Guardian.TemplateAuthoring.PointDistance, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <TextBlock Classes="muted"
                                     MinWidth="72"
                                     VerticalAlignment="Center"
                                     Text="ROTATION" />
                          <NumericUpDown Grid.Column="1"
                                         MinWidth="132"
                                         Minimum="-1"
                                         Maximum="359.999"
                                         Increment="0.1"
                                         FormatString="0.0"
                                         Value="{Binding Guardian.TemplateAuthoring.PointRotation, Mode=TwoWay}" />
                        </Grid>
                        <WrapPanel>
                          <Button Classes="secondary"
                                  Margin="0,0,8,8"
                                  Command="{Binding Guardian.TemplateAuthoring.ApplySelectedPointCommand}"
                                  Content="Apply point edit" />
                          <Button Classes="danger"
                                  Margin="0,0,0,8"
                                  Command="{Binding Guardian.TemplateAuthoring.RemoveSelectedPointCommand}"
                                  Content="Remove point" />
                        </WrapPanel>
                      </StackPanel>
                    </StackPanel>
                    <ContentControl Content="{Binding Guardian.SurveyEditor.SelectedPoint}"
                                    IsEnabled="{Binding Guardian.SurveyEditor.CanEditSelectedPoint}">
                      <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:GuardianSurveyPoiViewModel">
                          <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding IsRaw}">
                              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                              <TextBlock Grid.Column="1"
                                         Classes="muted"
                                         Text="{Binding TypeText}" />
                            </Grid>
                            <StackPanel x:Name="GuardianRawPointPrecisionEditor"
                                        Spacing="8"
                                        IsVisible="{Binding IsRaw}">
                              <TextBlock Classes="muted" Text="RAW-POINT PRECISION" />
                              <ComboBox ItemsSource="{Binding EditableRawPointTypes}"
                                        SelectedItem="{Binding Type, Mode=TwoWay}" />
                              <StackPanel x:Name="GuardianRawPointGeometryFields"
                                          Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                  <TextBlock Classes="muted"
                                             MinWidth="72"
                                             VerticalAlignment="Center"
                                             Text="ANGLE" />
                                  <NumericUpDown Grid.Column="1"
                                                 MinWidth="132"
                                                 Minimum="0"
                                                 Maximum="359.999"
                                                 Increment="0.1"
                                                 FormatString="0.0"
                                                 Value="{Binding RawAngle, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                  <TextBlock Classes="muted"
                                             MinWidth="72"
                                             VerticalAlignment="Center"
                                             Text="DISTANCE" />
                                  <NumericUpDown Grid.Column="1"
                                                 MinWidth="132"
                                                 Minimum="0"
                                                 Maximum="100000"
                                                 Increment="0.1"
                                                 FormatString="0.0"
                                                 Value="{Binding RawDistance, Mode=TwoWay}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                  <TextBlock Classes="muted"
                                             MinWidth="72"
                                             VerticalAlignment="Center"
                                             Text="ROTATION" />
                                  <NumericUpDown Grid.Column="1"
                                                 MinWidth="132"
                                                 Minimum="-1"
                                                 Maximum="359.999"
                                                 Increment="0.1"
                                                 FormatString="0.0"
                                                 Value="{Binding RawRotation, Mode=TwoWay}" />
                                </Grid>
                              </StackPanel>
                              <TextBlock Classes="muted"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Text="Fine-tune the commander-specific marker after selecting it on the map." />
                            </StackPanel>
                            <StackPanel Spacing="5">
                              <TextBlock Classes="muted" Text="STATUS" />
                              <ComboBox IsEnabled="{Binding IsStatusEditable}"
                                        ItemsSource="{Binding AllowedStatuses}"
                                        SelectedItem="{Binding Status, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="5"
                                        IsVisible="{Binding SupportsRelicHeading}">
                              <TextBlock Classes="muted" Text="RELIC HEADING" />
                              <NumericUpDown Minimum="-1"
                                             Maximum="359"
                                             Increment="1"
                                             FormatString="0"
                                             Value="{Binding RelicHeading, Mode=TwoWay}" />
                              <TextBlock Classes="muted"
                                         FontSize="11"
                                         TextWrapping="Wrap"
                                         Text="Only relic towers store an individual site-survey heading." />
                            </StackPanel>
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding CanEditComponentMaterials}">
                              <TextBlock Classes="muted" Text="COMPONENT MATERIALS" />
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock VerticalAlignment="Center" Text="Panel / top" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ComponentMaterialOptions}"
                                          SelectedItem="{Binding TopComponentMaterial, Mode=TwoWay}" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SupportsMultipleComponentMaterials}">
                                <TextBlock VerticalAlignment="Center" Text="Middle" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ComponentMaterialOptions}"
                                          SelectedItem="{Binding MiddleComponentMaterial, Mode=TwoWay}" />
                              </Grid>
                              <Grid ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10"
                                    IsVisible="{Binding SupportsMultipleComponentMaterials}">
                                <TextBlock VerticalAlignment="Center" Text="Bottom" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ComponentMaterialOptions}"
                                          SelectedItem="{Binding BottomComponentMaterial, Mode=TwoWay}" />
                              </Grid>
                            </StackPanel>
                          </StackPanel>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                    <Button Classes="secondary"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding Guardian.SurveyEditor.HasSelectedRawPoint}"
                            Command="{Binding Guardian.SurveyEditor.RemoveRawPointCommand}"
                            Content="Delete local raw point" />
                  </StackPanel>
                </Border>

                <Border x:Name="GuardianSurveyMapNotes"
                        Classes="card"
                        IsVisible="{Binding Guardian.ShouldShowMapNotes}">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="eyebrow" Text="COMMANDER NOTES" />
                    <ContentControl Content="{Binding Guardian.SelectedSite}">
                      <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:GuardianSiteRowViewModel">
                          <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

              <Border x:Name="GuardianMapDraftTools"
                      Classes="card"
                      IsVisible="{Binding Guardian.TemplateAuthoring.IsAuthoring}">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding Guardian.TemplateAuthoring.DraftModeTitle}" />
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Guardian.TemplateAuthoring.TemplateTitle}" />
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.TemplateAuthoring.DraftDescription}" />

                    <Border x:Name="GuardianMapCatalogDetails"
                            Classes="card raised"
                            IsEnabled="{Binding Guardian.SurveyEditor.IsAvailable}">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="muted" Text="THIS SITE'S CATALOG DETAILS" />
                        <TextBlock Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="These values identify this particular site in the systems table. They are autofilled from the journal when available and are saved to this commander survey, separately from the shared map geometry." />
                        <Grid ColumnDefinitions="220,150,180,*" ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="muted" Text="BODY" />
                            <TextBox Text="{Binding Guardian.SurveyEditor.CatalogBodyName, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="muted" Text="DISTANCE LY" />
                            <NumericUpDown Minimum="0"
                                           Maximum="100000"
                                           Increment="0.01"
                                           FormatString="0.00"
                                           IsEnabled="{Binding Guardian.SurveyEditor.CanEditDistanceLy}"
                                           Value="{Binding Guardian.SurveyEditor.DistanceLy, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="muted" Text="ARRIVAL DISTANCE LS" />
                            <NumericUpDown Minimum="0"
                                           Maximum="1000000000"
                                           Increment="0.1"
                                           FormatString="0.0"
                                           Value="{Binding Guardian.SurveyEditor.ArrivalDistanceLs, Mode=TwoWay}" />
                          </StackPanel>
                          <Button Grid.Column="3"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Left"
                                  Command="{Binding Guardian.SurveyEditor.SaveCommand}"
                                  Content="Save site details" />
                        </Grid>
                        <TextBlock Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding Guardian.SurveyEditor.DistanceOriginText}" />
                      </StackPanel>
                    </Border>

                    <StackPanel Spacing="14"
                                IsVisible="{Binding Guardian.TemplateAuthoring.IsAuthoring}">
                      <TextBlock Classes="muted"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Text="Background and alignment changes preview immediately on the map. They remain part of this draft until the complete map catalog is saved." />
                      <Grid ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="8"
                            RowSpacing="8">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="muted" Text="TEMPLATE NAME" />
                          <TextBox Text="{Binding Guardian.TemplateAuthoring.TemplateName, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Classes="muted" Text="BACKGROUND IMAGE" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Guardian.TemplateAuthoring.BackgroundImage, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Classes="secondary"
                                    Click="ChooseGuardianTemplateBackground_Click"
                                    Content="Choose..." />
                          </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                          <TextBlock Classes="muted" Text="IMAGE X" />
                          <NumericUpDown Minimum="-100000"
                                         Maximum="100000"
                                         Value="{Binding Guardian.TemplateAuthoring.ImageOffsetX, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                          <TextBlock Classes="muted" Text="IMAGE Y" />
                          <NumericUpDown Minimum="-100000"
                                         Maximum="100000"
                                         Value="{Binding Guardian.TemplateAuthoring.ImageOffsetY, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="4">
                          <TextBlock Classes="muted" Text="SCALE" />
                          <NumericUpDown Minimum="0.0001"
                                         Maximum="10000"
                                         Increment="0.01"
                                         Value="{Binding Guardian.TemplateAuthoring.ScaleFactor, Mode=TwoWay}" />
                        </StackPanel>
                      </Grid>
                      <Border Classes="card raised">
                        <StackPanel Spacing="10">
                          <TextBlock Classes="muted" Text="MEASURED MASTER POINT" />
                          <TextBlock TextWrapping="Wrap"
                                     Text="{Binding Guardian.TemplateAuthoring.LiveMeasurementText}" />
                          <TextBlock Classes="muted"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     Text="Stand at the shared point, choose its name and type, then add it directly to this draft. No additional Apply action is required." />
                          <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Guardian.TemplateAuthoring.NewPointName, Mode=TwoWay}"
                                     PlaceholderText="Unique point name" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Guardian.TemplateAuthoring.PointTypes}"
                                      SelectedItem="{Binding Guardian.TemplateAuthoring.NewPointType, Mode=TwoWay}" />
                            <Button Grid.Column="2"
                                    Classes="secondary"
                                    Command="{Binding Guardian.TemplateAuthoring.AddMeasuredPointCommand}"
                                    Content="Add measured point" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <TextBlock Classes="muted"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Text="Group-label positions are shared map geometry. Set or remove a label here; the result is included when the map catalog is saved." />
                      <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
                        <ListBox Height="150"
                                 ItemsSource="{Binding Guardian.TemplateAuthoring.Groups}"
                                 SelectedItem="{Binding Guardian.TemplateAuthoring.SelectedGroup, Mode=TwoWay}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuardianTemplateGroupViewModel">
                              <Grid Margin="6,3"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1"
                                           Classes="muted"
                                           Text="{Binding GeometryText}" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Spacing="8">
                          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <TextBox Text="{Binding Guardian.TemplateAuthoring.GroupName, Mode=TwoWay}"
                                     PlaceholderText="Group label" />
                            <NumericUpDown Grid.Column="1"
                                           Minimum="0"
                                           Maximum="359.999"
                                           Increment="0.1"
                                           Value="{Binding Guardian.TemplateAuthoring.GroupAngle, Mode=TwoWay}" />
                            <NumericUpDown Grid.Column="2"
                                           Minimum="0"
                                           Maximum="100000"
                                           Increment="0.1"
                                           Value="{Binding Guardian.TemplateAuthoring.GroupDistance, Mode=TwoWay}" />
                          </Grid>
                          <TextBlock Classes="muted"
                                     FontSize="11"
                                     Text="Label · angle · distance" />
                          <WrapPanel>
                            <Button Classes="secondary"
                                    Margin="0,0,8,8"
                                    Command="{Binding Guardian.TemplateAuthoring.SetGroupCommand}"
                                    Content="Set group label" />
                            <Button Classes="secondary"
                                    Margin="0,0,0,8"
                                    Command="{Binding Guardian.TemplateAuthoring.RemoveSelectedGroupCommand}"
                                    Content="Remove selected label" />
                          </WrapPanel>
                        </StackPanel>
                      </Grid>

                      <TextBlock Classes="muted"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Text="{Binding Guardian.TemplateAuthoring.SaveLocationText}" />
                      <WrapPanel>
                        <Button Classes="secondary"
                                Margin="0,0,8,8"
                                Click="ExportGuardianTemplate_Click"
                                Content="Save map changes..." />
                        <Button Classes="secondary"
                                Margin="0,0,0,8"
                                Command="{Binding Guardian.TemplateAuthoring.RequestDiscardCommand}"
                                Content="Discard draft" />
                      </WrapPanel>

                      <Border Classes="card raised"
                              IsVisible="{Binding Guardian.TemplateAuthoring.IsDiscardConfirmationPending}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                                     TextWrapping="Wrap"
                                     Text="Discard all unexported master-template changes?" />
                          <StackPanel Grid.Column="1"
                                      Orientation="Horizontal"
                                      Spacing="8">
                            <Button Classes="secondary"
                                    Command="{Binding Guardian.TemplateAuthoring.CancelDiscardCommand}"
                                    Content="Keep draft" />
                            <Button Classes="danger"
                                    Command="{Binding Guardian.TemplateAuthoring.ConfirmDiscardCommand}"
                                    Content="Confirm discard" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>

                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.TemplateAuthoring.StatusMessage}" />
                    <TextBlock Classes="monospace muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.TemplateAuthoring.LastExportPath}" />
                  </StackPanel>
              </Border>

              <Border x:Name="GuardianSurveyEditor"
                      Classes="card">
                <StackPanel Spacing="14">
                  <TextBlock Classes="card-title" Text="This site survey" />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="These values belong only to the selected site: its type, origin, headings, notes, observed states, and local raw points. Save this survey separately from shared map changes." />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="{Binding Guardian.SurveyEditor.AvailabilityMessage}" />

                  <StackPanel Spacing="14"
                              IsEnabled="{Binding Guardian.SurveyEditor.IsAvailable}">
                    <Border Classes="card raised">
                      <StackPanel Spacing="12">
                        <TextBlock Classes="muted" Text="SITE IDENTITY AND SURVEY ORIGIN" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                          <StackPanel Spacing="5">
                            <TextBlock Classes="muted" Text="SITE TYPE" />
                            <ComboBox x:Name="GuardianSurveySiteType"
                                      ItemsSource="{Binding Guardian.SurveyEditor.SiteTypeOptions}"
                                      SelectedItem="{Binding Guardian.SurveyEditor.SiteType, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="muted" Text="SITE HEADING" />
                            <NumericUpDown Minimum="-1"
                                           Maximum="359"
                                           Increment="1"
                                           FormatString="0"
                                           Value="{Binding Guardian.SurveyEditor.SiteHeading, Mode=TwoWay}" />
                          </StackPanel>
                        </Grid>
                        <StackPanel Spacing="5"
                                    IsVisible="{Binding Guardian.SurveyEditor.IsRuinsSite}">
                          <TextBlock Classes="muted" Text="RUINS RELIC HEADING" />
                          <NumericUpDown Minimum="-1"
                                         Maximum="359"
                                         Increment="1"
                                         FormatString="0"
                                         Value="{Binding Guardian.SurveyEditor.RelicTowerHeading, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="210,210,Auto,*"
                              ColumnSpacing="12"
                              HorizontalAlignment="Left">
                          <StackPanel Spacing="5">
                            <TextBlock Classes="muted" Text="SURFACE LATITUDE" />
                            <NumericUpDown x:Name="GuardianSurveyLatitude"
                                           Minimum="-90"
                                           Maximum="90"
                                           Increment="0.000001"
                                           FormatString="0.000000"
                                           Value="{Binding Guardian.SurveyEditor.SurfaceLatitude, Mode=TwoWay}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="muted" Text="SURFACE LONGITUDE" />
                            <NumericUpDown x:Name="GuardianSurveyLongitude"
                                           Minimum="-180"
                                           Maximum="180"
                                           Increment="0.000001"
                                           FormatString="0.000000"
                                           Value="{Binding Guardian.SurveyEditor.SurfaceLongitude, Mode=TwoWay}" />
                          </StackPanel>
                          <Button Grid.Column="2"
                                  VerticalAlignment="Bottom"
                                  Command="{Binding Guardian.SurveyEditor.ResetCoordinatesCommand}"
                                  Content="Reset coordinates" />
                        </Grid>
                        <TextBlock Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Choose the correct template to repair an unknown or misidentified site. Enter both surface coordinates, or leave both blank when the origin is not yet known." />
                      </StackPanel>
                    </Border>

                    <StackPanel Spacing="5">
                      <TextBlock Classes="muted" Text="NOTES" />
                      <TextBox MinHeight="76"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.SurveyEditor.Notes, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" Text="OBELISK GROUPS" />
                      <ItemsControl ItemsSource="{Binding Guardian.SurveyEditor.ObeliskGroups}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GuardianObeliskGroupViewModel">
                            <CheckBox MinWidth="42"
                                      Margin="0,0,8,8"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding Name}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <Border x:Name="GuardianActiveObeliskEditor"
                            Classes="card raised">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="muted" Text="ACTIVE OBELISKS" />
                            <TextBlock Classes="muted"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="Author the scanned obelisk, log, and required artifact metadata used when publishing an unpublished site survey." />
                          </StackPanel>
                          <WrapPanel Grid.Column="1">
                            <Button Classes="secondary"
                                    Margin="0,0,8,0"
                                    Command="{Binding Guardian.SurveyEditor.AddActiveObeliskCommand}"
                                    Content="Add" />
                            <Button Classes="secondary"
                                    Command="{Binding Guardian.SurveyEditor.RemoveActiveObeliskCommand}"
                                    Content="Delete" />
                          </WrapPanel>
                        </Grid>
                        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
                          <ListBox Height="170"
                                   ItemsSource="{Binding Guardian.SurveyEditor.ActiveObelisks}"
                                   SelectedItem="{Binding Guardian.SurveyEditor.SelectedActiveObelisk, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:GuardianActiveObeliskViewModel">
                                <Grid Margin="6,3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                  <TextBlock Classes="monospace" Text="{Binding Name}" />
                                  <TextBlock Grid.Column="1"
                                             Classes="muted"
                                             Text="{Binding LogCode}" />
                                  <CheckBox Grid.Column="2"
                                            IsHitTestVisible="False"
                                            IsChecked="{Binding Scanned}"
                                            Content="Scanned" />
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                          <ContentControl Grid.Column="1"
                                          Content="{Binding Guardian.SurveyEditor.SelectedActiveObelisk}">
                            <ContentControl.ContentTemplate>
                              <DataTemplate x:DataType="vm:GuardianActiveObeliskViewModel">
                                <StackPanel Spacing="8">
                                  <TextBox Text="{Binding Name, Mode=TwoWay}"
                                           PlaceholderText="Map marker, for example A01" />
                                  <TextBox Text="{Binding LogCode, Mode=TwoWay}"
                                           PlaceholderText="Log code, for example H1" />
                                  <TextBox Text="{Binding ArtifactCodes, Mode=TwoWay}"
                                           PlaceholderText="Artifact codes separated by commas" />
                                  <CheckBox IsChecked="{Binding Scanned, Mode=TwoWay}"
                                            Content="Scanned by this commander" />
                                  <TextBlock Classes="muted"
                                             FontSize="11"
                                             TextWrapping="Wrap"
                                             Text="Clicking a matching obelisk marker on the map selects this metadata row." />
                                </StackPanel>
                              </DataTemplate>
                            </ContentControl.ContentTemplate>
                          </ContentControl>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Classes="card raised">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="muted" Text="LIVE RAW-POINT MEASUREMENT" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding Guardian.SurveyEditor.LiveMeasurementText}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <ComboBox ItemsSource="{Binding Guardian.SurveyEditor.RawPointTypes}"
                                    SelectedItem="{Binding Guardian.SurveyEditor.NewRawPointType, Mode=TwoWay}" />
                          <Button Grid.Column="1"
                                  Classes="secondary"
                                  Command="{Binding Guardian.SurveyEditor.AddRawPointCommand}"
                                  Content="Add measured point" />
                        </Grid>
                        <TextBlock Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Raw points are commander-specific discoveries. The active site, selected survey, surface position, body radius, and site heading must all agree before a point can be measured." />
                      </StackPanel>
                    </Border>

                    <Button Classes="primary"
                            HorizontalAlignment="Left"
                            Command="{Binding Guardian.SurveyEditor.SaveCommand}"
                            Content="{Binding Guardian.SurveyEditor.SaveButtonText}" />
                  </StackPanel>

                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="{Binding Guardian.SurveyEditor.StatusMessage}" />
                </StackPanel>
              </Border>

          </StackPanel>
        </TabItem>

        <TabItem Header="Share data">
          <StackPanel Margin="0,18,0,0" Spacing="16">
            <Border Classes="card raised">
              <StackPanel Spacing="12">
                <TextBlock Classes="card-title" Text="Share Guardian discoveries" />
                <TextBlock Classes="muted"
                           Text="Compare commander surveys with the published Guardian catalog, then package only new headings, locations, POI states, relic and component-material data, groups, and raw map points."
                           TextWrapping="Wrap" />
                <Button Classes="primary"
                        HorizontalAlignment="Left"
                        Command="{Binding Guardian.PrepareShareBundleCommand}"
                        Content="{Binding Guardian.ShareButtonText}" />
                <TextBlock Classes="muted"
                           Text="{Binding Guardian.ShareStatusMessage}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Guardian.HasShareArchive}">
              <StackPanel Spacing="12">
                <TextBlock Classes="card-title" Text="Prepared bundle" />
                <TextBlock Classes="monospace muted"
                           FontSize="12"
                           Text="{Binding Guardian.ShareArchivePath}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Guardian.ShareSiteNames}"
                              IsVisible="{Binding Guardian.HasShareSites}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,0,0,6"
                                 Text="{Binding}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="secondary"
                          Margin="0,0,8,8"
                          Click="OpenShareFolder_Click"
                          Content="Open folder" />
                  <Button Classes="secondary"
                          Margin="0,0,8,8"
                          Click="CopyShareBundle_Click"
                          Content="Copy bundle path" />
                  <Button Classes="secondary"
                          Margin="0,0,8,8"
                          Click="CopyShareBundleFile_Click"
                          Content="Copy bundle file" />
                  <Button Classes="secondary"
                          Margin="0,0,0,8"
                          Click="OpenShareDiscord_Click"
                          Content="Open Discord channel" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

        <TabItem Header="Ram Tah missions">
          <StackPanel Margin="0,16,0,0" Spacing="20">
            <Border Classes="card raised">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="5">
                  <TextBlock Classes="card-title" Text="Research mission tracker" />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="Mission states follow the live journal. Checklists use the same commander profile fields as the WinForms application." />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                  <Button Classes="secondary"
                          Click="OpenRuinsGuide_Click"
                          Content="Mission 1 guide" />
                  <Button Classes="secondary"
                          Click="OpenLogsGuide_Click"
                          Content="Mission 2 guide" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="MISSION 1" />
                    <TextBlock Classes="card-title"
                               Text="Decoding the Ancient Ruins" />
                    <TextBlock Classes="muted"
                               Text="Biology, culture, history, language, and technology records" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Classes="badge"
                          VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding RamTah.AncientRuinsMissionStatus}" />
                  </Border>
                </Grid>
                <StackPanel Spacing="6">
                  <ProgressBar Height="7"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding RamTah.AncientRuinsProgress}" />
                  <TextBlock Classes="muted"
                             Text="{Binding RamTah.AncientRuinsProgressText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RamTah.AncientRuinsGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RamTahLogGroupViewModel">
                      <StackPanel Margin="0,0,0,15" Spacing="7">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Logs}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RamTahLogViewModel">
                              <CheckBox MinWidth="64"
                                        Margin="0,0,8,8"
                                        IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                        Command="{Binding ToggleCommand}"
                                        Content="{Binding Code}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secondary"
                        HorizontalAlignment="Left"
                        Command="{Binding RamTah.RequestAncientRuinsResetCommand}"
                        Content="Clear mission 1 progress" />
                <Border Classes="card raised"
                        IsVisible="{Binding RamTah.IsAncientRuinsResetPending}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                                 FontWeight="SemiBold"
                                 Text="Clear Decoding the Ancient Ruins progress?" />
                      <TextBlock Classes="muted"
                                 Text="This removes the 101-log checklist state but does not change the journal mission status." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                      <Button Classes="secondary"
                              Command="{Binding RamTah.CancelAncientRuinsResetCommand}"
                              Content="Keep progress" />
                      <Button Classes="danger"
                              Command="{Binding RamTah.ConfirmAncientRuinsResetCommand}"
                              Content="Confirm clear" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="MISSION 2" />
                    <TextBlock Classes="card-title"
                               Text="Decrypting the Guardian Logs" />
                    <TextBlock Classes="muted"
                               Text="Thargoids, civil war, technology, language, and Body Protectorate records" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Classes="badge"
                          VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding RamTah.GuardianLogsMissionStatus}" />
                  </Border>
                </Grid>
                <StackPanel Spacing="6">
                  <ProgressBar Height="7"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding RamTah.GuardianLogsProgress}" />
                  <TextBlock Classes="muted"
                             Text="{Binding RamTah.GuardianLogsProgressText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RamTah.GuardianLogsGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RamTahLogGroupViewModel">
                      <StackPanel Margin="0,0,0,15" Spacing="7">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Logs}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RamTahLogViewModel">
                              <CheckBox MinWidth="64"
                                        Margin="0,0,8,8"
                                        IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                        Command="{Binding ToggleCommand}"
                                        Content="{Binding Code}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secondary"
                        HorizontalAlignment="Left"
                        Command="{Binding RamTah.RequestGuardianLogsResetCommand}"
                        Content="Clear mission 2 progress" />
                <Border Classes="card raised"
                        IsVisible="{Binding RamTah.IsGuardianLogsResetPending}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                                 FontWeight="SemiBold"
                                 Text="Clear Decrypting the Guardian Logs progress?" />
                      <TextBlock Classes="muted"
                                 Text="This removes the 28-log checklist state but does not change the journal mission status." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                      <Button Classes="secondary"
                              Command="{Binding RamTah.CancelGuardianLogsResetCommand}"
                              Content="Keep progress" />
                      <Button Classes="danger"
                              Command="{Binding RamTah.ConfirmGuardianLogsResetCommand}"
                              Content="Confirm clear" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="5">
                <TextBlock Classes="card-title" Text="Ram Tah status" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="{Binding RamTah.StatusMessage}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
