<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.GuardianView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="20" MaxWidth="1050">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="5">
          <TextBlock Classes="eyebrow" Text="GUARDIAN" />
          <TextBlock Classes="page-title" Text="Guardian operations" />
          <TextBlock Classes="muted"
                     Text="Explore sites, review surveys, and track both Ram Tah research missions." />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinWidth="116"
                VerticalAlignment="Center"
                Command="{Binding Guardian.RefreshCommand}"
                Content="{Binding Guardian.RefreshButtonText}" />
      </Grid>

      <TabControl SelectedIndex="{Binding Guardian.SelectedWorkspaceTabIndex, Mode=TwoWay}">
        <TabItem Header="Sites &amp; surveys">
          <StackPanel Margin="0,16,0,0" Spacing="20">
      <Border Classes="card raised">
        <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="18">
          <Border Background="{DynamicResource RavenAccentBrush}"
                  CornerRadius="4" />
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Classes="eyebrow" Text="LIVE SITE" />
            <TextBlock Classes="card-title"
                       Text="{Binding Guardian.ActiveSiteTitle}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.ActiveSiteDescription}" />
            <WrapPanel Margin="0,5,0,0">
              <TextBlock Classes="monospace"
                         Margin="0,0,18,0"
                         Text="{Binding Guardian.ActiveSiteLocation}" />
              <TextBlock Classes="muted"
                         Text="{Binding Guardian.ActiveSiteVisit}" />
            </WrapPanel>
          </StackPanel>
          <Border Grid.Column="2"
                  Classes="badge"
                  VerticalAlignment="Top">
            <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                       FontWeight="SemiBold"
                       Text="{Binding Guardian.ActiveSiteReference}" />
          </Border>
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="24">
          <StackPanel Spacing="8">
            <TextBlock Classes="muted" Text="DISTANCE ORIGIN" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding Guardian.OriginSystemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="Star-system name" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Command="{Binding Guardian.LookupOriginCommand}"
                      Content="{Binding Guardian.OriginLookupButtonText}" />
              <Button Grid.Column="2"
                      Classes="secondary"
                      IsVisible="{Binding Guardian.HasCustomOrigin}"
                      Command="{Binding Guardian.ClearOriginCommand}"
                      Content="Use current" />
            </Grid>
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.OriginLookupStatus}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Classes="muted" Text="RAM TAH CATALOG DATA" />
            <WrapPanel>
              <CheckBox Margin="0,0,18,6"
                        IsChecked="{Binding Guardian.IncludeRamTahLogs, Mode=TwoWay}"
                        Content="Show logs available at each site" />
              <CheckBox Margin="0,0,0,6"
                        IsEnabled="{Binding Guardian.IncludeRamTahLogs}"
                        IsChecked="{Binding Guardian.ShowOnlyNeededRamTahLogs, Mode=TwoWay}"
                        Content="Show only logs still needed" />
            </WrapPanel>
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Needed-only mode follows the active Ram Tah mission and commander checklist; inactive mission types show no log codes." />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="8,3*,2*" ColumnSpacing="18">
          <Border Background="{DynamicResource RavenAccentBrush}"
                  CornerRadius="4" />
          <StackPanel Grid.Column="1" Spacing="7">
            <TextBlock Classes="eyebrow" Text="LIVE SCANNER" />
            <TextBlock Classes="card-title"
                       Text="{Binding Guardian.CurrentObeliskTitle}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.CurrentObeliskLogText}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.NearbyPointText}" />
            <TextBlock Classes="monospace"
                       FontSize="11"
                       Text="{Binding Guardian.SiteDistanceText}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="10">
            <Border Classes="badge"
                    HorizontalAlignment="Left">
              <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                         FontWeight="SemiBold"
                         FontSize="11"
                         Text="{Binding Guardian.CurrentObeliskArtifactStatus}" />
            </Border>
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="REQUIRED ARTIFACTS" />
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding Guardian.CurrentObeliskRequirementsText}" />
            </StackPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Guardian.CurrentObeliskMissionStatus}" />
            <Button Classes="primary"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding Guardian.HasCurrentObelisk}"
                    Command="{Binding Guardian.ToggleCurrentObeliskScannedCommand}"
                    Content="{Binding Guardian.ToggleCurrentObeliskScannedText}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card raised">
        <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="SEARCH" />
            <TextBox Text="{Binding Guardian.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="System, body, ID, address, type, or notes" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="muted" Text="SITE KIND" />
            <ComboBox ItemsSource="{Binding Guardian.KindFilters}"
                      SelectedItem="{Binding Guardian.SelectedKindFilter, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Classes="muted" Text="VISIT STATE" />
            <ComboBox ItemsSource="{Binding Guardian.VisitFilters}"
                      SelectedItem="{Binding Guardian.SelectedVisitFilter, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="6">
            <TextBlock Classes="muted" Text="SITE TYPE" />
            <ComboBox ItemsSource="{Binding Guardian.SiteTypeFilters}"
                      SelectedItem="{Binding Guardian.SelectedSiteTypeFilter, Mode=TwoWay}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Margin="18,15,18,10"
                ColumnDefinitions="72,3*,110,90,100,96"
                ColumnSpacing="10">
            <TextBlock Classes="muted" Text="ID" />
            <TextBlock Grid.Column="1" Classes="muted" Text="SYSTEM / BODY" />
            <TextBlock Grid.Column="2" Classes="muted" Text="TYPE" />
            <TextBlock Grid.Column="3" Classes="muted" Text="DISTANCE" />
            <TextBlock Grid.Column="4" Classes="muted" Text="VISITED" />
            <TextBlock Grid.Column="5" Classes="muted" Text="SURVEY" />
          </Grid>
          <Separator Grid.Row="1" />
          <ListBox Grid.Row="2"
                   Height="370"
                   BorderThickness="0"
                   Background="Transparent"
                   ItemsSource="{Binding Guardian.Rows}"
                   SelectedItem="{Binding Guardian.SelectedSite, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GuardianSiteRowViewModel">
                <Grid Margin="10,5"
                      ColumnDefinitions="72,3*,110,90,100,96"
                      ColumnSpacing="10">
                  <TextBlock Classes="monospace"
                             VerticalAlignment="Center"
                             Text="{Binding DisplayId}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Reference.SystemName}" />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Reference.BodyName}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding SiteDescription}" />
                  <TextBlock Grid.Column="3"
                             VerticalAlignment="Center"
                             Text="{Binding DistanceText}" />
                  <TextBlock Grid.Column="4"
                             VerticalAlignment="Center"
                             Text="{Binding VisitText}" />
                  <TextBlock Grid.Column="5"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource RavenAccentBrush}"
                             FontWeight="SemiBold"
                             Text="{Binding SurveyText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
        <Border Classes="card">
          <StackPanel Spacing="15">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Classes="card-title"
                           Text="{Binding Guardian.SelectedSite.Reference.SystemName}" />
                <TextBlock Classes="muted"
                           Text="{Binding Guardian.SelectedSite.Reference.BodyName}" />
              </StackPanel>
              <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top">
                <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                           FontSize="11"
                           Text="{Binding Guardian.SelectedSite.SiteDescription}" />
              </Border>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="SYSTEM ADDRESS" />
                <TextBlock Classes="monospace"
                           Text="{Binding Guardian.SelectedSite.Reference.SystemAddress}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="muted" Text="ARRIVAL DISTANCE" />
                <TextBlock Text="{Binding Guardian.SelectedSite.ArrivalText}" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="GALACTIC POSITION" />
              <TextBlock Classes="monospace"
                         Text="{Binding Guardian.SelectedSite.GalacticPosition}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="SURFACE LOCATION" />
              <TextBlock Classes="monospace"
                         Text="{Binding Guardian.SelectedSite.SurfaceLocation}" />
            </StackPanel>
            <WrapPanel>
              <Button Classes="primary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSurvey}"
                      Command="{Binding Guardian.OpenSelectedSurveyCommand}"
                      Content="Open survey" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Command="{Binding Guardian.OpenShareWorkspaceCommand}"
                      Content="Share data" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopySystem_Click"
                      Content="Copy system" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopyAddress_Click"
                      Content="Copy address" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopyPosition_Click"
                      Content="Copy position" />
              <Button Classes="secondary"
                      Margin="0,0,0,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="CopySurface_Click"
                      Content="Copy lat/long" />
            </WrapPanel>
            <WrapPanel>
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="OpenCanonn_Click"
                      Content="Canonn Signals" />
              <Button Classes="secondary"
                      Margin="0,0,8,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="OpenSpansh_Click"
                      Content="Spansh" />
              <Button Classes="secondary"
                      Margin="0,0,0,8"
                      IsEnabled="{Binding Guardian.HasSelectedSite}"
                      Click="OpenEdsm_Click"
                      Content="EDSM" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="card-title" Text="Commander record" />
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="VISIT" />
              <TextBlock Text="{Binding Guardian.SelectedSite.VisitText}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="SURVEY" />
              <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                         FontWeight="SemiBold"
                         Text="{Binding Guardian.SelectedSite.SurveyText}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="NOTES / RELATED SITE" />
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding Guardian.SelectedSite.Notes}" />
            </StackPanel>
            <StackPanel Spacing="4"
                        IsVisible="{Binding Guardian.IncludeRamTahLogs}">
              <TextBlock Classes="muted" Text="RAM TAH LOGS" />
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding Guardian.SelectedSite.RamTahLogsText}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="5">
          <TextBlock Classes="card-title" Text="Guardian data status" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding Guardian.Summary}" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding Guardian.OriginStatus}" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding Guardian.StatusMessage}" />
        </StackPanel>
      </Border>
          </StackPanel>
        </TabItem>

        <TabItem Header="Survey map">
          <Grid Margin="0,16,0,0"
                ColumnDefinitions="3*,2*"
                ColumnSpacing="18">
            <Border Classes="card"
                    Padding="12"
                    VerticalAlignment="Top">
              <controls:GuardianSiteMapControl
                  Height="640"
                  Projection="{Binding Guardian.MapProjection}"
                  ShowLegend="{Binding Guardian.ShowMapLegend}"
                  MapBackground="{DynamicResource RavenRaisedSurfaceBrush}"
                  GridBrush="{DynamicResource RavenBorderBrush}"
                  AccentBrush="{DynamicResource RavenAccentBrush}"
                  MutedBrush="{DynamicResource RavenMutedTextBrush}"
                  PresentBrush="{DynamicResource RavenSuccessBrush}"
                  AbsentBrush="{DynamicResource RavenDangerBrush}"
                  EmptyBrush="{DynamicResource RavenWarningBrush}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="18">
              <Border Classes="card raised">
                <StackPanel Spacing="8">
                  <TextBlock Classes="eyebrow" Text="SELECTED MAP" />
                  <TextBlock Classes="card-title"
                             TextWrapping="Wrap"
                             Text="{Binding Guardian.MapTitle}" />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="{Binding Guardian.MapSummary}" />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="{Binding Guardian.MapStatus}" />
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox Margin="0,0,14,0"
                              IsChecked="{Binding Guardian.ShowMapLegend, Mode=TwoWay}"
                              Content="Show legend" />
                    <CheckBox IsChecked="{Binding Guardian.ShowMapNotes, Mode=TwoWay}"
                              Content="Show notes" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Classes="card"
                      IsVisible="{Binding Guardian.ShouldShowMapNotes}">
                <StackPanel Spacing="5">
                  <TextBlock Classes="eyebrow" Text="COMMANDER NOTES" />
                  <TextBlock Text="{Binding Guardian.SelectedSite.Notes}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Expander Header="Master template developer tools">
                <Border Classes="card">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="card-title"
                               Text="{Binding Guardian.TemplateAuthoring.TemplateTitle}" />
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="Edit the shared geometry used by every site of this type. Drafts preview locally; only an explicitly selected JSON export file is changed." />
                    <Button Classes="secondary"
                            HorizontalAlignment="Left"
                            Command="{Binding Guardian.TemplateAuthoring.StartCommand}"
                            Content="Start template draft" />

                    <StackPanel Spacing="14"
                                IsVisible="{Binding Guardian.TemplateAuthoring.IsAuthoring}">
                      <Grid ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="8"
                            RowSpacing="8">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="muted" Text="TEMPLATE NAME" />
                          <TextBox Text="{Binding Guardian.TemplateAuthoring.TemplateName, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Classes="muted" Text="BACKGROUND IMAGE" />
                          <TextBox Text="{Binding Guardian.TemplateAuthoring.BackgroundImage, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                          <TextBlock Classes="muted" Text="IMAGE X" />
                          <NumericUpDown Minimum="-100000"
                                         Maximum="100000"
                                         Value="{Binding Guardian.TemplateAuthoring.ImageOffsetX, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                          <TextBlock Classes="muted" Text="IMAGE Y" />
                          <NumericUpDown Minimum="-100000"
                                         Maximum="100000"
                                         Value="{Binding Guardian.TemplateAuthoring.ImageOffsetY, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="4">
                          <TextBlock Classes="muted" Text="SCALE" />
                          <NumericUpDown Minimum="0.0001"
                                         Maximum="10000"
                                         Increment="0.01"
                                         Value="{Binding Guardian.TemplateAuthoring.ScaleFactor, Mode=TwoWay}" />
                        </StackPanel>
                      </Grid>
                      <Button Classes="secondary"
                              HorizontalAlignment="Left"
                              Command="{Binding Guardian.TemplateAuthoring.ApplyMetadataCommand}"
                              Content="Apply metadata to draft" />

                      <Border Classes="card raised">
                        <StackPanel Spacing="10">
                          <TextBlock Classes="muted" Text="MEASURED MASTER POINT" />
                          <TextBlock TextWrapping="Wrap"
                                     Text="{Binding Guardian.TemplateAuthoring.LiveMeasurementText}" />
                          <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding Guardian.TemplateAuthoring.NewPointName, Mode=TwoWay}"
                                     PlaceholderText="Unique point name" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Guardian.TemplateAuthoring.PointTypes}"
                                      SelectedItem="{Binding Guardian.TemplateAuthoring.NewPointType, Mode=TwoWay}" />
                            <Button Grid.Column="2"
                                    Classes="secondary"
                                    Command="{Binding Guardian.TemplateAuthoring.AddMeasuredPointCommand}"
                                    Content="Add measured point" />
                          </Grid>
                        </StackPanel>
                      </Border>

                      <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
                        <ListBox Height="230"
                                 ItemsSource="{Binding Guardian.TemplateAuthoring.Points}"
                                 SelectedItem="{Binding Guardian.TemplateAuthoring.SelectedPoint, Mode=TwoWay}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuardianTemplatePointViewModel">
                              <StackPanel Margin="6,3" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Classes="muted"
                                           FontSize="11"
                                           Text="{Binding TypeText}" />
                                <TextBlock Classes="muted"
                                           FontSize="11"
                                           Text="{Binding GeometryText}" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1" Spacing="8">
                          <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                            <TextBox Text="{Binding Guardian.TemplateAuthoring.PointName, Mode=TwoWay}"
                                     PlaceholderText="Point name" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Guardian.TemplateAuthoring.PointTypes}"
                                      SelectedItem="{Binding Guardian.TemplateAuthoring.PointType, Mode=TwoWay}" />
                          </Grid>
                          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <NumericUpDown Minimum="0"
                                           Maximum="359.999"
                                           Increment="0.1"
                                           Value="{Binding Guardian.TemplateAuthoring.PointAngle, Mode=TwoWay}" />
                            <NumericUpDown Grid.Column="1"
                                           Minimum="0"
                                           Maximum="100000"
                                           Increment="0.1"
                                           Value="{Binding Guardian.TemplateAuthoring.PointDistance, Mode=TwoWay}" />
                            <NumericUpDown Grid.Column="2"
                                           Minimum="-1"
                                           Maximum="359.999"
                                           Increment="0.1"
                                           Value="{Binding Guardian.TemplateAuthoring.PointRotation, Mode=TwoWay}" />
                          </Grid>
                          <TextBlock Classes="muted"
                                     FontSize="11"
                                     Text="Angle · distance · rotation" />
                          <WrapPanel>
                            <Button Classes="secondary"
                                    Margin="0,0,8,8"
                                    Command="{Binding Guardian.TemplateAuthoring.ApplySelectedPointCommand}"
                                    Content="Apply point edit" />
                            <Button Classes="secondary"
                                    Margin="0,0,0,8"
                                    Command="{Binding Guardian.TemplateAuthoring.RemoveSelectedPointCommand}"
                                    Content="Remove point" />
                          </WrapPanel>
                        </StackPanel>
                      </Grid>

                      <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
                        <ListBox Height="150"
                                 ItemsSource="{Binding Guardian.TemplateAuthoring.Groups}"
                                 SelectedItem="{Binding Guardian.TemplateAuthoring.SelectedGroup, Mode=TwoWay}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuardianTemplateGroupViewModel">
                              <Grid Margin="6,3"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1"
                                           Classes="muted"
                                           Text="{Binding GeometryText}" />
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Spacing="8">
                          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <TextBox Text="{Binding Guardian.TemplateAuthoring.GroupName, Mode=TwoWay}"
                                     PlaceholderText="Group label" />
                            <NumericUpDown Grid.Column="1"
                                           Minimum="0"
                                           Maximum="359.999"
                                           Increment="0.1"
                                           Value="{Binding Guardian.TemplateAuthoring.GroupAngle, Mode=TwoWay}" />
                            <NumericUpDown Grid.Column="2"
                                           Minimum="0"
                                           Maximum="100000"
                                           Increment="0.1"
                                           Value="{Binding Guardian.TemplateAuthoring.GroupDistance, Mode=TwoWay}" />
                          </Grid>
                          <TextBlock Classes="muted"
                                     FontSize="11"
                                     Text="Label · angle · distance" />
                          <WrapPanel>
                            <Button Classes="secondary"
                                    Margin="0,0,8,8"
                                    Command="{Binding Guardian.TemplateAuthoring.SetGroupCommand}"
                                    Content="Set group label" />
                            <Button Classes="secondary"
                                    Margin="0,0,0,8"
                                    Command="{Binding Guardian.TemplateAuthoring.RemoveSelectedGroupCommand}"
                                    Content="Remove selected label" />
                          </WrapPanel>
                        </StackPanel>
                      </Grid>

                      <WrapPanel>
                        <Button Classes="primary"
                                Margin="0,0,8,8"
                                Click="ExportGuardianTemplate_Click"
                                Content="Export verified catalog..." />
                        <Button Classes="secondary"
                                Margin="0,0,0,8"
                                Command="{Binding Guardian.TemplateAuthoring.RequestDiscardCommand}"
                                Content="Discard draft" />
                      </WrapPanel>

                      <Border Classes="card raised"
                              IsVisible="{Binding Guardian.TemplateAuthoring.IsDiscardConfirmationPending}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                                     TextWrapping="Wrap"
                                     Text="Discard all unexported master-template changes?" />
                          <StackPanel Grid.Column="1"
                                      Orientation="Horizontal"
                                      Spacing="8">
                            <Button Classes="secondary"
                                    Command="{Binding Guardian.TemplateAuthoring.CancelDiscardCommand}"
                                    Content="Keep draft" />
                            <Button Classes="primary"
                                    Command="{Binding Guardian.TemplateAuthoring.ConfirmDiscardCommand}"
                                    Content="Confirm discard" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </StackPanel>

                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.TemplateAuthoring.StatusMessage}" />
                    <TextBlock Classes="monospace muted"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.TemplateAuthoring.LastExportPath}" />
                  </StackPanel>
                </Border>
              </Expander>

              <Border Classes="card">
                <StackPanel Spacing="14">
                  <TextBlock Classes="card-title" Text="Survey editor" />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="{Binding Guardian.SurveyEditor.AvailabilityMessage}" />

                  <StackPanel Spacing="14"
                              IsEnabled="{Binding Guardian.SurveyEditor.IsAvailable}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="muted" Text="SITE HEADING" />
                        <NumericUpDown Minimum="-1"
                                       Maximum="359"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding Guardian.SurveyEditor.SiteHeading, Mode=TwoWay}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Classes="muted" Text="RUINS RELIC HEADING" />
                        <NumericUpDown Minimum="-1"
                                       Maximum="359"
                                       Increment="1"
                                       FormatString="0"
                                       Value="{Binding Guardian.SurveyEditor.RelicTowerHeading, Mode=TwoWay}" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="5">
                      <TextBlock Classes="muted" Text="NOTES" />
                      <TextBox MinHeight="76"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               Text="{Binding Guardian.SurveyEditor.Notes, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" Text="OBELISK GROUPS" />
                      <ItemsControl ItemsSource="{Binding Guardian.SurveyEditor.ObeliskGroups}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GuardianObeliskGroupViewModel">
                            <CheckBox MinWidth="42"
                                      Margin="0,0,8,8"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding Name}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <Border Classes="card raised">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="muted" Text="LIVE RAW-POINT MEASUREMENT" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding Guardian.SurveyEditor.LiveMeasurementText}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <ComboBox ItemsSource="{Binding Guardian.SurveyEditor.RawPointTypes}"
                                    SelectedItem="{Binding Guardian.SurveyEditor.NewRawPointType, Mode=TwoWay}" />
                          <Button Grid.Column="1"
                                  Classes="secondary"
                                  Command="{Binding Guardian.SurveyEditor.AddRawPointCommand}"
                                  Content="Add measured point" />
                        </Grid>
                        <TextBlock Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Raw points are commander-specific discoveries. The active site, selected survey, surface position, body radius, and site heading must all agree before a point can be measured." />
                      </StackPanel>
                    </Border>

                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" Text="SURVEY POINTS" />
                      <ListBox Height="210"
                               ItemsSource="{Binding Guardian.SurveyEditor.Points}"
                               SelectedItem="{Binding Guardian.SurveyEditor.SelectedPoint, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:GuardianSurveyPoiViewModel">
                            <Grid Margin="6,3"
                                  ColumnDefinitions="70,*,Auto,Auto"
                                  ColumnSpacing="8">
                              <TextBlock Classes="monospace" Text="{Binding Name}" />
                              <TextBlock Grid.Column="1"
                                         Classes="muted"
                                         Text="{Binding TypeText}" />
                              <TextBlock Grid.Column="2"
                                         Classes="muted"
                                         Text="{Binding PositionText}" />
                              <TextBlock Grid.Column="3" Text="{Binding Status}" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>

                    <Border Classes="card raised"
                            IsVisible="{Binding Guardian.SurveyEditor.HasSelectedPoint}">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock FontWeight="SemiBold"
                                     Text="{Binding Guardian.SurveyEditor.SelectedPoint.Name}" />
                          <TextBlock Grid.Column="1"
                                     Classes="muted"
                                     Text="{Binding Guardian.SurveyEditor.SelectedPoint.TypeText}" />
                        </Grid>
                        <TextBlock Classes="muted"
                                   Text="{Binding Guardian.SurveyEditor.SelectedPoint.PositionText}" />
                        <StackPanel Spacing="5">
                          <TextBlock Classes="muted" Text="STATUS" />
                          <ComboBox IsEnabled="{Binding Guardian.SurveyEditor.SelectedPoint.IsStatusEditable}"
                                    ItemsSource="{Binding Guardian.SurveyEditor.SelectedPoint.AllowedStatuses}"
                                    SelectedItem="{Binding Guardian.SurveyEditor.SelectedPoint.Status, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="5"
                                    IsVisible="{Binding Guardian.SurveyEditor.SelectedPoint.SupportsRelicHeading}">
                          <TextBlock Classes="muted" Text="RELIC HEADING" />
                          <NumericUpDown Minimum="-1"
                                         Maximum="359"
                                         Increment="1"
                                         FormatString="0"
                                         Value="{Binding Guardian.SurveyEditor.SelectedPoint.RelicHeading, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Spacing="8"
                                    IsVisible="{Binding Guardian.SurveyEditor.SelectedPoint.CanEditComponentMaterials}">
                          <TextBlock Classes="muted" Text="COMPONENT MATERIALS" />
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock VerticalAlignment="Center" Text="Panel / top" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Guardian.SurveyEditor.SelectedPoint.ComponentMaterialOptions}"
                                      SelectedItem="{Binding Guardian.SurveyEditor.SelectedPoint.TopComponentMaterial, Mode=TwoWay}" />
                          </Grid>
                          <Grid ColumnDefinitions="Auto,*"
                                ColumnSpacing="10"
                                IsVisible="{Binding Guardian.SurveyEditor.SelectedPoint.SupportsMultipleComponentMaterials}">
                            <TextBlock VerticalAlignment="Center" Text="Middle" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Guardian.SurveyEditor.SelectedPoint.ComponentMaterialOptions}"
                                      SelectedItem="{Binding Guardian.SurveyEditor.SelectedPoint.MiddleComponentMaterial, Mode=TwoWay}" />
                          </Grid>
                          <Grid ColumnDefinitions="Auto,*"
                                ColumnSpacing="10"
                                IsVisible="{Binding Guardian.SurveyEditor.SelectedPoint.SupportsMultipleComponentMaterials}">
                            <TextBlock VerticalAlignment="Center" Text="Bottom" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Guardian.SurveyEditor.SelectedPoint.ComponentMaterialOptions}"
                                      SelectedItem="{Binding Guardian.SurveyEditor.SelectedPoint.BottomComponentMaterial, Mode=TwoWay}" />
                          </Grid>
                        </StackPanel>
                        <Button Classes="secondary"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding Guardian.SurveyEditor.HasSelectedRawPoint}"
                                Command="{Binding Guardian.SurveyEditor.RemoveRawPointCommand}"
                                Content="Remove local raw point" />
                      </StackPanel>
                    </Border>

                    <Button Classes="primary"
                            HorizontalAlignment="Left"
                            Command="{Binding Guardian.SurveyEditor.SaveCommand}"
                            Content="{Binding Guardian.SurveyEditor.SaveButtonText}" />
                  </StackPanel>

                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="{Binding Guardian.SurveyEditor.StatusMessage}" />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Classes="card-title" Text="Map legend" />
                  <Grid ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="9">
                    <Ellipse Width="10" Height="10"
                             Fill="{DynamicResource RavenMutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="Unknown / unconfirmed" />
                    <Ellipse Grid.Row="1" Width="10" Height="10"
                             Fill="{DynamicResource RavenSuccessBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Present / scanned" />
                    <Ellipse Grid.Row="2" Width="10" Height="10"
                             Fill="{DynamicResource RavenDangerBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Absent" />
                    <Ellipse Grid.Row="3" Width="10" Height="10"
                             Fill="{DynamicResource RavenWarningBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Empty puddle" />
                    <Ellipse Grid.Row="4" Width="10" Height="10"
                             Fill="{DynamicResource RavenAccentBrush}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Active obelisk" />
                  </Grid>
                  <StackPanel Spacing="7"
                              IsVisible="{Binding Guardian.ShowComponentMaterials}">
                    <TextBlock Classes="muted" Text="COMPONENT MATERIALS" />
                    <WrapPanel>
                      <Border Width="10" Height="10" Margin="0,4,6,0" Background="Lime" />
                      <TextBlock Margin="0,0,16,0" Text="Power Cell" />
                      <Border Width="10" Height="10" Margin="0,4,6,0" Background="Cyan" />
                      <TextBlock Margin="0,0,16,0" Text="Power Conduit" />
                      <Border Width="10" Height="10" Margin="0,4,6,0" Background="OrangeRed" />
                      <TextBlock Text="Technology Component" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="5">
                  <TextBlock Classes="card-title" Text="Orientation" />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="The map is fixed to the Guardian site template. The center dot is the surveyed settlement origin; rings scale to the outermost mapped object." />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Share data">
          <StackPanel Margin="0,18,0,0" Spacing="16">
            <Border Classes="card raised">
              <StackPanel Spacing="12">
                <TextBlock Classes="card-title" Text="Share Guardian discoveries" />
                <TextBlock Classes="muted"
                           Text="Compare commander surveys with the published Guardian catalog, then package only new headings, locations, POI states, relic and component-material data, groups, and raw map points."
                           TextWrapping="Wrap" />
                <Button Classes="primary"
                        HorizontalAlignment="Left"
                        Command="{Binding Guardian.PrepareShareBundleCommand}"
                        Content="{Binding Guardian.ShareButtonText}" />
                <TextBlock Classes="muted"
                           Text="{Binding Guardian.ShareStatusMessage}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Guardian.HasShareArchive}">
              <StackPanel Spacing="12">
                <TextBlock Classes="card-title" Text="Prepared bundle" />
                <TextBlock Classes="monospace muted"
                           FontSize="12"
                           Text="{Binding Guardian.ShareArchivePath}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Guardian.ShareSiteNames}"
                              IsVisible="{Binding Guardian.HasShareSites}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,0,0,6"
                                 Text="{Binding}"
                                 TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="secondary"
                          Margin="0,0,8,8"
                          Click="OpenShareFolder_Click"
                          Content="Open folder" />
                  <Button Classes="secondary"
                          Margin="0,0,8,8"
                          Click="CopyShareBundle_Click"
                          Content="Copy bundle path" />
                  <Button Classes="primary"
                          Margin="0,0,0,8"
                          Click="OpenShareDiscord_Click"
                          Content="Open Discord channel" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

        <TabItem Header="Ram Tah missions">
          <StackPanel Margin="0,16,0,0" Spacing="20">
            <Border Classes="card raised">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="5">
                  <TextBlock Classes="card-title" Text="Research mission tracker" />
                  <TextBlock Classes="muted"
                             TextWrapping="Wrap"
                             Text="Mission states follow the live journal. Checklists use the same commander profile fields as the WinForms application." />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                  <Button Classes="secondary"
                          Click="OpenRuinsGuide_Click"
                          Content="Mission 1 guide" />
                  <Button Classes="secondary"
                          Click="OpenLogsGuide_Click"
                          Content="Mission 2 guide" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="MISSION 1" />
                    <TextBlock Classes="card-title"
                               Text="Decoding the Ancient Ruins" />
                    <TextBlock Classes="muted"
                               Text="Biology, culture, history, language, and technology records" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Classes="badge"
                          VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding RamTah.AncientRuinsMissionStatus}" />
                  </Border>
                </Grid>
                <StackPanel Spacing="6">
                  <ProgressBar Height="7"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding RamTah.AncientRuinsProgress}" />
                  <TextBlock Classes="muted"
                             Text="{Binding RamTah.AncientRuinsProgressText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RamTah.AncientRuinsGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RamTahLogGroupViewModel">
                      <StackPanel Margin="0,0,0,15" Spacing="7">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Logs}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RamTahLogViewModel">
                              <CheckBox MinWidth="64"
                                        Margin="0,0,8,8"
                                        IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                        Command="{Binding ToggleCommand}"
                                        Content="{Binding Code}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secondary"
                        HorizontalAlignment="Left"
                        Command="{Binding RamTah.RequestAncientRuinsResetCommand}"
                        Content="Clear mission 1 progress" />
                <Border Classes="card raised"
                        IsVisible="{Binding RamTah.IsAncientRuinsResetPending}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                                 FontWeight="SemiBold"
                                 Text="Clear Decoding the Ancient Ruins progress?" />
                      <TextBlock Classes="muted"
                                 Text="This removes the 101-log checklist state but does not change the journal mission status." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                      <Button Classes="secondary"
                              Command="{Binding RamTah.CancelAncientRuinsResetCommand}"
                              Content="Keep progress" />
                      <Button Classes="primary"
                              Command="{Binding RamTah.ConfirmAncientRuinsResetCommand}"
                              Content="Confirm clear" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow" Text="MISSION 2" />
                    <TextBlock Classes="card-title"
                               Text="Decrypting the Guardian Logs" />
                    <TextBlock Classes="muted"
                               Text="Thargoids, civil war, technology, language, and Body Protectorate records" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Classes="badge"
                          VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding RamTah.GuardianLogsMissionStatus}" />
                  </Border>
                </Grid>
                <StackPanel Spacing="6">
                  <ProgressBar Height="7"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding RamTah.GuardianLogsProgress}" />
                  <TextBlock Classes="muted"
                             Text="{Binding RamTah.GuardianLogsProgressText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RamTah.GuardianLogsGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RamTahLogGroupViewModel">
                      <StackPanel Margin="0,0,0,15" Spacing="7">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <ItemsControl ItemsSource="{Binding Logs}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RamTahLogViewModel">
                              <CheckBox MinWidth="64"
                                        Margin="0,0,8,8"
                                        IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                        Command="{Binding ToggleCommand}"
                                        Content="{Binding Code}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="secondary"
                        HorizontalAlignment="Left"
                        Command="{Binding RamTah.RequestGuardianLogsResetCommand}"
                        Content="Clear mission 2 progress" />
                <Border Classes="card raised"
                        IsVisible="{Binding RamTah.IsGuardianLogsResetPending}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                                 FontWeight="SemiBold"
                                 Text="Clear Decrypting the Guardian Logs progress?" />
                      <TextBlock Classes="muted"
                                 Text="This removes the 28-log checklist state but does not change the journal mission status." />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                      <Button Classes="secondary"
                              Command="{Binding RamTah.CancelGuardianLogsResetCommand}"
                              Content="Keep progress" />
                      <Button Classes="primary"
                              Command="{Binding RamTah.ConfirmGuardianLogsResetCommand}"
                              Content="Confirm clear" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="5">
                <TextBlock Classes="card-title" Text="Ram Tah status" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="{Binding RamTah.StatusMessage}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
