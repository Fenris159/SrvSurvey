<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.QuestView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <Grid RowDefinitions="Auto,Auto,*" Margin="32" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="RAVEN COMMUNICATIONS" />
        <TextBlock Classes="page-title" Text="Quests" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="Read transmissions, follow active objectives, and manage commander adventures." />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="secondary"
              VerticalAlignment="Center"
              Command="{Binding QuestWorkspace.ToggleEnabledCommand}"
              Content="{Binding QuestWorkspace.ToggleEnabledButtonText}" />
      <Button Grid.Column="2"
              Classes="primary"
              MinWidth="100"
              VerticalAlignment="Center"
              Command="{Binding QuestWorkspace.RefreshCommand}"
              Content="{Binding QuestWorkspace.RefreshButtonText}" />
    </Grid>

    <Border Grid.Row="1" Classes="card raised" Padding="0">
      <Grid ColumnDefinitions="6,*">
        <Border Classes="accent-line" CornerRadius="12,0,0,12" />
        <Grid Grid.Column="1"
              Margin="20,14"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title"
                       Text="{Binding QuestWorkspace.ActiveQuestSummary}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding QuestWorkspace.StatusMessage}" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     Text="{Binding QuestWorkspace.MessageSummary}" />
        </Grid>
      </Grid>
    </Border>

    <TabControl Grid.Row="2">
      <TabItem Header="Messages">
        <Grid ColumnDefinitions="320,*" ColumnSpacing="18" Margin="0,16,0,0">
          <Border Classes="card" Padding="10">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
              <TextBlock Classes="card-title"
                         Text="{Binding QuestWorkspace.MessageSummary}" />
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding QuestWorkspace.Messages}"
                       SelectedItem="{Binding QuestWorkspace.SelectedMessage}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuestMessageRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,7">
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Subject}" />
                        <TextBlock Classes="muted"
                                   FontSize="11"
                                   Text="{Binding From}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                        <TextBlock FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource RavenAccentBrush}"
                                   Text="{Binding ReadLabel}" />
                        <TextBlock Classes="muted"
                                   FontSize="10"
                                   Text="{Binding ReceivedLabel}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="card raised">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding QuestWorkspace.SelectedMessage.From}" />
                    <TextBlock Classes="card-title"
                               FontSize="21"
                               TextWrapping="Wrap"
                               Text="{Binding QuestWorkspace.SelectedMessage.Subject}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          VerticalAlignment="Top"
                          Command="{Binding QuestWorkspace.OpenMessageCommand}"
                          CommandParameter="{Binding QuestWorkspace.SelectedMessage}"
                          Content="Open / mark read" />
                </Grid>
                <TextBlock Classes="muted"
                           Text="{Binding QuestWorkspace.SelectedMessage.TagsLabel}" />
                <Separator />
                <TextBlock FontSize="14"
                           LineHeight="22"
                           TextWrapping="Wrap"
                           Text="{Binding QuestWorkspace.SelectedMessage.Body}" />
                <TextBlock Classes="muted"
                           FontWeight="SemiBold"
                           Text="{Binding QuestWorkspace.SelectedMessage.Replied, StringFormat='Response: {0}'}" />
                <ItemsControl ItemsSource="{Binding QuestWorkspace.MessageActions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuestMessageActionViewModel">
                      <Button Classes="primary"
                              Margin="0,0,8,8"
                              Command="{Binding Command}"
                              Content="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="My quests">
        <Grid ColumnDefinitions="320,*" ColumnSpacing="18" Margin="0,16,0,0">
          <Border Classes="card" Padding="10">
            <ListBox ItemsSource="{Binding QuestWorkspace.ActiveQuests}"
                     SelectedItem="{Binding QuestWorkspace.SelectedQuest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuestCardViewModel">
                  <StackPanel Margin="4,7" Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Title}" />
                      <TextBlock Grid.Column="1"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource RavenAccentBrush}"
                                 Text="{Binding StateLabel}" />
                    </Grid>
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Subtitle}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <Border Grid.Column="1" Classes="card raised">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow"
                               Text="{Binding QuestWorkspace.SelectedQuest.StateLabel}" />
                    <TextBlock Classes="card-title"
                               FontSize="21"
                               Text="{Binding QuestWorkspace.SelectedQuest.Title}" />
                    <TextBlock Classes="muted"
                               TextWrapping="Wrap"
                               Text="{Binding QuestWorkspace.SelectedQuest.Subtitle}" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          VerticalAlignment="Top"
                          Command="{Binding QuestWorkspace.PauseQuestCommand}"
                          Content="Pause" />
                  <Button Grid.Column="2"
                          Classes="secondary"
                          VerticalAlignment="Top"
                          Command="{Binding QuestWorkspace.RemoveQuestCommand}"
                          Content="{Binding QuestWorkspace.RemoveQuestButtonText}" />
                </Grid>
                <TextBlock Classes="muted"
                           Text="{Binding QuestWorkspace.SelectedQuest.TagsLabel}" />
                <Separator />
                <TextBlock Classes="card-title" Text="Objectives" />
                <ItemsControl ItemsSource="{Binding QuestWorkspace.SelectedQuest.Objectives}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuestObjectiveRowViewModel">
                      <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                              BorderThickness="0,1,0,0"
                              Padding="0,10">
                        <Grid ColumnDefinitions="*,100,90" ColumnSpacing="10">
                          <TextBlock TextWrapping="Wrap" Text="{Binding Label}" />
                          <TextBlock Grid.Column="1"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource RavenAccentBrush}"
                                     Text="{Binding State}" />
                          <TextBlock Grid.Column="2"
                                     HorizontalAlignment="Right"
                                     Text="{Binding Progress}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="card-title" Text="Tracked locations" />
                <ItemsControl ItemsSource="{Binding QuestWorkspace.SelectedQuest.Locations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuestLocationRowViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Grid.Column="1"
                                   Classes="muted"
                                   Text="{Binding Coordinates}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Catalog">
        <Grid ColumnDefinitions="320,*" ColumnSpacing="18" Margin="0,16,0,0">
          <Border Classes="card" Padding="10">
            <ListBox ItemsSource="{Binding QuestWorkspace.Catalog}"
                     SelectedItem="{Binding QuestWorkspace.SelectedCatalogQuest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuestCatalogRowViewModel">
                  <StackPanel Margin="4,7" Spacing="3">
                    <TextBlock FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Title}" />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SubtitleOrDescription}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Column="1" Classes="card raised">
            <StackPanel Spacing="14">
              <TextBlock Classes="eyebrow"
                         Text="{Binding QuestWorkspace.SelectedCatalogQuest.Duration}" />
              <TextBlock Classes="card-title"
                         FontSize="21"
                         Text="{Binding QuestWorkspace.SelectedCatalogQuest.Title}" />
              <TextBlock Classes="muted"
                         Text="{Binding QuestWorkspace.SelectedCatalogQuest.Identity}" />
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding QuestWorkspace.SelectedCatalogQuest.Description}" />
              <TextBlock Classes="muted"
                         Text="{Binding QuestWorkspace.SelectedCatalogQuest.TagsLabel}" />
              <Button Classes="primary"
                      HorizontalAlignment="Left"
                      Command="{Binding QuestWorkspace.ActivateQuestCommand}"
                      Content="Activate quest" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="History">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,16,0,0">
          <Border Classes="card" Padding="10">
            <ListBox ItemsSource="{Binding QuestWorkspace.History}"
                     SelectedItem="{Binding QuestWorkspace.SelectedHistoryQuest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuestHistoryRowViewModel">
                  <Grid ColumnDefinitions="*,110,160" ColumnSpacing="12" Margin="4,7">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Identity}" />
                    <TextBlock Grid.Column="1"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               Text="{Binding StateLabel}" />
                    <TextBlock Grid.Column="2"
                               Classes="muted"
                               Text="{Binding StateChangedOn}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Button Grid.Column="1"
                  Classes="primary"
                  VerticalAlignment="Top"
                  Command="{Binding QuestWorkspace.ResumeQuestCommand}"
                  Content="Resume paused quest" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
