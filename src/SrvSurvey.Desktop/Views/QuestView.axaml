<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.QuestView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <Grid RowDefinitions="Auto,Auto,*" Margin="32" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="RAVEN COMMUNICATIONS" />
        <TextBlock Classes="page-title" Text="Quests" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="Read transmissions, follow active objectives, and manage commander adventures." />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="secondary"
              VerticalAlignment="Center"
              Command="{Binding QuestWorkspace.ToggleEnabledCommand}"
              Content="{Binding QuestWorkspace.ToggleEnabledButtonText}" />
      <Button Grid.Column="2"
              Classes="primary"
              MinWidth="100"
              VerticalAlignment="Center"
              Command="{Binding QuestWorkspace.RefreshCommand}"
              Content="{Binding QuestWorkspace.RefreshButtonText}" />
    </Grid>

    <Border Grid.Row="1" Classes="card raised" Padding="0">
      <Grid ColumnDefinitions="6,*">
        <Border Classes="accent-line" CornerRadius="12,0,0,12" />
        <Grid Grid.Column="1"
              Margin="20,14"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title"
                       Text="{Binding QuestWorkspace.ActiveQuestSummary}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding QuestWorkspace.StatusMessage}" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="{DynamicResource RavenAccentBrush}"
                     Text="{Binding QuestWorkspace.MessageSummary}" />
        </Grid>
      </Grid>
    </Border>

    <TabControl Grid.Row="2">
      <TabItem Header="Messages">
        <Grid ColumnDefinitions="320,*" ColumnSpacing="18" Margin="0,16,0,0">
          <Border Classes="card" Padding="10">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
              <TextBlock Classes="card-title"
                         Text="{Binding QuestWorkspace.MessageSummary}" />
              <ListBox Grid.Row="1"
                       ItemsSource="{Binding QuestWorkspace.Messages}"
                       SelectedItem="{Binding QuestWorkspace.SelectedMessage}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuestMessageRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,7">
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Subject}" />
                        <TextBlock Classes="muted"
                                   FontSize="11"
                                   Text="{Binding From}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                        <TextBlock FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource RavenAccentBrush}"
                                   Text="{Binding ReadLabel}" />
                        <TextBlock Classes="muted"
                                   FontSize="10"
                                   Text="{Binding ReceivedLabel}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="1" Classes="card raised">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <ContentControl Content="{Binding QuestWorkspace.SelectedMessage}">
                    <ContentControl.ContentTemplate>
                      <DataTemplate x:DataType="vm:QuestMessageRowViewModel">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="eyebrow" Text="{Binding From}" />
                          <TextBlock Classes="card-title"
                                     FontSize="21"
                                     TextWrapping="Wrap"
                                     Text="{Binding Subject}" />
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          VerticalAlignment="Top"
                          Command="{Binding QuestWorkspace.OpenMessageCommand}"
                          CommandParameter="{Binding QuestWorkspace.SelectedMessage}"
                          Content="Open / mark read" />
                </Grid>
                <ContentControl Content="{Binding QuestWorkspace.SelectedMessage}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:QuestMessageRowViewModel">
                      <StackPanel Spacing="14">
                        <TextBlock Classes="muted" Text="{Binding TagsLabel}" />
                        <Separator />
                        <TextBlock FontSize="14"
                                   LineHeight="22"
                                   TextWrapping="Wrap"
                                   Text="{Binding Body}" />
                        <TextBlock Classes="muted"
                                   FontWeight="SemiBold"
                                   Text="{Binding Replied, StringFormat='Response: {0}'}" />
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
                <ItemsControl ItemsSource="{Binding QuestWorkspace.MessageActions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuestMessageActionViewModel">
                      <Button Classes="primary"
                              Margin="0,0,8,8"
                              Command="{Binding Command}"
                              Content="{Binding Label}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="My quests">
        <Grid ColumnDefinitions="320,*" ColumnSpacing="18" Margin="0,16,0,0">
          <Border Classes="card" Padding="10">
            <ListBox ItemsSource="{Binding QuestWorkspace.ActiveQuests}"
                     SelectedItem="{Binding QuestWorkspace.SelectedQuest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuestCardViewModel">
                  <StackPanel Margin="4,7" Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Title}" />
                      <TextBlock Grid.Column="1"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource RavenAccentBrush}"
                                 Text="{Binding StateLabel}" />
                    </Grid>
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Subtitle}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <Border Grid.Column="1" Classes="card raised">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <ContentControl Content="{Binding QuestWorkspace.SelectedQuest}">
                    <ContentControl.ContentTemplate>
                      <DataTemplate x:DataType="vm:QuestCardViewModel">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="eyebrow" Text="{Binding StateLabel}" />
                          <TextBlock Classes="card-title"
                                     FontSize="21"
                                     Text="{Binding Title}" />
                          <TextBlock Classes="muted"
                                     TextWrapping="Wrap"
                                     Text="{Binding Subtitle}" />
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.ContentTemplate>
                  </ContentControl>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          VerticalAlignment="Top"
                          Command="{Binding QuestWorkspace.PauseQuestCommand}"
                          Content="Pause" />
                  <Button Grid.Column="2"
                          Classes="secondary"
                          VerticalAlignment="Top"
                          Command="{Binding QuestWorkspace.RemoveQuestCommand}"
                          Content="{Binding QuestWorkspace.RemoveQuestButtonText}" />
                </Grid>
                <ContentControl Content="{Binding QuestWorkspace.SelectedQuest}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:QuestCardViewModel">
                      <StackPanel Spacing="14">
                        <TextBlock Classes="muted" Text="{Binding TagsLabel}" />
                        <Separator />
                        <TextBlock Classes="card-title" Text="Objectives" />
                        <ItemsControl ItemsSource="{Binding Objectives}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuestObjectiveRowViewModel">
                              <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                                      BorderThickness="0,1,0,0"
                                      Padding="0,10">
                                <Grid ColumnDefinitions="*,100,90" ColumnSpacing="10">
                                  <TextBlock TextWrapping="Wrap" Text="{Binding Label}" />
                                  <TextBlock Grid.Column="1"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource RavenAccentBrush}"
                                             Text="{Binding State}" />
                                  <TextBlock Grid.Column="2"
                                             HorizontalAlignment="Right"
                                             Text="{Binding Progress}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="card-title" Text="Tracked locations" />
                        <ItemsControl ItemsSource="{Binding Locations}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuestLocationRowViewModel">
                              <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Grid.Column="1"
                                           Classes="muted"
                                           Text="{Binding Coordinates}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Catalog">
        <Grid ColumnDefinitions="320,*" ColumnSpacing="18" Margin="0,16,0,0">
          <Border Classes="card" Padding="10">
            <ListBox ItemsSource="{Binding QuestWorkspace.Catalog}"
                     SelectedItem="{Binding QuestWorkspace.SelectedCatalogQuest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuestCatalogRowViewModel">
                  <StackPanel Margin="4,7" Spacing="3">
                    <TextBlock FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Title}" />
                    <TextBlock Classes="muted"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SubtitleOrDescription}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Column="1" Classes="card raised">
            <StackPanel Spacing="14">
              <ContentControl Content="{Binding QuestWorkspace.SelectedCatalogQuest}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:QuestCatalogRowViewModel">
                    <StackPanel Spacing="14">
                      <TextBlock Classes="eyebrow" Text="{Binding Duration}" />
                      <TextBlock Classes="card-title"
                                 FontSize="21"
                                 Text="{Binding Title}" />
                      <TextBlock Classes="muted" Text="{Binding Identity}" />
                      <TextBlock TextWrapping="Wrap" Text="{Binding Description}" />
                      <TextBlock Classes="muted" Text="{Binding TagsLabel}" />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
              <Button Classes="primary"
                      HorizontalAlignment="Left"
                      Command="{Binding QuestWorkspace.ActivateQuestCommand}"
                      Content="Activate quest" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="History">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,16,0,0">
          <Border Classes="card" Padding="10">
            <ListBox ItemsSource="{Binding QuestWorkspace.History}"
                     SelectedItem="{Binding QuestWorkspace.SelectedHistoryQuest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:QuestHistoryRowViewModel">
                  <Grid ColumnDefinitions="*,110,160" ColumnSpacing="12" Margin="4,7">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Identity}" />
                    <TextBlock Grid.Column="1"
                               Foreground="{DynamicResource RavenAccentBrush}"
                               Text="{Binding StateLabel}" />
                    <TextBlock Grid.Column="2"
                               Classes="muted"
                               Text="{Binding StateChangedOn}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Button Grid.Column="1"
                  Classes="primary"
                  VerticalAlignment="Top"
                  Command="{Binding QuestWorkspace.ResumeQuestCommand}"
                  Content="Resume paused quest" />
        </Grid>
      </TabItem>

      <TabItem Header="Developer">
        <ScrollViewer Margin="0,16,0,0"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
            <Border Classes="card raised">
              <Grid RowDefinitions="Auto,Auto,Auto"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    RowSpacing="10">
                <StackPanel Spacing="3">
                  <TextBlock Classes="eyebrow" Text="QUEST DEBUGGER" />
                  <TextBlock Classes="card-title"
                             FontSize="21"
                             Text="{Binding QuestWorkspace.Developer.Title}" />
                  <TextBlock Classes="muted"
                             Text="{Binding QuestWorkspace.Developer.VersionLabel, StringFormat='Version {0}'}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="primary"
                        VerticalAlignment="Top"
                        Click="ImportDevelopmentFolder_Click"
                        Content="Import folder" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Classes="muted"
                           TextWrapping="Wrap"
                           Text="{Binding QuestWorkspace.Developer.SourceDirectory}" />
                <Grid Grid.Row="2"
                      Grid.ColumnSpan="2"
                      ColumnDefinitions="Auto,*,Auto,Auto"
                      ColumnSpacing="10">
                  <CheckBox VerticalAlignment="Center"
                            IsEnabled="{Binding QuestWorkspace.Developer.CanWatchSource}"
                            IsChecked="{Binding QuestWorkspace.Developer.WatchSource, Mode=TwoWay}"
                            Content="Watch source folder" />
                  <TextBlock Grid.Column="1"
                             Classes="muted"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Text="{Binding QuestWorkspace.Developer.StatusMessage}" />
                  <Button Grid.Column="2"
                          Classes="secondary"
                          Command="{Binding QuestWorkspace.Developer.ReloadSavedCommand}"
                          Content="Reload saved state" />
                  <Button Grid.Column="3"
                          Classes="secondary"
                          Command="{Binding QuestWorkspace.Developer.RemoveCommand}"
                          Content="{Binding QuestWorkspace.Developer.RemoveButtonText}" />
                </Grid>
              </Grid>
            </Border>

            <Border Classes="card"
                    IsVisible="{Binding QuestWorkspace.Developer.HasDevelopmentQuest}">
              <Grid RowDefinitions="Auto,300,Auto,Auto,Auto"
                    RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                      ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding QuestWorkspace.Developer.Views}"
                            SelectedItem="{Binding QuestWorkspace.Developer.SelectedView}"
                            MinWidth="240">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:QuestDevelopmentViewOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding QuestWorkspace.Developer.RefreshCommand}"
                          Content="Refresh" />
                  <Button Grid.Column="2"
                          Classes="primary"
                          Command="{Binding QuestWorkspace.Developer.ApplyCommand}"
                          Content="Apply JSON" />
                  <Button Grid.Column="3"
                          Classes="secondary"
                          IsVisible="{Binding QuestWorkspace.Developer.IsChapterSelected}"
                          Command="{Binding QuestWorkspace.Developer.StartChapterCommand}"
                          Content="Start chapter" />
                  <Button Grid.Column="4"
                          Classes="secondary"
                          IsVisible="{Binding QuestWorkspace.Developer.IsChapterSelected}"
                          Command="{Binding QuestWorkspace.Developer.StopChapterCommand}"
                          Content="Stop chapter" />
                </Grid>

                <TextBox Grid.Row="1"
                         AcceptsReturn="True"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Text="{Binding QuestWorkspace.Developer.EditorJson, Mode=TwoWay}" />

                <Grid Grid.Row="2"
                      IsVisible="{Binding QuestWorkspace.Developer.IsChapterSelected}"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                  <TextBox AcceptsReturn="True"
                           MinHeight="90"
                           PlaceholderText="Lua debug code"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           Text="{Binding QuestWorkspace.Developer.DebugCode, Mode=TwoWay}" />
                  <Button Grid.Column="1"
                          Classes="primary"
                          VerticalAlignment="Bottom"
                          Command="{Binding QuestWorkspace.Developer.RunDebugCommand}"
                          Content="Run Lua" />
                </Grid>

                <TextBlock Grid.Row="3"
                           Classes="muted"
                           IsVisible="{Binding QuestWorkspace.Developer.IsChapterSelected}"
                           TextWrapping="Wrap"
                           Text="{Binding QuestWorkspace.Developer.DebugResult}" />

                <Grid Grid.Row="4"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                  <CheckBox VerticalAlignment="Center"
                            IsChecked="{Binding QuestWorkspace.Developer.PublishConfirmed, Mode=TwoWay}"
                            Content="Confirm overwrite of the published Raven quest version" />
                  <Button Grid.Column="1"
                          Classes="primary"
                          Command="{Binding QuestWorkspace.Developer.PublishCommand}"
                          Content="Publish quest" />
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
