<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors"
 x:Class="SrvSurvey.Desktop.Views.MiningMissionCardsView" x:DataType="vm:MiningWorkspaceViewModel">
 <StackPanel Spacing="8">
  <TextBlock Text="Mining missions" Classes="card-title" />
  <TextBlock Text="Track missions in the overlay using each card's checkbox. Cargo is shared in acceptance order; delivered tonnes are counted separately." Classes="muted" TextWrapping="Wrap" />
  <TextBlock Text="Tracked destinations" FontSize="13" FontWeight="SemiBold" />
  <TextBlock Text="Select missions below to preview their combined destination requirements." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasTrackedMissionDestinations}" />
  <ItemsControl x:Name="TrackedDestinationSummary" ItemsSource="{Binding TrackedMissionDestinations}">
   <ItemsControl.ItemTemplate>
    <DataTemplate x:DataType="vm:MiningMissionDestinationViewModel">
     <Border Classes="mining-destination-summary" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6,0,8">
      <Grid ColumnDefinitions="2*,4*,Auto" ColumnSpacing="12" RowSpacing="6" SizeChanged="Summary_SizeChanged">
       <StackPanel Spacing="2">
        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button Classes="link" Padding="0" MinHeight="0" HorizontalAlignment="Left" behaviors:ClipboardCopyBehavior.Text="{Binding System}" IsVisible="{Binding HasSystem}">
         <TextBlock Text="{Binding System}" TextWrapping="Wrap" />
        </Button>
       </StackPanel>
       <StackPanel Grid.Column="2" Spacing="2" MaxWidth="150">
        <TextBlock Text="{Binding TrackedLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ExpiryLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
       </StackPanel>
       <ItemsControl Grid.Column="1" ItemsSource="{Binding Commodities}">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="vm:MiningMissionCommodityTotalsViewModel">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3" Margin="0,0,0,6">
           <StackPanel VerticalAlignment="Center">
            <Border Classes="commodity-code material" Width="40" Height="20" Padding="0" ToolTip.Tip="{Binding Commodity}" IsVisible="{Binding UseShortTags}">
             <TextBlock Text="{Binding Code}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Commodity}" IsVisible="{Binding !UseShortTags}" TextWrapping="Wrap" MaxWidth="120" />
           </StackPanel>
           <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding CargoProgress}" Margin="0,0,12,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeliveryProgress}" Margin="0,0,12,0" Foreground="{DynamicResource RavenSuccessBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Needed}" TextWrapping="Wrap" />
           </WrapPanel>
           <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Value="{Binding DeliveryPercentage}" Maximum="100" Foreground="{DynamicResource RavenSuccessBrush}" Background="{DynamicResource RavenRaisedSurfaceBrush}" />
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </Grid>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <WrapPanel>
   <TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,12,8" />
   <Button Content="Commodity" Classes="link" Command="{Binding MissionsSortCommand}" CommandParameter="Commodity" Margin="0,0,12,8" />
   <Button Content="Required" Classes="link" Command="{Binding MissionsSortCommand}" CommandParameter="Required" Margin="0,0,12,8" />
   <Button Content="Delivered" Classes="link" Command="{Binding MissionsSortCommand}" CommandParameter="Delivered" Margin="0,0,12,8" />
   <Button Content="On board" Classes="link" Command="{Binding MissionsSortCommand}" CommandParameter="OnBoard" Margin="0,0,12,8" />
   <Button Content="Status" Classes="link" Command="{Binding MissionsSortCommand}" CommandParameter="Status" Margin="0,0,12,8" />
   <Button Content="Expiry" Classes="link" Command="{Binding MissionsSortCommand}" CommandParameter="Expiry" Margin="0,0,12,8" />
   <Button Content="Destination" Classes="link" Command="{Binding MissionsSortCommand}" CommandParameter="Destination" Margin="0,0,12,8" />
   <Button Content="Needed" Classes="link" Command="{Binding MissionsSortCommand}" CommandParameter="Remaining" Margin="0,0,12,8" />
  </WrapPanel>
  <TextBlock Text="Accept a mining mission in game to track its cargo and deliveries here." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasMissionCards}" />
  <ItemsControl x:Name="MissionCards" ItemsSource="{Binding MissionCards}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel SizeChanged="Cards_SizeChanged" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate>
    <DataTemplate x:DataType="vm:MiningMissionCardViewModel">
     <Border Classes="mining-mission-card" Background="{DynamicResource RavenSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,8,8">
      <StackPanel Spacing="4">
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding Commodity}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource RavenAccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" IsChecked="{Binding IsTracked, Mode=TwoWay}" IsEnabled="{Binding IsActive}" Content="Track" FontSize="11" Padding="2,0" ToolTip.Tip="Show this mission in the Mining Missions overlay" />
       </Grid>
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding CargoOnBoard}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding Needed}" Classes="muted" />
       </Grid>
       <ProgressBar Value="{Binding CargoPercentage}" Maximum="100" Height="4" Foreground="{DynamicResource RavenAccentBrush}" Background="{DynamicResource RavenRaisedSurfaceBrush}" />
       <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding DeliveryProgress}" Foreground="{DynamicResource RavenSuccessBrush}" />
        <TextBlock Grid.Column="1" Text="&#x2713;" IsVisible="{Binding IsComplete}" FontSize="18" FontWeight="Bold" FontFamily="avares://SrvSurvey.Desktop/Assets/Fonts/NotoSansSymbols2#Noto Sans Symbols 2" Foreground="{DynamicResource RavenSuccessBrush}" />
       </Grid>
       <ProgressBar Value="{Binding DeliveryPercentage}" Maximum="100" Height="4" Foreground="{DynamicResource RavenSuccessBrush}" Background="{DynamicResource RavenRaisedSurfaceBrush}" />
       <Button Classes="link" HorizontalAlignment="Left" Padding="0" MinHeight="0" IsEnabled="{Binding HasSystem}" behaviors:ClipboardCopyBehavior.Text="{Binding System}">
        <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" />
       </Button>
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding TimeRemaining}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" />
       </Grid>
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel>
         <TextBlock Text="{Binding Reward}" FontWeight="SemiBold" FontSize="12" />
         <TextBlock Text="{Binding RewardPerTon}" Classes="muted" FontSize="10" />
        </StackPanel>
        <Button Grid.Column="1" Content="Find hotspots" FontSize="11" Padding="6,3" MinHeight="24" Command="{Binding FindHotspotsCommand}" VerticalAlignment="Center" />
       </Grid>
      </StackPanel>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
 </StackPanel>
</UserControl>
