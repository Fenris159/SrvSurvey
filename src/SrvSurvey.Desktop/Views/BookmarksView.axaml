<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:nav="using:SrvSurvey.Core.Navigation" xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors" Grid.IsSharedSizeScope="True" x:Class="SrvSurvey.Desktop.Views.BookmarksView" x:DataType="vm:BookmarksViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Classes="eyebrow" Text="NAVIGATION"/>
      <TextBlock Classes="page-title" Text="Bookmarks"/>
      <TextBlock Classes="muted" Text="Keep mining rings, saved surface mining maps, locations, POIs and other destinations in one catalog. Assign one or more categories to control where each bookmark appears." TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="180,*" ColumnSpacing="12">
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" HorizontalAlignment="Stretch"/>
        <TextBox Grid.Column="1" Text="{Binding Query}" PlaceholderText="Filter systems, rings, minerals or notes"/>
      </Grid>
      <Grid x:Name="BookmarksHeader" Classes="table-header" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks2" /><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks3" /><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks4" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
        <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="System"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="SYSTEM" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=System}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="DisplayBody"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="BODY" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=DisplayBody}" /></StackPanel></Button>
        <Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="DisplayRing"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="RING" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=DisplayRing}" /></StackPanel></Button><Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="CategoryDisplay"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="CATEGORY" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=CategoryDisplay}" /></StackPanel></Button><Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="DisplayDetails"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="DETAILS" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=DisplayDetails}" /></StackPanel></Button><Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Notes"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="NOTES" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Notes}" /></StackPanel></Button>
      </Grid>
      <ListBox x:Name="BookmarkRows" Classes="table-rows" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MinHeight="180" MaxHeight="360">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="New bookmark" Command="{Binding NewCommand}"/>
            <MenuItem Header="Delete selected bookmark" Command="{Binding DeleteCommand}"/>
            <MenuItem Header="Copy selected system" behaviors:ClipboardCopyBehavior.Text="{Binding Selected.System}"/>
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="nav:GalacticBookmark">
            <Grid Classes="table-row" Margin="10,7" RowDefinitions="Auto" ColumnSpacing="10" Tag="{Binding Id}" PointerPressed="BookmarkRow_PointerPressed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks2" /><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks3" /><ColumnDefinition Width="Auto" SharedSizeGroup="Bookmarks4" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding System}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding System}"/>
              <TextBlock Grid.Column="1" Text="{Binding DisplayBody}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayBody}"/>
              <TextBlock Grid.Column="2" Text="{Binding DisplayRing}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayRing}"/>
              <TextBlock Grid.Column="3" Text="{Binding CategoryDisplay}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CategoryDisplay}"/>
              <TextBlock Grid.Column="4" Classes="muted" Text="{Binding DisplayDetails}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayDetails}"/>
              <TextBlock Grid.Column="5" Width="180" Classes="muted" Text="{Binding Notes}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notes}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="card-title" Text="Bookmark details"/>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="System"/>
              <TextBox Text="{Binding System}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Body (optional)"/>
              <TextBox Text="{Binding Body}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Ring (optional)"/>
              <TextBox Text="{Binding Ring}"/>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Categories"/>
              <Expander Header="{Binding CategorySummary}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Margin="8" Spacing="6">
                  <CheckBox Content="Mining" IsChecked="{Binding CategoryMining, Mode=TwoWay}"/>
                  <CheckBox Content="Surface Mining" IsChecked="{Binding CategorySurfaceMining, Mode=TwoWay}"/>
                  <CheckBox Content="Location" IsChecked="{Binding CategoryLocation, Mode=TwoWay}"/>
                  <CheckBox Content="POI" IsChecked="{Binding CategoryPoi, Mode=TwoWay}"/>
                  <CheckBox Content="Other" IsChecked="{Binding CategoryOther, Mode=TwoWay}"/>
                </StackPanel>
              </Expander>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Rating (0–5)"/>
              <NumericUpDown Minimum="0" Maximum="5" Value="{Binding Rating}" FormatString="0"/>
            </StackPanel>
          </Grid>
          <Border Classes="card raised" IsVisible="{Binding IsSurfaceMiningMap}">
            <StackPanel Spacing="10">
              <TextBlock Classes="card-title" Text="Surface mining map"/>
              <Grid ColumnDefinitions=".7*,1.4*,1*,1*" ColumnSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="Signal #"/>
                  <NumericUpDown Minimum="1" Maximum="9999" Value="{Binding SurfaceSignal}" FormatString="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Body type"/>
                  <TextBox Text="{Binding SurfaceBodyType}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                  <TextBlock Text="Mineral amount"/>
                  <ComboBox ItemsSource="{Binding SurfaceRatingOptions}" SelectedItem="{Binding SurfaceMineralAmount}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4">
                  <TextBlock Text="Density"/>
                  <ComboBox ItemsSource="{Binding SurfaceRatingOptions}" SelectedItem="{Binding SurfaceDensity}"/>
                </StackPanel>
              </Grid>
              <StackPanel Spacing="4" MaxWidth="260" HorizontalAlignment="Left">
                <TextBlock Text="Arrival distance (ls)"/>
                <NumericUpDown Minimum="0" Maximum="1000000000" Value="{Binding SurfaceArrivalDistanceLs}" FormatString="0.0"/>
              </StackPanel>
              <TextBlock Classes="muted" Text="Map coordinates and deposit markers remain attached while these bookmark details and notes are edited." TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Minerals"/>
          <TextBox Text="{Binding Minerals}"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Hotspot overlaps"/>
              <TextBox Text="{Binding Overlaps}" PlaceholderText="e.g. Platinum ×2"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Resource Extraction Sites"/>
              <TextBox Text="{Binding ResourceExtractionSites}" PlaceholderText="e.g. Hazardous"/>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Hotspot name"/>
              <TextBox Text="{Binding Hotspot}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Average yield"/>
              <TextBox Text="{Binding AverageYield}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Last mined (YYYY-MM-DD)"/>
              <TextBox Text="{Binding LastMined}"/>
            </StackPanel>
          </Grid>
          <ItemsControl ItemsSource="{Binding SelectedScreenshots}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Content="Open screenshot" Tag="{Binding}" Click="OpenScreenshot_Click"/><Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="RemoveScreenshot_Click"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Notes"/>
          <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
          <WrapPanel>
            <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,8,0"/>
            <Button Content="Save bookmark" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="Import…" Click="Import_Click" Margin="0,0,8,0"/>
            <Button Content="Export…" Click="Export_Click" Margin="0,0,8,0"/><Button Content="Attach screenshots…" Click="Attach_Click" Margin="0,0,8,0"/><Button Content="Undo delete" Click="Undo_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
