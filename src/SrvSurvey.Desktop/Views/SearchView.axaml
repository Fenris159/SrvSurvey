<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             xmlns:search="using:SrvSurvey.Core.Search"
             x:Class="SrvSurvey.Desktop.Views.SearchView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="1050">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="5">
          <TextBlock Classes="eyebrow" Text="SEARCH" />
          <TextBlock Classes="page-title" Text="Galactic search tools" />
          <TextBlock Classes="muted"
                     Text="Define a spherical boundary or work a generated boxel one system at a time." />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinWidth="116"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}"
                Content="{Binding RefreshButtonText}" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Classes="eyebrow"
                   VerticalAlignment="Center"
                   Text="SPHERICAL LIMIT" />
        <Separator Grid.Column="1" VerticalAlignment="Center" />
      </Grid>

      <Border Classes="card raised" Padding="0">
        <Grid ColumnDefinitions="6,*">
          <Border Classes="accent-line" CornerRadius="12,0,0,12" />
          <Grid Grid.Column="1"
                Margin="28"
                ColumnDefinitions="2*,*,*"
                ColumnSpacing="24">
            <StackPanel Spacing="5">
              <TextBlock Classes="muted" Text="CURRENT LIMIT" />
              <TextBlock FontSize="28"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource RavenAccentBrush}"
                         TextWrapping="Wrap"
                         Text="{Binding Search.LimitSummary}" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{Binding Search.CurrentSystemResult}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="muted" Text="CURRENT SYSTEM" />
              <TextBlock Classes="card-title"
                         TextWrapping="Wrap"
                         Text="{Binding Search.CurrentSystemName}" />
              <TextBlock Classes="muted monospace"
                         TextWrapping="Wrap"
                         Text="{Binding Search.CurrentPosition}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Classes="muted" Text="TO CENTER" />
              <TextBlock Classes="metric" Text="{Binding Search.DistanceToCenter}" />
              <Border Classes="badge" HorizontalAlignment="Left">
                <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                           FontSize="11"
                           Text="{Binding Search.StatusLabel}" />
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Configure the search sphere" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="CENTER SYSTEM" />
                <TextBox Text="{Binding Search.Query, Mode=TwoWay}"
                         PlaceholderText="Sol, Colonia, or another system" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="secondary"
                      MinWidth="120"
                      VerticalAlignment="Bottom"
                      Command="{Binding Search.SearchCommand}"
                      Content="{Binding Search.SearchButtonText}" />
            </Grid>
            <StackPanel Spacing="6" IsVisible="{Binding Search.HasSearchResults}">
              <TextBlock Classes="muted" Text="MATCHING SYSTEMS" />
              <ComboBox ItemsSource="{Binding Search.SearchResults}"
                        SelectedItem="{Binding Search.SelectedCenterSystem, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="search:StarSystemReference">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1"
                                 Classes="muted monospace"
                                 Text="{Binding Position}" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="RADIUS (LIGHT-YEARS)" />
              <TextBox Text="{Binding Search.Radius, Mode=TwoWay}"
                       PlaceholderText="1 to 1000" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary"
                      Margin="0,0,10,10"
                      Command="{Binding Search.EnableCommand}"
                      Content="Enable limit" />
              <Button Classes="secondary"
                      Margin="0,0,0,10"
                      Command="{Binding Search.DisableCommand}"
                      Content="Disable limit" />
            </WrapPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Search.StatusMessage}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Resolved center" />
            <StackPanel Spacing="5">
              <TextBlock Classes="muted" Text="SYSTEM" />
              <TextBlock FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Text="{Binding Search.CenterSystemName}" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Classes="muted" Text="GALACTIC POSITION" />
              <TextBlock Classes="monospace"
                         TextWrapping="Wrap"
                         Text="{Binding Search.CenterPosition}" />
            </StackPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="System suggestions and coordinates come from Spansh. Saving updates only the compatible sphereLimit fields." />
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
        <TextBlock Classes="eyebrow"
                   VerticalAlignment="Center"
                   Text="BOXEL SEARCH" />
        <Separator Grid.Column="1" VerticalAlignment="Center" />
      </Grid>

      <Border Classes="card raised" Padding="0">
        <Grid ColumnDefinitions="6,*">
          <Border Classes="accent-line" CornerRadius="12,0,0,12" />
          <Grid Grid.Column="1"
                Margin="28"
                ColumnDefinitions="2*,2*,*,Auto"
                ColumnSpacing="24">
            <StackPanel Spacing="5">
              <TextBlock Classes="muted" Text="CURRENT BOXEL" />
              <TextBlock FontSize="24"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource RavenAccentBrush}"
                         TextWrapping="Wrap"
                         Text="{Binding BoxelSearch.CurrentBoxelName}" />
              <TextBlock Classes="muted" Text="{Binding BoxelSearch.SystemProgress}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="muted" Text="NEXT SYSTEM" />
              <TextBlock Classes="card-title monospace"
                         TextWrapping="Wrap"
                         Text="{Binding BoxelSearch.NextSystem}" />
              <TextBlock Classes="muted" Text="{Binding BoxelSearch.BoxelProgress}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Classes="muted" Text="CURRENT SYSTEM" />
              <TextBlock FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Text="{Binding BoxelSearch.CurrentSystemName}" />
            </StackPanel>
            <Border Grid.Column="3"
                    Classes="badge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
              <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                         FontSize="11"
                         Text="{Binding BoxelSearch.StatusLabel}" />
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Configure boxel search" />
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="TOP BOXEL OR GENERATED SYSTEM" />
              <TextBox Text="{Binding BoxelSearch.TopBoxelText, Mode=TwoWay}"
                       PlaceholderText="Praea Euq IL-P c5-0" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{Binding BoxelSearch.SearchSize}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="LOWEST MASS CODE" />
                <ComboBox ItemsSource="{Binding BoxelSearch.MassCodes}"
                          SelectedItem="{Binding BoxelSearch.LowMassCode, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="muted" Text="SEARCH START DATE" />
                <DatePicker SelectedDate="{Binding BoxelSearch.StartedOn, Mode=TwoWay}" />
              </StackPanel>
            </Grid>
            <CheckBox IsChecked="{Binding BoxelSearch.SkipAlreadyVisited, Mode=TwoWay}"
                      Content="Skip systems visited before the start date" />
            <CheckBox IsChecked="{Binding BoxelSearch.SkipKnownToSpansh, Mode=TwoWay}"
                      Content="Skip systems known to Spansh before the start date" />
            <CheckBox IsChecked="{Binding BoxelSearch.CompleteOnFssAllBodies, Mode=TwoWay}"
                      Content="Complete only after FSS reports all bodies" />
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary"
                      Margin="0,0,10,10"
                      Command="{Binding BoxelSearch.ActivateCommand}"
                      Content="Start search" />
              <Button Classes="secondary"
                      Margin="0,0,0,10"
                      Command="{Binding BoxelSearch.DisableCommand}"
                      Content="Stop search" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Current boxel controls" />
            <CheckBox IsChecked="{Binding BoxelSearch.AutoCopy, Mode=TwoWay}"
                      Content="Auto-copy next system in Galaxy Map" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="EXPECTED SYSTEMS" />
                <TextBox Text="{Binding BoxelSearch.ExpectedSystemCount, Mode=TwoWay}" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="secondary"
                      VerticalAlignment="Bottom"
                      Command="{Binding BoxelSearch.ApplyExpectedCountCommand}"
                      Content="Apply" />
            </Grid>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary"
                      Margin="0,0,10,10"
                      Command="{Binding BoxelSearch.CopyNextCommand}"
                      Content="Copy next" />
              <Button Classes="secondary"
                      Margin="0,0,10,10"
                      Command="{Binding BoxelSearch.RefreshCommand}"
                      Content="{Binding BoxelSearch.RefreshButtonText}" />
              <Button Classes="secondary"
                      Margin="0,0,0,10"
                      Command="{Binding BoxelSearch.ToggleEmptyCommand}"
                      Content="{Binding BoxelSearch.EmptyButtonText}" />
            </WrapPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding BoxelSearch.StatusMessage}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card" IsVisible="{Binding BoxelSearch.IsActive}">
        <StackPanel Spacing="14">
          <TextBlock Classes="card-title" Text="Navigate the search tree" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="secondary"
                    Margin="0,0,10,10"
                    Command="{Binding BoxelSearch.NavigateParentCommand}"
                    Content="Parent" />
            <Button Classes="secondary"
                    Margin="0,0,10,10"
                    Command="{Binding BoxelSearch.NavigatePreviousCommand}"
                    Content="Previous sibling" />
            <Button Classes="secondary"
                    Margin="0,0,0,10"
                    Command="{Binding BoxelSearch.NavigateNextCommand}"
                    Content="Next sibling" />
          </WrapPanel>
          <StackPanel Spacing="6" IsVisible="{Binding BoxelSearch.HasChildBoxels}">
            <TextBlock Classes="muted" Text="CHILD BOXELS" />
            <ItemsControl ItemsSource="{Binding BoxelSearch.ChildBoxels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BoxelNavigationOptionViewModel">
                  <Button Classes="secondary"
                          Margin="0,0,10,10"
                          Command="{Binding NavigateCommand}"
                          Content="{Binding Label}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding BoxelSearch.IsActive}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Systems in current boxel" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{Binding BoxelSearch.SystemListNote}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Classes="muted"
                       VerticalAlignment="Center"
                       Text="{Binding BoxelSearch.SystemProgress}" />
          </Grid>
          <Border Background="{DynamicResource RavenSurfaceBrush}"
                  CornerRadius="8"
                  Padding="12,8">
            <Grid ColumnDefinitions="2*,*,*,*,Auto" ColumnSpacing="12">
              <TextBlock Classes="muted" Text="SYSTEM" />
              <TextBlock Grid.Column="1" Classes="muted" Text="DISTANCE" />
              <TextBlock Grid.Column="2" Classes="muted" Text="VISITED" />
              <TextBlock Grid.Column="3" Classes="muted" Text="SPANSH" />
              <TextBlock Grid.Column="4" Classes="muted" Text="STATE" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding BoxelSearch.Systems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BoxelSystemRowViewModel">
                <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                  <Grid ColumnDefinitions="2*,*,*,*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="monospace"
                                 FontWeight="SemiBold"
                                 Text="{Binding Name}" />
                      <TextBlock Classes="muted"
                                 FontSize="10"
                                 IsVisible="{Binding IsCurrent}"
                                 Text="CURRENT SYSTEM" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Classes="muted"
                               VerticalAlignment="Center"
                               Text="{Binding Distance}" />
                    <TextBlock Grid.Column="2"
                               Classes="muted"
                               VerticalAlignment="Center"
                               Text="{Binding VisitedAt}" />
                    <TextBlock Grid.Column="3"
                               Classes="muted"
                               VerticalAlignment="Center"
                               Text="{Binding SpanshUpdatedAt}" />
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="8">
                      <Border Classes="badge" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                                   FontSize="10"
                                   Text="{Binding Status}" />
                      </Border>
                      <Button Classes="secondary"
                              MinWidth="72"
                              Command="{Binding ToggleCommand}"
                              Content="{Binding ToggleButtonText}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding BoxelSearch.IsCurrentEmpty}"
                     Text="This boxel is recorded as empty." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="5">
            <TextBlock Classes="card-title" Text="Nearby systems" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Nearest-system queries remain pending until their cache and result workflow is ported." />
          </StackPanel>
          <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center">
            <TextBlock Classes="muted" FontSize="11" Text="PENDING" />
          </Border>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
