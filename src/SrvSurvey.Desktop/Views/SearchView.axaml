<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             xmlns:search="using:SrvSurvey.Core.Search"
             x:Class="SrvSurvey.Desktop.Views.SearchView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="1050">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="5">
          <TextBlock Classes="eyebrow" Text="SEARCH" />
          <TextBlock Classes="page-title" Text="Galactic search tools" />
          <TextBlock Classes="muted"
                     Text="Define a spherical boundary or find nearby biological systems." />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinWidth="116"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}"
                Content="{Binding RefreshButtonText}" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Classes="eyebrow"
                   VerticalAlignment="Center"
                   Text="SPHERICAL LIMIT" />
        <Separator Grid.Column="1" VerticalAlignment="Center" />
      </Grid>

      <Border Classes="card raised" Padding="0">
        <Grid ColumnDefinitions="6,*">
          <Border Classes="accent-line" CornerRadius="12,0,0,12" />
          <Grid Grid.Column="1"
                Margin="28"
                ColumnDefinitions="2*,*,*"
                ColumnSpacing="24">
            <StackPanel Spacing="5">
              <TextBlock Classes="muted" Text="CURRENT LIMIT" />
              <TextBlock FontSize="28"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource RavenAccentBrush}"
                         TextWrapping="Wrap"
                         Text="{Binding Search.LimitSummary}" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{Binding Search.CurrentSystemResult}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="muted" Text="CURRENT SYSTEM" />
              <Button Classes="link" HorizontalAlignment="Left"
                      behaviors:ClipboardCopyBehavior.Text="{Binding Search.CurrentSystemName}">
                <TextBlock Classes="card-title" TextWrapping="Wrap"
                           Text="{Binding Search.CurrentSystemName}" />
              </Button>
              <Button Classes="link" HorizontalAlignment="Left"
                      IsVisible="{Binding Search.HasCurrentSystemAddress}"
                      behaviors:ClipboardCopyBehavior.Text="{Binding Search.CurrentSystemAddress}">
                <TextBlock Classes="muted monospace"
                           Text="{Binding Search.CurrentSystemAddressText}" />
              </Button>
              <TextBlock Classes="muted monospace"
                         TextWrapping="Wrap"
                         Text="{Binding Search.CurrentPosition}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
              <TextBlock Classes="muted" Text="TO CENTER" />
              <TextBlock Classes="metric" Text="{Binding Search.DistanceToCenter}" />
              <Border Classes="badge" HorizontalAlignment="Left">
                <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                           FontSize="11"
                           Text="{Binding Search.StatusLabel}" />
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Configure the search sphere" />
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="CENTER SYSTEM" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <controls:SystemNameEntry
                    Text="{Binding Search.Query, Mode=TwoWay}"
                    PlaceholderText="System name or id64" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        MinWidth="120"
                        VerticalAlignment="Top"
                        Command="{Binding Search.SearchCommand}"
                        Content="{Binding Search.SearchButtonText}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding Search.HasSearchResults}">
              <TextBlock Classes="muted" Text="MATCHING SYSTEMS" />
              <ComboBox ItemsSource="{Binding Search.SearchResults}"
                        SelectedItem="{Binding Search.SelectedCenterSystem, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="search:StarSystemReference">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1"
                                 Classes="muted monospace"
                                 Text="{Binding Position}" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="RADIUS (LIGHT-YEARS)" />
              <TextBox Text="{Binding Search.Radius, Mode=TwoWay}"
                       PlaceholderText="1 to 1000" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="primary"
                      Margin="0,0,10,10"
                      Command="{Binding Search.EnableCommand}"
                      Content="Enable limit" />
              <Button Classes="secondary"
                      Margin="0,0,0,10"
                      Command="{Binding Search.DisableCommand}"
                      Content="Disable limit" />
            </WrapPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding Search.StatusMessage}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Resolved center" />
            <StackPanel Spacing="5">
              <TextBlock Classes="muted" Text="SYSTEM" />
              <Button Classes="link" HorizontalAlignment="Left"
                      behaviors:ClipboardCopyBehavior.Text="{Binding Search.CenterSystemName}">
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="{Binding Search.CenterSystemName}" />
              </Button>
              <Button Classes="link" HorizontalAlignment="Left"
                      IsVisible="{Binding Search.HasCenterSystemAddress}"
                      behaviors:ClipboardCopyBehavior.Text="{Binding Search.CenterSystemAddress}">
                <TextBlock Classes="muted monospace"
                           Text="{Binding Search.CenterSystemAddressText}" />
              </Button>
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Classes="muted" Text="GALACTIC POSITION" />
              <TextBlock Classes="monospace"
                         TextWrapping="Wrap"
                         Text="{Binding Search.CenterPosition}" />
            </StackPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Inline system suggestions come from EDSM with an Ardent fallback; the resolved center and coordinates still come from Spansh. Saving updates only the compatible sphereLimit fields." />
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
        <TextBlock Classes="eyebrow"
                   VerticalAlignment="Center"
                   Text="NEARBY BIOLOGY" />
        <Separator Grid.Column="1" VerticalAlignment="Center" />
      </Grid>

      <Border Classes="card raised" Padding="0">
        <Grid ColumnDefinitions="6,*">
          <Border Classes="accent-line" CornerRadius="12,0,0,12" />
          <Grid Grid.Column="1"
                Margin="28"
                ColumnDefinitions="2*,2*,Auto"
                ColumnSpacing="24">
            <StackPanel Spacing="5">
              <TextBlock Classes="muted" Text="REFERENCE SYSTEM" />
              <Button Classes="link" HorizontalAlignment="Left"
                      behaviors:ClipboardCopyBehavior.Text="{Binding NearestSystems.ReferenceSystemName}">
                <TextBlock FontSize="24" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Text="{Binding NearestSystems.ReferenceSystemName}" />
              </Button>
              <Button Classes="link" HorizontalAlignment="Left"
                      IsVisible="{Binding NearestSystems.HasReferenceSystemAddress}"
                      behaviors:ClipboardCopyBehavior.Text="{Binding NearestSystems.ReferenceSystemAddress}">
                <TextBlock Classes="muted monospace"
                           Text="{Binding NearestSystems.ReferenceSystemAddressText}" />
              </Button>
              <TextBlock Classes="muted monospace"
                         TextWrapping="Wrap"
                         Text="{Binding NearestSystems.ReferencePosition}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
              <TextBlock Classes="muted" Text="SEARCH MODE" />
              <TextBlock Classes="card-title"
                         Text="{Binding NearestSystems.SelectedMode.Label}" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{Binding NearestSystems.SelectedMode.Description}" />
            </StackPanel>
            <Border Grid.Column="2"
                    Classes="badge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
              <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                         FontSize="11"
                         Text="{Binding NearestSystems.Results.Count, StringFormat='{}{0} RESULTS'}" />
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="18">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Find nearby biological systems" />
            <StackPanel Spacing="6">
              <TextBlock Classes="muted" Text="SEARCH TYPE" />
              <ComboBox ItemsSource="{Binding NearestSystems.Modes}"
                        SelectedItem="{Binding NearestSystems.SelectedMode, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:NearestSystemsSearchModeOptionViewModel">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                      <TextBlock Classes="muted" Text="{Binding Description}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding NearestSystems.IsCanonnMode}">
              <TextBlock Classes="muted" Text="BIOLOGICAL SIGNAL" />
              <TextBox Text="{Binding NearestSystems.BiologicalSignal, Mode=TwoWay}"
                       PlaceholderText="Stratum, Bacterium, or another codex signal" />
            </StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding NearestSystems.IsVariantMode}">
              <Grid ColumnDefinitions="*,2*" ColumnSpacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Classes="muted" Text="GENUS" />
                  <TextBox Text="{Binding NearestSystems.Genus, Mode=TwoWay}"
                           PlaceholderText="Tussock" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Classes="muted" Text="SPECIES" />
                  <TextBox Text="{Binding NearestSystems.Species, Mode=TwoWay}"
                           PlaceholderText="Tussock Capillum" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Classes="muted" Text="MISSING VARIANT COLORS" />
                <TextBox Text="{Binding NearestSystems.VariantColors, Mode=TwoWay}"
                         PlaceholderText="Emerald, Teal" />
                <TextBlock Classes="muted"
                           Text="Separate multiple colors with commas or semicolons." />
              </StackPanel>
            </StackPanel>
            <Button Classes="primary"
                    HorizontalAlignment="Left"
                    MinWidth="132"
                    Command="{Binding NearestSystems.SearchCommand}"
                    Content="{Binding NearestSystems.SearchButtonText}" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding NearestSystems.StatusMessage}" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Classes="card-title" Text="Selected result" />
            <ContentControl Content="{Binding NearestSystems.SelectedResult}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:NearestSystemRowViewModel">
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="muted" Text="SYSTEM" />
                      <Button Classes="link" HorizontalAlignment="Left"
                              behaviors:ClipboardCopyBehavior.Text="{Binding SystemName}">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding SystemName}" />
                      </Button>
                      <Button Classes="link" HorizontalAlignment="Left"
                              IsVisible="{Binding HasSystemAddress}"
                              behaviors:ClipboardCopyBehavior.Text="{Binding SystemAddress}">
                        <TextBlock Classes="muted monospace"
                                   Text="{Binding SystemAddressText}" />
                      </Button>
                    </StackPanel>
                    <StackPanel Spacing="5">
                      <TextBlock Classes="muted" Text="GALACTIC POSITION" />
                      <TextBlock Classes="monospace"
                                 TextWrapping="Wrap"
                                 Text="{Binding Coordinate}" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="secondary"
                      Margin="0,0,10,10"
                      Command="{Binding NearestSystems.CopySystemCommand}"
                      Content="Copy system" />
              <Button Classes="secondary"
                      Margin="0,0,0,10"
                      Command="{Binding NearestSystems.CopyCoordinatesCommand}"
                      Content="Copy coordinates" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal">
              <Button Classes="secondary"
                      Margin="0,0,10,10"
                      Command="{Binding NearestSystems.OpenCanonnCommand}"
                      Content="Open Canonn" />
              <Button Classes="secondary"
                      Margin="0,0,0,10"
                      Command="{Binding NearestSystems.OpenSpanshCommand}"
                      Content="Open Spansh" />
            </WrapPanel>
            <Button Classes="secondary"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding NearestSystems.HasSpanshSearchReference}"
                    Command="{Binding NearestSystems.OpenSpanshSearchCommand}"
                    Content="Open original Spansh search" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card" IsVisible="{Binding NearestSystems.HasResults}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Nearest systems" />
              <TextBlock Classes="muted"
                         Text="Select a row to copy it or inspect it on Canonn and Spansh." />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Classes="muted"
                       VerticalAlignment="Center"
                       Text="{Binding NearestSystems.Results.Count, StringFormat='{}{0} unique systems'}" />
          </Grid>
          <Border Background="{DynamicResource RavenSurfaceBrush}"
                  CornerRadius="8"
                  Padding="12,8">
            <Grid ColumnDefinitions="2*,*,4*,Auto" ColumnSpacing="12">
              <TextBlock Classes="muted" Text="SYSTEM" />
              <TextBlock Grid.Column="1" Classes="muted" Text="DISTANCE" />
              <TextBlock Grid.Column="2" Classes="muted" Text="NOTES" />
              <TextBlock Grid.Column="3" Classes="muted" Text="SOURCE" />
            </Grid>
          </Border>
          <ListBox ItemsSource="{Binding NearestSystems.Results}"
                   SelectedItem="{Binding NearestSystems.SelectedResult, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NearestSystemRowViewModel">
                <Grid Margin="8,10" ColumnDefinitions="2*,*,4*,Auto" ColumnSpacing="12">
                  <TextBlock Classes="monospace"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap"
                             Text="{Binding SystemName}" />
                  <TextBlock Grid.Column="1"
                             Classes="muted"
                             VerticalAlignment="Center"
                             Text="{Binding Distance}" />
                  <TextBlock Grid.Column="2"
                             Classes="muted"
                             TextWrapping="Wrap"
                             Text="{Binding Notes}" />
                  <Border Grid.Column="3"
                          Classes="badge"
                          VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource RavenAccentBrush}"
                               FontSize="10"
                               Text="{Binding Source}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
