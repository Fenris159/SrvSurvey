<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:replay="using:SrvSurvey.Core.Diagnostics.Replay"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.DiagnosticsView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <Grid RowDefinitions="Auto,*">
    <TabControl Margin="32,24,32,0"
                SelectedIndex="{Binding SelectedDiagnosticsTabIndex, Mode=TwoWay}">
      <TabItem Header="Source"><Border Height="0" /></TabItem>
      <TabItem Header="History"><Border Height="0" /></TabItem>
      <TabItem Header="Updates"><Border Height="0" /></TabItem>
      <TabItem Header="Processing"><Border Height="0" /></TabItem>
      <TabItem Header="Inspector"><Border Height="0" /></TabItem>
      <TabItem Header="Logs"><Border Height="0" /></TabItem>
    </TabControl>

  <ScrollViewer Grid.Row="1"
                x:Name="DiagnosticsPageScroller"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="1000">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="DIAGNOSTICS" />
        <TextBlock Classes="page-title" Text="{Binding DiagnosticsTabTitle}" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="{Binding DiagnosticsTabDescription}" />
      </StackPanel>

      <Border Classes="card"
              IsVisible="{Binding IsDiagnosticsSourceSelected}">
        <StackPanel Spacing="12">
          <TextBlock Classes="card-title" Text="Selected folder" />
          <TextBlock Classes="monospace"
                     TextWrapping="Wrap"
                     Text="{Binding JournalFolderPath}" />
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Text="{Binding DiagnosticReplayStatus}" />
          <Separator Margin="0,4" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding StatusMessage}" />
          <Button Classes="secondary"
                  HorizontalAlignment="Left"
                  MinWidth="116"
                  Command="{Binding RefreshCommand}"
                  Content="{Binding RefreshButtonText}" />
        </StackPanel>
      </Border>

      <Border Classes="card"
              IsVisible="{Binding IsDiagnosticsHistorySelected}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Journal history" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Read-only history from the active journal folder. Export creates a portable, versioned replay package without changing profile data." />
          </StackPanel>

          <TextBlock Classes="monospace muted"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="{Binding JournalHistory.JournalDirectory}" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding JournalHistory.Summary}" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding JournalHistory.SearchText, Mode=TwoWay}"
                     PlaceholderText="Search event, commander, system, file, or JSON" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding JournalHistory.RefreshCommand}"
                    Content="Refresh" />
          </Grid>

          <Grid ColumnDefinitions="300,*" ColumnSpacing="14">
            <ListBox x:Name="JournalHistoryEventList"
                     MinHeight="320"
                     MaxHeight="500"
                     ItemsSource="{Binding JournalHistory.Events}"
                     ScrollViewer.IsScrollChainingEnabled="False"
                     SelectedItem="{Binding JournalHistory.SelectedEvent, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="replay:JournalHistoryEvent">
                  <StackPanel Margin="4" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock FontWeight="SemiBold" Text="{Binding EventName}" />
                      <TextBlock Grid.Column="1"
                                 Classes="monospace muted"
                                 FontSize="10"
                                 Text="{Binding Index}" />
                    </Grid>
                    <TextBlock Classes="monospace muted"
                               FontSize="10"
                               Text="{Binding Timestamp}" />
                    <TextBlock Classes="muted"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SystemName}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Column="1" Spacing="10">
              <Grid ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="6">
                <TextBlock Classes="muted" Text="File" />
                <TextBlock Grid.Column="1"
                           Classes="monospace"
                           Text="{Binding JournalHistory.SelectedEvent.FileName}" />
                <TextBlock Grid.Row="1" Classes="muted" Text="Commander" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding JournalHistory.SelectedEvent.CommanderName}" />
                <TextBlock Grid.Row="2" Classes="muted" Text="System" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding JournalHistory.SelectedEvent.SystemName}" />
                <TextBlock Grid.Row="3" Classes="muted" Text="Timestamp" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Classes="monospace"
                           Text="{Binding JournalHistory.SelectedEvent.Timestamp}" />
              </Grid>
              <TextBox MinHeight="225"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       TextWrapping="NoWrap"
                       FontFamily="Consolas, Menlo, monospace"
                       FontSize="11"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.IsScrollChainingEnabled="False"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Text="{Binding JournalHistory.SelectedEvent.RawJson}" />
            </StackPanel>
          </Grid>

          <Separator Margin="0,4" />
          <TextBlock FontWeight="SemiBold" Text="Replay export range" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="muted" Text="From" />
              <TextBox Text="{Binding JournalHistory.RangeFromText, Mode=TwoWay}"
                       PlaceholderText="2026-08-21T18:00:00Z" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="muted" Text="To" />
              <TextBox Text="{Binding JournalHistory.RangeToText, Mode=TwoWay}"
                       PlaceholderText="2026-08-21T18:30:00Z" />
            </StackPanel>
          </Grid>
          <CheckBox IsChecked="{Binding JournalHistory.RedactExport, Mode=TwoWay}"
                    Content="Redact commander identities, chat, locations, coordinates, and screenshot paths" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding JournalHistory.ExportPreview}" />
          <Button Classes="secondary"
                  HorizontalAlignment="Left"
                  Click="ExportJournalReplay_Click"
                  Content="Export replay package" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding JournalHistory.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card"
              IsVisible="{Binding IsDiagnosticsUpdatesSelected}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Application updates" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Checks checksum-indexed SrvSurvey-XP packages. The check never installs files or changes profile data." />
          </StackPanel>

          <CheckBox IsChecked="{Binding ReleaseUpdates.UseDevelopmentReleases, Mode=TwoWay}"
                    Content="Use SrvSurvey-XP development releases" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding ReleaseUpdates.ReleaseSourceDescription}" />

          <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="10">
            <TextBlock Classes="muted" Text="Installed" />
            <TextBlock Grid.Column="1"
                       FontWeight="SemiBold"
                       Text="{Binding ReleaseUpdates.CurrentVersion}" />
            <TextBlock Grid.Column="2" Classes="muted" Text="Published" />
            <TextBlock Grid.Column="3"
                       FontWeight="SemiBold"
                       Text="{Binding ReleaseUpdates.LatestVersion}" />
          </Grid>

          <WrapPanel Orientation="Horizontal">
            <Button Classes="secondary"
                    Margin="0,0,8,8"
                    Command="{Binding ReleaseUpdates.CheckCommand}"
                    Content="{Binding ReleaseUpdates.CheckButtonText}" />
            <Button Classes="secondary"
                    Margin="0,0,0,8"
                    IsVisible="{Binding ReleaseUpdates.IsUpdateAvailable}"
                    Command="{Binding ReleaseUpdates.OpenReleaseCommand}"
                    Content="{Binding ReleaseUpdates.OpenReleaseButtonText}" />
            <Button Classes="primary"
                    Margin="8,0,0,8"
                    IsVisible="{Binding ReleaseUpdates.IsUpdateAvailable}"
                    Command="{Binding ReleaseUpdates.InstallCommand}"
                    Content="{Binding ReleaseUpdates.InstallButtonText}" />
            <Button Classes="secondary"
                    Margin="8,0,0,8"
                    IsVisible="{Binding ReleaseUpdates.HasReleaseNotes}"
                    Click="ReleaseNotes_Click"
                    Content="Release notes" />
          </WrapPanel>

          <CheckBox IsVisible="{Binding ReleaseUpdates.IsUpdateAvailable}"
                    IsEnabled="{Binding ReleaseUpdates.CanInstallCurrentInstallation}"
                    IsChecked="{Binding ReleaseUpdates.InstallConfirmed, Mode=TwoWay}"
                    Content="I understand SrvSurvey will close, verify the replacement, and automatically roll back if startup fails." />
          <TextBlock Classes="muted"
                     IsVisible="{Binding ReleaseUpdates.ShowGenericInstallUnavailable}"
                     TextWrapping="Wrap"
                     Text="Automatic replacement is disabled because this copy was not launched from a checksum-indexed release package. Open the releases page to install manually." />
          <Border IsVisible="{Binding ReleaseUpdates.ShowAppImageManualInstall}"
                  BorderBrush="{DynamicResource RavenAccentBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <StackPanel Spacing="5">
              <TextBlock FontWeight="SemiBold"
                         Text="AppImage manual update" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{x:Static vm:ReleaseUpdateViewModel.AppImageManualInstallInstructions}" />
            </StackPanel>
          </Border>
          <ProgressBar IsVisible="{Binding ReleaseUpdates.IsInstalling}"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding ReleaseUpdates.InstallProgressPercent}" />
          <TextBlock Classes="monospace muted"
                     IsVisible="{Binding ReleaseUpdates.IsInstalling}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="{Binding ReleaseUpdates.InstallProgressText}" />

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding ReleaseUpdates.StatusMessage}" />
          <Separator Margin="0,4" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding ReferenceDataUpdates.StatusMessage}" />
          <TextBlock Classes="monospace muted"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="{Binding ReferenceDataUpdates.UpdatedCatalogs}" />
          <TextBlock Classes="monospace muted"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="{Binding ReferenceDataUpdates.BackupDirectory}" />
          <WrapPanel Orientation="Horizontal">
            <Button Classes="secondary"
                    Margin="0,0,8,0"
                    Command="{Binding ReferenceDataUpdates.RefreshCommand}"
                    Content="{Binding ReferenceDataUpdates.RefreshButtonText}" />
            <Button Classes="primary"
                    IsVisible="{Binding ReferenceDataUpdates.IsRestartRequired}"
                    Command="{Binding ReferenceDataUpdates.RestartCommand}"
                    Content="Restart to apply" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="card raised"
              IsVisible="{Binding IsDiagnosticsProcessingSelected}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Historical journal processor" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Analyze the original processor statistics without modifying profile data, or explicitly merge earlier Commander Codex first discoveries using atomic writes." />
          </StackPanel>

          <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
            <ComboBox ItemsSource="{Binding JournalPostProcessor.Commanders}"
                      SelectedItem="{Binding JournalPostProcessor.SelectedCommander, Mode=TwoWay}"
                      PlaceholderText="Choose a commander">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JournalPostProcessorCommanderViewModel">
                  <TextBlock Margin="4" Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <DatePicker Grid.Column="1"
                        SelectedDate="{Binding JournalPostProcessor.StartDate, Mode=TwoWay}" />
            <Button Grid.Column="2"
                    Classes="secondary"
                    Command="{Binding JournalPostProcessor.SetBeginningCommand}"
                    Content="Beginning of time" />
          </Grid>

          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary"
                    Margin="0,0,8,8"
                    Command="{Binding JournalPostProcessor.AnalyzeCommand}"
                    Content="Analyze journals" />
            <Button Classes="secondary"
                    Margin="0,0,8,8"
                    Command="{Binding JournalPostProcessor.RefreshCommandersCommand}"
                    Content="Refresh commanders" />
            <Button Classes="secondary"
                    Margin="0,0,8,8"
                    Command="{Binding JournalPostProcessor.AnalyzeSystemsCommand}"
                    Content="Analyze system files" />
            <Button Classes="secondary"
                    Margin="0,0,0,8"
                    Command="{Binding JournalPostProcessor.CancelCommand}"
                    Content="Stop" />
          </WrapPanel>

          <ProgressBar Minimum="0"
                       Maximum="{Binding JournalPostProcessor.ProgressMaximum}"
                       Value="{Binding JournalPostProcessor.ProgressValue}" />

          <ItemsControl ItemsSource="{Binding JournalPostProcessor.Statistics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemWidth="225" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:JournalPostProcessorStatisticViewModel">
                <Border Margin="0,0,8,8"
                        BorderBrush="{DynamicResource RavenBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="muted" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1"
                               FontWeight="SemiBold"
                               Text="{Binding Value}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding JournalPostProcessor.TrailblazersSummary}" />

          <Border BorderBrush="{DynamicResource RavenWarningBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  IsVisible="{Binding JournalPostProcessor.HasHistoricalGreenGasGiantCandidates}"
                  Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding JournalPostProcessor.HistoricalGreenGasGiantPublishConfirmed, Mode=TwoWay}"
                          Content="Confirm publication of the listed historical Green Gas Giant candidates" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="{Binding JournalPostProcessor.HistoricalGreenGasGiantSummary}" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="The Green Gas Giant upload privacy option in Settings must also be enabled. Analysis and local reconstruction never publish candidates." />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="secondary"
                      VerticalAlignment="Center"
                      Command="{Binding JournalPostProcessor.PublishGreenGasGiantsCommand}"
                      Content="Publish candidates" />
            </Grid>
          </Border>

          <Expander Classes="section-pill" Header="Species and atmosphere summary">
            <StackPanel Margin="0,10,0,0" Spacing="8">
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{Binding JournalPostProcessor.SystemAnalysisSummary}" />
              <ItemsControl ItemsSource="{Binding JournalPostProcessor.SystemSpecies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:JournalPostProcessorSpeciesViewModel">
                    <Border Margin="0,0,0,8"
                            BorderBrush="{DynamicResource RavenBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock Grid.Column="1"
                                     Classes="muted"
                                     Text="{Binding CountText}" />
                        </Grid>
                        <TextBlock Classes="monospace muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding AtmosphereSummary}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>

          <Border BorderBrush="{DynamicResource RavenWarningBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding JournalPostProcessor.CodexRebuildConfirmed, Mode=TwoWay}"
                          Content="Confirm an all-history Commander Codex merge" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="This merge never deletes existing firsts and does not upload historical events. Completed files remain valid if you stop early." />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="secondary"
                      VerticalAlignment="Center"
                      Command="{Binding JournalPostProcessor.RebuildCodexCommand}"
                      Content="Rebuild Codex firsts" />
            </Grid>
          </Border>

          <Border BorderBrush="{DynamicResource RavenWarningBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding JournalPostProcessor.SystemRebuildConfirmed, Mode=TwoWay}"
                          Content="Confirm a verified historical system rebuild" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="Reconstructed facts are merged without deleting unknown fields. Every existing file is checksum-backed up before atomic activation, and an activation failure rolls back completed files." />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="secondary"
                      VerticalAlignment="Center"
                      Command="{Binding JournalPostProcessor.RebuildSystemsCommand}"
                      Content="Rebuild systems" />
            </Grid>
          </Border>

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding JournalPostProcessor.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card"
              IsVisible="{Binding IsDiagnosticsInspectorSelected}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Journal inspector" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Inspect the newest 120 events and select scalar fields to generate a Lua quest handler." />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox MinHeight="110"
                     MaxHeight="180"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Menlo, monospace"
                     FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.IsScrollChainingEnabled="False"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Text="{Binding JournalInspector.StatusText}" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    VerticalAlignment="Top"
                    Command="{Binding JournalInspector.CopyCoordinatesCommand}"
                    Content="Copy coordinates" />
          </Grid>

          <Grid ColumnDefinitions="300,*" ColumnSpacing="14">
            <ListBox x:Name="JournalInspectorEventList"
                     MinHeight="280"
                     MaxHeight="400"
                     ItemsSource="{Binding JournalInspector.Events}"
                     ScrollViewer.IsScrollChainingEnabled="False"
                     SelectedItem="{Binding JournalInspector.SelectedEvent, Mode=TwoWay}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JournalInspectorEventViewModel">
                  <StackPanel Margin="4" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding EventName}" />
                    <TextBlock Classes="monospace muted"
                               FontSize="10"
                               Text="{Binding Timestamp}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="10">
              <ScrollViewer MinHeight="280"
                            MaxHeight="400"
                            HorizontalScrollBarVisibility="Auto"
                            IsScrollChainingEnabled="False"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding JournalInspector.Properties}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JournalInspectorPropertyViewModel">
                      <Grid Margin="{Binding Indent}"
                            ColumnDefinitions="Auto,220,*"
                            ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSelectable}" />
                        <TextBlock Grid.Column="1"
                                   Classes="monospace"
                                   FontSize="11"
                                   Text="{Binding Path}" />
                        <TextBlock Grid.Column="2"
                                   Classes="monospace muted"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding DisplayValue}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBox Grid.Row="1"
                       MinHeight="90"
                       MaxHeight="160"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       TextWrapping="NoWrap"
                       FontFamily="Consolas, Menlo, monospace"
                       FontSize="11"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.IsScrollChainingEnabled="False"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Text="{Binding JournalInspector.RawJson}" />
            </Grid>
          </Grid>

          <Border BorderBrush="{DynamicResource RavenWarningBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <CheckBox IsChecked="{Binding JournalInspector.ReplayConfirmed, Mode=TwoWay}"
                        Content="I understand replay may change and save active quest progress" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Command="{Binding JournalInspector.ReplayCommand}"
                      Content="Replay selected event" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox MinHeight="110"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Menlo, monospace"
                     FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.IsScrollChainingEnabled="False"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Text="{Binding JournalInspector.CodeText}" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    VerticalAlignment="Top"
                    Command="{Binding JournalInspector.CopyCodeCommand}"
                    Content="Copy handler" />
          </Grid>

          <TextBlock Classes="muted"
                     IsVisible="{Binding JournalInspector.HasStatusMessage}"
                     TextWrapping="Wrap"
                     Text="{Binding JournalInspector.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card"
              IsVisible="{Binding IsDiagnosticsProcessingSelected}">
        <StackPanel Spacing="8">
          <TextBlock Classes="card-title" Text="Commander Codex ledger" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding CommanderCodexStatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card"
              IsVisible="{Binding IsDiagnosticsInspectorSelected}">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10"
              ColumnSpacing="28">
          <TextBlock Grid.ColumnSpan="2"
                     Classes="card-title"
                     Margin="0,0,0,6"
                     Text="Latest parsed state" />
          <TextBlock Grid.Row="1" Classes="muted" Text="Commander" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommanderName}" />
          <TextBlock Grid.Row="2" Classes="muted" Text="Frontier ID" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FrontierId}" />
          <TextBlock Grid.Row="3" Classes="muted" Text="Game" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameDescription}" />
          <TextBlock Grid.Row="4" Classes="muted" Text="Mode" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GameMode}" />
          <TextBlock Grid.Row="5" Classes="muted" Text="System" />
          <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Text="{Binding SystemDescription}" />
          <TextBlock Grid.Row="6" Classes="muted" Text="Body" />
          <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Text="{Binding BodyName}" />
          <TextBlock Grid.Row="7" Classes="muted" Text="Session" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SessionState}" />
        </Grid>
      </Border>

      <Border Classes="card"
              IsVisible="{Binding IsDiagnosticsInspectorSelected}">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10"
              ColumnSpacing="28">
          <TextBlock Grid.ColumnSpan="2"
                     Classes="card-title"
                     Margin="0,0,0,6"
                     Text="Live Status.json state" />
          <TextBlock Grid.Row="1" Classes="muted" Text="Vehicle" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VehicleState}" />
          <TextBlock Grid.Row="2" Classes="muted" Text="Latitude / longitude" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SurfacePosition}" />
          <TextBlock Grid.Row="3" Classes="muted" Text="Heading / altitude" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HeadingAndAltitude}" />
          <TextBlock Grid.Row="4" Classes="muted" Text="Game UI focus" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GameUiFocus}" />
        </Grid>
      </Border>

      <Border Classes="card raised"
              IsVisible="{Binding IsDiagnosticsSourceSelected}">
        <StackPanel Spacing="10">
          <TextBlock Classes="card-title" Text="Candidate paths" />
          <TextBlock Classes="monospace muted"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Text="{Binding CandidatePaths}" />
        </StackPanel>
      </Border>

      <Border Classes="card raised"
              IsVisible="{Binding IsDiagnosticsProcessingSelected}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Visited stars reference cache" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Back up and replace Elite's VisitedStarsCache.dat with the 3,500 closest known systems from EDGalaxy." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding VisitedStarsCache.RefreshCommand}"
                    Content="Refresh state" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="10">
            <TextBlock VerticalAlignment="Center"
                       Classes="muted"
                       Text="Commander" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding VisitedStarsCache.Commanders}"
                      SelectedItem="{Binding VisitedStarsCache.SelectedCommander}"
                      PlaceholderText="Choose a saved commander">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VisitedStarsCommanderOptionViewModel">
                  <TextBlock Margin="4" Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1"
                       VerticalAlignment="Center"
                       Classes="muted"
                       Text="Reference system" />
            <controls:SystemNameEntry
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding VisitedStarsCache.SystemName, Mode=TwoWay}"
                PlaceholderText="System name or id64" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding VisitedStarsCache.TargetPath, Mode=TwoWay}"
                     PlaceholderText="Path to VisitedStarsCache.dat" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Click="ChooseVisitedStarsCache_Click"
                    Content="Choose file" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Classes="muted" Text="Original backup" />
            <TextBlock Grid.Column="1"
                       Classes="monospace muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="{Binding VisitedStarsCache.BackupPath}" />
          </Grid>

          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Text="{Binding VisitedStarsCache.GameStateMessage}" />

          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary"
                    Margin="0,0,8,8"
                    Command="{Binding VisitedStarsCache.SwapCommand}"
                    Content="{Binding VisitedStarsCache.SwapButtonText}" />
            <Button Classes="secondary"
                    Margin="0,0,8,8"
                    Command="{Binding VisitedStarsCache.RestoreCommand}"
                    Content="{Binding VisitedStarsCache.RestoreButtonText}" />
            <Button Classes="secondary"
                    Margin="0,0,0,8"
                    Click="OpenVisitedStarsWebsite_Click"
                    Content="Open EDGalaxy" />
          </WrapPanel>

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding VisitedStarsCache.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card"
              IsVisible="{Binding IsDiagnosticsLogsSelected}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Application logs" />
            <TextBlock Classes="muted"
                       Text="{Binding DiagnosticsLog.SessionDescription}" />
          </StackPanel>

          <Border Background="{DynamicResource RavenSurfaceBrush}"
                  BorderBrush="{DynamicResource RavenBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <ScrollViewer x:Name="ApplicationLogScroller"
                          MinHeight="260"
                          MaxHeight="420"
                          Padding="10"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <TextBlock FontFamily="Consolas, Menlo, monospace"
                         FontSize="12"
                         TextWrapping="NoWrap"
                         Text="{Binding DiagnosticsLog.LogText, Mode=OneWay}" />
            </ScrollViewer>
          </Border>

          <WrapPanel Orientation="Horizontal">
            <Button Classes="secondary"
                    Margin="0,0,8,8"
                    Command="{Binding DiagnosticsLog.CopyCommand}"
                    Content="Copy logs" />
            <Button Classes="secondary"
                    Margin="0,0,8,8"
                    Command="{Binding DiagnosticsLog.ClearCommand}"
                    Content="Clear view" />
            <Button Classes="secondary"
                    Margin="0,0,0,8"
                    Command="{Binding DiagnosticsLog.OpenFolderCommand}"
                    Content="Open log folder" />
          </WrapPanel>

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding DiagnosticsLog.PersistenceStatus}" />
          <TextBlock Classes="monospace muted"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Text="{Binding DiagnosticsLog.CurrentLogPath}" />
          <TextBlock Classes="muted"
                     IsVisible="{Binding DiagnosticsLog.HasStatusMessage}"
                     TextWrapping="Wrap"
                     Text="{Binding DiagnosticsLog.StatusMessage}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="muted"
                 HorizontalAlignment="Right"
                 Text="{Binding LastUpdated}" />
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
