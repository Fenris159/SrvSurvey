<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.DiagnosticsView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32" Spacing="24" MaxWidth="1000">
      <StackPanel Spacing="5">
        <TextBlock Classes="eyebrow" Text="DIAGNOSTICS" />
        <TextBlock Classes="page-title" Text="Journal source" />
        <TextBlock Classes="muted"
                   Text="The active bootstrap source and the locations checked on this platform." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="card-title" Text="Selected folder" />
          <TextBlock Classes="monospace"
                     TextWrapping="Wrap"
                     Text="{Binding JournalFolderPath}" />
          <Separator Margin="0,4" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding StatusMessage}" />
          <Button Classes="primary"
                  HorizontalAlignment="Left"
                  MinWidth="116"
                  Command="{Binding RefreshCommand}"
                  Content="{Binding RefreshButtonText}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Journal inspector" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Inspect the newest 120 events and select scalar fields to generate a Lua quest handler." />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox MinHeight="110"
                     MaxHeight="180"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Menlo, monospace"
                     FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Text="{Binding JournalInspector.StatusText}" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    VerticalAlignment="Top"
                    Command="{Binding JournalInspector.CopyCoordinatesCommand}"
                    Content="Copy coordinates" />
          </Grid>

          <Grid ColumnDefinitions="300,*" ColumnSpacing="14">
            <ListBox MinHeight="280"
                     MaxHeight="400"
                     ItemsSource="{Binding JournalInspector.Events}"
                     SelectedItem="{Binding JournalInspector.SelectedEvent, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:JournalInspectorEventViewModel">
                  <StackPanel Margin="4" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding EventName}" />
                    <TextBlock Classes="monospace muted"
                               FontSize="10"
                               Text="{Binding Timestamp}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="10">
              <ScrollViewer MinHeight="280"
                            MaxHeight="400"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding JournalInspector.Properties}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JournalInspectorPropertyViewModel">
                      <Grid Margin="{Binding Indent}"
                            ColumnDefinitions="Auto,220,*"
                            ColumnSpacing="8">
                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSelectable}" />
                        <TextBlock Grid.Column="1"
                                   Classes="monospace"
                                   FontSize="11"
                                   Text="{Binding Path}" />
                        <TextBlock Grid.Column="2"
                                   Classes="monospace muted"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding DisplayValue}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBox Grid.Row="1"
                       MinHeight="90"
                       MaxHeight="160"
                       AcceptsReturn="True"
                       IsReadOnly="True"
                       TextWrapping="NoWrap"
                       FontFamily="Consolas, Menlo, monospace"
                       FontSize="11"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Text="{Binding JournalInspector.RawJson}" />
            </Grid>
          </Grid>

          <Border BorderBrush="{DynamicResource RavenWarningBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <CheckBox IsChecked="{Binding JournalInspector.ReplayConfirmed, Mode=TwoWay}"
                        Content="I understand replay may change and save active quest progress" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Command="{Binding JournalInspector.ReplayCommand}"
                      Content="Replay selected event" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox MinHeight="110"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Menlo, monospace"
                     FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Text="{Binding JournalInspector.CodeText}" />
            <Button Grid.Column="1"
                    Classes="primary"
                    VerticalAlignment="Top"
                    Command="{Binding JournalInspector.CopyCodeCommand}"
                    Content="Copy handler" />
          </Grid>

          <TextBlock Classes="muted"
                     IsVisible="{Binding JournalInspector.HasStatusMessage}"
                     TextWrapping="Wrap"
                     Text="{Binding JournalInspector.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="card-title" Text="Commander Codex ledger" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding CommanderCodexStatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10"
              ColumnSpacing="28">
          <TextBlock Grid.ColumnSpan="2"
                     Classes="card-title"
                     Margin="0,0,0,6"
                     Text="Latest parsed state" />
          <TextBlock Grid.Row="1" Classes="muted" Text="Commander" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommanderName}" />
          <TextBlock Grid.Row="2" Classes="muted" Text="Frontier ID" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FrontierId}" />
          <TextBlock Grid.Row="3" Classes="muted" Text="Game" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameDescription}" />
          <TextBlock Grid.Row="4" Classes="muted" Text="Mode" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GameMode}" />
          <TextBlock Grid.Row="5" Classes="muted" Text="System" />
          <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Text="{Binding SystemDescription}" />
          <TextBlock Grid.Row="6" Classes="muted" Text="Body" />
          <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Text="{Binding BodyName}" />
          <TextBlock Grid.Row="7" Classes="muted" Text="Session" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SessionState}" />
        </Grid>
      </Border>

      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="10"
              ColumnSpacing="28">
          <TextBlock Grid.ColumnSpan="2"
                     Classes="card-title"
                     Margin="0,0,0,6"
                     Text="Live Status.json state" />
          <TextBlock Grid.Row="1" Classes="muted" Text="Vehicle" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VehicleState}" />
          <TextBlock Grid.Row="2" Classes="muted" Text="Latitude / longitude" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SurfacePosition}" />
          <TextBlock Grid.Row="3" Classes="muted" Text="Heading / altitude" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HeadingAndAltitude}" />
          <TextBlock Grid.Row="4" Classes="muted" Text="Game UI focus" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GameUiFocus}" />
        </Grid>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="10">
          <TextBlock Classes="card-title" Text="Candidate paths" />
          <TextBlock Classes="monospace muted"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Text="{Binding CandidatePaths}" />
        </StackPanel>
      </Border>

      <Border Classes="card raised">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel Spacing="4">
              <TextBlock Classes="card-title" Text="Visited stars reference cache" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Back up and replace Elite's VisitedStarsCache.dat with the 3,500 closest known systems from EDGalaxy." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="secondary"
                    Command="{Binding VisitedStarsCache.RefreshCommand}"
                    Content="Refresh state" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="10">
            <TextBlock VerticalAlignment="Center"
                       Classes="muted"
                       Text="Commander" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding VisitedStarsCache.Commanders}"
                      SelectedItem="{Binding VisitedStarsCache.SelectedCommander}"
                      PlaceholderText="Choose a saved commander">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VisitedStarsCommanderOptionViewModel">
                  <TextBlock Margin="4" Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="1"
                       VerticalAlignment="Center"
                       Classes="muted"
                       Text="Reference system" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding VisitedStarsCache.SystemName, Mode=TwoWay}"
                     PlaceholderText="Sol" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding VisitedStarsCache.TargetPath, Mode=TwoWay}"
                     PlaceholderText="Path to VisitedStarsCache.dat" />
            <Button Grid.Column="1"
                    Classes="secondary"
                    Click="ChooseVisitedStarsCache_Click"
                    Content="Choose file" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Classes="muted" Text="Original backup" />
            <TextBlock Grid.Column="1"
                       Classes="monospace muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="{Binding VisitedStarsCache.BackupPath}" />
          </Grid>

          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Text="{Binding VisitedStarsCache.GameStateMessage}" />

          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary"
                    Margin="0,0,8,8"
                    Command="{Binding VisitedStarsCache.SwapCommand}"
                    Content="{Binding VisitedStarsCache.SwapButtonText}" />
            <Button Classes="secondary"
                    Margin="0,0,8,8"
                    Command="{Binding VisitedStarsCache.RestoreCommand}"
                    Content="{Binding VisitedStarsCache.RestoreButtonText}" />
            <Button Classes="secondary"
                    Margin="0,0,0,8"
                    Click="OpenVisitedStarsWebsite_Click"
                    Content="Open EDGalaxy" />
          </WrapPanel>

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding VisitedStarsCache.StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Application logs" />
            <TextBlock Classes="muted"
                       Text="{Binding DiagnosticsLog.SessionDescription}" />
          </StackPanel>

          <TextBox MinHeight="260"
                   MaxHeight="420"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   TextWrapping="NoWrap"
                   FontFamily="Consolas, Menlo, monospace"
                   FontSize="12"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Text="{Binding DiagnosticsLog.LogText, Mode=OneWay}" />

          <WrapPanel Orientation="Horizontal">
            <Button Classes="primary"
                    Margin="0,0,8,8"
                    Command="{Binding DiagnosticsLog.CopyCommand}"
                    Content="Copy logs" />
            <Button Classes="secondary"
                    Margin="0,0,8,8"
                    Command="{Binding DiagnosticsLog.ClearCommand}"
                    Content="Clear view" />
            <Button Classes="secondary"
                    Margin="0,0,0,8"
                    Command="{Binding DiagnosticsLog.OpenFolderCommand}"
                    Content="Open log folder" />
          </WrapPanel>

          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding DiagnosticsLog.PersistenceStatus}" />
          <TextBlock Classes="monospace muted"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Text="{Binding DiagnosticsLog.CurrentLogPath}" />
          <TextBlock Classes="muted"
                     IsVisible="{Binding DiagnosticsLog.HasStatusMessage}"
                     TextWrapping="Wrap"
                     Text="{Binding DiagnosticsLog.StatusMessage}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="muted"
                 HorizontalAlignment="Right"
                 Text="{Binding LastUpdated}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
