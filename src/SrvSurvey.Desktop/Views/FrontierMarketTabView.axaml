<UserControl xmlns="https://github.com/avaloniaui" xmlns:controls="using:SrvSurvey.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SrvSurvey.Desktop.Views.FrontierMarketTabView" x:DataType="vm:CommanderProfileViewModel" Classes="commander-subpage" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:core="using:SrvSurvey.Core.Frontier">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" x:Name="FrontierPageScroller">
    <StackPanel Margin="0,14,8,18" Spacing="22">
      <Border Classes="card" IsVisible="{Binding HasMarketError}">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Market update warning" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding MarketError}" />
        </StackPanel>
      </Border>
      <Border Classes="card console-page-header">
        <StackPanel Spacing="4">
          <TextBlock Classes="console-label" Text="Last docked market" />
          <TextBlock Text="{Binding MarketTitle}" Classes="console-page-title" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding MarketSubtitle}" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding !HasMarket}">
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="Market information becomes available after Frontier has a supported last-docked market for the commander." />
      </Border>
      <StackPanel IsVisible="{Binding HasMarket}" Spacing="16">
        <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.MarketCommodities.IsExpanded, Mode=TwoWay}">
          <Expander.Header>
            <TextBlock Text="{Binding MarketCommodities.Count, StringFormat=Commodity market ({0})}" />
          </Expander.Header>
          <ScrollViewer x:Name="MarketPricesScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="460" Focusable="True">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="10,6,10,12">
              <Grid ColumnSpacing="14" Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="180" SharedSizeGroup="MarketCommodity" />
                  <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="MarketStatus" />
                  <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="MarketBuy" />
                  <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="MarketSell" />
                  <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="MarketStock" />
                  <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="MarketDemand" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="table-heading" Text="Commodity" />
                <TextBlock Grid.Column="1" Classes="table-heading" Text="Status" />
                <TextBlock Grid.Column="2" Classes="table-heading" Text="Buy" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Classes="table-heading" Text="Sell" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Classes="table-heading" Text="Stock" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Classes="table-heading" Text="Demand" HorizontalAlignment="Right" />
              </Grid>
              <ItemsControl ItemsSource="{Binding MarketCommodities}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FrontierCommodityRowViewModel">
                    <Border Classes="dashboard-row">
                      <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" MinWidth="180" SharedSizeGroup="MarketCommodity" />
                          <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="MarketStatus" />
                          <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="MarketBuy" />
                          <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="MarketSell" />
                          <ColumnDefinition Width="Auto" MinWidth="90" SharedSizeGroup="MarketStock" />
                          <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="MarketDemand" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                          <TextBlock Classes="muted" FontSize="10" Text="{Binding Category}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Legality}" />
                          <TextBlock Classes="muted" FontSize="10" Text="{Binding Availability}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding BuyPrice}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding SellPrice}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Stock}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding Demand}" HorizontalAlignment="Right" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Expander>
        <controls:ResponsiveColumnsPanel MinimumColumnWidth="240" MaximumColumns="3" Spacing="24">
          <Border Classes="card" IsVisible="{Binding HasMarketServices}">
            <StackPanel Spacing="8">
              <TextBlock Classes="card-title" Text="Services" />
              <ItemsControl ItemsSource="{Binding MarketServices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:FrontierNamedValueSnapshot">
                    <Border Classes="badge" Margin="0,0,6,6">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Classes="muted" Text="{Binding Value}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasMarketEconomies}">
            <StackPanel Spacing="8">
              <TextBlock Classes="card-title" Text="Economies" />
              <ItemsControl ItemsSource="{Binding MarketEconomies}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FrontierEconomyRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Proportion}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="7">
              <TextBlock Classes="card-title" Text="Trade policy" />
              <TextBlock Classes="muted" FontSize="10" Text="Imports" />
              <TextBlock TextWrapping="Wrap" Text="{Binding MarketImported.Count, StringFormat={}{0} commodities}" />
              <TextBlock Classes="muted" FontSize="10" Text="Exports" />
              <TextBlock TextWrapping="Wrap" Text="{Binding MarketExported.Count, StringFormat={}{0} commodities}" />
              <TextBlock Classes="muted" FontSize="10" Text="Prohibited" />
              <TextBlock TextWrapping="Wrap" Text="{Binding MarketProhibited.Count, StringFormat={}{0} commodities}" />
            </StackPanel>
          </Border>
        </controls:ResponsiveColumnsPanel>
        <controls:ResponsiveColumnsPanel MinimumColumnWidth="240" MaximumColumns="3" Spacing="24">
          <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.MarketImported.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <TextBlock Text="{Binding MarketImported.Count, StringFormat=Imported ({0})}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding MarketImported}" Margin="8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="4" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.MarketExported.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <TextBlock Text="{Binding MarketExported.Count, StringFormat=Exported ({0})}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding MarketExported}" Margin="8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="4" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
          <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.MarketProhibited.IsExpanded, Mode=TwoWay}">
            <Expander.Header>
              <TextBlock Text="{Binding MarketProhibited.Count, StringFormat=Prohibited ({0})}" />
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding MarketProhibited}" Margin="8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="4" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </controls:ResponsiveColumnsPanel>
        <Expander Classes="profile-section" IsExpanded="{Binding PaneStates.MarketData.IsExpanded, Mode=TwoWay}">
          <Expander.Header>
            <TextBlock Text="{Binding MarketData.Count, StringFormat=All market data points ({0})}" />
          </Expander.Header>
          <ScrollViewer MaxHeight="500" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding MarketData}" Margin="8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:FrontierDataPointSnapshot">
                  <Grid ColumnDefinitions="1.1*,1.4*" ColumnSpacing="12" Margin="4,3">
                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding Path}" />
                    <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Text="{Binding Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Expander>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
