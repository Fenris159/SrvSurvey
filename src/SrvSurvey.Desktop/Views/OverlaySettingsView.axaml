<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:SrvSurvey.Desktop.Controls"
             xmlns:vm="using:SrvSurvey.Desktop.ViewModels"
             x:Class="SrvSurvey.Desktop.Views.OverlaySettingsView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <StackPanel Margin="0,16,0,0" Spacing="24">
    <StackPanel Spacing="5">
      <TextBlock x:Name="OverlaySettingsEyebrow" Classes="eyebrow" Text="OVERLAYS" />
      <TextBlock x:Name="OverlaySettingsTitle" Classes="page-title" Text="Game overlays" />
      <TextBlock x:Name="OverlaySettingsDescription" Classes="muted"
                 TextWrapping="Wrap"
                 Text="Control passive Galaxy Map, route, survey, and status surfaces." />
    </StackPanel>

    <Border x:Name="MiningShortcutsCard" Classes="card raised">
      <StackPanel Spacing="12">
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Automatically clear saved rigs when you board your own ship or dock the Rhino. Send --- in game chat to clear all bookmarks and rigs on the current body at any time." />
        <CheckBox IsChecked="{Binding Mining.AutoClearRigsOnShipBoarding, Mode=TwoWay}"
                  Content="Clear rigs automatically when boarding your ship" />
        <TextBlock Classes="card-title" Text="Rig bar detection (experimental)" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Detection only: saved rig locations are never changed. Open Edit Overlay Positions and choose Mining. Move and resize the frame over all six HUD circles, align the dots with their centres and the cyan boxes with their labels. While stationary, select Test and return focus to Elite to learn the labels. Use the editor's save or cancel button when finished. Detection uses bar shape and contrast, with no required HUD color." />
        <CheckBox IsChecked="{Binding Mining.Detection.Enabled, Mode=TwoWay}"
                  Content="Observe rig bars while operating the Rhino" />
        <TextBlock Text="{Binding Mining.Detection.SlotsText}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Mining.Detection.StatusText}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding Mining.Detection.LastAppearance}" TextWrapping="Wrap" />
        <TextBlock Classes="card-title" Text="Rig location shortcuts" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="In a Rhino, set or clear each rig at its deployment position. These are the same bindings shown in Input settings. Hold a combination and release to save; Escape cancels; Backspace or Delete clears." />
        <ItemsControl ItemsSource="{Binding InputSettings.MiningBindings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InputBindingViewModel">
              <Grid ColumnDefinitions="*,260" ColumnSpacing="24" Margin="0,4">
                <TextBlock Text="{Binding MiningDisplayName}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <controls:ShortcutCaptureBox Chord="{Binding Chord, Mode=TwoWay}"
                                               PlaceholderText="Click, then hold shortcut keys" />
                  <TextBlock Foreground="{DynamicResource RavenWarningBrush}" IsVisible="{Binding HasValidationError}"
                             Text="{Binding ValidationMessage}" FontSize="10" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Border x:Name="PassiveNotificationCard" Classes="card raised">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Passive notification overlay" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Show the original six-second PlotFloatie messages without taking focus from Elite. Messages are de-duplicated, expire automatically, and never replay from startup journal history." />
          </StackPanel>
          <CheckBox Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Notifications.Enabled, Mode=TwoWay}"
                    Content="Allow timed notification messages" />
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Spacing="10">
            <CheckBox IsChecked="{Binding Notifications.MaterialCountAfterPickup, Mode=TwoWay}"
                      Content="Materials count after pickup" />
            <CheckBox IsChecked="{Binding Notifications.CargoMissionRemaining, Mode=TwoWay}"
                      Content="Mission remaining cargo count" />
            <CheckBox IsChecked="{Binding Notifications.ShowScreenshot, Mode=TwoWay}"
                      Content="Screenshot taken" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Successful Green Gas Giant uploads and the screenshot-banner shortcut use this overlay when it is enabled." />
          </StackPanel>
        </Grid>
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   IsVisible="{Binding Notifications.HasSettingsStatus}"
                   TextWrapping="Wrap"
                   Text="{Binding Notifications.SettingsStatus}" />
      </StackPanel>
    </Border>

    <Border x:Name="BoxelOverlayCard" Classes="card raised">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Galaxy Map boxel guidance" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="While an active boxel search and the Galaxy Map are open, show the current boxel, completion progress, next system or prefix, destination validity, and clipboard state." />
        </StackPanel>
        <CheckBox IsChecked="{Binding BoxelSearch.AutoCopy, Mode=TwoWay}"
                  Content="Auto-copy next system in Galaxy Map" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="Auto-copy is mutually exclusive with Route Manager and FC Routes so only one Galaxy Map destination source can control the clipboard." />
        <Separator />
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Boxel completion notifications" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Choose the six-second messages shown after FSS completes a system. Timed messages also require the global passive notification overlay in Settings." />
        </StackPanel>
        <CheckBox IsChecked="{Binding Notifications.CurrentBoxelSearchStatus, Mode=TwoWay}"
                  Content="Show current boxel completion percentage" />
        <CheckBox IsChecked="{Binding Notifications.ShowNextBoxelToSearch, Mode=TwoWay}"
                  Content="Show the next boxel when the current one is complete" />
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   IsVisible="{Binding Notifications.HasSettingsStatus}"
                   TextWrapping="Wrap"
                   Text="{Binding Notifications.SettingsStatus}" />
      </StackPanel>
    </Border>

    <Border x:Name="GalaxyMapCard" Classes="card raised">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Galaxy Map intelligence" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Show the selected destination, next jump, discovery progress, biological signal count, route distance, and optional faction influence while the Galaxy Map is open." />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
          <CheckBox IsChecked="{Binding GalaxyMap.AutoShow, Mode=TwoWay}"
                    Content="Show exploration preview in Galaxy Map (uses external data)" />
          <CheckBox Grid.Column="1"
                    IsChecked="{Binding GalaxyMap.ShowFactions, Mode=TwoWay}"
                    Content="Show factions in gal-map" />
        </Grid>
        <TextBlock IsVisible="{Binding GalaxyMap.HasSettingsStatus}"
                   Foreground="{DynamicResource RavenWarningBrush}"
                   Text="{Binding GalaxyMap.SettingsStatus}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border x:Name="GlobalOverlayBehaviorCard" Classes="card raised">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Global overlay behavior" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Apply the original focus and Odyssey suit rules consistently to every passive overlay." />
        </StackPanel>
        <CheckBox IsChecked="{Binding OverlayBehavior.KeepWhenGameLosesFocus, Mode=TwoWay}"
                  Content="Keep overlays visible when Elite loses focus" />
        <CheckBox IsChecked="{Binding OverlayBehavior.HideMultiGameCommanderOverlay, Mode=TwoWay}"
                  Content="Hide the multi-game Commander overlay" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="Disable overlays when on foot in:" />
            <CheckBox IsChecked="{Binding OverlayBehavior.HideInDominatorSuit, Mode=TwoWay}"
                      Content="Dominator suit" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Classes="muted" Text=" " />
            <CheckBox IsChecked="{Binding OverlayBehavior.HideInMaverickSuit, Mode=TwoWay}"
                      Content="Maverick suit" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,240" ColumnSpacing="20">
          <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="Overlay scale" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       Text="Match desktop scaling or force the original 50-250% overlay sizes." />
          </StackPanel>
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding OverlayScale.Options}"
                    SelectedItem="{Binding OverlayScale.SelectedOption, Mode=TwoWay}" />
        </Grid>
        <Border Background="{DynamicResource RavenSurfaceBrush}"
                BorderBrush="{DynamicResource RavenBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="Edit overlay positions" />
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="{Binding OverlayInteraction.ModeLabel}" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="primary"
                      Command="{Binding OverlayInteraction.ToggleCommand}"
                      Content="{Binding OverlayInteraction.ToggleButtonText}" />
            </Grid>
            <Grid ColumnDefinitions="*,220" ColumnSpacing="18">
              <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="Live-overlay interaction shortcut" />
                <TextBlock Classes="muted"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Enable global keyboard input below, then use this shortcut to make existing live overlays clickable and draggable. Use it again to save positions and restore click-through mode; it never opens the full editor." />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <controls:ShortcutCaptureBox Chord="{Binding OverlayInteractionBinding.Chord, Mode=TwoWay}"
                                             PlaceholderText="Click, then hold shortcut keys"
                                             ToolTip.Tip="Hold a key combination, then release all keys to save. Esc cancels; Backspace or Delete clears." />
                <TextBlock Classes="muted"
                           FontSize="10"
                           Text="{Binding OverlayInteractionBinding.DefaultChord}" />
                <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                           FontSize="10"
                           IsVisible="{Binding OverlayInteractionBinding.HasValidationError}"
                           Text="{Binding OverlayInteractionBinding.ValidationMessage}" />
              </StackPanel>
            </Grid>
            <Separator />
            <StackPanel Spacing="10">
              <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="Overlay Opacity Override" />
                <TextBlock Classes="muted"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Choose an overlay, then optionally override its inherited opacity without changing its drag-managed position." />
              </StackPanel>
              <ComboBox ItemsSource="{Binding OverlayLayout.Overlays}"
                        SelectedItem="{Binding OverlayLayout.SelectedOverlay, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OverlayPlacementEditorViewModel">
                    <Grid Margin="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                      <TextBlock Grid.Column="1"
                                 Classes="muted"
                                 FontSize="11"
                                 Text="{Binding Description}" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid DataContext="{Binding OverlayLayout.SelectedOverlay}"
                    x:DataType="vm:OverlayPlacementEditorViewModel"
                    ColumnDefinitions="*,140"
                    ColumnSpacing="12">
                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding UseCustomOpacity, Mode=TwoWay}"
                          Content="Override the global overlay opacity" />
                <NumericUpDown Grid.Column="1"
                               IsEnabled="{Binding IsCustomOpacityEnabled}"
                               Minimum="0"
                               Maximum="100"
                               Increment="1"
                               FormatString="N0"
                               Value="{Binding CustomOpacityPercent, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock VerticalAlignment="Center"
                           Classes="muted"
                           TextWrapping="Wrap"
                           Text="{Binding OverlayLayout.StatusMessage}" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Command="{Binding OverlayLayout.ReloadCommand}"
                        Content="Discard opacity changes" />
                <Button Grid.Column="2"
                        Classes="primary"
                        Command="{Binding OverlayLayout.SaveCommand}"
                        Content="Save opacity override" />
              </Grid>
            </StackPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="{Binding OverlayInteraction.StatusMessage}" />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted"
                   FontSize="11"
                   Text="{Binding OverlayBehavior.CurrentSuitText}" />
        <TextBlock IsVisible="{Binding OverlayScale.HasSettingsStatus}"
                   Foreground="{DynamicResource RavenMutedTextBrush}"
                   Text="{Binding OverlayScale.SettingsStatus}"
                   TextWrapping="Wrap" />
        <TextBlock IsVisible="{Binding OverlayBehavior.HasSettingsStatus}"
                   Foreground="{DynamicResource RavenWarningBrush}"
                   Text="{Binding OverlayBehavior.SettingsStatus}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border x:Name="PulseOverlayCard" Classes="card raised">
      <StackPanel Spacing="10">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Journal activity and SCO status" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Controls the complete PlotPulse overlay: the ~10-second journal/status pulse bar and the Supercruise Overdrive cooldown indicator. There is a single enable preference for both." />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <CheckBox VerticalAlignment="Center"
                    IsChecked="{Binding PulseOverlay.HideJournalWriteTimer, Mode=TwoWay}"
                    Content="Hide PlotPulse (journal activity and SCO status) →→→" />
          <Border Grid.Column="1"
                  Width="56"
                  Height="40"
                  Background="#101010"
                  BorderBrush="{DynamicResource RavenBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  ClipToBounds="True">
            <Panel>
              <Image Source="avares://SrvSurvey.Desktop/Assets/SettingsVisualAids/journal-pulse-preview.png"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
              <Image Source="avares://SrvSurvey.Desktop/Assets/SettingsVisualAids/pulse.png"
                     Width="18"
                     Height="18"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,4,4"
                     Opacity="0.9" />
            </Panel>
          </Border>
        </Grid>
        <TextBlock Classes="muted"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text="When checked, the entire PlotPulse overlay is hidden (journal pulse and SCO indicator). When unchecked, PlotPulse can appear outside Galaxy Map and System Map for ~10 seconds after journal activity and SCO use. Matches the original hideJournalWriteTimer setting polarity." />
        <TextBlock IsVisible="{Binding PulseOverlay.HasSettingsStatus}"
                   Foreground="{DynamicResource RavenWarningBrush}"
                   Text="{Binding PulseOverlay.SettingsStatus}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border x:Name="StreamOverlayCard" Classes="card raised">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="Joined stream overlay" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Clone every live game overlay into the transparent SrvSurveyWindowOne capture surface used by streaming software." />
          </StackPanel>
          <CheckBox Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding StreamOverlay.Enabled, Mode=TwoWay}"
                    Content="For streaming: use joined overlay" />
        </Grid>
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="{Binding StreamOverlay.StatusMessage}" />
        <TextBlock Classes="muted"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text="Alt+Ctrl+O toggles this capture window. Its enabled state is restored at startup." />
      </StackPanel>
    </Border>

    <Border x:Name="OpenVrOverlayCard" Classes="card raised">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="4">
            <TextBlock Classes="card-title" Text="OpenVR overlays" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Project every live Avalonia overlay into SteamVR with the original per-overlay position, rotation, scale, opacity, and vehicle-mode overrides." />
          </StackPanel>
          <CheckBox Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding VrOverlay.Enabled, Mode=TwoWay}"
                    Content="Enable VR overlays" />
        </Grid>

        <Grid ColumnDefinitions="*,220" ColumnSpacing="18">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="VR RUNTIME PROCESS" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Projection starts only while this process is running. Use SRVSURVEY_OPENVR_LIBRARY on Linux when SteamVR is installed in a custom location." />
          </StackPanel>
          <TextBox Grid.Column="1"
                   VerticalAlignment="Center"
                   Text="{Binding VrOverlay.RuntimeProcessName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                   PlaceholderText="vrserver" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <TextBlock VerticalAlignment="Center"
                     Classes="muted"
                     TextWrapping="Wrap"
                     Text="{Binding VrOverlay.StatusMessage}" />
          <Button Grid.Column="1"
                  Classes="secondary"
                  Click="BeginVrAdjustment_Click"
                  Content="Adjust overlays" />
        </Grid>

        <Border IsVisible="{Binding VrOverlay.IsAdjusting}"
                Padding="16"
                Background="{DynamicResource RavenSurfaceBrush}"
                BorderBrush="{DynamicResource RavenBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="18">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="CALIBRATION TARGET" />
                <ComboBox MinWidth="280"
                          ItemsSource="{Binding VrOverlay.AvailableOverlays}"
                          SelectedItem="{Binding VrOverlay.SelectedOverlayName, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="eyebrow" Text="VEHICLE / GAME MODE" />
                <ComboBox MinWidth="200"
                          ItemsSource="{Binding VrOverlay.AvailableModes}"
                          SelectedItem="{Binding VrOverlay.SelectedMode, Mode=TwoWay}" />
                <TextBlock Classes="muted"
                           FontSize="11"
                           Text="{Binding VrOverlay.CurrentRuntimeMode, StringFormat='Current: {0}'}" />
              </StackPanel>
              <TextBlock Grid.Column="2"
                         VerticalAlignment="Bottom"
                         Classes="muted"
                         FontSize="11"
                         Text="Alt+V opens this editor" />
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
              <StackPanel Spacing="5">
                <TextBlock Classes="eyebrow" Text="SCALE" />
                <NumericUpDown Minimum="0.1"
                               Maximum="50"
                               Increment="0.1"
                               FormatString="0.0###"
                               Value="{Binding VrOverlay.Scale, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Classes="eyebrow" Text="POSITION X / Y / Z" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <NumericUpDown Minimum="-1000" Maximum="1000" Increment="0.1"
                                 FormatString="0.0###"
                                 Value="{Binding VrOverlay.PositionX, Mode=TwoWay}" />
                  <NumericUpDown Grid.Column="1" Minimum="-1000" Maximum="1000" Increment="0.1"
                                 FormatString="0.0###"
                                 Value="{Binding VrOverlay.PositionY, Mode=TwoWay}" />
                  <NumericUpDown Grid.Column="2" Minimum="-1000" Maximum="1000" Increment="0.1"
                                 FormatString="0.0###"
                                 Value="{Binding VrOverlay.PositionZ, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Classes="eyebrow" Text="PITCH / YAW / ROLL" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                  <NumericUpDown Minimum="-360" Maximum="360" Increment="0.1"
                                 FormatString="0.0###"
                                 Value="{Binding VrOverlay.RotationPitch, Mode=TwoWay}" />
                  <NumericUpDown Grid.Column="1" Minimum="-360" Maximum="360" Increment="0.1"
                                 FormatString="0.0###"
                                 Value="{Binding VrOverlay.RotationYaw, Mode=TwoWay}" />
                  <NumericUpDown Grid.Column="2" Minimum="-360" Maximum="360" Increment="0.1"
                                 FormatString="0.0###"
                                 Value="{Binding VrOverlay.RotationRoll, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
              <TextBlock VerticalAlignment="Center"
                         Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Text="Changes preview live in OpenVR. Save is atomic and preserves desktop placement plus unknown overlays." />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Command="{Binding VrOverlay.CancelCommand}"
                      Content="Cancel" />
              <Button Grid.Column="2"
                      Classes="secondary"
                      Command="{Binding VrOverlay.ResetCommand}"
                      Content="Reset selected" />
              <Button Grid.Column="3"
                      Classes="primary"
                      Command="{Binding VrOverlay.SaveCommand}"
                      Content="Save calibration" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border x:Name="CombatOverlayCard" Classes="card raised">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Combat overlays" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Track Odyssey ground conflict-zone bonds and active ship massacre missions with the same journal rules as the original application." />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow" Text="GROUND COMBAT" />
            <CheckBox IsChecked="{Binding Combat.AutoShowFootCombat, Mode=TwoWay}"
                      Content="Show ground combat-zone totals" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Appears below 100 m while on foot or in an SRV at a settlement whose faction is at war or civil war." />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Classes="eyebrow" Text="MASSACRE MISSIONS" />
            <CheckBox IsChecked="{Binding Combat.AutoShowMassacreMissions, Mode=TwoWay}"
                      Content="Massacre mission helper (Experimental)" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Shows remaining kills in flight, supercruise, station services, and the navigation panel. Progress is stored in the commander profile." />
          </StackPanel>
        </Grid>
        <CheckBox IsChecked="{Binding Combat.SuppressForActiveBuildProjects, Mode=TwoWay}"
                  Content="Hide combat overlays while Raven Colonial build projects are active" />
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   IsVisible="{Binding Combat.HasStatusMessage}"
                   TextWrapping="Wrap"
                   Text="{Binding Combat.StatusMessage}" />
      </StackPanel>
    </Border>

    <Border x:Name="GuardianOverlayCard" Classes="card raised">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Guardian overlays" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Show live Guardian maps, system-site summaries, and Ram Tah artifact guidance using the original game-mode rules." />
        </StackPanel>
        <CheckBox IsChecked="{Binding Guardian.EnableGuardianSites, Mode=TwoWay}">
          <TextBlock Text="Enable Guardian Ruins features"
                     TextWrapping="Wrap" />
        </CheckBox>
        <Grid x:Name="GuardianPrimaryColumns"
              ColumnDefinitions="*,*"
              ColumnSpacing="28">
          <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow" Text="SYSTEM SUMMARY" />
            <CheckBox IsChecked="{Binding Guardian.AutoShowGuardianSummary, Mode=TwoWay}">
              <TextBlock Text="Show summary of Guardian sites"
                         TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Appears in supercruise, the navigation panel, or the system map and marks the selected destination." />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Classes="eyebrow" Text="RAM TAH" />
            <CheckBox IsChecked="{Binding Guardian.AutoShowRamTah, Mode=TwoWay}">
              <TextBlock Text="Show helper for Ram Tah missions"
                         TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="At an active ruins or structure, lists incomplete logs, matching obelisks, and available artifact counts." />
          </StackPanel>
        </Grid>
        <CheckBox IsChecked="{Binding Guardian.SuppressForActiveBuildProjects, Mode=TwoWay}">
          <TextBlock Text="Hide Guardian summaries and Ram Tah guidance while Raven Colonial build projects are active"
                     TextWrapping="Wrap" />
        </CheckBox>
        <Grid x:Name="GuardianSettingsColumns"
              ColumnDefinitions="*,*"
              ColumnSpacing="28">
          <StackPanel x:Name="GuardianLeftColumn" Spacing="22">
            <StackPanel Spacing="10">
              <TextBlock Classes="eyebrow" Text="MAP ZOOM" />
              <CheckBox IsChecked="{Binding Guardian.AutoZoomNearObelisks, Mode=TwoWay}">
                <TextBlock Text="Auto zoom map if within 30 m of obelisks"
                           TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox IsChecked="{Binding Guardian.AutoZoomInSrvTurret, Mode=TwoWay}">
                <TextBlock Text="Auto zoom map when using SRV turret"
                           TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox IsChecked="{Binding Guardian.ShowComponentMaterials, Mode=TwoWay}">
                <TextBlock Text="Track Guardian component materials"
                           TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox IsChecked="{Binding Guardian.ShowMapLegend, Mode=TwoWay}">
                <TextBlock Text="Show the survey-map legend"
                           TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox IsChecked="{Binding Guardian.ShowMapNotes, Mode=TwoWay}">
                <TextBlock Text="Show commander notes beside survey maps"
                           TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Text="Shows tower loadouts and destructible panels and preserves the original component survey format. Auto-zoom engages within 30 m of an active obelisk." />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Classes="eyebrow" Text="ALIGNMENT GUIDES" />
              <CheckBox IsChecked="{Binding Guardian.DisableRuinsMeasurementGrid, Mode=TwoWay}">
                <TextBlock Text="Disable site heading assistance overlay."
                           TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox IsChecked="{Binding Guardian.DisableAerialAlignmentGrid, Mode=TwoWay}">
                <TextBlock Text="Disable aerial screenshot alignment overlay."
                           TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Text="Matches upstream polarity: leave unchecked to keep the heading grid and aerial origin guides available at ruins." />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="GuardianRightColumn"
                      Grid.Column="1"
                      Spacing="22">
            <StackPanel x:Name="GuardianOverlaySizeSection" Spacing="8">
              <TextBlock Classes="eyebrow" Text="OVERLAY SIZE" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Use one of the five original Guardian plotter sizes." />
              <ComboBox Width="200"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Guardian.OverlaySizeOptions}"
                        SelectedItem="{Binding Guardian.SelectedOverlaySize, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GuardianOverlaySizeOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="8">
              <TextBlock Classes="eyebrow" Text="RUINS AERIAL ALTITUDES" />
              <TextBlock Classes="muted"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Text="Preferred altitude for aerial screenshots (m). Adjust so each site comfortably fits your monitor. Screenshots within 50 m of site origin and 500–2000 m altitude are eligible for aerial copies." />
              <StackPanel Spacing="8" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="72,120" ColumnSpacing="10">
                  <TextBlock VerticalAlignment="Center" Text="Alpha" />
                  <NumericUpDown Grid.Column="1"
                                 Width="120"
                                 MinWidth="120"
                                 Minimum="0"
                                 Maximum="5000"
                                 Increment="10"
                                 FormatString="0"
                                 Value="{Binding ScreenshotProcessing.AerialAltitudeAlpha, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="72,120" ColumnSpacing="10">
                  <TextBlock VerticalAlignment="Center" Text="Beta" />
                  <NumericUpDown Grid.Column="1"
                                 Width="120"
                                 MinWidth="120"
                                 Minimum="0"
                                 Maximum="5000"
                                 Increment="10"
                                 FormatString="0"
                                 Value="{Binding ScreenshotProcessing.AerialAltitudeBeta, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="72,120" ColumnSpacing="10">
                  <TextBlock VerticalAlignment="Center" Text="Gamma" />
                  <NumericUpDown Grid.Column="1"
                                 Width="120"
                                 MinWidth="120"
                                 Minimum="0"
                                 Maximum="5000"
                                 Increment="10"
                                 FormatString="0"
                                 Value="{Binding ScreenshotProcessing.AerialAltitudeGamma, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   IsVisible="{Binding Guardian.HasOverlaySettingsStatus}"
                   TextWrapping="Wrap"
                   Text="{Binding Guardian.OverlaySettingsStatus}" />
      </StackPanel>
    </Border>

    <Border x:Name="StationInformationCard" Classes="card raised">
      <StackPanel Spacing="10">
        <TextBlock Classes="card-title" Text="Station information" />
        <CheckBox IsChecked="{Binding StationInfo.AutoShow, Mode=TwoWay}"
                  Content="Show station/target details in left nav panel" />
        <TextBlock Classes="muted"
                   TextWrapping="Wrap"
                   Text="Uses current Spansh station data for pads, economies, faction, relevant services, and prohibited commodities. Alt+I toggles the overlay manually." />
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   IsVisible="{Binding StationInfo.HasSettingsStatus}"
                   TextWrapping="Wrap"
                   Text="{Binding StationInfo.SettingsStatus}" />
      </StackPanel>
    </Border>

    <Border x:Name="HumanSettlementCard" Classes="card raised">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Human settlement map" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Navigate Odyssey settlements with the original site templates, docking guidance, and commander-relative map rendered in the active Raven theme." />
        </StackPanel>
        <CheckBox IsChecked="{Binding HumanSite.AutoShow, Mode=TwoWay}"
                  Content="Human settlement maps" />
        <CheckBox IsChecked="{Binding HumanSite.SuppressForActiveBuildProjects, Mode=TwoWay}"
                  Content="Hide the settlement map while Raven Colonial build projects are active" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow" Text="MAP CONTENT" />
            <CheckBox IsChecked="{Binding HumanSite.ShowMedkits, Mode=TwoWay}"
                      Content="Med kits" />
            <CheckBox IsChecked="{Binding HumanSite.ShowBatteries, Mode=TwoWay}"
                      Content="Battery packs" />
            <CheckBox IsChecked="{Binding HumanSite.ShowDataTerminals, Mode=TwoWay}"
                      Content="Data terminals" />
            <CheckBox IsChecked="{Binding HumanSite.ShowCollectedMaterials, Mode=TwoWay}"
                      Content="Show dots when some material is collected" />
            <CheckBox IsChecked="{Binding HumanSite.TrackMaterialCollection, Mode=TwoWay}"
                      Content="Record material collection surveys" />
            <CheckBox IsChecked="{Binding HumanSite.AutoZoomInside, Mode=TwoWay}"
                      Content="Auto-zoom if inside buildings" />
            <CheckBox IsChecked="{Binding HumanSite.AutoZoomTool, Mode=TwoWay}"
                      Content="Auto-zoom with analyzer tool" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Material dots can lag when collecting quickly. POI markers are randomly generated per settlement and may not match true locations." />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="10">
            <TextBlock Classes="eyebrow" Text="WINDOW SIZE" />
            <Grid ColumnDefinitions="*,132" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="Width" />
              <NumericUpDown Grid.Column="1"
                             Minimum="320"
                             Maximum="1600"
                             Increment="20"
                             Value="{Binding HumanSite.PreferredWidth, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,132" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="Height" />
              <NumericUpDown Grid.Column="1"
                             Minimum="320"
                             Maximum="1400"
                             Increment="20"
                             Value="{Binding HumanSite.PreferredHeight, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </Grid>

        <TextBlock Classes="eyebrow" Text="ZOOM BY ACTIVITY" />
        <Grid ColumnDefinitions="*,132,*,132" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock VerticalAlignment="Center" Text="Ship" />
          <NumericUpDown Grid.Column="1"
                         Minimum="0.2"
                         Maximum="15"
                         Increment="0.1"
                         FormatString="0.0"
                         Value="{Binding HumanSite.ShipZoom, Mode=TwoWay}" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="SRV" />
          <NumericUpDown Grid.Column="3"
                         Minimum="0.2"
                         Maximum="15"
                         Increment="0.1"
                         FormatString="0.0"
                         Value="{Binding HumanSite.SrvZoom, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="On foot" />
          <NumericUpDown Grid.Row="1" Grid.Column="1"
                         Minimum="0.2"
                         Maximum="15"
                         Increment="0.1"
                         FormatString="0.0"
                         Value="{Binding HumanSite.FootZoom, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Inside" />
          <NumericUpDown Grid.Row="1" Grid.Column="3"
                         Minimum="0.2"
                         Maximum="15"
                         Increment="0.1"
                         FormatString="0.0"
                         Value="{Binding HumanSite.InsideZoom, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Suit tool" />
          <NumericUpDown Grid.Row="2" Grid.Column="1"
                         Minimum="0.2"
                         Maximum="15"
                         Increment="0.1"
                         FormatString="0.0"
                         Value="{Binding HumanSite.ToolZoom, Mode=TwoWay}" />
        </Grid>

        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   TextWrapping="Wrap"
                   Text="{Binding HumanSite.SettingsStatus}" />
      </StackPanel>
    </Border>

    <Expander x:Name="HumanTemplateAuthoringExpander"
              Classes="section-pill"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              IsExpanded="False">
      <Expander.Header>
        <StackPanel Spacing="3">
          <TextBlock Classes="card-title"
                     Text="Settlement template authoring" />
          <TextBlock Classes="muted"
                     Text="Developer tools for capturing live Odyssey settlement geometry." />
        </StackPanel>
      </Expander.Header>
      <Border Margin="0,12,0,0" Classes="card">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="LIVE TEMPLATE DRAFT" />
              <TextBlock Classes="card-title"
                         Text="{Binding HumanSite.TemplateAuthor.TemplateTitle}" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="Draft points are previewed on the active settlement map. Nothing changes on disk until you choose an export destination." />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="primary"
                    VerticalAlignment="Center"
                    Command="{Binding HumanSite.TemplateAuthor.StartCommand}"
                    Content="Start local draft" />
          </Grid>

          <Border Background="{DynamicResource RavenSurfaceBrush}"
                  CornerRadius="8"
                  Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding HumanSite.TemplateAuthor.CurrentOffsetText}" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Text="{Binding HumanSite.TemplateAuthor.StatusMessage}" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="16"
                      IsVisible="{Binding HumanSite.TemplateAuthor.IsAuthoring}">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
              <Border Classes="badge" Padding="10,6">
                <TextBlock HorizontalAlignment="Center">
                  <Run Text="Buildings " />
                  <Run FontWeight="Bold"
                       Text="{Binding HumanSite.TemplateAuthor.BuildingCount}" />
                </TextBlock>
              </Border>
              <Border Grid.Column="1" Classes="badge" Padding="10,6">
                <TextBlock HorizontalAlignment="Center">
                  <Run Text="Named " />
                  <Run FontWeight="Bold"
                       Text="{Binding HumanSite.TemplateAuthor.NamedPointCount}" />
                </TextBlock>
              </Border>
              <Border Grid.Column="2" Classes="badge" Padding="10,6">
                <TextBlock HorizontalAlignment="Center">
                  <Run Text="Terminals " />
                  <Run FontWeight="Bold"
                       Text="{Binding HumanSite.TemplateAuthor.DataTerminalCount}" />
                </TextBlock>
              </Border>
              <Border Grid.Column="3" Classes="badge" Padding="10,6">
                <TextBlock HorizontalAlignment="Center">
                  <Run Text="Doors " />
                  <Run FontWeight="Bold"
                       Text="{Binding HumanSite.TemplateAuthor.SecureDoorCount}" />
                </TextBlock>
              </Border>
            </Grid>

            <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
              <StackPanel Spacing="12">
                <TextBlock FontWeight="Bold" Text="Points of interest" />
                <Grid ColumnDefinitions="110,110,*" ColumnSpacing="12">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="muted" Text="SECURITY" />
                    <NumericUpDown Minimum="0"
                                   Maximum="3"
                                   Increment="1"
                                   FormatString="0"
                                   Value="{Binding HumanSite.TemplateAuthor.SecurityLevel, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Classes="muted" Text="FLOOR" />
                    <NumericUpDown Minimum="0"
                                   Maximum="99"
                                   Increment="1"
                                   FormatString="0"
                                   Value="{Binding HumanSite.TemplateAuthor.Floor, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Classes="muted" Text="NAMED POINT" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding HumanSite.TemplateAuthor.NamedPointName, Mode=TwoWay}"
                               PlaceholderText="Battery, Medkit, Alarm, Power..." />
                      <Button Grid.Column="1"
                              Classes="secondary"
                              Command="{Binding HumanSite.TemplateAuthor.AddNamedPointCommand}"
                              Content="Add here" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <WrapPanel Orientation="Horizontal">
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.AddDataTerminalCommand}"
                          Content="Add data terminal here" />
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.AddSecureDoorCommand}"
                          Content="Add secure door here" />
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.RemoveLastNamedPointCommand}"
                          Content="Undo named" />
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.RemoveLastDataTerminalCommand}"
                          Content="Undo terminal" />
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.RemoveLastSecureDoorCommand}"
                          Content="Undo door" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource RavenBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock FontWeight="Bold" Text="Building geometry" />
                    <TextBlock Classes="muted">
                      <Run Text="Polygon points " />
                      <Run FontWeight="Bold"
                           Text="{Binding HumanSite.TemplateAuthor.PendingPolygonPointCount}" />
                      <Run Text=" · pending paths " />
                      <Run FontWeight="Bold"
                           Text="{Binding HumanSite.TemplateAuthor.PendingBuildingPathCount}" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.RemoveLastBuildingCommand}"
                          Content="Undo committed building" />
                </Grid>

                <WrapPanel Orientation="Horizontal">
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.BeginPolygonCommand}"
                          Content="Start polygon here" />
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.AddPolygonPointCommand}"
                          Content="Add point" />
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.EndPolygonCommand}"
                          Content="End path here" />
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.CancelPolygonCommand}"
                          Content="Cancel polygon" />
                  <TextBlock Margin="10,0,8,8"
                             Classes="muted"
                             VerticalAlignment="Center"
                             Text="Circle radius" />
                  <NumericUpDown Width="110"
                                 Margin="0,0,8,8"
                                 Minimum="0.1"
                                 Maximum="10000"
                                 Increment="0.5"
                                 FormatString="0.0"
                                 Value="{Binding HumanSite.TemplateAuthor.CircleRadius, Mode=TwoWay}" />
                  <Button Margin="0,0,8,8"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.AddCircleCommand}"
                          Content="Add circle here" />
                </WrapPanel>

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding HumanSite.TemplateAuthor.BuildingName, Mode=TwoWay}"
                           PlaceholderText="Building name" />
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding HumanSite.TemplateAuthor.RemovePendingPathCommand}"
                          Content="Undo pending path" />
                  <Button Grid.Column="2"
                          Classes="primary"
                          Command="{Binding HumanSite.TemplateAuthor.CommitBuildingCommand}"
                          Content="Commit building to draft" />
                </Grid>
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="While a polygon is active, toggling ship shields captures the current point just like the original builder." />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <TextBlock Classes="muted"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding HumanSite.TemplateAuthor.LastExportPath}" />
              <Button Grid.Column="1"
                      Classes="secondary"
                      Command="{Binding HumanSite.TemplateAuthor.RequestDiscardCommand}"
                      Content="Discard draft" />
              <Button Grid.Column="2"
                      Classes="secondary"
                      Click="ExportHumanSiteTemplates_Click"
                      Content="Export verified catalog..." />
            </Grid>

            <Border BorderBrush="{DynamicResource RavenWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsVisible="{Binding HumanSite.TemplateAuthor.IsDiscardConfirmationPending}"
                    Padding="12">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center"
                           Text="Discard the unexported in-memory draft?" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Command="{Binding HumanSite.TemplateAuthor.CancelDiscardCommand}"
                        Content="Keep draft" />
                <Button Grid.Column="2"
                        Classes="danger"
                        Command="{Binding HumanSite.TemplateAuthor.ConfirmDiscardCommand}"
                        Content="Confirm discard" />
              </Grid>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </Expander>

    <Border x:Name="JumpInformationCard" Classes="card raised">
      <StackPanel Spacing="14">
        <CheckBox IsChecked="{Binding JumpInfo.AutoShow, Mode=TwoWay}"
                  Content="Show next system summary before FSD jumping (uses external data)" />
        <TextBlock Margin="28,-8,0,0"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Text="Displays target, route progress, discovery, traffic, services, Guardian sites, and followed-route notes while the FSD is charging or jumping." />
        <CheckBox IsChecked="{Binding JumpInfo.Minimal, Mode=TwoWay}"
                  Content="Show hops only" />
        <TextBlock Margin="28,-8,0,0"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Text="Compact mode keeps the target and route visualization while hiding network metadata and special locations." />
        <CheckBox IsChecked="{Binding JumpInfo.ShowWhenNextHopSelected, Mode=TwoWay}"
                  Content="Show if destination is next hop in route" />
        <TextBlock Margin="28,-8,0,0"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Text="Also displays the overlay in supercruise when the navigation destination matches the next followed-route system." />
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   IsVisible="{Binding JumpInfo.HasSettingsStatus}"
                   TextWrapping="Wrap"
                   Text="{Binding JumpInfo.SettingsStatus}" />
      </StackPanel>
    </Border>

    <Border x:Name="ColonizationShoppingCard" Classes="card raised">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Shopping overlay" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Configure the passive in-game commodity list and linked Fleet Carrier columns." />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
          <StackPanel Spacing="10">
            <CheckBox IsChecked="{Binding Colonization.AutoShowCommodityOverlay, Mode=TwoWay}"
                      Content="Auto show colonization overlay" />
            <CheckBox IsChecked="{Binding Colonization.ShowCommodityOverlayOnRightPanel, Mode=TwoWay}"
                      Content="Show when looking at right-hand panel" />
            <CheckBox IsChecked="{Binding Colonization.CollapseCoveredCommodityGroups, Mode=TwoWay}"
                      Content="Collapse cargo groups when enough on FCs" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="10">
            <CheckBox IsChecked="{Binding Colonization.ShowFleetCarrierCargo, Mode=TwoWay}"
                      Content="Show Fleet Carrier aggregate counts" />
            <CheckBox IsChecked="{Binding Colonization.ShowFleetCarrierDelta, Mode=TwoWay}"
                      IsEnabled="{Binding Colonization.ShowFleetCarrierCargo}"
                      Content="Show delta vs sum" />
            <CheckBox IsChecked="{Binding Colonization.InlineFleetCarrierCargo, Mode=TwoWay}"
                      IsEnabled="{Binding Colonization.ShowFleetCarrierCargo}"
                      Content="Share column with ship cargo counts" />
            <CheckBox IsChecked="{Binding Colonization.HighlightAlmostCoveredFleetCarrierLoads, Mode=TwoWay}"
                      IsEnabled="{Binding Colonization.ShowFleetCarrierCargo}"
                      Content="Highlight if ship can load enough on FCs" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border x:Name="SystemSurveyCard" Classes="card raised">
      <StackPanel Spacing="16">
        <StackPanel Spacing="4">
          <TextBlock x:Name="SystemSurveyCardTitle" Classes="card-title" Text="System survey overlays" />
          <TextBlock x:Name="SystemSurveyCardDescription" Classes="muted"
                     TextWrapping="Wrap"
                     Text="Configure body details, the FSS body feed, and compact system-completion overlays. These preserve the original survey rules while using the active Raven theme." />
        </StackPanel>

        <Grid x:Name="ExplorationSurveyGrid" ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Spacing="12">
            <TextBlock Classes="eyebrow" Text="FSS BODY FEED" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowLastFssBody, Mode=TwoWay}"
                      Content="Show the last tuned body in FSS" />
            <CheckBox IsChecked="{Binding SystemSurvey.FssTuningDetectorEnabled, Mode=TwoWay}"
                      Content="Detect FSS tuning completion from the game display" />
            <CheckBox Margin="24,0,0,0"
                      IsChecked="{Binding SystemSurvey.SaveFssTuningDiagnosticImages, Mode=TwoWay}"
                      IsEnabled="{Binding SystemSurvey.FssTuningDetectorEnabled}"
                      Content="Save a diagnostic capture when the tuning panel cannot be found" />
            <TextBlock Classes="muted"
                       IsVisible="{Binding SystemSurvey.HasFssTuningDetectorStatus}"
                       Text="{Binding SystemSurvey.FssTuningDetectorStatus}"
                       TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowFssInfo, Mode=TwoWay}"
                      Content="Show exploration values in FSS" />
            <CheckBox IsChecked="{Binding SystemSurvey.ShowFssInfoInSystemMap, Mode=TwoWay}"
                      Content="Show list in system map" />
            <StackPanel Margin="28,0,0,0" Spacing="6">
              <TextBlock Text="# of bodies before scrolling:" />
              <NumericUpDown Width="150"
                             HorizontalAlignment="Left"
                             Minimum="1"
                             Maximum="20"
                             Increment="1"
                             FormatString="N0"
                             Value="{Binding SystemSurvey.FssBodiesBeforeScrolling, Mode=TwoWay}" />
            </StackPanel>
            <CheckBox IsChecked="{Binding SystemSurvey.ShowFssInfoInNavigationPanel, Mode=TwoWay}"
                      Content="Show exploration values list" />
            <CheckBox IsChecked="{Binding SystemSurvey.HideGeoCount, Mode=TwoWay}"
                      Content="Hide geo signal counts" />
            <StackPanel Spacing="6">
              <TextBlock Text="Minimum displayed body value (credits)" />
              <NumericUpDown Width="150"
                             HorizontalAlignment="Left"
                             Minimum="0"
                             Maximum="100000000"
                             Increment="1000"
                             FormatString="N0"
                             Value="{Binding SystemSurvey.FssBodyValueFloor, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Classes="eyebrow" Text="SURVEY STATUS" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowSystemStatus, Mode=TwoWay}"
                      Content="Show system DSS remaining" />
            <CheckBox IsChecked="{Binding SystemSurvey.HighlightDssCandidates, Mode=TwoWay}"
                      Content="Skip bodies with estimated value below:" />
            <CheckBox IsChecked="{Binding SystemSurvey.SkipGasGiantsForDss, Mode=TwoWay}"
                      Content="Skip DSS of gas giants" />
            <CheckBox IsChecked="{Binding SystemSurvey.SkipRingsForDss, Mode=TwoWay}"
                      Content="Skip DSS of rings" />
            <CheckBox IsChecked="{Binding SystemSurvey.SkipDistantDssCandidates, Mode=TwoWay}"
                      Content="Skip bodies exceeding:" />
            <StackPanel Spacing="6"
                        IsEnabled="{Binding SystemSurvey.SkipDistantDssCandidates}">
              <TextBlock Text="DSS distance limit (LS from primary star)" />
              <NumericUpDown Width="150"
                             HorizontalAlignment="Left"
                             Minimum="0"
                             Maximum="10000000"
                             Increment="1000"
                             FormatString="N0"
                             Value="{Binding SystemSurvey.DssDistanceLimitLs, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="6"
                        IsEnabled="{Binding SystemSurvey.HighlightDssCandidates}">
              <TextBlock Text="Minimum DSS value (credits)" />
              <NumericUpDown Width="150"
                             HorizontalAlignment="Left"
                             Minimum="0"
                             Maximum="100000000"
                             Increment="10000"
                             FormatString="N0"
                             Value="{Binding SystemSurvey.DssValueFloor, Mode=TwoWay}" />
            </StackPanel>
            <CheckBox IsChecked="{Binding SystemSurvey.ShowNonBodySignals, Mode=TwoWay}"
                      Content="Show non-body signals" />
          </StackPanel>
        </Grid>

        <Separator x:Name="ExobiologyExternalDataSeparator" />

        <Grid x:Name="ExobiologyExternalDataGrid" ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Spacing="12">
            <TextBlock Classes="eyebrow" Text="CANONN PRIOR SCANS" />
            <CheckBox IsChecked="{Binding SystemSurvey.UseExternalData, Mode=TwoWay}"
                      Content="Download star system, bodies and organic signals data from EDSM, Spansh and Canonn" />
            <CheckBox IsChecked="{Binding SystemSurvey.UseExternalBioData, Mode=TwoWay}"
                      IsEnabled="{Binding SystemSurvey.UseExternalData}"
                      Content="Use downloaded bio data from Canonn and Spansh" />
            <StackPanel Spacing="12"
                        IsEnabled="{Binding SystemSurvey.UseExternalData}">
              <CheckBox IsChecked="{Binding SystemSurvey.AutoShowPriorScans, Mode=TwoWay}"
                        Content="Show aiming guidance to bio signals from Canonn" />
              <StackPanel Spacing="12"
                          IsEnabled="{Binding SystemSurvey.AutoShowPriorScans}">
                <CheckBox IsChecked="{Binding SystemSurvey.HideOwnCanonnSignals, Mode=TwoWay}"
                          Content="Hide my own scans. Uncheck to revisit signals after dying" />
                <CheckBox IsChecked="{Binding SystemSurvey.SkipPriorScansLowValue, Mode=TwoWay}"
                          Content="Skip signals with reward below:" />
                <Grid ColumnDefinitions="*,150"
                      ColumnSpacing="12"
                      IsEnabled="{Binding SystemSurvey.SkipPriorScansLowValue}">
                  <TextBlock VerticalAlignment="Center"
                             Text="Minimum reward (credits)" />
                  <NumericUpDown Grid.Column="1"
                                 Minimum="0"
                                 Maximum="100000000"
                                 Increment="100000"
                                 FormatString="N0"
                                 Value="{Binding SystemSurvey.PriorScanMinimumValue, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Prior-scan guidance uses Canonn coordinates for the current body. Disabling external data prevents these network requests." />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Spacing="12"
                      IsEnabled="{Binding SystemSurvey.UseExternalData}">
            <StackPanel Spacing="12"
                        IsEnabled="{Binding SystemSurvey.AutoShowPriorScans}">
              <CheckBox IsChecked="{Binding SystemSurvey.ShowCanonnSignalsOnRadar, Mode=TwoWay}"
                        Content="Show bio signals from Canonn on the radar" />
              <StackPanel Spacing="8"
                          IsEnabled="{Binding SystemSurvey.ShowCanonnSignalsOnRadar}">
                <RadioButton GroupName="CanonnRadarCircleStyle"
                             IsChecked="{Binding SystemSurvey.UseSmallCanonnRadarCircles, Mode=TwoWay}"
                             Content="Use small circles" />
                <RadioButton GroupName="CanonnRadarCircleStyle"
                             IsChecked="{Binding SystemSurvey.UseBioSignalRadius, Mode=TwoWay}"
                             Content="Use bio signal radius" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="muted" FontSize="11" Text="Small circles (~100 m)" />
                    <Border Background="#101010"
                            BorderBrush="{DynamicResource RavenBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Height="120">
                      <Image Source="avares://SrvSurvey.Desktop/Assets/SettingsVisualAids/radar-small-circles-preview.png"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Classes="muted" FontSize="11" Text="Bio signal radius (organism sample range)" />
                    <Border Background="#101010"
                            BorderBrush="{DynamicResource RavenBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Height="120">
                      <Image Source="avares://SrvSurvey.Desktop/Assets/SettingsVisualAids/radar-radius-preview.png"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Prior-scan guidance uses Canonn coordinates for the current body (PlotPriorScans list). When surface radar is visible, the same coordinates are drawn as rings on PlotGrounded, matching legacy drawPriorScans. Disabling external data prevents Canonn POI requests. Use External Bio Data controls whether Spansh/Canonn body biology is merged into the system scan; prior-scan coordinates still require External Data only." />
          </StackPanel>
        </Grid>

        <Separator x:Name="SurfaceRadarSeparator" />

        <StackPanel x:Name="SurfaceRadarPanel" Spacing="12">
          <TextBlock Classes="eyebrow" Text="SURFACE RADAR" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
            <StackPanel Spacing="12">
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowSurfaceRadar, Mode=TwoWay}"
                      Content="Show sample scan exclusion zones" />
            <TextBlock Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Surface history, trackers, and sample-exclusion rings on the bio plot radar." />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowMiniTrack, Mode=TwoWay}"
                      Content="Mini trackers" />
            <CheckBox IsChecked="{Binding SystemSurvey.ShowSurfaceRadarOnlyWhenGeneticSamplerDrawn, Mode=TwoWay}"
                      IsEnabled="{Binding SystemSurvey.AutoShowSurfaceRadar}">
              <TextBlock Text="Onfoot: Show only when Genetic Sampler is drawn."
                         TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox IsChecked="{Binding SystemSurvey.AutoHideSurfaceRadarWithoutLandingGear, Mode=TwoWay}"
                      Content="Hide if landing gear is not deployed when flying." />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
            <CheckBox IsChecked="{Binding SystemSurvey.AutoRemoveTrackerOnSampling, Mode=TwoWay}"
                      Content="Auto remove tracker location when sampling an organism within 250 m." />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoRemoveTrackerOnFinalSample, Mode=TwoWay}"
                      Content="Auto remove tracker locations upon final scan" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoTrackCompositionScans, Mode=TwoWay}"
                      Content="Auto add tracker location when Composition scanning organisms." />
            <CheckBox IsChecked="{Binding SystemSurvey.SkipAnalyzedCompositionScans, Mode=TwoWay}"
                      Content="But not if that organism has already been analyzed." />
            <Button Classes="secondary"
                    HorizontalAlignment="Left"
                    Command="{Binding ClearSurfaceTrackersCommand}"
                    Content="Clear all trackers on current body" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Clears commander surface bookmarks for the body under the ship or suit, matching the legacy Bio Scanning settings control." />
            <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center"
                         Text="Radar size (0–4)" />
              <NumericUpDown Grid.Column="1"
                             Minimum="0"
                             Maximum="4"
                             Increment="1"
                             FormatString="N0"
                             Value="{Binding SystemSurvey.SurfaceRadarSize, Mode=TwoWay}" />
            </Grid>
            </StackPanel>
          </Grid>
        </StackPanel>

        <Separator x:Name="ExobiologySurveySeparator" />

        <Grid x:Name="ExobiologySurveyGrid" ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Spacing="12">
            <TextBlock Classes="eyebrow" Text="EXOBIOLOGY SURVEY" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowBioSystem, Mode=TwoWay}"
                      Content="Show whole system exo bio status" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowBioStatus, Mode=TwoWay}"
                      Content="Show biological signal summary" />
            <CheckBox IsChecked="{Binding SystemSurvey.SuppressForActiveBuildProjects, Mode=TwoWay}"
                      Content="Hide survey overlays while build projects are active" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoHideBioPlotOnRepeat, Mode=TwoWay}"
                      Content="Hide completed biology overlays on repeat visits" />
            <CheckBox IsChecked="{Binding SystemSurvey.KeepBioPlottersVisibleAfterDss, Mode=TwoWay}"
                      Content="Keep bio overlays visible after DSS scans for:" />
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Left">
              <NumericUpDown Width="120"
                             MinWidth="120"
                             IsEnabled="{Binding SystemSurvey.KeepBioPlottersVisibleAfterDss}"
                             Minimum="0"
                             Maximum="600"
                             Increment="5"
                             FormatString="0"
                             HorizontalAlignment="Left"
                             Value="{Binding SystemSurvey.BioPlotterDssDurationSeconds, Mode=TwoWay}" />
              <TextBlock VerticalAlignment="Center"
                         Text="seconds" />
            </StackPanel>
            <CheckBox IsChecked="{Binding SystemSurvey.DrawBodyBiosOnlyWhenNear, Mode=TwoWay}"
                      Content="Show body bio signals only when the target body is close by (DSS always shows the targeted body)." />
            <CheckBox IsChecked="{Binding SystemSurvey.HideGeoCountInBioSystem, Mode=TwoWay}"
                      Content="Hide geo signals" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Classes="eyebrow" Text="BIOLOGY PRESENTATION" />
            <CheckBox IsChecked="{Binding SystemSurvey.HighlightRegionalFirsts, Mode=TwoWay}"
                      Content="Highlight regional firsts in gold" />
            <CheckBox IsChecked="{Binding SystemSurvey.DimAnalyzedOrganisms, Mode=TwoWay}"
                      Content="Dim if analyzed" />
            <CheckBox IsChecked="{Binding SystemSurvey.DisableBioPredictions, Mode=TwoWay}"
                      Content="Disable organism predictions" />
            <CheckBox IsChecked="{Binding SystemSurvey.ShowTemperatureRangeDebug, Mode=TwoWay}"
                      Content="Show biology temperature diagnostics" />
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Predictions use the bundled SrvSurvey Codex criteria; confirmed scans and rewards remain visible when predictions are disabled." />
          </StackPanel>
        </Grid>

        <Separator x:Name="BiologyRewardSeparator" />

        <StackPanel x:Name="BiologyRewardPanel" Spacing="10" HorizontalAlignment="Stretch">
          <TextBlock Classes="eyebrow" Text="SPECIES REWARD GROUPS" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="Choose the reward level per group by millions of credits:" />
          <!-- Match upstream FormSettings groupRingBuckets:
               [1 bar] < n1 < [2 bars] < n2 < [3 bars] < n3 > [4 bars] -->
          <WrapPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,0,0,8"
                        VerticalAlignment="Center">
              <Border Width="48" Height="48"
                      Background="#000000"
                      BorderBrush="{DynamicResource RavenBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="2"
                      Padding="14,8"
                      VerticalAlignment="Center">
                <controls:BiologyRewardBandControl Width="16"
                                                  Height="32"
                                                  MinimumReward="1"
                                                  MaximumReward="1"
                                                  BucketOneMillions="{Binding BiologyRewards.BucketOneMillions}"
                                                  BucketTwoMillions="{Binding BiologyRewards.BucketTwoMillions}"
                                                  BucketThreeMillions="{Binding BiologyRewards.BucketThreeMillions}"
                                                  FilledBrush="{DynamicResource RavenOverlayBioConfirmedBrush}"
                                                  PotentialBrush="{DynamicResource RavenOverlayBioPotentialBrush}"
                                                  EdgeBrush="{DynamicResource RavenOverlayBioConfirmedEdgeBrush}"
                                                  EmptyBrush="{DynamicResource RavenOverlayBioEmptyBrush}" />
              </Border>
              <TextBlock VerticalAlignment="Center" FontSize="16" Text="&lt;" />
              <NumericUpDown Width="100"
                             MinWidth="100"
                             Minimum="0"
                             Maximum="20"
                             Increment="0.5"
                             FormatString="0.##"
                             VerticalAlignment="Center"
                             Value="{Binding BiologyRewards.BucketOneMillions, Mode=TwoWay}" />
              <Border Width="48" Height="48"
                      Background="#000000"
                      BorderBrush="{DynamicResource RavenBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="2"
                      Padding="14,8"
                      VerticalAlignment="Center">
                <controls:BiologyRewardBandControl Width="16"
                                                  Height="32"
                                                  MinimumReward="{Binding BiologyRewards.PreviewTwoBarReward}"
                                                  MaximumReward="{Binding BiologyRewards.PreviewTwoBarReward}"
                                                  BucketOneMillions="{Binding BiologyRewards.BucketOneMillions}"
                                                  BucketTwoMillions="{Binding BiologyRewards.BucketTwoMillions}"
                                                  BucketThreeMillions="{Binding BiologyRewards.BucketThreeMillions}"
                                                  FilledBrush="{DynamicResource RavenOverlayBioConfirmedBrush}"
                                                  PotentialBrush="{DynamicResource RavenOverlayBioPotentialBrush}"
                                                  EdgeBrush="{DynamicResource RavenOverlayBioConfirmedEdgeBrush}"
                                                  EmptyBrush="{DynamicResource RavenOverlayBioEmptyBrush}" />
              </Border>
              <TextBlock VerticalAlignment="Center" FontSize="16" Text="&lt;" />
              <NumericUpDown Width="100"
                             MinWidth="100"
                             Minimum="0"
                             Maximum="20"
                             Increment="0.5"
                             FormatString="0.##"
                             VerticalAlignment="Center"
                             Value="{Binding BiologyRewards.BucketTwoMillions, Mode=TwoWay}" />
              <Border Width="48" Height="48"
                      Background="#000000"
                      BorderBrush="{DynamicResource RavenBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="2"
                      Padding="14,8"
                      VerticalAlignment="Center">
                <controls:BiologyRewardBandControl Width="16"
                                                  Height="32"
                                                  MinimumReward="{Binding BiologyRewards.PreviewThreeBarReward}"
                                                  MaximumReward="{Binding BiologyRewards.PreviewThreeBarReward}"
                                                  BucketOneMillions="{Binding BiologyRewards.BucketOneMillions}"
                                                  BucketTwoMillions="{Binding BiologyRewards.BucketTwoMillions}"
                                                  BucketThreeMillions="{Binding BiologyRewards.BucketThreeMillions}"
                                                  FilledBrush="{DynamicResource RavenOverlayBioConfirmedBrush}"
                                                  PotentialBrush="{DynamicResource RavenOverlayBioPotentialBrush}"
                                                  EdgeBrush="{DynamicResource RavenOverlayBioConfirmedEdgeBrush}"
                                                  EmptyBrush="{DynamicResource RavenOverlayBioEmptyBrush}" />
              </Border>
              <TextBlock VerticalAlignment="Center" FontSize="16" Text="&lt;" />
              <NumericUpDown Width="100"
                             MinWidth="100"
                             Minimum="0"
                             Maximum="20"
                             Increment="0.5"
                             FormatString="0.##"
                             VerticalAlignment="Center"
                             Value="{Binding BiologyRewards.BucketThreeMillions, Mode=TwoWay}" />
              <TextBlock VerticalAlignment="Center" FontSize="16" Text="&gt;" />
              <Border Width="48" Height="48"
                      Background="#000000"
                      BorderBrush="{DynamicResource RavenBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="2"
                      Padding="14,8"
                      VerticalAlignment="Center">
                <controls:BiologyRewardBandControl Width="16"
                                                  Height="32"
                                                  MinimumReward="{Binding BiologyRewards.PreviewFourBarReward}"
                                                  MaximumReward="{Binding BiologyRewards.PreviewFourBarReward}"
                                                  BucketOneMillions="{Binding BiologyRewards.BucketOneMillions}"
                                                  BucketTwoMillions="{Binding BiologyRewards.BucketTwoMillions}"
                                                  BucketThreeMillions="{Binding BiologyRewards.BucketThreeMillions}"
                                                  FilledBrush="{DynamicResource RavenOverlayBioConfirmedBrush}"
                                                  PotentialBrush="{DynamicResource RavenOverlayBioPotentialBrush}"
                                                  EdgeBrush="{DynamicResource RavenOverlayBioConfirmedEdgeBrush}"
                                                  EmptyBrush="{DynamicResource RavenOverlayBioEmptyBrush}" />
              </Border>
            </StackPanel>
          </WrapPanel>
          <TextBlock Classes="muted"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Text="Illustrations show 1, 2, 3, then 4 filled bands for rewards above 0 CR and each threshold (defaults 3 / 7 / 12 M)." />
          <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                     IsVisible="{Binding BiologyRewards.HasStatusMessage}"
                     Text="{Binding BiologyRewards.StatusMessage}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Separator x:Name="BodyInformationSeparator" />

        <Grid x:Name="BodyInformationGrid" ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Spacing="12">
            <TextBlock Classes="eyebrow" Text="BODY INFORMATION" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowBodyInfo, Mode=TwoWay}"
                      Content="Show body information panel" />
            <CheckBox IsChecked="{Binding SystemSurvey.ShowBodyInfoInSystemMap, Mode=TwoWay}"
                      Content="In the System Map" />
            <StackPanel Margin="24,0,0,0" Spacing="6">
              <TextBlock Text="Extend Body Information Preview by:" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <NumericUpDown Width="150"
                               Minimum="0"
                               Maximum="600"
                               Increment="1"
                               FormatString="N0"
                               Value="{Binding SystemSurvey.BodyInformationPreviewExtensionSeconds, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="seconds" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="24,0,0,0" Spacing="6">
              <TextBlock Text="Extend Body Predictions preview by:" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <NumericUpDown Width="150"
                               Minimum="0"
                               Maximum="600"
                               Increment="1"
                               FormatString="N0"
                               Value="{Binding SystemSurvey.BodyPredictionPreviewExtensionSeconds, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="seconds" />
              </StackPanel>
            </StackPanel>
            <CheckBox IsChecked="{Binding SystemSurvey.ShowBodyInfoInOrbit, Mode=TwoWay}"
                      Content="In orbit around a body" />
            <CheckBox IsChecked="{Binding SystemSurvey.ShowBodyInfoAtSurface, Mode=TwoWay}"
                      Content="When at planet surface and not in Combat mode" />
            <CheckBox IsChecked="{Binding SystemSurvey.HideBodyInfoInBubble, Mode=TwoWay}"
                      Content="But keep it hidden when in the bubble near Sol" />
            <CheckBox IsChecked="{Binding SystemSurvey.HideBodyInfoMaterials, Mode=TwoWay}"
                      Content="Hide body materials" />
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Classes="eyebrow" Text="BODY THRESHOLDS" />
            <CheckBox IsChecked="{Binding SystemSurvey.AutoShowFlightWarnings, Mode=TwoWay}"
                      Content="Show flight warnings" />
            <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center"
                         Text="Sol bubble radius (ly, default 200)" />
              <NumericUpDown Grid.Column="1"
                             Minimum="0"
                             Maximum="10000"
                             Increment="10"
                             FormatString="N0"
                             Value="{Binding SystemSurvey.BodyInfoBubbleSizeLy, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center"
                         Text="When body gravity is above (g)" />
              <NumericUpDown Grid.Column="1"
                             Minimum="0"
                             Maximum="50"
                             Increment="0.1"
                             FormatString="N2"
                             Value="{Binding SystemSurvey.HighGravityWarningLevel, Mode=TwoWay}" />
            </Grid>
            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Alt+B toggles details for the current or selected body. With the bubble rule enabled, the panel stays hidden within the configured Sol radius (upstream default &lt;200 ly)." />
          </StackPanel>
        </Grid>

        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   IsVisible="{Binding SystemSurvey.HasSettingsStatus}"
                   TextWrapping="Wrap"
                   Text="{Binding SystemSurvey.SettingsStatus}" />
      </StackPanel>
    </Border>

    <Border x:Name="PanelVisibilityCard" Classes="card raised">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="card-title" Text="Panel availability and shortcuts" />
          <TextBlock Classes="muted"
                     TextWrapping="Wrap"
                     Text="These master switches control whether each panel may render. Existing auto-show and context settings still decide when an enabled panel appears. Shortcut fields are optional and have no default binding." />
        </StackPanel>
        <ItemsControl x:Name="PanelVisibilityItems">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OverlayPanelVisibilityEntryViewModel">
              <Grid Margin="0,4"
                    ColumnDefinitions="*,260"
                    ColumnSpacing="24">
                <StackPanel Spacing="3">
                  <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                            Content="{Binding DisplayName}" />
                  <TextBlock Margin="28,0,0,0"
                             Classes="muted"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Text="{Binding Description}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="muted"
                             FontSize="11"
                             Text="Optional visibility shortcut" />
                  <controls:ShortcutCaptureBox Chord="{Binding Shortcut.Chord, Mode=TwoWay}"
                                               PlaceholderText="Click, then hold shortcut keys"
                                               ToolTip.Tip="Hold a key combination, then release all keys to save. Esc cancels; Backspace or Delete clears." />
                  <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                             FontSize="10"
                             IsVisible="{Binding Shortcut.HasValidationError}"
                             Text="{Binding Shortcut.ValidationMessage}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Foreground="{DynamicResource RavenWarningBrush}"
                   IsVisible="{Binding OverlayPanelVisibility.HasPersistenceStatus}"
                   TextWrapping="Wrap"
                   Text="{Binding OverlayPanelVisibility.PersistenceStatus}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
