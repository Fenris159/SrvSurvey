<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:mining="using:SrvSurvey.Core.Mining" xmlns:journal="using:SrvSurvey.Core.Journal" xmlns:views="using:SrvSurvey.Desktop.Views" xmlns:controls="using:SrvSurvey.Desktop.Controls" xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors" Grid.IsSharedSizeScope="True" x:Class="SrvSurvey.Desktop.Views.MiningView" x:Name="MiningRoot" x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="TabItem.mining-workspace-tab">
      <Setter Property="Padding" Value="8,6"/>
    </Style>
  </UserControl.Styles>
  <Grid DataContext="{Binding MiningWorkspace}" x:DataType="vm:MiningWorkspaceViewModel" RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Spacing="6" Margin="0,0,0,16">
      <TextBlock Classes="eyebrow" Text="ACTIVITIES"/>
      <TextBlock Classes="page-title" Text="Mining"/>
      <TextBlock Classes="muted" Text="{Binding Context}"/>
    </StackPanel>
    <TabControl x:Name="MiningTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <controls:AdaptiveTabHeaderPanel/>
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>
      <TabItem Classes="mining-workspace-tab">
        <TabItem.Header>
          <TextBlock Text="Session"/>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="4,20,4,16">
            <Border Classes="card raised">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding SessionSummary}" TextWrapping="Wrap" Classes="card-title"/>
                <WrapPanel>
                  <Button Content="Start session" Command="{Binding StartCommand}" Margin="0,0,8,8"/>
                  <Button Content="Pause / resume" Command="{Binding PauseCommand}" Margin="0,0,8,8"/>
                  <Button Content="End session" Command="{Binding StopCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding CargoSummary}" TextWrapping="Wrap" Classes="card-title"/>
            <ScrollViewer x:Name="CargoHorizontalScroller"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              IsScrollChainingEnabled="True">
              <Grid RowDefinitions="Auto,*">
                <Grid x:Name="CargoHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cargo0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Cargo1" /></Grid.ColumnDefinitions>
              <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding CargoSortCommand}" CommandParameter="Name"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="CARGO" /><TextBlock Classes="table-heading" Text="{Binding CargoSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Name}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding CargoSortCommand}" CommandParameter="Count"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TONS" /><TextBlock Classes="table-heading" Text="{Binding CargoSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Count}" /></StackPanel></Button>
            </Grid>
                <ListBox Grid.Row="1" x:Name="CargoRows" Classes="table-rows" ItemsSource="{Binding Cargo}" MinHeight="60" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="journal:CargoItem">
                  <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Cargo0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Cargo1" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Count}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              </Grid>
            </ScrollViewer>
            <Expander Header="Refinery contents (manual)">
              <StackPanel Spacing="8">
                <TextBlock Text="The journal does not report refinery bins. Pending tons are manual estimates, separate from refined cargo and efficiency. Set zero to remove an estimate." TextWrapping="Wrap"/>
                <TextBlock Text="Mineral" TextWrapping="Wrap"/>
                <TextBox Text="{Binding RefineryMineral}"/>
                <NumericUpDown Minimum="0" Maximum="16" Increment="0.1" Value="{Binding RefineryTons}"/>
                <Button Content="Save refinery estimate" Click="Refinery_Click" Margin="0,0,8,8"/>
                <TextBlock Text="{Binding RefinerySummary}" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="Prospecting yields" TextWrapping="Wrap" Classes="card-title"/>
            <ScrollViewer x:Name="MaterialsHorizontalScroller"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              IsScrollChainingEnabled="True">
              <Grid RowDefinitions="Auto,*">
                <Grid x:Name="MaterialsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Materials0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials2" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials3" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials4" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials5" /></Grid.ColumnDefinitions>
              <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MaterialsSortCommand}" CommandParameter="Name"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="MINERAL" /><TextBlock Classes="table-heading" Text="{Binding MaterialsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Name}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MaterialsSortCommand}" CommandParameter="Finds"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="FINDS" /><TextBlock Classes="table-heading" Text="{Binding MaterialsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Finds}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MaterialsSortCommand}" CommandParameter="QualityHits"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="QUALITY HITS" /><TextBlock Classes="table-heading" Text="{Binding MaterialsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=QualityHits}" /></StackPanel></Button>
              <Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MaterialsSortCommand}" CommandParameter="Average"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="AVERAGE" /><TextBlock Classes="table-heading" Text="{Binding MaterialsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Average}" /></StackPanel></Button><Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MaterialsSortCommand}" CommandParameter="Best"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="BEST" /><TextBlock Classes="table-heading" Text="{Binding MaterialsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Best}" /></StackPanel></Button><Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MaterialsSortCommand}" CommandParameter="Tons"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TONS" /><TextBlock Classes="table-heading" Text="{Binding MaterialsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Tons}" /></StackPanel></Button>
            </Grid>
                <ListBox Grid.Row="1" x:Name="MaterialsRows" Classes="table-rows" ItemsSource="{Binding Materials}" MinHeight="60" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="mining:MiningMaterialSummary">
                  <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Materials0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials2" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials3" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials4" /><ColumnDefinition Width="Auto" SharedSizeGroup="Materials5" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Finds}"/><TextBlock Grid.Column="2" Text="{Binding QualityHits}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Average, StringFormat={}{0:0.0}%}"/><TextBlock Grid.Column="4" Text="{Binding Best, StringFormat={}{0:0.0}%}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Tons}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              </Grid>
            </ScrollViewer>
            <Expander Header="Compare mineral yields">
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding Materials}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mining:MiningMaterialSummary">
                      <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="12" Margin="0,8">
                        <TextBlock Text="{Binding Name}"/>
                        <ProgressBar Grid.Column="1" Maximum="100" Value="{Binding Average}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Average, StringFormat={}{0:0.0}%}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>
            <Expander Header="Manual count corrections">
              <StackPanel Spacing="8">
                <TextBlock Text="Correct totals without changing the original journal observations. Quality adjustments apply to the mineral entered below." TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="+1 asteroid" Command="{Binding AddAsteroidCommand}" Margin="0,0,8,8"/>
                  <Button Content="-1 asteroid" Command="{Binding RemoveAsteroidCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="Mineral" TextWrapping="Wrap"/>
                <TextBox Text="{Binding TargetMaterial}"/>
                <WrapPanel>
                  <Button Content="-1 quality hit" Click="AdjustQuality_Click" Tag="minus" Margin="0,0,8,8"/>
                  <Button Content="+1 quality hit" Click="AdjustQuality_Click" Margin="0,0,8,8"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            <Expander Header="Prospecting timeline">
              <StackPanel Spacing="8">
                <ScrollViewer x:Name="ProspectsHorizontalScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  IsScrollChainingEnabled="True">
                  <Grid RowDefinitions="Auto,*">
                    <Grid x:Name="ProspectsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Prospects0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Prospects1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Prospects2" /></Grid.ColumnDefinitions>
                  <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding ProspectsSortCommand}" CommandParameter="Time"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TIME" /><TextBlock Classes="table-heading" Text="{Binding ProspectsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Time}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding ProspectsSortCommand}" CommandParameter="MineralSummary"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="MINERALS" /><TextBlock Classes="table-heading" Text="{Binding ProspectsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=MineralSummary}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding ProspectsSortCommand}" CommandParameter="Core"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="CORE" /><TextBlock Classes="table-heading" Text="{Binding ProspectsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Core}" /></StackPanel></Button>
                </Grid>
                    <ListBox Grid.Row="1" x:Name="ProspectRows" Classes="table-rows" ItemsSource="{Binding Prospects}" MinHeight="60" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="mining:MiningProspect">
                      <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Prospects0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Prospects1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Prospects2" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}"/><TextBlock Grid.Column="1" Text="{Binding MineralSummary}" ToolTip.Tip="{Binding MineralSummary}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Core}" ToolTip.Tip="{Binding Core}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                  </Grid>
                </ScrollViewer>
              </StackPanel>
            </Expander>
            <Expander Header="Engineering materials collected">
              <StackPanel Spacing="8">
                <ScrollViewer x:Name="EngineeringMaterialsHorizontalScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  IsScrollChainingEnabled="True">
                  <Grid RowDefinitions="Auto,*">
                    <Grid x:Name="EngineeringMaterialsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="EngineeringMaterials0" /><ColumnDefinition Width="Auto" SharedSizeGroup="EngineeringMaterials1" /><ColumnDefinition Width="Auto" SharedSizeGroup="EngineeringMaterials2" /></Grid.ColumnDefinitions>
                  <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding EngineeringSortCommand}" CommandParameter="Name"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="MATERIAL" /><TextBlock Classes="table-heading" Text="{Binding EngineeringSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Name}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding EngineeringSortCommand}" CommandParameter="Grade"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="GRADE" /><TextBlock Classes="table-heading" Text="{Binding EngineeringSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Grade}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding EngineeringSortCommand}" CommandParameter="Count"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="COUNT" /><TextBlock Classes="table-heading" Text="{Binding EngineeringSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Count}" /></StackPanel></Button>
                </Grid>
                    <ListBox Grid.Row="1" x:Name="EngineeringMaterialRows" Classes="table-rows" ItemsSource="{Binding EngineeringMaterials}" MinHeight="60" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="mining:MiningCollectionEntry">
                      <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="EngineeringMaterials0" /><ColumnDefinition Width="Auto" SharedSizeGroup="EngineeringMaterials1" /><ColumnDefinition Width="Auto" SharedSizeGroup="EngineeringMaterials2" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Grade}"/><TextBlock Grid.Column="2" Text="{Binding Count}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                  </Grid>
                </ScrollViewer>
              </StackPanel>
            </Expander>
            <Expander Header="Recent notifications">
              <StackPanel Spacing="8">
                <ScrollViewer x:Name="NoticesHorizontalScroller"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  IsScrollChainingEnabled="True">
                  <Grid RowDefinitions="Auto,*">
                    <Grid x:Name="NoticesHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Notices0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Notices1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Notices2" /></Grid.ColumnDefinitions>
                  <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding NoticesSortCommand}" CommandParameter="Time"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TIME" /><TextBlock Classes="table-heading" Text="{Binding NoticesSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Time}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding NoticesSortCommand}" CommandParameter="Kind"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="KIND" /><TextBlock Classes="table-heading" Text="{Binding NoticesSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Kind}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding NoticesSortCommand}" CommandParameter="Text"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="NOTIFICATION" /><TextBlock Classes="table-heading" Text="{Binding NoticesSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Text}" /></StackPanel></Button>
                </Grid>
                    <ListBox Grid.Row="1" x:Name="NoticeRows" Classes="table-rows" ItemsSource="{Binding Notices}" MinHeight="60" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="mining:MiningNotice">
                      <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Notices0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Notices1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Notices2" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}"/><TextBlock Grid.Column="1" Text="{Binding Kind}"/><TextBlock Grid.Column="2" Text="{Binding Text}" ToolTip.Tip="{Binding Text}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                  </Grid>
                </ScrollViewer>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Classes="mining-workspace-tab">
        <TabItem.Header>
          <TextBlock Text="Reports"/>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="4,20,4,16">
            <TextBlock Text="{Binding HistorySummary}" TextWrapping="Wrap" Classes="card-title"/>
            <TextBlock Text="Select a completed session for notes, screenshots and exports. HTML reports work offline and can be printed or saved as PDF. Imported CSV summaries retain their original fields." TextWrapping="Wrap" Classes="muted"/>
            <WrapPanel>
              <Button Content="Import report CSV…" Click="ImportReports_Click" Margin="0,0,8,8"/>
              <Button Content="Delete selected" Click="DeleteReport_Click" Margin="0,0,8,8"/>
              <Button Content="Undo delete" Click="UndoReport_Click" Margin="0,0,8,8"/>
            </WrapPanel>
            <ScrollViewer x:Name="HistoryHorizontalScroller"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              IsScrollChainingEnabled="True">
              <Grid RowDefinitions="Auto,*">
                <Grid x:Name="HistoryHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="History0" /><ColumnDefinition Width="Auto" SharedSizeGroup="History1" /><ColumnDefinition Width="Auto" SharedSizeGroup="History2" /><ColumnDefinition Width="Auto" SharedSizeGroup="History3" /><ColumnDefinition Width="Auto" SharedSizeGroup="History4" /></Grid.ColumnDefinitions>
              <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding HistorySortCommand}" CommandParameter="Started"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="STARTED" /><TextBlock Classes="table-heading" Text="{Binding HistorySortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Started}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding HistorySortCommand}" CommandParameter="System"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="SYSTEM" /><TextBlock Classes="table-heading" Text="{Binding HistorySortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=System}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding HistorySortCommand}" CommandParameter="Ring"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="RING" /><TextBlock Classes="table-heading" Text="{Binding HistorySortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Ring}" /></StackPanel></Button>
              <Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding HistorySortCommand}" CommandParameter="RefinedTons"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TONS" /><TextBlock Classes="table-heading" Text="{Binding HistorySortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=RefinedTons}" /></StackPanel></Button><Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding HistorySortCommand}" CommandParameter="TonsPerHour"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TONS / HOUR" /><TextBlock Classes="table-heading" Text="{Binding HistorySortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=TonsPerHour}" /></StackPanel></Button>
            </Grid>
                <ListBox Grid.Row="1" x:Name="HistoryRows" Classes="table-rows" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedSession}" MinHeight="60" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Export HTML report…" Click="ExportReport_Click" Tag="html"/>
                  <MenuItem Header="Export CSV…" Click="ExportReport_Click" Tag="csv"/>
                  <MenuItem Header="Attach screenshots…" Click="AttachScreenshots_Click"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="mining:MiningSession">
                  <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="History0" /><ColumnDefinition Width="Auto" SharedSizeGroup="History1" /><ColumnDefinition Width="Auto" SharedSizeGroup="History2" /><ColumnDefinition Width="Auto" SharedSizeGroup="History3" /><ColumnDefinition Width="Auto" SharedSizeGroup="History4" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Started}"/><TextBlock Grid.Column="1" Text="{Binding System}" ToolTip.Tip="{Binding System}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Ring}" ToolTip.Tip="{Binding Ring}"/><TextBlock Grid.Column="3" Text="{Binding RefinedTons}"/>
                    <TextBlock Grid.Column="4" Text="{Binding TonsPerHour, StringFormat={}{0:0.0}}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              </Grid>
            </ScrollViewer>
            <Expander Header="Compare session efficiency">
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding History}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mining:MiningSession">
                      <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="12" Margin="0,8">
                        <TextBlock Text="{Binding System}"/>
                        <ProgressBar Grid.Column="1" Maximum="{Binding $parent[UserControl].DataContext.MiningWorkspace.MaximumHistoryRate}" Value="{Binding TonsPerHour}"/>
                        <TextBlock Grid.Column="2" Text="{Binding TonsPerHour, StringFormat={}{0:0.0} t/h}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>
            <ItemsControl ItemsSource="{Binding ReportScreenshots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="Open screenshot" Tag="{Binding}" Click="OpenScreenshot_Click"/>
                    <Button Grid.Column="2" Content="Remove" Tag="{Binding}" Click="RemoveScreenshot_Click"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Session notes" TextWrapping="Wrap"/>
            <TextBox Text="{Binding Notes}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/>
            <Button Content="Save notes" Command="{Binding SaveNotesCommand}" Margin="0,0,8,8"/>
            <WrapPanel>
              <Button Content="Export selected HTML…" Click="ExportReport_Click" Tag="html" Margin="0,0,8,8"/>
              <Button Content="Export selected CSV…" Click="ExportReport_Click" Tag="csv" Margin="0,0,8,8"/>
              <Button Content="Export all CSV…" Click="ExportReport_Click" Tag="allcsv" Margin="0,0,8,8"/>
              <Button Content="Export text…" Click="ExportReport_Click" Tag="txt" Margin="0,0,8,8"/>
              <Button Content="Compare / export all…" Click="ExportReport_Click" Tag="all" Margin="0,0,8,8"/>
              <Button Content="Attach screenshots…" Click="AttachScreenshots_Click" Margin="0,0,8,8"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Classes="mining-workspace-tab">
        <TabItem.Header>
          <TextBlock Text="Missions"/>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="4,20,4,16">
            <TextBlock Text="Mining missions" TextWrapping="Wrap" Classes="card-title"/>
            <TextBlock Text="Cargo is allocated to active missions in acceptance order. Delivered counts are cumulative. Completion, failure and abandonment follow journal events." TextWrapping="Wrap" Classes="muted"/>
            <ScrollViewer x:Name="MissionsHorizontalScroller"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              IsScrollChainingEnabled="True">
              <Grid RowDefinitions="Auto,*">
                <Grid x:Name="MissionsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Missions0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions2" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions3" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions4" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions5" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions6" /></Grid.ColumnDefinitions>
              <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MissionsSortCommand}" CommandParameter="Commodity"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="COMMODITY" /><TextBlock Classes="table-heading" Text="{Binding MissionsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Commodity}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MissionsSortCommand}" CommandParameter="Required"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="REQUIRED" /><TextBlock Classes="table-heading" Text="{Binding MissionsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Required}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MissionsSortCommand}" CommandParameter="Delivered"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="DELIVERED" /><TextBlock Classes="table-heading" Text="{Binding MissionsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Delivered}" /></StackPanel></Button><Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MissionsSortCommand}" CommandParameter="OnBoard"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="ON BOARD" /><TextBlock Classes="table-heading" Text="{Binding MissionsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=OnBoard}" /></StackPanel></Button>
              <Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MissionsSortCommand}" CommandParameter="Remaining"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="NEEDED" /><TextBlock Classes="table-heading" Text="{Binding MissionsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Remaining}" /></StackPanel></Button><Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MissionsSortCommand}" CommandParameter="Destination"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="DESTINATION" /><TextBlock Classes="table-heading" Text="{Binding MissionsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Destination}" /></StackPanel></Button><Button Grid.Column="6" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding MissionsSortCommand}" CommandParameter="Status"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="STATUS" /><TextBlock Classes="table-heading" Text="{Binding MissionsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Status}" /></StackPanel></Button>
            </Grid>
                <ListBox Grid.Row="1" x:Name="MissionRows" Classes="table-rows" ItemsSource="{Binding Missions}" SelectedItem="{Binding SelectedMission}" MinHeight="60" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Find hotspots for this commodity" Command="{Binding MissionHotspotsCommand}"/>
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="mining:MiningMission">
                  <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="Missions0" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions1" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions2" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions3" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions4" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions5" /><ColumnDefinition Width="Auto" SharedSizeGroup="Missions6" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Commodity}"/><TextBlock Grid.Column="1" Text="{Binding Required}"/><TextBlock Grid.Column="2" Text="{Binding Delivered}"/>
                    <TextBlock Grid.Column="3" Text="{Binding OnBoard}"/><TextBlock Grid.Column="4" Text="{Binding Remaining}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Destination}" ToolTip.Tip="{Binding Destination}"/><TextBlock Grid.Column="6" Text="{Binding Status}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
              </Grid>
            </ScrollViewer>
            <Button Content="Find hotspots" Command="{Binding MissionHotspotsCommand}" Margin="0,0,8,8"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Classes="mining-workspace-tab">
        <TabItem.Header>
          <TextBlock Text="Powerplay"/>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <views:MiningPowerplayView DataContext="{Binding}" Margin="4,12,4,16"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Classes="mining-workspace-tab">
        <TabItem.Header>
          <TextBlock Text="Find"/>
        </TabItem.Header>
        <Grid RowDefinitions="Auto,*" Margin="4,12,4,8">
          <WrapPanel>
            <Button Content="Search destinations" Click="SearchPane_Click" Margin="0,0,8,8"/>
            <Button Content="Local discoveries / import journals" Click="LocalPane_Click" Margin="0,0,8,8"/>
          </WrapPanel>
          <ScrollViewer x:Name="SearchPage" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <views:MiningSearchView x:Name="SearchPane" DataContext="{Binding Search}" Margin="0,0,12,16"/>
          </ScrollViewer>
          <Border x:Name="LocalPane" Grid.Row="1" IsVisible="False">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <StackPanel Spacing="8">
                <TextBlock Text="Local ring discoveries" TextWrapping="Wrap" Classes="card-title"/>
                <Button Content="Import earlier journals…" Click="ImportJournals_Click" Margin="0,0,8,8"/>
                <TextBlock Text="Scans add local rings and hotspots. Shared Mining bookmarks add your overlap, RES and rating notes." TextWrapping="Wrap" Classes="muted"/>
                <TextBlock Text="Filter local discoveries" TextWrapping="Wrap"/>
                <TextBox Text="{Binding Filter}"/>
              </StackPanel>
              <ScrollViewer x:Name="LocalRingsHorizontalScroller" Grid.Row="1" Grid.RowSpan="2"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                IsScrollChainingEnabled="True">
                <Grid RowDefinitions="Auto,*">
                  <Grid x:Name="LocalRingsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings0" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings1" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings2" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings3" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings4" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings5" /></Grid.ColumnDefinitions>
                <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding RingsSortCommand}" CommandParameter="System"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="SYSTEM" /><TextBlock Classes="table-heading" Text="{Binding RingsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=System}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding RingsSortCommand}" CommandParameter="Body"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="RING" /><TextBlock Classes="table-heading" Text="{Binding RingsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Body}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding RingsSortCommand}" CommandParameter="RingType"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TYPE" /><TextBlock Classes="table-heading" Text="{Binding RingsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=RingType}" /></StackPanel></Button><Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding RingsSortCommand}" CommandParameter="Reserve"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="RESERVE" /><TextBlock Classes="table-heading" Text="{Binding RingsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Reserve}" /></StackPanel></Button>
                <Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding RingsSortCommand}" CommandParameter="Minerals"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="HOTSPOTS" /><TextBlock Classes="table-heading" Text="{Binding RingsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Minerals}" /></StackPanel></Button><Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding RingsSortCommand}" CommandParameter="ArrivalLs"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="ARRIVAL" /><TextBlock Classes="table-heading" Text="{Binding RingsSortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=ArrivalLs}" /></StackPanel></Button>
              </Grid>
                  <ListBox x:Name="LocalRingRows" Grid.Row="1" Classes="table-rows" ItemsSource="{Binding Rings}" SelectedItem="{Binding SelectedRing}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Bookmark ring" Command="{Binding BookmarkRingCommand}"/>
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="mining:MiningRing">
                    <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings0" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings1" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings2" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings3" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings4" /><ColumnDefinition Width="Auto" SharedSizeGroup="LocalRings5" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding System}" ToolTip.Tip="{Binding System}"/><TextBlock Grid.Column="1" Text="{Binding Body}" ToolTip.Tip="{Binding Body}"/>
                      <TextBlock Grid.Column="2" Text="{Binding RingType}"/><TextBlock Grid.Column="3" Text="{Binding Reserve}"/>
                      <TextBlock Grid.Column="4" Text="{Binding Minerals}" ToolTip.Tip="{Binding Minerals}"/><TextBlock Grid.Column="5" Text="{Binding ArrivalLs, StringFormat='{}{0:N0} ls'}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
                </Grid>
              </ScrollViewer>
              <Button Grid.Row="3" Content="Bookmark selected ring" Command="{Binding BookmarkRingCommand}" Margin="0,8,8,8"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Classes="mining-workspace-tab">
        <TabItem.Header>
          <TextBlock Text="Bookmarks"/>
        </TabItem.Header>
        <views:BookmarksView DataContext="{Binding #MiningRoot.DataContext.Bookmarks}"/>
      </TabItem>
      <TabItem Classes="mining-workspace-tab">
        <TabItem.Header>
          <TextBlock Text="Reference"/>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="4,20,4,16">
            <TextBlock Text="Ring mining reference" TextWrapping="Wrap" Classes="card-title"/>
            <TextBlock Text="Mineral availability follows ring composition. Average sell prices are reference values and market prices vary, so check current observations before selling." TextWrapping="Wrap" Classes="muted"/>
            <ItemsControl x:Name="RingReferenceRows" ItemsSource="{Binding RingReferences}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MiningRingReferenceViewModel">
                  <Expander Header="{Binding Name}" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="8">
                      <StackPanel Spacing="4">
                        <Grid Classes="table-header" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Classes="table-heading" Text="LASER"/>
                          <TextBlock Grid.Column="1" Classes="table-heading" Text="AVG SELL"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Laser}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MiningReferenceCommodityRowViewModel">
                              <Grid Classes="table-row" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Classes="type-value" Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding AverageSellPriceLabel}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <Grid Classes="table-header" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Classes="table-heading" Text="CORE"/>
                          <TextBlock Grid.Column="1" Classes="table-heading" Text="AVG SELL"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Core}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MiningReferenceCommodityRowViewModel">
                              <Grid Classes="table-row" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Classes="type-value" Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding AverageSellPriceLabel}"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </Expander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="Resource Extraction Sites (RES)">
              <StackPanel Spacing="8">
                <TextBlock Text="Low, regular, High and Hazardous identify extraction sites with differing security presence and combat risk. Hazardous sites have no security response. Save RES categories in shared Mining bookmarks, then filter Hotspots with RES sites only. Multiple hotspots in a ring do not themselves prove an overlap." TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Classes="mining-workspace-tab">
        <TabItem.Header>
          <TextBlock Text="Settings"/>
        </TabItem.Header>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="4,20,4,16">
            <TabControl x:Name="MiningSettingsTabs">
              <TabItem Header="Session">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="14" Margin="4,20,4,16">
                    <CheckBox Content="Start a session when a prospector limpet launches" IsChecked="{Binding Settings.AutoStart}"/>
                    <CheckBox Content="Switch to Session on prospecting and Hotspots on completion" IsChecked="{Binding Settings.AutoSwitchTabs}"/>
                    <CheckBox Content="Refresh hotspot search after jumps and scans" IsChecked="{Binding Settings.AutoSearch}"/>
                    <CheckBox Content="Receive live community market and Powerplay observations from EDDN" IsChecked="{Binding Settings.ReceiveCommunityData}"/>
                    <TextBlock Text="EDDN reception opens a separate receive-only connection. Commodity observations expire after 24 hours; coverage grows while enabled." TextWrapping="Wrap" Classes="muted"/>
                    <TextBlock Text="{Binding CommunityStatus}" TextWrapping="Wrap"/>
                    <TextBlock Text="Save also remembers your search filters." TextWrapping="Wrap" Classes="muted"/>
                    <Button Content="Save mining settings" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,8"/>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Announcements">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="14" Margin="4,20,4,16">
                    <Border Classes="card raised">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="Announcement events"/>
                        <CheckBox Content="Core asteroid announcements" IsChecked="{Binding Settings.AnnounceCores}"/>
                        <CheckBox Content="Non-core asteroid announcements" IsChecked="{Binding Settings.AnnounceNonCores}"/>
                        <CheckBox Content="Prospecting results" IsChecked="{Binding Settings.NotifyProspecting}"/>
                        <CheckBox Content="Refined commodities" IsChecked="{Binding Settings.NotifyRefined}"/>
                        <CheckBox Content="Collected engineering materials" IsChecked="{Binding Settings.NotifyMaterials}"/>
                        <CheckBox Content="Cargo full reminder after one minute idle" IsChecked="{Binding Settings.NotifyCargoFull}"/>
                        <TextBlock Text="Persistent prospector results shown in the overlay"/>
                        <NumericUpDown x:Name="PersistentProspectSlotsInput" Minimum="1" Maximum="8" Value="{Binding Settings.PersistentProspectSlots}" FormatString="0" HorizontalAlignment="Left" Width="100"/>
                      </StackPanel>
                    </Border>
                    <Border Classes="card raised">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="Mineral thresholds"/>
                        <TextBlock Classes="muted" Text="Each row is an independent target. When thresholds are listed, the Mining Notifications overlay, chime, and speech ignore non-core prospects unless at least one listed mineral reaches its minimum. Enabled core asteroids still qualify. An empty list allows every enabled prospect." TextWrapping="Wrap"/>
                        <ListBox x:Name="ThresholdRows" ItemsSource="{Binding ThresholdGroups}" SelectedItem="{Binding SelectedThresholdGroup}" MinHeight="70" MaxHeight="210" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MiningThresholdGroupViewModel">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="8,5">
                                <TextBlock Text="{Binding Minerals}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Classes="type-value" Foreground="{DynamicResource RavenAccentBrush}" Text="{Binding MinimumLabel}"/>
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
                          <views:MiningChipBox DataContext="{Binding ThresholdMinerals}"/>
                          <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Minimum percentage"/><TextBox Text="{Binding ThresholdText}"/></StackPanel>
                        </Grid>
                        <WrapPanel>
                          <Button Content="Add threshold group" Click="AddThresholdGroup_Click" Margin="0,0,8,8"/>
                          <Button Content="Delete selected group" Click="DeleteThresholdGroup_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock Classes="muted" Text="{Binding ThresholdSummary}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                    <Border Classes="card raised">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="Announcement presets"/>
                        <TextBlock Classes="muted" Text="Save the complete threshold and asteroid-type configuration, then select a preset to apply, rename, or delete it." TextWrapping="Wrap"/>
                        <ListBox x:Name="AnnouncementPresetRows" ItemsSource="{Binding AnnouncementPresets}" SelectedItem="{Binding SelectedAnnouncementPreset}" MinHeight="70" MaxHeight="210" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MiningAnnouncementPresetRowViewModel">
                              <Grid ColumnDefinitions="160,*" ColumnSpacing="12" Margin="8,5">
                                <TextBlock Classes="type-value" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Preset name"/>
                        <TextBox Text="{Binding PresetName}"/>
                        <WrapPanel>
                          <Button Content="New preset" Click="NewPreset_Click" Margin="0,0,8,8"/>
                          <Button Content="Save preset" Click="SavePreset_Click" Margin="0,0,8,8"/>
                          <Button Content="Apply selected" Click="LoadPreset_Click" Margin="0,0,8,8"/>
                          <Button Content="Delete selected" Click="DeletePreset_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="card raised">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="card-title" Text="Audio announcements"/>
                        <CheckBox Content="Play a chime for qualifying prospects" IsChecked="{Binding Settings.PlayProspectChime}"/>
                        <TextBlock Text="Chime sound"/>
                        <ComboBox x:Name="ChimeSelector" ItemsSource="{Binding ChimeOptions}" SelectedItem="{Binding Settings.Chime}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="Chime volume"/>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Settings.ChimeVolume}"/>
                        <Button Content="Preview chime" Click="PreviewChime_Click" Margin="0,0,8,8" HorizontalAlignment="Left"/>
                        <CheckBox Content="Speak announcements using a local voice" IsChecked="{Binding Settings.SpeakAnnouncements}"/>
                        <Button Content="Refresh local voices" Click="LoadVoices_Click" Margin="0,0,8,8" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="LocalVoiceSelector" ItemsSource="{Binding Voices}" SelectedItem="{Binding Settings.Voice}" HorizontalAlignment="Stretch"/>
                        <TextBlock Classes="muted" Text="Windows uses installed SAPI voices. Linux uses Speech Dispatcher or eSpeak NG when available." TextWrapping="Wrap"/>
                        <TextBlock Text="Speech volume" TextWrapping="Wrap"/>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Settings.SpeechVolume}"/>
                        <TextBlock Text="Speech rate" TextWrapping="Wrap"/>
                        <Slider Minimum="-10" Maximum="10" Value="{Binding Settings.SpeechRate}"/>
                      </StackPanel>
                    </Border>
                    <Button Content="Save announcements" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,8"/>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Backup">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="14" Margin="4,20,4,16">
                    <TextBlock Text="Back up commander mining history, missions, settings, local discoveries, shared bookmarks and attached screenshots in one ZIP. Restore replaces mining data and shared bookmarks with the backup contents, retaining the previous files for recovery." TextWrapping="Wrap"/>
                    <WrapPanel>
                      <Button Content="Export backup…" Click="Backup_Click" Margin="0,0,8,8"/>
                      <Button Content="Restore backup…" Click="Restore_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Grid>
</UserControl>
