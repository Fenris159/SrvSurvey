<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:mining="using:SrvSurvey.Core.Mining" xmlns:search="using:SrvSurvey.Core.Search" xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors" xmlns:converters="using:Avalonia.Data.Converters" Grid.IsSharedSizeScope="True" x:Class="SrvSurvey.Desktop.Views.MiningSearchView" x:DataType="vm:MiningSearchViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto">
    <StackPanel Spacing="4" Margin="0,0,0,8">
      <TextBlock Text="Plan a mining trip" Classes="card-title"/>
      <TextBlock Text="{Binding PlanningContext}" IsVisible="{Binding HasPlan}" TextWrapping="Wrap" Classes="muted"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,120,Auto" ColumnSpacing="12" Margin="0,0,0,8">
      <StackPanel Spacing="4"><TextBlock Text="Reference system"/><TextBox Text="{Binding Reference}"/></StackPanel>
      <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Radius (ly)"/><NumericUpDown Minimum="1" Maximum="500" Value="{Binding Radius}"/></StackPanel>
      <Button Grid.Column="2" Content="Use current" Click="Current_Click" VerticalAlignment="Bottom"/>
    </Grid>
    <TabControl x:Name="SearchDestinations" Grid.Row="3" SelectedIndex="{Binding Destination}">
      <TabItem Header="Rings">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,12,0,0">
          <Border>
            <StackPanel Spacing="8">
              <WrapPanel>
                <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                  <TextBlock Text="Mineral (blank = any)" TextWrapping="Wrap"/>
                  <TextBox Text="{Binding Mineral}"/>
                </StackPanel>
                <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                  <TextBlock Text="Ring type" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding RingTypes}" SelectedItem="{Binding RingType}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                  <TextBlock Text="Source" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </WrapPanel>
              <Expander Header="Hotspot and annotation filters">
                <WrapPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Minimum hotspots" TextWrapping="Wrap"/>
                    <NumericUpDown Minimum="1" Maximum="20" Value="{Binding MinimumHotspots}"/>
                  </StackPanel>
                  <CheckBox Content="Overlaps only" IsChecked="{Binding OnlyOverlaps}" Margin="0,0,16,4"/>
                  <CheckBox Content="RES sites only" IsChecked="{Binding OnlyRes}" Margin="0,0,16,4"/>
                </WrapPanel>
              </Expander>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="RingResultsHorizontalScroller" Grid.Row="2" Grid.RowSpan="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            IsScrollChainingEnabled="True">
            <Grid RowDefinitions="Auto,*">
              <Grid x:Name="RingResultsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults0" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults1" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults2" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults3" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults4" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults5" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults6" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults7" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults8" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults9" /></Grid.ColumnDefinitions>
            <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="System"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="SYSTEM" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=System}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Body"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="RING" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Body}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Minerals"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="MINERALS" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Minerals}" /></StackPanel></Button>
            <Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="RingType"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TYPE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=RingType}" /></StackPanel></Button><Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Reserve"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="RESERVE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Reserve}" /></StackPanel></Button><Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Power"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="POWER" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Power}" /></StackPanel></Button>
            <Button Grid.Column="6" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Overlaps"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="OVERLAPS" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Overlaps}" /></StackPanel></Button><Button Grid.Column="7" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="ResourceExtractionSites"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="RES" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=ResourceExtractionSites}" /></StackPanel></Button><Button Grid.Column="8" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="DistanceLy"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="DISTANCE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=DistanceLy}" /></StackPanel></Button><Button Grid.Column="9" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="ArrivalLs"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="ARRIVAL" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=ArrivalLs}" /></StackPanel></Button>
          </Grid>
              <ListBox x:Name="RingResults" Grid.Row="1" Classes="table-rows" ItemsSource="{Binding Rings}" SelectedItem="{Binding SelectedRing}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.IsScrollChainingEnabled="True" Margin="0,0,0,10">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Bookmark ring" Click="Bookmark_Click"/>
                <MenuItem Header="Save ring locally" Click="Cache_Click"/>
                <MenuItem Header="Open system in Inara" Click="OpenSystem_Click" Tag="ring"/>
                <MenuItem Header="Open system in EDSM" Click="OpenSystem_Click" Tag="ring:edsm"/>
                <MenuItem Header="Open Spansh search" Click="OpenSystem_Click" Tag="ring:spansh"/>
                <MenuItem Header="Copy system" behaviors:ClipboardCopyBehavior.Text="{Binding SelectedRing.System}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="mining:MiningRing">
                <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults0" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults1" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults2" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults3" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults4" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults5" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults6" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults7" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults8" /><ColumnDefinition Width="Auto" SharedSizeGroup="RingResults9" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding System}" ToolTip.Tip="{Binding System}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Body}" ToolTip.Tip="{Binding Body}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Minerals}" ToolTip.Tip="{Binding Minerals}"/>
                  <TextBlock Grid.Column="3" Text="{Binding RingType}"/>
                  <TextBlock Grid.Column="4" Text="{Binding Reserve}"/>
                  <TextBlock Grid.Column="5" Text="{Binding Power}" ToolTip.Tip="{Binding Power}"/>
                  <TextBlock Grid.Column="6" Text="{Binding Overlaps}" ToolTip.Tip="{Binding Overlaps}"/>
                  <TextBlock Grid.Column="7" Text="{Binding ResourceExtractionSites}" ToolTip.Tip="{Binding ResourceExtractionSites}"/>
                  <TextBlock Grid.Column="8" Text="{Binding DistanceLy, StringFormat='{}{0:N1} ly'}"/>
                  <TextBlock Grid.Column="9" Text="{Binding ArrivalLs, StringFormat='{}{0:N0} ls'}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
            </Grid>
          </ScrollViewer>
          <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Content="Search rings" Click="SearchRings_Click" Margin="0,0,8,4"/>
            <Button Content="Bookmark ring" Click="Bookmark_Click" Margin="0,0,8,4"/>
            <Button Content="Save locally" Click="Cache_Click" Margin="0,0,8,4"/>
            <Button Content="Selling stations →" Click="SellingStations_Click" Margin="0,0,8,4"/>
          </WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Markets">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,12,0,0">
          <Border>
            <StackPanel Spacing="8">
              <WrapPanel>
                <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                  <TextBlock Text="Trade objective" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding TradeModes}" SelectedItem="{Binding TradeMode}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                  <TextBlock Text="Category" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding CommodityCategories}" SelectedItem="{Binding CommodityCategory}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                  <TextBlock Text="Commodity" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding CommodityOptions}" SelectedItem="{Binding Commodity}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </WrapPanel>
              <Expander Header="Commodity name, station and freshness filters">
                <WrapPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Any commodity name" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Commodity}"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Station type contains" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding StationType}"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Maximum age (days)" TextWrapping="Wrap"/>
                    <NumericUpDown Minimum="1" Maximum="30" Value="{Binding MaximumAgeDays}"/>
                  </StackPanel>
                  <CheckBox Content="Galaxy-wide" IsChecked="{Binding GalaxyWide}" Margin="0,0,16,4"/>
                  <CheckBox Content="Exclude carriers" IsChecked="{Binding ExcludeCarriers}" Margin="0,0,16,4"/>
                  <CheckBox Content="Large pads" IsChecked="{Binding LargePads}" Margin="0,0,16,4"/>
                </WrapPanel>
              </Expander>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="MarketResultsHorizontalScroller" Grid.Row="2" Grid.RowSpan="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            IsScrollChainingEnabled="True">
            <Grid RowDefinitions="Auto,*">
              <Grid x:Name="MarketResultsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults0" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults1" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults2" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults3" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults4" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults5" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults6" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults7" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults8" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults9" /></Grid.ColumnDefinitions>
            <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="System"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="SYSTEM" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=System}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Station"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="STATION" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Station}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Type"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TYPE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Type}" /></StackPanel></Button><Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="PadDescription"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="PAD" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=PadDescription}" /></StackPanel></Button>
            <Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Distance"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="DISTANCE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Distance}" /></StackPanel></Button><Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="ArrivalLs"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="ARRIVAL" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=ArrivalLs}" /></StackPanel></Button><Button Grid.Column="6" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Price"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="PRICE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Price}" /></StackPanel></Button><Button Grid.Column="7" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Demand"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="DEMAND" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Demand}" /></StackPanel></Button>
            <Button Grid.Column="8" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Supply"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="STOCK" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Supply}" /></StackPanel></Button><Button Grid.Column="9" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Updated"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="OBSERVED" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Updated}" /></StackPanel></Button>
          </Grid>
              <ListBox x:Name="MarketResults" Grid.Row="1" Classes="table-rows" ItemsSource="{Binding Markets}" SelectedItem="{Binding SelectedMarket}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.IsScrollChainingEnabled="True" Margin="0,0,0,10">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open system in Inara" Click="OpenSystem_Click" Tag="market"/>
                <MenuItem Header="Open system in EDSM" Click="OpenSystem_Click" Tag="market:edsm"/>
                <MenuItem Header="Open Spansh search" Click="OpenSystem_Click" Tag="market:spansh"/>
                <MenuItem Header="Copy system" behaviors:ClipboardCopyBehavior.Text="{Binding SelectedMarket.System}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="search:MiningMarketResult">
                <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults0" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults1" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults2" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults3" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults4" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults5" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults6" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults7" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults8" /><ColumnDefinition Width="Auto" SharedSizeGroup="MarketResults9" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding System}" ToolTip.Tip="{Binding System}"/><TextBlock Grid.Column="1" Text="{Binding Station}" ToolTip.Tip="{Binding Station}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Type}"/><TextBlock Grid.Column="3" Text="{Binding PadDescription}"/>
                  <TextBlock Grid.Column="4" Text="{Binding Distance, StringFormat='{}{0:N1} ly'}"/><TextBlock Grid.Column="5" Text="{Binding ArrivalLs, StringFormat='{}{0:N0} ls'}"/>
                  <TextBlock Grid.Column="6" Text="{Binding Price, StringFormat='{}{0:N0} CR/t'}"/><TextBlock Grid.Column="7" Text="{Binding Demand, StringFormat='{}{0:N0} t'}"/>
                  <TextBlock Grid.Column="8" Text="{Binding Supply, StringFormat='{}{0:N0} t'}"/><TextBlock Grid.Column="9" Text="{Binding Updated, StringFormat='{}{0:g}'}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
            </Grid>
          </ScrollViewer>
          <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Content="Find prices" Click="SearchMarkets_Click" Margin="0,0,8,4"/>
          </WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Traders">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,12,0,0">
          <Border>
            <StackPanel Spacing="8">
              <TextBlock Text="Exchange engineering materials at a trader. These are separate from the commodity market." TextWrapping="Wrap" Classes="muted"/>
              <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                <TextBlock Text="Material type" TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{Binding TraderTypes}" SelectedItem="{Binding TraderType}" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="TraderResultsHorizontalScroller" Grid.Row="2" Grid.RowSpan="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            IsScrollChainingEnabled="True">
            <Grid RowDefinitions="Auto,*">
              <Grid x:Name="TraderResultsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults0" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults1" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults2" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults3" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults4" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults5" /></Grid.ColumnDefinitions>
            <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="System"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="SYSTEM" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=System}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Station"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="STATION" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Station}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Type"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="TYPE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Type}" /></StackPanel></Button><Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="PadDescription"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="PAD" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=PadDescription}" /></StackPanel></Button>
            <Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Distance"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="DISTANCE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Distance}" /></StackPanel></Button><Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="ArrivalLs"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="ARRIVAL" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=ArrivalLs}" /></StackPanel></Button>
          </Grid>
              <ListBox x:Name="TraderResults" Grid.Row="1" Classes="table-rows" ItemsSource="{Binding Traders}" SelectedItem="{Binding SelectedTrader}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.IsScrollChainingEnabled="True" Margin="0,0,0,10">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open system in Inara" Click="OpenSystem_Click" Tag="trader"/>
                <MenuItem Header="Open system in EDSM" Click="OpenSystem_Click" Tag="trader:edsm"/>
                <MenuItem Header="Open Spansh search" Click="OpenSystem_Click" Tag="trader:spansh"/>
                <MenuItem Header="Copy system" behaviors:ClipboardCopyBehavior.Text="{Binding SelectedTrader.System}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="search:MiningMarketResult">
                <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults0" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults1" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults2" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults3" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults4" /><ColumnDefinition Width="Auto" SharedSizeGroup="TraderResults5" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding System}" ToolTip.Tip="{Binding System}"/><TextBlock Grid.Column="1" Text="{Binding Station}" ToolTip.Tip="{Binding Station}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Type}"/><TextBlock Grid.Column="3" Text="{Binding PadDescription}"/>
                  <TextBlock Grid.Column="4" Text="{Binding Distance, StringFormat='{}{0:N1} ly'}"/><TextBlock Grid.Column="5" Text="{Binding ArrivalLs, StringFormat='{}{0:N0} ls'}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
            </Grid>
          </ScrollViewer>
          <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Content="Find material traders" Click="SearchTraders_Click" Margin="0,0,8,4"/>
          </WrapPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Powerplay">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,12,0,0">
          <Border>
            <StackPanel Spacing="8">
              <WrapPanel>
                <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                  <TextBlock Text="Objective" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding Objectives}" SelectedItem="{Binding Objective}" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                  <TextBlock Text="Your pledged Power" TextWrapping="Wrap"/>
                  <ComboBox ItemsSource="{Binding Powers}" SelectedItem="{Binding PledgedPower}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="Choose an objective and Power, find a system, then find its rings. Use selling stations from a ring to complete the plan. Acquisition candidates still need support-range checks in the game; prices are not merit estimates." TextWrapping="Wrap" Classes="muted"/>
              <Expander Header="System filters">
                <WrapPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Security" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Security}"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Allegiance" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Allegiance}"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Government" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Government}"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Economy" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Economy}"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Faction state" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding State}"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Controlling Power" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding Powers}" SelectedItem="{Binding Power}" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Power state" TextWrapping="Wrap"/>
                    <ComboBox ItemsSource="{Binding PowerStates}" SelectedItem="{Binding PowerState}" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                  <StackPanel Spacing="4" Width="190" Margin="0,0,12,10">
                    <TextBlock Text="Minimum population" TextWrapping="Wrap"/>
                    <NumericUpDown Minimum="0" Maximum="1000000000000" Value="{Binding MinimumPopulation}"/>
                  </StackPanel>
                </WrapPanel>
              </Expander>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="SystemResultsHorizontalScroller" Grid.Row="2" Grid.RowSpan="2"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            IsScrollChainingEnabled="True">
            <Grid RowDefinitions="Auto,*">
              <Grid x:Name="SystemResultsHeader" Classes="table-header" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults0" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults1" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults2" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults3" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults4" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults5" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults6" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults7" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults8" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults9" /></Grid.ColumnDefinitions>
            <Button Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="System"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="SYSTEM" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=System}" /></StackPanel></Button><Button Grid.Column="1" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Power"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="POWER" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Power}" /></StackPanel></Button><Button Grid.Column="2" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="PowerState"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="POWER STATE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=PowerState}" /></StackPanel></Button><Button Grid.Column="3" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Security"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="SECURITY" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Security}" /></StackPanel></Button>
            <Button Grid.Column="4" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Economy"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="ECONOMY" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Economy}" /></StackPanel></Button><Button Grid.Column="5" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Government"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="GOVERNMENT" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Government}" /></StackPanel></Button><Button Grid.Column="6" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Allegiance"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="ALLEGIANCE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Allegiance}" /></StackPanel></Button>
            <Button Grid.Column="7" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="State"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="FACTION STATE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=State}" /></StackPanel></Button><Button Grid.Column="8" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Population"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="POPULATION" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Population}" /></StackPanel></Button><Button Grid.Column="9" Classes="link" Padding="0" HorizontalContentAlignment="Left" Command="{Binding SortCommand}" CommandParameter="Distance"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="table-heading" Text="DISTANCE" /><TextBlock Classes="table-heading" Text="{Binding SortIndicators, Converter={x:Static vm:WorkspaceSortIndicatorConverter.Instance}, ConverterParameter=Distance}" /></StackPanel></Button>
          </Grid>
              <ListBox x:Name="SystemResults" Grid.Row="1" Classes="table-rows" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.IsScrollChainingEnabled="True" Margin="0,0,0,10">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Use for hotspot search" Click="UseSystem_Click"/>
                <MenuItem Header="Open system in Inara" Click="OpenSystem_Click" Tag="system"/>
                <MenuItem Header="Copy system" behaviors:ClipboardCopyBehavior.Text="{Binding SelectedSystem.System}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="search:MiningSystemResult">
                <Grid Classes="table-row" RowDefinitions="Auto" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults0" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults1" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults2" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults3" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults4" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults5" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults6" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults7" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults8" /><ColumnDefinition Width="Auto" SharedSizeGroup="SystemResults9" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding System}" ToolTip.Tip="{Binding System}"/><TextBlock Grid.Column="1" Text="{Binding Power}"/>
                  <TextBlock Grid.Column="2" Text="{Binding PowerState}"/><TextBlock Grid.Column="3" Text="{Binding Security}"/>
                  <TextBlock Grid.Column="4" Text="{Binding Economy}"/><TextBlock Grid.Column="5" Text="{Binding Government}"/>
                  <TextBlock Grid.Column="6" Text="{Binding Allegiance}"/><TextBlock Grid.Column="7" Text="{Binding State}"/>
                  <TextBlock Grid.Column="8" Text="{Binding Population, StringFormat='{}{0:N0}'}"/><TextBlock Grid.Column="9" Text="{Binding Distance, StringFormat='{}{0:N1} ly'}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
            </Grid>
          </ScrollViewer>
          <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Content="Find systems" Click="SearchSystems_Click" Margin="0,0,8,4"/>
            <Button Content="Find rings in selected system →" Click="UseSystem_Click" Margin="0,0,8,4"/>
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
      <WrapPanel Grid.ColumnSpan="2" Margin="0,0,0,6">
        <Button Content="Clear Powerplay plan" IsVisible="{Binding HasPlan}" Click="ClearPlan_Click" Margin="0,0,8,0"/>
        <CheckBox Content="Only this system (rings / markets)" IsChecked="{Binding SystemOnly}" Margin="0,0,12,0"/>
        <TextBlock Text="Provider page (0 first)" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <NumericUpDown Minimum="0" Maximum="99" Value="{Binding Page}" Width="110"/>
      </WrapPanel>
      <Button Grid.Row="1" Content="Cancel search" Click="Cancel_Click" IsVisible="{Binding IsBusy}"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</UserControl>
