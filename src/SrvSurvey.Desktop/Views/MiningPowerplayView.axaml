<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SrvSurvey.Desktop.ViewModels" xmlns:mining="using:SrvSurvey.Core.Mining" xmlns:search="using:SrvSurvey.Core.Search" xmlns:behaviors="using:SrvSurvey.Desktop.Behaviors" xmlns:controls="using:SrvSurvey.Desktop.Controls" xmlns:views="using:SrvSurvey.Desktop.Views" x:Class="SrvSurvey.Desktop.Views.MiningPowerplayView" x:DataType="vm:MiningWorkspaceViewModel" Grid.IsSharedSizeScope="True">
  <UserControl.Styles>
    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Border.highlight">
      <Setter Property="Background" Value="{DynamicResource RavenAccentBrush}"/>
    </Style>
    <Style Selector="Border.highlight TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RavenAccentForegroundBrush}"/>
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="16" Margin="4,12,4,16">
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Reference system" VerticalAlignment="Center"/>
          <TextBlock Text="Force Include if viable:" VerticalAlignment="Center"/>
          <ToggleSwitch IsChecked="{Binding Search.ForceIncludeReference}" OnContent="" OffContent="" VerticalAlignment="Center"/>
        </StackPanel>
        <controls:SystemNameEntry x:Name="PowerplayReference" Text="{Binding Search.Reference, Mode=TwoWay}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Text="Distance"/>
        <TextBlock Text="{Binding Search.DistanceWarning}" IsVisible="{Binding Search.HasDistanceWarning}" TextWrapping="Wrap" Classes="muted"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Slider x:Name="PowerplayDistanceSlider" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding Search.CanChooseDistance}" Value="{Binding Search.Radius}"/>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" MinWidth="52" Text="{Binding Search.Radius, StringFormat={}{0:0} ly}"/>
        </Grid>
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Text="Search results"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Slider x:Name="PowerplayResultsSlider" Minimum="1" Maximum="{Binding Search.MaximumResultLimit}" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Search.ResultLimit}"/>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" MinWidth="28" Text="{Binding Search.ResultLimit, StringFormat={}{0:0}}"/>
        </Grid>
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock Text="Your Power"/>
        <ComboBox x:Name="PowerplayPledgedPower" HorizontalAlignment="Stretch" ItemsSource="{Binding Search.Powers}" SelectedItem="{Binding Search.PledgedPower}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
        <TextBlock Text="Power goal"/>
        <ComboBox x:Name="PowerplayGoal" HorizontalAlignment="Stretch" IsEnabled="{Binding Search.CanChoosePowerGoal}" ItemsSource="{Binding Search.PowerplayObjectives}" SelectedItem="{Binding Search.Objective}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
        <TextBlock Text="Opposing Power"/>
        <ComboBox x:Name="PowerplayOpposingPower" HorizontalAlignment="Stretch" IsEnabled="{Binding Search.CanChoosePowerGoal}" ItemsSource="{Binding Search.OpposingChoices}" SelectedItem="{Binding Search.OpposingPower}"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="4">
        <TextBlock Text="Mineral / metal"/>
        <views:MiningChipBox DataContext="{Binding Search.PrimaryMineralChips}" MinWidth="0" Margin="0" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" IsVisible="{Binding Search.UsesRingFilters}">
        <TextBlock Text="Ring type"/>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Search.RingTypes}" SelectedItem="{Binding Search.RingType}" IsEnabled="{Binding Search.UsesRingFilters}"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4" IsVisible="{Binding Search.UsesRingFilters}">
        <TextBlock Text="Reserve level"/>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Search.Reserves}" SelectedItem="{Binding Search.Reserve}"/>
      </StackPanel>
      <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Max age" VerticalAlignment="Center"/>
        <ToggleSwitch IsChecked="{Binding Search.LimitMarketAge}" OnContent="" OffContent="" MinWidth="44" VerticalAlignment="Center"/>
        <controls:RestoringNumberBox Number="{Binding Search.MarketAge}" Minimum="1" Maximum="9999" Width="88" MinHeight="32" VerticalAlignment="Center"/>
        <ComboBox Width="120" VerticalAlignment="Center" ItemsSource="{Binding Search.MarketAgeUnits}" SelectedItem="{Binding Search.MarketAgeUnit}"/>
      </StackPanel>
      <StackPanel Grid.Row="4" Spacing="4">
        <TextBlock Text="Mining type"/>
        <views:MiningChipBox DataContext="{Binding Search.MiningTypeChips}" MinWidth="0" Margin="0" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
        <TextBlock Text="Min. demand"/>
        <controls:RestoringNumberBox Number="{Binding Search.MinimumDemand}" Minimum="0" Maximum="1000000000" MinHeight="32" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <StackPanel Grid.Row="4" Grid.Column="2" Spacing="4">
        <TextBlock Text="Landing pad"/>
        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Search.PadSizes}" SelectedItem="{Binding Search.PadSize}"/>
      </StackPanel>
      <StackPanel Grid.Row="5" Spacing="4">
        <TextBlock Text="Add mineral/metal"/>
        <views:MiningChipBox DataContext="{Binding Search.MineralChips}" MinWidth="0" Margin="0" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4">
        <TextBlock Text="Max. demand"/>
        <controls:RestoringNumberBox Number="{Binding Search.MaximumDemand}" Minimum="0" Maximum="1000000000" MinHeight="32" HorizontalAlignment="Stretch"/>
      </StackPanel>
      <StackPanel Grid.Row="5" Grid.Column="2" Spacing="4">
        <TextBlock Text="System state"/>
        <views:MiningChipBox DataContext="{Binding Search.StateChips}" MinWidth="0" Margin="0" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Search" Click="SearchSystems_Click"/>
      <Button Content="Reset" Click="Reset_Click"/>
      <TextBlock Text="Hide Irrelevant Material Tags:" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding Search.IsPlanetaryMining}"/>
      <ToggleSwitch IsChecked="{Binding Search.PlanetarySearch.HideIrrelevantMaterialTags}" OnContent="" OffContent="" VerticalAlignment="Center" IsVisible="{Binding Search.IsPlanetaryMining}"/>
      <Button Content="Cancel" Click="Cancel_Click" IsVisible="{Binding Search.IsBusy}"/>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding Search.UsesRingFilters}">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="Planet" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="New ring"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="RingIcy" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Icy"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="RingRocky" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Rocky"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="RingMetallic" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Metallic"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="RingMetalRich" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Metal-rich"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="ReservePristine" Width="14" Height="13" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Pristine"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="ReserveMajor" Width="14" Height="13" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Major"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="ReserveCommon" Width="14" Height="13" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Common"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="ReserveLow" Width="14" Height="13" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Low"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="ReserveDepleted" Width="14" Height="13" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Depleted"/></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4"><views:MiningIcon Kind="Hotspot" Width="12" Height="12" VerticalAlignment="Center"/><TextBlock Classes="muted" VerticalAlignment="Center" Text="Hotspot"/></StackPanel>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Text="{Binding Search.Status}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Search.ShowSearchStatus}"/>

    <ScrollViewer x:Name="ResultsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ResultsTable" MinWidth="1280">
          <Grid IsVisible="{Binding Search.IsPlanetaryAcquire}">
            <views:PowerplayPlanetaryAcquireResults DataContext="{Binding Search.PlanetarySearch}"/>
          </Grid>
          <Grid IsVisible="{Binding Search.IsPlanetaryCombined}">
            <views:PowerplayPlanetaryCombinedResults DataContext="{Binding Search.PlanetarySearch}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Search.RingAcquireClusters}" IsVisible="{Binding Search.HasAcquireRows}" HorizontalAlignment="Stretch">
            <ItemsControl.Styles><Style Selector="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style></ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PowerplayRingAcquireClusterViewModel">
                <views:PowerplayRingAcquireSharedCluster/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid IsVisible="{Binding Search.HasMeritRows}" ColumnDefinitions="12*,6*,22*,42*,8*,10*" Margin="0,8,0,0">
            <Border Background="{DynamicResource RavenRaisedSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="1" Padding="6,4"><TextBlock Text="System" Foreground="{DynamicResource RavenAccentBrush}"/></Border>
            <Border Grid.Column="1" Background="{DynamicResource RavenRaisedSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,1,1,1" Padding="6,4">
              <Button Classes="link" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding Search.DistanceSortCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="DST" Foreground="{DynamicResource RavenAccentBrush}"/>
                  <TextBlock Text="{Binding Search.DistanceSortIndicator}" Foreground="{DynamicResource RavenAccentBrush}"/>
                </StackPanel>
              </Button>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource RavenRaisedSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,1,1,1" Padding="6,4"><TextBlock Text="Ring Details" Foreground="{DynamicResource RavenAccentBrush}"/></Border>
            <Border Grid.Column="3" Background="{DynamicResource RavenRaisedSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,1,1,1" Padding="6,4"><TextBlock Text="Stations" Foreground="{DynamicResource RavenAccentBrush}"/></Border>
            <Border Grid.Column="4" Background="{DynamicResource RavenRaisedSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,1,1,1" Padding="6,4"><TextBlock Text="State" Foreground="{DynamicResource RavenAccentBrush}" HorizontalAlignment="Center"/></Border>
            <Border Grid.Column="5" Background="{DynamicResource RavenRaisedSurfaceBrush}" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,1,1,1" Padding="6,4"><TextBlock Text="Power" Foreground="{DynamicResource RavenAccentBrush}"/></Border>
          </Grid>
          <ItemsControl x:Name="PowerplayResults" ItemsSource="{Binding Search.MeritRows}" IsVisible="{Binding Search.HasMeritRows}" HorizontalAlignment="Stretch">
            <ItemsControl.Styles>
              <Style Selector="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MeritSystemRowViewModel">
                <Grid ColumnDefinitions="12*,6*,22*,42*,8*,10*" Background="{DynamicResource RavenSurfaceBrush}">
                  <Border BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="1,0,1,1" Padding="6">
                    <Button Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center" behaviors:ClipboardCopyBehavior.Text="{Binding Name}">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                    </Button>
                  </Border>
                  <Border Grid.Column="1" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,0,1,1" Padding="6">
                    <TextBlock Text="{Binding Distance}" Foreground="{DynamicResource RavenAccentBrush}" VerticalAlignment="Center"/>
                  </Border>
                  <Border Grid.Column="2" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,0,1,1" Padding="6">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MeritLineViewModel">
                          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                            <views:MiningIcon Kind="{Binding Icon}" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding ShowPlanet}"/>
                            <Border Width="14" IsVisible="{Binding ShowSpacer}"/>
                            <TextBlock Text="{Binding RingName}" TextWrapping="Wrap" Foreground="{DynamicResource RavenTextBrush}" VerticalAlignment="Center" IsVisible="{Binding ShowMineral}"/>
                            <views:MiningIcon Kind="{Binding RingTypeIcon}" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding ShowRingType}"/>
                            <views:MiningIcon Kind="{Binding ReserveIcon}" Width="14" Height="13" VerticalAlignment="Center" IsVisible="{Binding ShowReserve}"/>
                            <views:MiningIcon Kind="Hotspot" Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding ShowMineral}"/>
                            <TextBlock Text="{Binding Mineral}" TextWrapping="Wrap" Foreground="{DynamicResource RavenTextBrush}" VerticalAlignment="Center" IsVisible="{Binding ShowMineral}"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource RavenTextBrush}" VerticalAlignment="Center" IsVisible="{Binding ShowPlainText}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding SignalToggleLabel}" Command="{Binding ToggleSignalsCommand}" IsVisible="{Binding CanToggleSignals}" Margin="0,6,0,0" Padding="6,2" HorizontalAlignment="Left"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="3" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,0,1,1" Padding="6" ClipToBounds="True">
                    <StackPanel>
                    <ItemsControl ItemsSource="{Binding StationBlocks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MeritStationBlockViewModel">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,2,0,8">
                            <StackPanel Spacing="2" MaxWidth="280">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <views:MiningIcon Kind="{Binding Icon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource RavenTextBrush}" TextWrapping="Wrap"/>
                              </StackPanel>
                              <TextBlock Text="{Binding Commodity}" Foreground="{DynamicResource RavenAccentBrush}"/>
                              <TextBlock Text="{Binding Price}" Foreground="{DynamicResource RavenAccentBrush}"/>
                              <TextBlock Text="{Binding Demand}" Foreground="{DynamicResource RavenTextBrush}"/>
                              <TextBlock Text="{Binding Arrival}" Foreground="{DynamicResource RavenMutedTextBrush}"/>
                              <TextBlock Text="{Binding Updated}" Foreground="{DynamicResource RavenMutedTextBrush}" FontStyle="Italic"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Other Commodities:" Foreground="{DynamicResource RavenTextBrush}" VerticalAlignment="Center"/>
                                <Button Classes="link" Content="{Binding CommodityToggleLabel}" Command="{Binding ToggleCommoditiesCommand}" IsVisible="{Binding CanToggleCommodities}" Padding="2,0"/>
                              </StackPanel>
                              <ItemsControl ItemsSource="{Binding OtherCommodities}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:MeritCommodityLineViewModel">
                                    <Grid ColumnDefinitions="40,*" Margin="0,1">
                                      <Border Classes="commodity-code material" Width="40" Height="20" Padding="0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Code}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                      </Border>
                                      <TextBlock Grid.Column="1" Margin="6,0,0,0" Foreground="{DynamicResource RavenTextBrush}" TextWrapping="Wrap">
                                        <Run Text="{Binding Price}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Demand}"/>
                                      </TextBlock>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{Binding StationToggleLabel}" Command="{Binding ToggleStationsCommand}" IsVisible="{Binding CanToggleStations}" Margin="0,6,0,0" Padding="6,2" HorizontalAlignment="Left"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="4" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,0,1,1" Padding="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <views:MiningIcon Kind="{Binding StateIcon}" Accent="{Binding Power}" Width="14" Height="14"/>
                      <StackPanel>
                        <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource RavenMutedTextBrush}"/>
                        <TextBlock Text="{Binding FactionState}" Foreground="{DynamicResource RavenTextBrush}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="5" BorderBrush="{DynamicResource RavenBorderBrush}" BorderThickness="0,0,1,1" Padding="6">
                    <ItemsControl ItemsSource="{Binding PowerLines}" VerticalAlignment="Center"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PowerplayPowerLineViewModel"><TextBlock Text="{Binding Display}" Foreground="{Binding ColorHex}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </StackPanel>
</UserControl>
