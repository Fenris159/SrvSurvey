<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SrvSurvey.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LuaCSharp" Version="0.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\SrvSurvey\EliteDangerousRegionMap\RegionMapData.cs"
             Link="Navigation\RegionMapData.cs" />
    <EmbeddedResource Include="..\..\docs\codexRef.json"
                      LogicalName="SrvSurvey.Core.Resources.codexRef.json" />
    <EmbeddedResource Include="..\..\docs\nebulae.json"
                      LogicalName="SrvSurvey.Core.Resources.nebulae.json" />
    <EmbeddedResource Include="..\..\SrvSurvey\allRuins.json"
                      LogicalName="SrvSurvey.Core.Resources.allRuins.json" />
    <EmbeddedResource Include="..\..\SrvSurvey\allStructures.json"
                      LogicalName="SrvSurvey.Core.Resources.allStructures.json" />
    <EmbeddedResource Include="..\..\SrvSurvey\allBeacons.json"
                      LogicalName="SrvSurvey.Core.Resources.allBeacons.json" />
    <EmbeddedResource Include="..\..\SrvSurvey\guardianSiteTemplates.json"
                      LogicalName="SrvSurvey.Core.Resources.guardianSiteTemplates.json" />
    <EmbeddedResource Include="..\..\SrvSurvey\settlements\humanSiteTemplates.json"
                      LogicalName="SrvSurvey.Core.Resources.humanSiteTemplates.json" />
    <EmbeddedResource Include="..\..\data\guardian.zip"
                      LogicalName="SrvSurvey.Core.Resources.guardian.zip" />
    <EmbeddedResource Include="..\..\SrvSurvey\colonization-costs2.json"
                      LogicalName="SrvSurvey.Core.Resources.colonization-costs2.json" />
    <EmbeddedResource Include="..\..\SrvSurvey\ggg.json"
                      LogicalName="SrvSurvey.Core.Resources.ggg.json" />
    <EmbeddedResource Include="..\..\SrvSurvey\bio-criteria\*.json"
                      LogicalName="SrvSurvey.Core.Resources.bio-criteria.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
