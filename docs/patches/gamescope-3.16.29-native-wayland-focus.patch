--- /dev/null
+++ b/src/Backends/HostFocusPublisher.h
@@ -0,0 +1,151 @@
+#pragma once
+
+// Optional native Wayland backend publisher. The public geometry marker stays
+// unchanged; consumers validate this file against the live PID's start ticks.
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+class HostFocusPublisher
+{
+public:
+    HostFocusPublisher()
+    {
+        std::ifstream statFile( "/proc/self/stat" );
+        std::string stat;
+        std::getline( statFile, stat );
+        const auto end = stat.rfind( ')' );
+        if ( end == std::string::npos )
+            return;
+        std::istringstream fields( stat.substr( end + 1 ) );
+        std::string fieldValue;
+        for ( int field = 3; field <= 22; ++field )
+            if ( !( fields >> fieldValue ) )
+                return;
+        m_startTicks = fieldValue;
+        if ( m_startTicks.empty() || m_startTicks.find_first_not_of( "0123456789" ) != std::string::npos )
+        {
+            m_startTicks.clear();
+            return;
+        }
+
+        const char *runtime = std::getenv( "XDG_RUNTIME_DIR" );
+        if ( runtime && runtime[0] == '/' )
+        {
+            m_runtimeFd = open( runtime, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW );
+            struct stat info;
+            if ( m_runtimeFd >= 0 && ( fstat( m_runtimeFd, &info ) != 0 ||
+                 info.st_uid != getuid() || ( info.st_mode & 0077 ) != 0 ) )
+            {
+                close( m_runtimeFd );
+                m_runtimeFd = -1;
+            }
+        }
+        m_name = "GamescopeGameWindowFocus." + std::to_string( getpid() );
+        const char *legacy = std::getenv( "GAMESCOPE_HOST_FOCUS_FILE" );
+        if ( !legacy || !legacy[0] )
+            legacy = std::getenv( "ELITE_HOST_FOCUS_FILE" );
+        if ( legacy && legacy[0] == '/' )
+            m_legacyPath = legacy;
+    }
+
+    ~HostFocusPublisher()
+    {
+        Publish( false );
+        if ( m_runtimeFd >= 0 )
+        {
+            unlinkat( m_runtimeFd, m_name.c_str(), 0 );
+            close( m_runtimeFd );
+        }
+    }
+
+    bool Publish( bool focused )
+    {
+        const bool hasRuntime = m_runtimeFd >= 0 && !m_startTicks.empty();
+        bool okay = false;
+        if ( hasRuntime )
+        {
+            const std::string temp = m_name + ".tmp." + std::to_string( ++m_sequence );
+            const std::string data = m_startTicks + ( focused ? "\n1\n" : "\n0\n" );
+            const int fd = openat( m_runtimeFd, temp.c_str(),
+                O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600 );
+            okay = fd >= 0 && WriteAll( fd, data.data(), data.size() );
+            if ( fd >= 0 && close( fd ) != 0 )
+                okay = false;
+            if ( okay )
+                okay = renameat( m_runtimeFd, temp.c_str(), m_runtimeFd, m_name.c_str() ) == 0;
+            if ( !okay )
+            {
+                // Keep the capability visible to new consumers after a failure.
+                // In-place fallback also works when atomic replacement cannot.
+                PreserveUnfocused();
+                unlinkat( m_runtimeFd, temp.c_str(), 0 );
+            }
+        }
+        if ( !m_legacyPath.empty() )
+        {
+            const int fd = open( m_legacyPath.c_str(), O_WRONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK );
+            struct stat info;
+            const char state = focused && ( !hasRuntime || okay ) ? '1' : '0';
+            const bool legacyOkay = fd >= 0 && fstat( fd, &info ) == 0 &&
+                S_ISREG( info.st_mode ) && info.st_uid == getuid() &&
+                pwrite( fd, &state, 1, 0 ) == 1;
+            if ( fd >= 0 )
+                close( fd );
+            if ( !legacyOkay && hasRuntime )
+                PreserveUnfocused();
+            okay = legacyOkay && ( !hasRuntime || okay );
+        }
+        return okay;
+    }
+
+private:
+    void PreserveUnfocused()
+    {
+        const int fd = openat( m_runtimeFd, m_name.c_str(),
+            O_WRONLY | O_CREAT | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK, 0600 );
+        if ( fd < 0 )
+            return;
+        struct stat info;
+        if ( fstat( fd, &info ) == 0 && S_ISREG( info.st_mode ) && info.st_uid == getuid() )
+        {
+            const std::string data = m_startTicks + "\n0\n";
+            if ( ftruncate( fd, 0 ) == 0 )
+                WriteAll( fd, data.data(), data.size() );
+        }
+        close( fd );
+    }
+
+    static bool WriteAll( int fd, const char *data, size_t length )
+    {
+        while ( length )
+        {
+            const ssize_t count = write( fd, data, length );
+            if ( count < 0 && errno == EINTR )
+                continue;
+            if ( count <= 0 )
+                return false;
+            data += count;
+            length -= count;
+        }
+        return true;
+    }
+
+    int m_runtimeFd = -1;
+    unsigned long m_sequence = 0;
+    std::string m_startTicks;
+    std::string m_name;
+    std::string m_legacyPath;
+};
+
+inline bool PublishHostFocus( bool focused )
+{
+    static HostFocusPublisher publisher;
+    return publisher.Publish( focused );
+}
